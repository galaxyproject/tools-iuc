<tool id="ete3_setup_database" name="ETE3 Setup Taxonomy Database" tool_type="manage_data" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>build an ETE3 NCBI taxonomy SQLite database</description>
    <macros>
        <token name="@TOOL_VERSION@">3.1.3</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">25.0</token>
    </macros>
    <requirements>
        <requirement type="package" version="3.12">python</requirement>
        <requirement type="package" version="@TOOL_VERSION@">ete3</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
mkdir -p '$out_file.extra_files_path' &&

#if $taxonomy_source.source == 'existing':
    #set $taxonomy_dir = $taxonomy_source.taxdump.fields.path
    #set $taxonomy_value = $taxonomy_source.taxdump.fields.value
    #set $taxonomy_name = $taxonomy_source.taxdump.fields.name
python '$__tool_directory__/build_ete3_taxonomy.py'
    --output-dir '$out_file.extra_files_path/db'
    --output-json '$out_file'
    --ete-version '@TOOL_VERSION@'
    --taxonomy-dir '$taxonomy_dir'
    --taxonomy-value '$taxonomy_value'
    --taxonomy-name '$taxonomy_name'
#else:
python '$__tool_directory__/build_ete3_taxonomy.py'
    --output-dir '$out_file.extra_files_path/db'
    --output-json '$out_file'
    --ete-version '@TOOL_VERSION@'
#end if
    ]]></command>
    <inputs>
        <conditional name="taxonomy_source">
            <param name="source" type="select" label="NCBI taxonomy source">
                <option value="existing" selected="true">
                    Use an installed NCBI taxonomy dump
                </option>
                <option value="download">
                    Download the current NCBI taxonomy
                </option>
            </param>
            <when value="existing">
                <param name="taxdump" type="select" label="NCBI taxonomy database" help="NCBI taxonomy data installed through the NCBI taxonomy Data Manager">
                    <options from_data_table="ncbi_taxonomy">
                        <filter type="sort_by" column="1"/>
                    </options>
                    <validator type="no_options" message="No NCBI Taxonomy database download is available"/>
                </param>
            </when>
            <when value="download"/>
        </conditional>
    </inputs>
    <outputs>
        <data name="out_file" format="data_manager_json"/>
    </outputs>
    <tests>
        <!-- Build from an existing Galaxy-managed NCBI taxonomy -->
        <test expect_num_outputs="1">
            <conditional name="taxonomy_source">
                <param name="source" value="existing"/>
                <param name="taxdump" value="test"/>
            </conditional>
            <output name="out_file">
                <assert_contents>
                    <has_text text="{&quot;data_tables&quot;"/>
                    <has_text text="ete3_taxonomy_db"/>
                    <has_text text="&quot;value&quot;: &quot;test&quot;"/>
                    <has_text text="&quot;name&quot;: &quot;Test NCBI taxonomy&quot;"/>
                    <has_text text="&quot;version&quot;: &quot;3.1.3&quot;"/>
                    <has_text text="&quot;path&quot;: &quot;db&quot;"/>
                </assert_contents>
            </output>
        </test>
        <!-- Let ETE3 download the current NCBI taxonomy -->
        <test expect_num_outputs="1">
            <conditional name="taxonomy_source">
                <param name="source" value="download"/>
            </conditional>
            <output name="out_file">
                <assert_contents>
                    <has_text text="{&quot;data_tables&quot;"/>
                    <has_text text="ete3_taxonomy_db"/>
                    <has_text_matching expression="&quot;value&quot;: &quot;ncbi_[0-9a-f]{64}&quot;"/>
                    <has_text_matching expression="&quot;name&quot;: &quot;NCBI Taxonomy \(downloaded \d{4}-\d{2}-\d{2}\)&quot;"/>
                    <has_text text="&quot;version&quot;: &quot;3.1.3&quot;"/>
                    <has_text text="&quot;path&quot;: &quot;db&quot;"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
## What it does

Builds an ETE3 SQLite taxonomy database from NCBI taxonomy data.

The database can either be created from an NCBI taxonomy dump already installed in
Galaxy through the **NCBI taxonomy** data manager, or ETE3 can download the current
NCBI taxonomy directly.

The result is registered in the `ete3_taxonomy_db` tool data table, where tools such
as **Perseus Extract Features** and **Perseus Filter Kraken2 Output** pick it up. The
data table entry points at the directory holding `taxa.sqlite`, so that the
`taxa.sqlite.traverse.pkl` cache ETE3 writes next to it is installed together with the
database.

### Inputs

- **Existing NCBI taxonomy dump**: uses taxonomy data already installed in Galaxy
  through the `ncbi_taxonomy` tool data table.
- **Download current NCBI taxonomy**: downloads the current taxonomy from the NCBI
  server and constructs the ETE3 SQLite database.
    ]]></help>
    <citations>
        <citation type="doi">10.1093/molbev/msw046</citation>
    </citations>
</tool>
