<data_managers>
    <data_manager tool_file="data_manager/ete3_setup_database.xml" id="ete3_setup_database">
        <data_table name="ete3_taxonomy_db">
            <output>
                <column name="value"/>
                <column name="name"/>
                <column name="path">
                    <move type="file">
                        <source>${path}</source>
                        <target base="${GALAXY_DATA_MANAGER_DATA_PATH}">
                            ete3_taxonomy_db/${value}/taxa.sqlite
                        </target>
                    </move>
                    <value_translation>
                        ${GALAXY_DATA_MANAGER_DATA_PATH}/ete3_taxonomy_db/${value}/taxa.sqlite
                    </value_translation>
                    <value_translation type="function">
                        abspath
                    </value_translation>
                </column>
            </output>
        </data_table>
    </data_manager>
</data_managers>
