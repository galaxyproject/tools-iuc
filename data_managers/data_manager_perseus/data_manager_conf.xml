<data_managers>
    <data_manager tool_file="data_manager/perseus_setup_database.xml" id="perseus_setup_database">
        <data_table name="perseus_taxonomy_db">
            <output>
                <column name="value"/>
                <column name="name"/>
                <column name="path"/>
                <move type="directory">
                    <source>${path}</source>
                    <target base="${GALAXY_DATA_MANAGER_DATA_PATH}">
                        perseus_taxonomy_db/${value}
                    </target>
                </move>
                <value_translation>
                    ${GALAXY_DATA_MANAGER_DATA_PATH}/perseus_taxonomy_db/${value}
                </value_translation>
                <value_translation type="function">abspath</value_translation>
            </output>
        </data_table>
    </data_manager>
</data_managers>
