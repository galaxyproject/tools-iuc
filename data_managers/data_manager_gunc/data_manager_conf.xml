<data_managers>
    <data_manager tool_file="data_manager/gunc_database_downloader.xml" id="gunc_database_downloader">
        <data_table name="gunc_database">
            <output>
                <column name="value"/>
                <column name="name"/>
                <column name="version"/>
                <column name="path" output_ref="out_file">
                    <move type="file">
                        <source>${path}</source>
                        <target base="${GALAXY_DATA_MANAGER_DATA_PATH}">gunc/${value}/${path}</target>
                    </move>
                    <value_translation>${GALAXY_DATA_MANAGER_DATA_PATH}/gunc/${value}/${path}</value_translation>
                    <value_translation type="function">abspath</value_translation>
                </column>
            </output>
        </data_table>
    </data_manager>
</data_managers>
