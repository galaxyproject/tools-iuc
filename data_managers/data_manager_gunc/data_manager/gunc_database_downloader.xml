<tool id="gunc_database_downloader" name="GUNC" tool_type="manage_data" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>reference database downloader</description>
    <macros>
        <token name="@TOOL_VERSION@">1.1.1</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">25.0</token>
    </macros>
    <xrefs>
        <xref type="bio.tools">gunc</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">gunc</requirement>
    </requirements>
    <version_command>gunc --version</version_command>
    <command detect_errors="exit_code"><![CDATA[
mkdir -p '$out_file.extra_files_path' &&
gunc download_db
    #if str($test) == 'true':
        --database test_data
    #else:
        --database '$database'
    #end if
    '$out_file.extra_files_path' &&
cp '$dmjson' '$out_file'
    ]]></command>
    <configfiles>
        <configfile name="dmjson"><![CDATA[
#set $files = {'progenomes_2.1': 'gunc_db_progenomes2.1.dmnd', 'progenomes_3': 'gunc_db_progenomes3.dmnd', 'gtdb_95': 'gunc_db_gtdb95.dmnd', 'gtdb_214': 'gunc_db_gtdb214.dmnd', 'test_data': 'ci_test.dmnd'}
#set $names = {'progenomes_2.1': 'proGenomes 2.1', 'progenomes_3': 'proGenomes 3', 'gtdb_95': 'GTDB 95', 'gtdb_214': 'GTDB 214', 'test_data': 'CI test data'}
#if str($test) == 'true':
    #set $db = 'test_data'
#else:
    #set $db = str($database)
#end if
{
  "data_tables": {
    "gunc_database": [
      {
        "value": "${db}",
        "name": "GUNC ${names[$db]} (GUNC @TOOL_VERSION@)",
        "version": "@TOOL_VERSION@",
        "path": "${files[$db]}"
      }
    ]
  }
}]]></configfile>
    </configfiles>
    <inputs>
        <param name="database" type="select" label="Database">
            <option value="progenomes_2.1" selected="true">proGenomes 2.1 (default of GUNC, ~13 GB)</option>
            <option value="progenomes_3">proGenomes 3</option>
            <option value="gtdb_95">GTDB release 95</option>
            <option value="gtdb_214">GTDB release 214</option>
        </param>
        <!-- tests set this to download GUNC's small CI database instead -->
        <param name="test" type="hidden" value="false"/>
    </inputs>
    <outputs>
        <data name="out_file" format="data_manager_json"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="test" value="true"/>
            <output name="out_file">
                <assert_contents>
                    <has_text text="&quot;value&quot;: &quot;test_data&quot;"/>
                    <has_text text="&quot;path&quot;: &quot;ci_test.dmnd&quot;"/>
                    <has_text text="&quot;version&quot;: &quot;1.1.1&quot;"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
Downloads a [GUNC](https://github.com/grp-bork/gunc) reference database (DIAMOND `.dmnd` file) with `gunc download_db`, checks its MD5 sums, and registers it in the `gunc_database` data table.

The file keeps its original name (e.g. `gunc_db_progenomes2.1.dmnd`), because GUNC derives the database type and the matching taxonomy from it.
    ]]></help>
    <citations>
        <citation type="doi">10.1186/s13059-021-02393-0</citation>
    </citations>
</tool>
