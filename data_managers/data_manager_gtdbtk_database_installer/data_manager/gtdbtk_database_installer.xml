<tool id="gtdbtk_database_installer" name="GTDB-Tk Database Installer" tool_type="manage_data" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description></description>
    <macros>
        <token name="@TOOL_VERSION@">232</token>
        <token name="@VERSION_SUFFIX@">1</token>
        <token name="@PROFILE@">24.0</token>
    </macros>
    <creator>
        <person givenName="Bérénice" familyName="Batut" identifier="https://orcid.org/0000-0001-9852-1987" url="https://github.com/bebatut"/>
        <person givenName="Björn" familyName="Grüning" identifier="https://orcid.org/0000-0002-3079-6586" url="https://github.com/bgruening"/>
        <person givenName="Cameron" familyName="Hyde" identifier="https://orcid.org/0000-0002-5913-9766" url="https://github.com/neoformit"/>
        <person givenName="Greg" familyName="Von Kuster" url="https://github.com/gregvonkuster"/>
        <person givenName="Marius" familyName="van den Beek" identifier="https://orcid.org/0000-0002-9676-7032" url="https://github.com/mvdbeek"/>
        <person givenName="Matthias" familyName="Bernt" identifier="https://orcid.org/0000-0003-3763-0797" url="https://github.com/bernt-matthias"/>
        <person givenName="Paul" familyName="Zierep" identifier="https://orcid.org/0000-0003-2982-388X" url="https://github.com/paulzierep"/>
        <person givenName="Santino" familyName="Faack" identifier="https://orcid.org/0009-0004-0382-2023" url="https://github.com/SantaMcCloud"/>
    </creator>
    <requirements>
        <requirement type="package" version="3.10.2">python</requirement>
    </requirements>
    <required_files>
        <include path="gtdbtk_database_installer.py"/>
    </required_files>
    <command><![CDATA[
        python '$__tool_directory__/gtdbtk_database_installer.py'
            --release '$release'
            --out_file '$out_file'
            $meta
            $test
    ]]></command>
    <inputs>
        <param name="meta" type="boolean" truevalue="--meta" falsevalue="" checked="false" label="Only store GTDBTK metadata in a dedicated data table."/>
        <param name="test" type="hidden" value="" checked="false" label="Run a dry test run!"/>
        <param name="release" type="select" multiple="false" label="GTDB Release">
            <option value="202">202</option>
            <option value="207">207</option>
            <option value="214">214</option>
            <option value="220">220</option>
            <option value="226">226</option>
            <option value="232.0" selected="true">232.0</option>
            <option value="mocked_232">mocked DB (232)</option>
        </param>
    </inputs>
    <outputs>
        <data name="out_file" format="data_manager_json"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <!-- Not actually installing a huge GTDB-Tk database -->
            <!-- but it will check if all urls exist -->
            <param name="release" value="202"/>
            <param name="test" value="--test"/>
            <output name="out_file">
                <assert_contents>
                    <has_text text="Full Database - release 202"/>
                    <has_text text="full_database_release_202"/>
                </assert_contents>
            </output>
            <assert_stdout>
                <!-- the test archive is not listed in the GTDB checksum files -->
                <has_text text="No remote MD5 sum available for release220-test.tar.gz: download not verified"/>
            </assert_stdout>
        </test>
        <test expect_num_outputs="1">
            <!-- Same test database as in the previous test, but the deposit
                 https://zenodo.org/records/23918153 also publishes an MD5SUM.txt
                 (md5 498d1d4516995bffb2283aa2ad83e361) for it. Release 232.0
                 selects this deposit in test mode.
            -->
            <param name="release" value="232.0"/>
            <param name="test" value="--test"/>
            <output name="out_file">
                <assert_contents>
                    <has_text text="Full Database - release 232.0"/>
                    <has_text text="full_database_release_232.0"/>
                    <has_text text="&quot;version&quot;: &quot;232&quot;"/>
                </assert_contents>
            </output>
            <assert_stdout>
                <has_text text="Remote MD5 sum used for release220-test.tar.gz: 498d1d4516995bffb2283aa2ad83e361 (from https://zenodo.org/records/23918153/files/MD5SUM.txt)"/>
            </assert_stdout>
        </test>
        <!-- Test meta data download with tsv.gz-->
        <!-- to large .. takes to much time
        <test expect_num_outputs="1">
            <param name="release" value="220"/>
            <param name="meta" value="true"/>
            <output name="out_file">
                <assert_contents>
                    <has_text text="Metadata Tables - release 220"/>
                    <has_text text="metadata_tables_release_220"/>
                </assert_contents>
            </output>
            <assert_stdout>
                <has_text text="Remote MD5 sum used for ar53_metadata_r220.tsv.gz: "/>
            </assert_stdout>
        </test> -->
        <test expect_num_outputs="1">
            <!-- Test meta data download with tar.gz -->
            <param name="release" value="207"/>
            <param name="meta" value="true"/>
            <output name="out_file">
                <assert_contents>
                    <has_text text="Metadata Tables - release 207"/>
                    <!-- value: metadata_tables_release_207 -->
                    <has_text text="metadata_tables_release_207"/>
                </assert_contents>
            </output>
            <assert_stdout>
                <!-- both checksums are taken from .../release207/207.0/MD5SUM.txt -->
                <has_text text="Remote MD5 sum used for ar53_metadata_r207.tar.gz: 610b08c1c1da4e3539a6c88bfa81be5e (from https://data.gtdb.ecogenomic.org/releases/release207/207.0/MD5SUM.txt)"/>
                <has_text text="Remote MD5 sum used for bac120_metadata_r207.tar.gz: fb1911b5aa12c098fd25387c4296b157 (from https://data.gtdb.ecogenomic.org/releases/release207/207.0/MD5SUM.txt)"/>
            </assert_stdout>
        </test>
    </tests>
    <help>
This data manager downloads the DB required for GTDB-Tk tools such as
the `gtdbtk classify_wf`. The meta options allows downloading only the metadata for the
corresponding DB, which is used by tools like `gtdb_to_taxdump`.

Downloaded files are verified against the MD5 checksums published by GTDB in the
root directory of each release (`MD5SUM.txt`). For every file the tool reports in
the job log whether a remote MD5 sum was used for verification, e.g.
`Remote MD5 sum used for ar53_metadata_r207.tar.gz: 610b08c1c... (from .../MD5SUM.txt)`
or `No remote MD5 sum available for ...: download not verified`. If no checksum is
published for a file (e.g. for the mockup database) the download still proceeds
unverified.

The installed databases are stored under their release, e.g.
`full_database_release_232.0` (`full database`) or `metadata_tables_release_232.0`
(`metadata only`), each in a dedicated directory. The release is the one GTDB names the
download directory after (e.g. `232.0`), the version stored in the data table is the
release without the minor version (`232`), which is what the tools filter on.
    </help>
    <citations>
        <citation type="doi">10.1038/s41587-020-0501-8</citation>
        <citation type="doi">10.1038/nbt.4229</citation>
    </citations>
</tool>
