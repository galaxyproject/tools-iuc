<tool id="data_manager_enzbert" name="enzbert data manager" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" tool_type="manage_data" profile="25.1">
    <macros>
        <token name="@TOOL_VERSION@">1.1</token>
        <token name="@VERSION_SUFFIX@">1</token>
    </macros>
    <command detect_errors="exit_code"><![CDATA[       
        python '$__tool_directory__/enzbert.py'
        --output-dir '$output_dir'
        --output-file '$output_file'
        --test '$test'
    ]]></command>
    <inputs>
        <param name='test' type='hidden'/>
        <param name='output_dir' type='text' label='Output Directory' value=""/>    
    </inputs>
    <outputs>
        <data name="output_file" format="data_manager_json" label="Enzbert data manager: JSON"/>
    </outputs>
    <tests>
        <test>
            <param name="test" value="true"/>
            <param name="output_dir" value="enzbert"/>
            <output name="output_file" file="out.json" compare="sim_size"/>
        </test>        
    </tests>
    <help><![CDATA[
        This data manager retrieves Enzbert model data.
    ]]></help>
    <citations>
        <citation type="doi">10.5281/zenodo.10041121</citation>
    </citations>
</tool>