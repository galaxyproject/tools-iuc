<tool id="molsig_alphabet_fetcher" name="Molecule signature alphabet fetcher" version="0.0.1" tool_type="manage_data" profile="21.05">
    <description>download alphabets from Zenodo</description>
    <requirements>
        <requirement type="package" version="3.12">python</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
        python '$__tool_directory__/fetch_alphabet.py'
            --alphabet '$alphabet'
            --version '$version'
            --out '$out_file'
    ]]></command>
    <inputs>
        <param name="alphabet" type="select" label="Alphabet to download">
            <option value="metanetx">MetaNetX (biology)</option>
            <option value="emolecules">eMolecules (commercial)</option>
            <option value="chembl">ChEMBL (drug-like)</option>
            <option value="drugbank">DrugBank (drugs)</option>
        </param>
        <param name="version" type="text" value="zenodo-22691018" label="Version tag">
            <validator type="regex">^[A-Za-z0-9._-]+$</validator>
        </param>
    </inputs>
    <outputs>
        <data name="out_file" format="data_manager_json"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="alphabet" value="drugbank"/>
            <param name="version" value="test"/>
            <output name="out_file">
                <assert_contents>
                    <has_text text="molsig_alphabets"/>
                    <has_text text="drugbank"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
Downloads a reference alphabet for the Molecule signature tool from
https://zenodo.org/records/22691018 and registers it in the ``molsig_alphabets`` data table.
    ]]></help>
    <citations>
        <citation type="doi">10.1186/s13321-025-01074-5</citation>
    </citations>
</tool>