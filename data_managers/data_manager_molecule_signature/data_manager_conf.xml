<?xml version="1.0"?>
<data_managers>
    <data_manager tool_file="data_manager/molsig_alphabet_fetcher.xml" id="molsig_alphabet_fetcher">
        <data_table name="molsig_alphabets">
            <output>
                <column name="value"/>
                <column name="name"/>
                <column name="version"/>
                <column name="path" output_ref="out_file">
                    <move type="file">
                        <source>${path}</source>
                        <target base="${GALAXY_DATA_MANAGER_DATA_PATH}">molsig_alphabets/${version}/${value}.npz</target>
                    </move>
                    <value_translation>${GALAXY_DATA_MANAGER_DATA_PATH}/molsig_alphabets/${version}/${value}.npz</value_translation>
                    <value_translation type="function">abspath</value_translation>
                </column>
            </output>
        </data_table>
    </data_manager>
</data_managers>