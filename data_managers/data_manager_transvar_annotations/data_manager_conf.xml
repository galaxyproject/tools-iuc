<?xml version="1.0"?>
<data_managers>
    <data_manager tool_file="data_manager/data_manager_transvar_download.xml" id="data_manager_transvar_download">
        <data_table name="transvar_annotations">
            <output>
                <column name="value"/>
                <column name="dbkey"/>
                <column name="refversion"/>
                <column name="name"/>
                <column name="sources"/>
                <column name="path" output_ref="out_file">
                    <move type="directory" relativize_symlinks="True">
                        <source>${path}</source>
                        <target base="${GALAXY_DATA_MANAGER_DATA_PATH}">transvar/${value}</target>
                    </move>
                    <value_translation>${GALAXY_DATA_MANAGER_DATA_PATH}/transvar/${value}</value_translation>
                    <value_translation type="function">abspath</value_translation>
                </column>
            </output>
        </data_table>
    </data_manager>
</data_managers>
