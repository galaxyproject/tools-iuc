---
import { siteConfig } from '../lib/data';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 bg-white">
  <div class="container-main py-8 text-sm text-slate-500">
    <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p>© {year} Galaxy IUC — Intergalactic Utilities Commission</p>
      <div class="flex gap-4">
        <a href={`https://github.com/${siteConfig.iuc.repo}`}>GitHub</a>
        <a href={siteConfig.iuc.guides}>Best-practice guides</a>
        <a href={`${base}/request/`}>Request a tool</a>
      </div>
    </div>
  </div>
</footer>
