---
import { siteConfig } from '../lib/data';
import '../styles/global.css';

const base = import.meta.env.BASE_URL; // /tools-iuc
const nav = [
  { href: `${base}/tools/`, label: 'Tools' },
  { href: `${base}/contributors/`, label: 'Contributors' },
  { href: `${base}/stats/`, label: 'Statistics' },
  { href: `${base}/request/`, label: 'Request a tool' },
];
const ecosystemNav = [
  { href: siteConfig.ecosystem.galaxy_hub, label: 'Galaxy Hub' },
  { href: siteConfig.ecosystem.iwc, label: 'IWC' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="container-main flex h-16 items-center justify-between">
    <a href={`${base}/`} class="flex items-center gap-2 no-underline">
      <img src={`${base}/iuc_logo.svg`} alt="IUC" class="h-8 w-8" />
      <span class="text-lg font-bold text-slate-900">IUC</span>
      <span class="hidden text-sm text-slate-500 sm:inline">Intergalactic Utilities Commission</span>
    </a>
    <nav class="flex items-center gap-1 overflow-x-auto text-sm sm:gap-3">
      {nav.map(item => (
        <a
          href={item.href}
          class:list={[
            'whitespace-nowrap px-2 py-1 rounded no-underline font-medium',
            path.startsWith(item.href) ? 'text-galaxy-700 bg-galaxy-50' : 'text-slate-600 hover:text-galaxy-700',
          ]}
        >{item.label}</a>
      ))}
      <span class="mx-1 hidden h-5 w-px bg-slate-200 md:block"></span>
      {ecosystemNav.map(item => (
        <a href={item.href} class="hidden whitespace-nowrap px-2 py-1 font-medium text-slate-600 no-underline hover:text-galaxy-700 md:inline" target="_blank" rel="noopener">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
