---
import type { ToolIndexEntry } from '../lib/data';

interface Props {
  tools: ToolIndexEntry[];
  evidence?: Record<string, { commits: string[]; paths: string[] }>;
}
const { tools, evidence = {} } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul class="mt-4 grid gap-3 sm:grid-cols-2">
  {tools.map(t => (
    <li class="card">
      <a href={`${base}/tools/${t.owner}/${t.repo}/${t.slug}/`} class="font-semibold no-underline">{t.name}</a>
      <p class="mt-1 text-sm text-slate-600">{t.description}</p>
      <div class="mt-2 flex flex-wrap gap-1">
        <span class="badge badge-blue">v{t.version}</span>
        {t.biotools && <span class="badge badge-purple">bio.tools</span>}
        {t.edam_topics.slice(0, 2).map(e => <span class="badge badge-slate">{e.label || e.uri.split('/').pop()}</span>)}
      </div>
      {evidence[t.path]?.commits.length > 0 && (
        <p class="mt-2 text-xs text-slate-500">
          {evidence[t.path].commits.length} contributing commit{evidence[t.path].commits.length === 1 ? '' : 's'} ·{' '}
          <a href={`https://github.com/galaxyproject/tools-iuc/commit/${evidence[t.path].commits[0]}`} target="_blank" rel="noopener">Example change</a>
        </p>
      )}
    </li>
  ))}
</ul>
