---
import { socialIcons, socialLink } from '../lib/socialIcons';
import { getGtnContributor, gtnHallOfFameUrl, hubHallOfFameUrl, type Contributor } from '../lib/data';

interface Props {
  contributor: Contributor;
  href?: string;
}

const { contributor: c, href } = Astro.props;

const base = import.meta.env.BASE_URL;

// Look up GTN metadata (source of truth for socials, etc.)
const gtn = getGtnContributor(c.gtn_handle);

const avatar = c.github
  ? `https://avatars.githubusercontent.com/${c.github}?s=240`
  : null;

const initials = c.name
  ? c.name.split(" ").map((w) => w[0]).slice(0, 2).join("").toUpperCase()
  : "?";

// Build social link list (from GTN if available, else from IUC data)
const socials: { type: string; href: string; icon: any }[] = [];
if (c.github) {
  const h = socialLink("github", c.github);
  if (h) socials.push({ type: "github", href: h, icon: socialIcons.github });
}
const orcid = gtn?.orcid ?? c.orcid;
if (orcid) {
  const h = socialLink("orcid", orcid);
  if (h) socials.push({ type: "ORCID", href: h, icon: socialIcons.orcid });
}
if (gtn?.fediverse) {
  const h = socialLink("fediverse", gtn.fediverse);
  if (h) socials.push({ type: "Fediverse", href: h, icon: socialIcons.fediverse });
}
if (gtn?.bluesky) {
  const h = socialLink("bluesky", gtn.bluesky);
  if (h) socials.push({ type: "Bluesky", href: h, icon: socialIcons.bluesky });
}
if (gtn?.linkedin) {
  const h = socialLink("linkedin", gtn.linkedin);
  if (h) socials.push({ type: "LinkedIn", href: h, icon: socialIcons.linkedin });
}
if (gtn?.matrix) {
  const h = socialLink("matrix", gtn.matrix);
  if (h) socials.push({ type: "Matrix", href: h, icon: socialIcons.matrix });
}
const url = gtn?.url ?? c.url;
if (url) {
  const h = socialLink("url", url);
  if (h) socials.push({ type: "Website", href: h, icon: socialIcons.globe });
}

// GTN / Hub cross-links
const gtnUrl = gtnHallOfFameUrl(c.gtn_handle);
const hubUrl = hubHallOfFameUrl(c.gtn_handle);

// Summary line: tools + commits
const parts: string[] = [];
if (c.tool_count > 0) parts.push(`${c.tool_count} tool${c.tool_count !== 1 ? "s" : ""}`);
if (c.commits > 0) parts.push(`${c.commits} commit${c.commits !== 1 ? "s" : ""}`);
const summary = parts.join(" · ");
---

<article class="relative rounded-lg border border-slate-200 bg-white p-6 pt-14 text-center shadow-sm transition-transform duration-200 hover:-translate-y-1 hover:shadow-md overflow-visible">
  {c.is_member && (
    <span class="absolute right-3 top-3 z-10 inline-flex items-center rounded-md bg-gradient-to-r from-galaxy-700 to-galaxy-500 px-2.5 py-0.5 text-[11px] font-semibold text-white shadow-md -rotate-3">
      IUC member
    </span>
  )}
  {c.is_alumni && (
    <span class="absolute right-3 top-3 z-10 inline-flex items-center rounded-md bg-slate-400 px-2.5 py-0.5 text-[11px] font-semibold text-white shadow-md -rotate-3">
      IUC alumni
    </span>
  )}

  <!-- Stretched link makes the whole card clickable -->
  {href && <a href={href} class="absolute inset-0 z-0" aria-label={c.name} />}

  <!-- Avatar — lifted above the card -->
  <div class="relative z-10 mx-auto -mt-16 mb-2 h-20 w-20 overflow-hidden rounded-full bg-slate-100 shadow-md ring-4 ring-white">
    {avatar ? (
      <img src={avatar} alt={c.name} class="h-full w-full object-cover" loading="lazy" />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-lg font-semibold text-galaxy-600">{initials}</div>
    )}
  </div>

  <div class="space-y-1">
    <h3 class="mt-2 text-lg font-semibold text-slate-900">{c.name}</h3>
    {summary && (
      <p class="text-sm text-slate-500">{summary}</p>
    )}
  </div>

  {/* Row 1: GTN + Hub icons */}
  {(gtnUrl || hubUrl) && (
    <div class="relative z-10 mt-2 flex justify-center gap-2">
      {gtnUrl && (
        <a href={gtnUrl} target="_blank" rel="noopener noreferrer" title="GTN Hall of Fame" aria-label="GTN Hall of Fame"
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white shadow-sm transition-colors hover:border-galaxy-400 hover:bg-galaxy-50">
          <img src={`${base}/gtn_icon.svg`} alt="" class="h-6 w-6" loading="lazy" />
        </a>
      )}
      {hubUrl && (
        <a href={hubUrl} target="_blank" rel="noopener noreferrer" title="Galaxy Hub Hall of Fame" aria-label="Galaxy Hub Hall of Fame"
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-white shadow-sm transition-colors hover:border-galaxy-400 hover:bg-galaxy-50">
          <img src={`${base}/galaxy_icon.png`} alt="" class="h-6 w-6" loading="lazy" />
        </a>
      )}
    </div>
  )}

  {/* Row 2: Social icons */}
  {socials.length > 0 && (
    <div class="relative z-10 mt-2 flex flex-wrap justify-center gap-2">
      {socials.map((s) => (
        <a
          href={s.href}
          title={s.type}
          aria-label={s.type}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-slate-200 bg-white text-galaxy-600 shadow-sm transition-colors hover:border-galaxy-400 hover:bg-galaxy-50"
        >
          <svg class="h-5 w-5" viewBox={s.icon.viewBox} aria-hidden="true">
            <path d={s.icon.path} fill="currentColor" />
          </svg>
        </a>
      ))}
    </div>
  )}
</article>
