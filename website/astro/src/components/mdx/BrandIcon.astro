---
import { brandIcons } from './brand-icons';
import { localIcons } from '../../lib/socialIcons';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, class: className, size = 20 } = Astro.props;

// Brand icons are a verbatim copy of galaxy-hub's brand-icons.ts; localIcons
// holds the few non-brand marks this site needs (currently just Globe).
const icons: Record<string, string> = { ...localIcons, ...brandIcons };
const svg = icons[name];

// The vendored SVG strings carry fixed width/height attributes, so resize them
// here — classes on the wrapper span do not size the inner svg.
function applySvgProps(svgStr: string, sizeVal: number, cls?: string): string {
  let result = svgStr.replace(/width="\d+"/, `width="${sizeVal}"`).replace(/height="\d+"/, `height="${sizeVal}"`);
  if (cls) {
    result = /class="[^"]*"/.test(result)
      ? result.replace(/class="[^"]*"/, `class="${cls}"`)
      : result.replace('<svg', `<svg class="${cls}"`);
  }
  return result;
}
---

{svg ? (
  <span class="inline-flex" set:html={applySvgProps(svg, size, className)} />
) : (
  <span title={`Unknown icon: ${name}`} />
)}
