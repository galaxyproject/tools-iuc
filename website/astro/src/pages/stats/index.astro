---
import Base from '../../layouts/Base.astro';
import { loadYaml } from '../../lib/data';

const stats = loadYaml<any>('stats.yaml');
const byMonth = stats.by_month || [];
const cumulative = stats.cumulative || [];
const cumulativeTools = stats.cumulative_tools || [];
const changeTypes = stats.change_types || {};
const topUpdated = stats.top_updated_suites || [];
const toolCount = stats.tool_count || 0;
const totalEvents = stats.total_events || 0;
const totalTools = stats.total_tools || 0;

const hasChangeTypes = Object.keys(changeTypes).length > 0;
const hasTopUpdated = topUpdated.length > 0;
const hasCumulative = cumulative.length > 0 && cumulativeTools.length > 0;

const changeTypeLabels: Record<string, string> = {
  initial: 'New tool added',
  wrapper: 'Wrapper update',
  upstream: 'Upstream version change',
};

const topUpdatedHeight = Math.max(250, topUpdated.length * 30);
---

<Base title="Statistics — IUC">
  <h1 class="text-2xl font-bold">IUC Statistics</h1>
  <p class="mt-1 text-slate-600">{toolCount.toLocaleString()} tools · {totalEvents.toLocaleString()} events · {totalTools} unique tool ids over time</p>

  <div class="mt-4 flex gap-8">
    <div class="text-center">
      <p class="text-3xl font-bold text-galaxy-600">{toolCount.toLocaleString()}</p>
      <p class="text-sm text-slate-500">Current tools</p>
    </div>
    <div class="text-center">
      <p class="text-3xl font-bold text-galaxy-600">{totalEvents.toLocaleString()}</p>
      <p class="text-sm text-slate-500">Total events</p>
    </div>
    <div class="text-center">
      <p class="text-3xl font-bold text-galaxy-600">{totalTools}</p>
      <p class="text-sm text-slate-500">Unique tool IDs</p>
    </div>
  </div>

  <section class="mt-8 card">
    <h2 class="text-lg font-semibold">New tool additions vs. updates per month</h2>
    <p class="text-sm text-slate-500">New tools (first appearance) versus updates to existing tools.</p>
    <div style="position: relative; height: 250px;" class="mt-3"><canvas id="chart-new-vs-update"></canvas></div>
  </section>

  <section class="mt-6 card">
    <h2 class="text-lg font-semibold">Total monthly activity</h2>
    <div style="position: relative; height: 250px;" class="mt-3"><canvas id="chart-monthly"></canvas></div>
  </section>

  {hasCumulative && (
    <section class="mt-6 card">
      <h2 class="text-lg font-semibold">Cumulative growth</h2>
      <p class="text-sm text-slate-500">Total events and total unique tools over time.</p>
      <div style="position: relative; height: 300px;" class="mt-3"><canvas id="chart-cumulative"></canvas></div>
    </section>
  )}

  {hasChangeTypes && (
    <section class="mt-6 card">
      <h2 class="text-lg font-semibold">Event breakdown by type</h2>
      <p class="text-sm text-slate-500">
        <span class="font-medium">New tool added</span> — first version of a tool ·
        <span class="font-medium">Wrapper update</span> — Galaxy wrapper/parameter changes ·
        <span class="font-medium">Upstream version change</span> — underlying software version changed
      </p>
      <div style="position: relative; height: 250px;" class="mt-3"><canvas id="chart-change"></canvas></div>
    </section>
  )}

  {hasTopUpdated && (
    <section class="mt-6 card">
      <h2 class="text-lg font-semibold">Most-updated tools</h2>
      <p class="text-sm text-slate-500">Tool directories with the most version updates (excluding initial additions). Numbers in parentheses show updates per tool for normalization.</p>
      <div style={`position: relative; height: ${topUpdatedHeight}px;`} class="mt-3"><canvas id="chart-top"></canvas></div>
    </section>
  )}
</Base>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script is:inline define:vars={{ byMonth, cumulative, cumulativeTools, changeTypes, topUpdated, hasChangeTypes, hasTopUpdated, hasCumulative, changeTypeLabels, topUpdatedHeight }}>
  function makeChart(id, config) {
    const el = document.getElementById(id);
    if (el && window.Chart) new Chart(el, config);
  }

  const months = byMonth.map(d => d.month);
  const newCounts = byMonth.map(d => d.new || 0);
  const updateCounts = byMonth.map(d => d.updates || 0);

  makeChart('chart-new-vs-update', {
    type: 'bar',
    data: { labels: months, datasets: [
      { label: 'New tools', data: newCounts, backgroundColor: '#22c55e' },
      { label: 'Updates', data: updateCounts, backgroundColor: '#3377ff' },
    ] },
    options: { responsive: true, maintainAspectRatio: false,
      scales: { x: { stacked: true, ticks: { maxTicksLimit: 12 } }, y: { stacked: true } } },
  });

  makeChart('chart-monthly', {
    type: 'bar',
    data: { labels: months, datasets: [{ label: 'Events', data: byMonth.map(d => d.count), backgroundColor: '#3377ff' }] },
    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
      scales: { x: { ticks: { maxTicksLimit: 12 } } } },
  });

  if (hasCumulative) {
    const cumMonths = cumulative.map(d => d.month);
    makeChart('chart-cumulative', {
      type: 'line',
      data: { labels: cumMonths, datasets: [
        { label: 'Cumulative events', data: cumulative.map(d => d.cumulative), borderColor: '#1a55f0', backgroundColor: 'rgba(26,85,240,0.1)', fill: true, yAxisID: 'y' },
        { label: 'Cumulative tools', data: cumulativeTools.map(d => d.cumulative), borderColor: '#22c55e', backgroundColor: 'rgba(34,197,94,0.1)', fill: true, yAxisID: 'y1' },
      ] },
      options: { responsive: true, maintainAspectRatio: false,
        scales: {
          x: { ticks: { maxTicksLimit: 12 } },
          y: { position: 'left', title: { display: true, text: 'Events' } },
          y1: { position: 'right', title: { display: true, text: 'Tools' }, grid: { drawOnChartArea: false } },
        } },
    });
  }

  if (hasChangeTypes) {
    const ctEntries = Object.entries(changeTypes);
    makeChart('chart-change', {
      type: 'bar',
      data: { labels: ctEntries.map(([k]) => changeTypeLabels[k] || k), datasets: [{ label: 'Count', data: ctEntries.map(([, v]) => v), backgroundColor: ['#22c55e', '#3377ff', '#f59e0b', '#8b5cf6'] }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } },
    });
  }

  if (hasTopUpdated) {
    makeChart('chart-top', {
      type: 'bar',
      data: { labels: topUpdated.map(d => `${d.directory} (${d.updates_per_tool}/tool)`), datasets: [{ label: 'Updates', data: topUpdated.map(d => d.updates), backgroundColor: '#3377ff' }] },
      options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } },
    });
  }
</script>
