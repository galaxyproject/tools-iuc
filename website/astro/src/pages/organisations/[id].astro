---
import Base from '../../layouts/Base.astro';
import { loadYaml, type Organisation, type ToolIndexEntry } from '../../lib/data';

export function getStaticPaths() {
  const orgs = loadYaml<Organisation[]>('organisations.yaml');
  return orgs.map(o => ({
    params: { id: o.name.toLowerCase().replace(/[^a-z0-9]+/g, '-') },
    props: { org: o },
  }));
}

const { org } = Astro.props as { org: Organisation };
const tools = loadYaml<ToolIndexEntry[]>('tools_index.yaml');
const authored = tools.filter(t => org.tools.includes(t.id));
const base = import.meta.env.BASE_URL;
---

<Base title={`${org.name} — IUC Organisations`}>
  <nav class="text-sm text-slate-500"><a href={`${base}/organisations/`}>Organisations</a> / <span>{org.name}</span></nav>
  <h1 class="mt-4 text-2xl font-bold">{org.name}</h1>
  <p class="mt-1 text-sm text-slate-500">{authored.length} tool{authored.length !== 1 ? 's' : ''}</p>
  {org.url && <a href={org.url} class="text-sm">Website →</a>}

  <h2 class="mt-8 text-xl font-bold">Tools</h2>
  <ul class="mt-3 grid gap-3 sm:grid-cols-2">
    {authored.map(t => (
      <li class="card">
        <a href={`${base}/tools/${t.owner}/${t.repo}/${t.id}/`} class="font-semibold no-underline">{t.name}</a>
        <p class="text-sm text-slate-600">{t.description}</p>
      </li>
    ))}
  </ul>
</Base>
