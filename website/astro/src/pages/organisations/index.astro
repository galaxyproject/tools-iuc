---
import Base from '../../layouts/Base.astro';
import { loadYaml, type Organisation } from '../../lib/data';

const orgs = loadYaml<Organisation[]>('organisations.yaml');
const base = import.meta.env.BASE_URL;
---

<Base title="Organisations — IUC">
  <h1 class="text-2xl font-bold">Organisations</h1>
  <p class="mt-1 text-slate-600">{orgs.length} organisations have contributed tools to the IUC.</p>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {orgs.map(o => (
      <a href={`${base}/organisations/${o.name.toLowerCase().replace(/[^a-z0-9]+/g,'-')}/`} class="card no-underline">
        <p class="font-semibold text-slate-900">{o.name}</p>
        <p class="text-sm text-slate-500">{o.tool_count} tool{o.tool_count !== 1 ? 's' : ''}</p>
      </a>
    ))}
  </div>
</Base>
