---
import Base from '../../layouts/Base.astro';
import { loadYaml, type Contributor, type ToolIndexEntry, getGtnContributor, gtnHallOfFameUrl, hubHallOfFameUrl, affiliationUrl } from '../../lib/data';
import { socialIcons, socialLink } from '../../lib/socialIcons';

export function getStaticPaths() {
  const contributors = loadYaml<Contributor[]>('contributors.yaml');
  const tools = loadYaml<ToolIndexEntry[]>('tools_index.yaml');
  const toolsById = new Map(tools.map(t => [t.id, t]));
  return contributors.map(c => ({
    params: { id: c.id },
    props: {
      contributor: c,
      authored: c.tools.map(id => toolsById.get(id)).filter(Boolean) as ToolIndexEntry[],
    },
  }));
}

const { contributor: c, authored } = Astro.props as { contributor: Contributor; authored: ToolIndexEntry[] };
const base = import.meta.env.BASE_URL;

// Look up GTN metadata (source of truth)
const gtn = getGtnContributor(c.gtn_handle);

const avatar = c.github
  ? `https://avatars.githubusercontent.com/${c.github}?s=200`
  : null;
const initials = c.name
  ? c.name.split(" ").map(w => w[0]).slice(0, 2).join("").toUpperCase()
  : "?";

// Social links (from GTN if available, else from IUC data)
const socials: { type: string; href: string; icon: any }[] = [];
if (c.github) {
  const h = socialLink("github", c.github);
  if (h) socials.push({ type: "GitHub", href: h, icon: socialIcons.github });
}
const orcid = gtn?.orcid ?? c.orcid;
if (orcid) {
  const h = socialLink("orcid", orcid);
  if (h) socials.push({ type: "ORCID", href: h, icon: socialIcons.orcid });
}
if (gtn?.fediverse) {
  const h = socialLink("fediverse", gtn.fediverse);
  if (h) socials.push({ type: "Fediverse", href: h, icon: socialIcons.fediverse });
}
if (gtn?.bluesky) {
  const h = socialLink("bluesky", gtn.bluesky);
  if (h) socials.push({ type: "Bluesky", href: h, icon: socialIcons.bluesky });
}
if (gtn?.linkedin) {
  const h = socialLink("linkedin", gtn.linkedin);
  if (h) socials.push({ type: "LinkedIn", href: h, icon: socialIcons.linkedin });
}
if (gtn?.matrix) {
  const h = socialLink("matrix", gtn.matrix);
  if (h) socials.push({ type: "Matrix", href: h, icon: socialIcons.matrix });
}
const url = gtn?.url ?? c.url;
if (url) {
  const h = socialLink("url", url);
  if (h) socials.push({ type: "Website", href: h, icon: socialIcons.globe });
}

// GTN / Hub cross-links
const gtnUrl = gtnHallOfFameUrl(c.gtn_handle);
const hubUrl = hubHallOfFameUrl(c.gtn_handle);

// Contribution summary
const contribParts: string[] = [];
if (c.tool_count > 0) contribParts.push(`${c.tool_count} tool${c.tool_count !== 1 ? "s" : ""} authored`);
if (c.commits > 0) contribParts.push(`${c.commits} commit${c.commits !== 1 ? "s" : ""}`);
const contribSummary = contribParts.join(" · ");

// Affiliations (current + former) from GTN
const currentAffils = gtn?.affiliations || [];
const formerAffils = gtn?.former_affiliations || [];
---

<Base title={`${c.name} — IUC Contributors`} description={`${c.name} — IUC contributor with ${c.tool_count} tools and ${c.commits} commits.`}>
  <nav class="text-sm text-slate-500"><a href={`${base}/contributors/`}>← Hall of Fame</a></nav>

  <!-- Dark gradient header -->
  <div class="mt-4 overflow-hidden rounded-t-lg bg-gradient-to-br from-galaxy-800 to-galaxy-600 px-6 py-8 text-white sm:px-8">
    <div class="flex items-start gap-6">
      <div class="flex h-28 w-28 flex-shrink-0 items-center justify-center overflow-hidden rounded-xl bg-white/95 ring-2 ring-white/50 shadow-lg">
        {avatar ? (
          <img src={avatar} alt={c.name} class="h-full w-full object-cover" />
        ) : (
          <span class="text-4xl font-bold text-galaxy-700">{initials}</span>
        )}
      </div>
      <div class="flex-1 space-y-2">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-3xl font-bold">{c.name}</h1>
          {c.is_member && (
            <span class="rounded-md bg-white px-3 py-1 text-sm font-semibold text-galaxy-700 shadow-sm">IUC Member</span>
          )}
        </div>
        {contribSummary && (
          <p class="text-galaxy-100">{contribSummary}</p>
        )}
        {c.first_commit && (
          <p class="text-sm text-galaxy-200">First IUC contribution {c.first_commit.slice(0, 10)}</p>
        )}
        {/* Row 1: GTN + Hub icon buttons (no text) */}
        {(gtnUrl || hubUrl) && (
          <div class="flex flex-wrap gap-2 pt-2">
            {gtnUrl && (
              <a href={gtnUrl} target="_blank" rel="noopener noreferrer" title="GTN Hall of Fame" aria-label="GTN Hall of Fame"
                class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-white shadow-sm transition-colors hover:bg-galaxy-50">
                <img src={`${base}/gtn_icon.svg`} alt="" class="h-7 w-7" loading="lazy" />
              </a>
            )}
            {hubUrl && (
              <a href={hubUrl} target="_blank" rel="noopener noreferrer" title="Galaxy Hub Hall of Fame" aria-label="Galaxy Hub Hall of Fame"
                class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-white shadow-sm transition-colors hover:bg-galaxy-50">
                <img src={`${base}/galaxy_icon.png`} alt="" class="h-7 w-7" loading="lazy" />
              </a>
            )}
          </div>
        )}
        {/* Row 2: Social icons */}
        {socials.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {socials.map(s => (
              <a
                href={s.href}
                title={s.type}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-white text-galaxy-700 shadow-sm transition-colors hover:bg-galaxy-50"
              >
                <svg class="h-6 w-6" viewBox={s.icon.viewBox} aria-hidden="true">
                  <path d={s.icon.path} fill="currentColor" />
                </svg>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- White body -->
  <div class="rounded-b-lg bg-white px-6 py-6 shadow-sm sm:px-8">
    <!-- Bio -->
    {gtn?.bio && (
      <div class="mb-6">
        <h2 class="text-lg font-bold">Bio</h2>
        <p class="mt-2 whitespace-pre-line text-slate-700">{gtn.bio}</p>
      </div>
    )}

    <!-- Metadata grid -->
    {(currentAffils.length > 0 || formerAffils.length > 0 || gtn?.location || gtn?.elixir_node) && (
      <div class="mb-6 grid gap-4 sm:grid-cols-2">
        <div class="space-y-3">
          {currentAffils.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-slate-500">Affiliations</h3>
              <div class="mt-1 flex flex-wrap gap-1.5">
                {currentAffils.map(a => {
                  const aUrl = affiliationUrl(a);
                  return aUrl
                    ? <a class="badge badge-blue no-underline" href={aUrl} target="_blank" rel="noopener noreferrer">{a}</a>
                    : <span class="badge badge-blue">{a}</span>;
                })}
              </div>
            </div>
          )}
          {formerAffils.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-slate-500">Former affiliations</h3>
              <div class="mt-1 flex flex-wrap gap-1.5">
                {formerAffils.map(a => {
                  const aUrl = affiliationUrl(a);
                  return aUrl
                    ? <a class="badge badge-slate no-underline" href={aUrl} target="_blank" rel="noopener noreferrer">{a}</a>
                    : <span class="badge badge-slate">{a}</span>;
                })}
              </div>
            </div>
          )}
        </div>
        <div class="space-y-3">
          {gtn?.location && (
            <div>
              <h3 class="text-sm font-semibold text-slate-500">Location</h3>
              <p class="mt-1 text-slate-700">{gtn.location.country}</p>
            </div>
          )}
          {gtn?.elixir_node && (
            <div>
              <h3 class="text-sm font-semibold text-slate-500">ELIXIR Node</h3>
              <p class="mt-1 text-slate-700 uppercase">{gtn.elixir_node}</p>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- Authored tools -->
    <h2 class="text-xl font-bold">Authored tools</h2>
    {authored.length === 0 ? (
      <p class="mt-3 text-slate-500">No tools found as <code>&lt;creator&gt;</code>. {c.commits > 0 && `This contributor has ${c.commits} git commit${c.commits !== 1 ? "s" : ""} in the IUC repository.`}</p>
    ) : (
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {authored.map(t => (
          <li class="card">
            <a href={`${base}/tools/${t.owner}/${t.repo}/${t.id}/`} class="font-semibold no-underline">{t.name}</a>
            <p class="mt-1 text-sm text-slate-600">{t.description}</p>
            <div class="mt-2 flex flex-wrap gap-1">
              <span class="badge badge-blue">v{t.version}</span>
              {t.biotools && <span class="badge badge-purple">bio.tools</span>}
              {t.edam_topics.slice(0, 2).map(e => <span class="badge badge-slate">{e}</span>)}
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
