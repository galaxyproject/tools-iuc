---
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/PersonCard.astro';
import { loadYaml, type Contributor, type Organisation } from '../../lib/data';

const contributors = loadYaml<Contributor[]>('contributors.yaml');
const organisations = loadYaml<Organisation[]>('organisations.yaml');
const base = import.meta.env.BASE_URL;
const members = contributors.filter(c => c.is_member);
const alumni = contributors.filter(c => c.is_alumni);
---

<Base title="Contributors — IUC">
  <h1 class="text-2xl font-bold">IUC contributors</h1>
  <p class="mt-1 max-w-3xl text-slate-600">
    People and organisations who authored tool metadata, maintained wrappers, or contributed commits to
    IUC repositories. GTN and Galaxy Hub Hall of Fame links are shown when a contributor has matching
    Galaxy community metadata.
  </p>

  <div class="mt-4 flex gap-8">
    <div class="text-center">
      <p class="text-3xl font-bold text-galaxy-600">{contributors.length}</p>
      <p class="text-sm text-slate-500">Contributors</p>
    </div>
    <div class="text-center">
      <p class="text-3xl font-bold text-galaxy-600">{members.length}</p>
      <p class="text-sm text-slate-500">Active IUC members</p>
    </div>
    <div class="text-center">
      <a href="#organisations" class="block no-underline">
        <p class="text-3xl font-bold text-galaxy-600">{organisations.length}</p>
        <p class="text-sm text-slate-500">Organisations</p>
      </a>
    </div>
  </div>

  <h2 class="mt-10 text-xl font-bold">People</h2>
  <div class="mt-4 grid gap-x-5 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
    {contributors.map(c => (
      <PersonCard
        contributor={c}
        href={`${base}/contributors/${c.id}/`}
      />
    ))}
  </div>

  {organisations.length > 0 && (
    <>
      <h2 id="organisations" class="mt-12 scroll-mt-4 text-xl font-bold">Organisations</h2>
      <div class="mt-4 grid gap-x-5 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {organisations.map(o => (
          <article class="rounded-lg border border-slate-200 bg-white p-5 text-center shadow-sm">
            <h3 class="text-base font-semibold text-slate-900">
              {o.url ? (
                <a href={o.url} target="_blank" rel="noopener noreferrer" class="hover:text-galaxy-600 hover:underline">{o.name}</a>
              ) : (
                o.name
              )}
            </h3>
            <p class="mt-1 text-sm text-slate-500">{o.tool_count} tool{o.tool_count !== 1 ? "s" : ""}</p>
          </article>
        ))}
      </div>
    </>
  )}
</Base>
