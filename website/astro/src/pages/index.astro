---
import Base from '../layouts/Base.astro';
import { loadYaml, loadConfig, type ToolIndexEntry } from '../lib/data';

const tools = loadYaml<ToolIndexEntry[]>('tools_index.yaml');
const recent = loadYaml<{ added: any[]; updated: any[] }>('recent.yaml');
const stats = loadYaml<{ tool_count: number; by_month: any[] }>('stats.yaml');
const repos = loadConfig<any[]>('tool_repos.yaml');
const base = import.meta.env.BASE_URL;

const toolCount = tools.length;

// recent.added / recent.updated entries already carry a `tool` (slim index entry),
// `date`, `subject`, and `version` (produced by pipeline/extract_stats.py).
const added = (recent.added || []).filter((e: any) => e.tool);
const updated = (recent.updated || []).filter((e: any) => e.tool);
---

<Base title="IUC — Intergalactic Utilities Commission">
  <!-- Hero -->
  <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-galaxy-50 to-galaxy-100 px-8 py-12 text-slate-800 border border-galaxy-200">
    <img src={`${base}/iuc_logo.svg`} alt="IUC logo" class="absolute right-8 top-8 h-32 w-32 opacity-90" />
    <h1 class="text-3xl font-bold sm:text-4xl text-galaxy-800">Intergalactic Utilities Commission</h1>
    <p class="mt-3 max-w-2xl text-lg text-slate-600">
      The IUC maintains <strong>{toolCount.toLocaleString()}</strong> high-quality, well-annotated tools
      for the Galaxy platform — from genomics to climate science.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`${base}/tools/`} class="btn btn-primary">Browse tools</a>
      <a href={`${base}/request/`} class="btn btn-secondary">Request a tool</a>
      <a href="https://galaxy-iuc-standards.readthedocs.io/" class="btn btn-secondary">Best-practice guides</a>
    </div>
    <!-- Search -->
    <div class="mt-6 max-w-xl">
      <label class="sr-only" for="tool-search">Search tools</label>
      <div class="flex shadow-sm">
        <input
          id="tool-search"
          type="search"
          placeholder="Search tools by name, description, EDAM term…"
          class="w-full rounded-l-md border border-slate-300 px-4 py-2 text-slate-800 outline-none focus:border-galaxy-500 focus:ring-2 focus:ring-galaxy-200"
        />
        <button type="button" id="tool-search-btn" class="btn btn-primary rounded-l-none">Search</button>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ base }}>
    function doSearch() {
      const v = document.getElementById('tool-search')?.value;
      if (v) window.location.href = `${base}/tools/?q=` + encodeURIComponent(v);
    }
    document.getElementById('tool-search')?.addEventListener('keydown', e => { if (e.key === 'Enter') doSearch(); });
    document.getElementById('tool-search-btn')?.addEventListener('click', doSearch);
  </script>

  <!-- What is IUC + how to contribute -->
  <section class="mt-8 grid gap-6 md:grid-cols-3">
    <div class="card">
      <h2 class="text-lg font-semibold">What is the IUC?</h2>
      <p class="mt-2 text-sm text-slate-600">
        The Intergalactic Utilities Commission is a community of tool developers that curates and maintains
        a standard set of high-quality Galaxy tool wrappers, ensuring they are well-tested, well-annotated,
        and reproducibly installable from the ToolShed.
      </p>
    </div>
    <div class="card">
      <h2 class="text-lg font-semibold">How to contribute</h2>
      <p class="mt-2 text-sm text-slate-600">
        Add or improve a tool wrapper, review pull requests, or report issues. New contributors are always
        welcome — see the best-practice guides and the CONTRIBUTING file in the repository.
      </p>
      <a class="mt-2 inline-block text-sm" href={`https://github.com/galaxyproject/tools-iuc/blob/main/CONTRIBUTING.md`}>Read CONTRIBUTING.md →</a>
    </div>
    <div class="card">
      <h2 class="text-lg font-semibold">Tool count</h2>
      <p class="mt-2 text-3xl font-bold text-galaxy-700">{toolCount.toLocaleString()}</p>
      <p class="text-sm text-slate-600">tool wrappers maintained by the IUC</p>
    </div>
  </section>

  <!-- Recent additions + updates -->
  <section class="mt-8 grid gap-6 md:grid-cols-2">
    <div>
      <h2 class="mb-3 text-xl font-bold">Recently added</h2>
      <ul class="space-y-2">
        {added.map(e => (
          <li class="card flex items-center justify-between">
            <div>
              <a href={`${base}/tools/${e.tool.owner}/${e.tool.repo}/${e.tool.id}/`} class="font-semibold no-underline">{e.tool.name}</a>
              <p class="text-sm text-slate-500">{e.tool.description}</p>
            </div>
            <span class="badge badge-green">{e.date}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="mb-3 text-xl font-bold">Recently updated</h2>
      <ul class="space-y-2">
        {updated.map(e => (
          <li class="card flex items-center justify-between">
            <div>
              <a href={`${base}/tools/${e.tool.owner}/${e.tool.repo}/${e.tool.id}/`} class="font-semibold no-underline">{e.tool.name}</a>
              <p class="text-sm text-slate-500 truncate">{e.subject}</p>
            </div>
            <span class="badge badge-blue">{e.date}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Stats preview -->
  <section class="mt-8 card">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold">Activity</h2>
      <a href={`${base}/stats/`} class="text-sm">Full statistics →</a>
    </div>
    <p class="mt-2 text-sm text-slate-600">
      {stats.by_month?.length ?? 0} months of activity recorded across the IUC tool repositories.
    </p>
  </section>

  <!-- Other Galaxy tool repositories -->
  <section class="mt-8">
    <h2 class="text-xl font-bold">Other Galaxy tool repositories</h2>
    <p class="mt-1 text-sm text-slate-600">
      Beyond the IUC, many teams maintain Galaxy tool wrappers. To add a new repository,
      edit <a href="https://github.com/galaxyproject/tools-iuc/blob/main/website/config/tool_repos.yaml" class="underline" target="_blank" rel="noopener"><code>tool_repos.yaml</code></a>.
    </p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {repos.map(r => (
        <li class="card">
          <a href={r.url} class="font-semibold no-underline" target="_blank" rel="noopener">{r.name}</a>
          <p class="mt-1 text-sm text-slate-600">{r.description}</p>
          {r.owner && <p class="mt-1 text-xs text-slate-400">{r.owner}</p>}
        </li>
      ))}
    </ul>
  </section>
</Base>
