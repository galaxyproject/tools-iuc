---
import Base from '../layouts/Base.astro';
import { loadYaml, loadConfig, siteConfig, withBase, type ToolIndexEntry } from '../lib/data';

const tools = loadYaml<ToolIndexEntry[]>('tools_index.yaml');
const recent = loadYaml<{ added: any[]; updated: any[] }>('recent.yaml');
const stats = loadYaml<{ tool_count: number; by_month: any[] }>('stats.yaml');
const contributors = loadYaml<any[]>('contributors.yaml');
const repos = loadConfig<any[]>('tool_repos.yaml');
const base = import.meta.env.BASE_URL;

const toolCount = tools.length;
const annotatedCount = tools.filter(t => t.edam_operations.length || t.edam_topics.length || t.biotools).length;
const contributorCount = contributors.length;

// recent.added / recent.updated entries already carry a `tool` (slim index entry),
// `date`, `subject`, and `version` (produced by pipeline/extract_stats.py).
const added = (recent.added || []).filter((e: any) => e.tool);
const updated = (recent.updated || []).filter((e: any) => e.tool);
---

<Base title="IUC — Intergalactic Utilities Commission">
  <section class="border-b border-slate-200 pb-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-4xl">
        <p class="text-base font-semibold uppercase tracking-wide text-galaxy-700">Galaxy tool development</p>
        <h1 class="mt-2 text-4xl font-bold text-slate-950 sm:text-5xl">Intergalactic Utilities Commission</h1>
        <p class="mt-4 text-xl leading-8 text-slate-600">
          The IUC maintains reviewed, tested, high-quality Galaxy tool wrappers for the Main ToolShed and
          provides the best-practice standards used by the wider Galaxy tool developer community.
        </p>
      </div>
      <img src={withBase('iuc_logo.svg')} alt="IUC logo" class="h-32 w-32 shrink-0 lg:h-40 lg:w-40" />
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={`${base}/tools/`} class="btn btn-primary">Browse tools</a>
      <a href={`${base}/request/`} class="btn btn-secondary">Request a tool</a>
      <a href={siteConfig.iuc.guides} class="btn btn-secondary" target="_blank" rel="noopener">Best-practice guides</a>
      <a href={siteConfig.toolshed.base} class="btn btn-secondary" target="_blank" rel="noopener">Main ToolShed</a>
    </div>
    <!-- Search -->
    <div class="mt-6 max-w-xl">
      <label class="sr-only" for="tool-search">Search tools</label>
      <div class="flex shadow-sm">
        <input
          id="tool-search"
          type="search"
          placeholder="Search tools by name, description, EDAM term…"
          class="w-full rounded-l-md border border-slate-300 px-4 py-2 text-slate-800 outline-none focus:border-galaxy-500 focus:ring-2 focus:ring-galaxy-200"
        />
        <button type="button" id="tool-search-btn" class="btn btn-primary rounded-l-none">Search</button>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ base }}>
    function doSearch() {
      const v = document.getElementById('tool-search')?.value;
      if (v) window.location.href = `${base}/tools/?q=` + encodeURIComponent(v);
    }
    document.getElementById('tool-search')?.addEventListener('keydown', e => { if (e.key === 'Enter') doSearch(); });
    document.getElementById('tool-search-btn')?.addEventListener('click', doSearch);
  </script>

  <section class="mt-8 grid gap-6 border-b border-slate-200 pb-8 md:grid-cols-3">
    <div class="text-center">
      <p class="text-3xl font-bold text-galaxy-700">{toolCount.toLocaleString()}</p>
      <p class="mt-1 text-sm font-medium text-slate-700">tool wrappers</p>
    </div>
    <div class="text-center">
      <p class="text-3xl font-bold text-galaxy-700">{annotatedCount.toLocaleString()}</p>
      <p class="mt-1 text-sm font-medium text-slate-700">with EDAM/bio.tools metadata</p>
    </div>
    <div class="text-center">
      <p class="text-3xl font-bold text-galaxy-700">{contributorCount.toLocaleString()}</p>
      <p class="mt-1 text-sm font-medium text-slate-700">contributors</p>
    </div>
  </section>

  <section class="mt-8 grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
    <div>
      <h2 class="text-xl font-bold">What the IUC maintains</h2>
      <ul class="mt-3 space-y-3 text-sm leading-6 text-slate-600">
        <li><strong class="text-slate-800">Reviewed ToolShed repositories.</strong> The IUC repository is the reference collection of community-maintained Galaxy tool wrappers.</li>
        <li><strong class="text-slate-800">Best-practice standards.</strong> Tool metadata, tests, requirements, containers, citations, and EDAM annotations follow shared Galaxy conventions.</li>
        <li><strong class="text-slate-800">Developer support.</strong> Contributors can discuss wrapper quality, metadata, and review questions in public Galaxy channels.</li>
      </ul>
    </div>
    <div>
      <h2 class="text-xl font-bold">Galaxy Tool ecosystem</h2>
      <div class="mt-3 grid gap-2 text-sm">
        <a class="rounded-md border border-slate-200 bg-white px-3 py-2 no-underline hover:border-galaxy-400" href={siteConfig.ecosystem.planemo} target="_blank" rel="noopener">Planemo</a>
        <a class="rounded-md border border-slate-200 bg-white px-3 py-2 no-underline hover:border-galaxy-400" href={siteConfig.ecosystem.galaxy_language_server} target="_blank" rel="noopener">Galaxy Language Server</a>
        <a class="rounded-md border border-slate-200 bg-white px-3 py-2 no-underline hover:border-galaxy-400" href={siteConfig.ecosystem.gtn_tool_training} target="_blank" rel="noopener">GTN tool development training</a>
        <a class="rounded-md border border-slate-200 bg-white px-3 py-2 no-underline hover:border-galaxy-400" href={siteConfig.ecosystem.tool_dev_sig} target="_blank" rel="noopener">Tool Development SIG</a>
        <a class="rounded-md border border-slate-200 bg-white px-3 py-2 no-underline hover:border-galaxy-400" href={siteConfig.ecosystem.chat} target="_blank" rel="noopener">IUC community chat</a>
      </div>
    </div>
  </section>

  <!-- Recent additions + updates -->
  <section class="mt-8 grid gap-6 md:grid-cols-2">
    <div>
      <h2 class="mb-3 text-xl font-bold">Recently added</h2>
      <ul class="space-y-2">
        {added.map(e => (
          <li class="card flex min-w-0 items-center justify-between gap-3">
            <div class="min-w-0">
              <a href={`${base}/tools/${e.tool.owner}/${e.tool.repo}/${e.tool.slug}/`} class="block truncate font-semibold no-underline">{e.tool.name}</a>
              <p class="text-sm text-slate-500">{e.tool.description}</p>
            </div>
            <span class="badge badge-green shrink-0">{e.date}</span>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="mb-3 text-xl font-bold">Recently updated</h2>
      <ul class="space-y-2">
        {updated.map(e => (
          <li class="card flex min-w-0 items-center justify-between gap-3">
            <div class="min-w-0">
              <a href={`${base}/tools/${e.tool.owner}/${e.tool.repo}/${e.tool.slug}/`} class="block truncate font-semibold no-underline">{e.tool.name}</a>
              <p class="text-sm text-slate-500 truncate">{e.subject}</p>
            </div>
            <span class="badge badge-blue shrink-0">{e.date}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Stats preview -->
  <section class="mt-8 border-y border-slate-200 py-6">
    <div class="flex items-center justify-between">
      <h2 class="text-xl font-bold">Activity</h2>
      <a href={`${base}/stats/`} class="text-sm">Full statistics →</a>
    </div>
    <p class="mt-2 text-sm text-slate-600">
      {stats.by_month?.length ?? 0} months of activity recorded across the IUC tool repositories.
    </p>
  </section>

  <!-- Other Galaxy tool repositories -->
  <section class="mt-8">
    <h2 class="text-xl font-bold">Other Galaxy tool repositories</h2>
    <p class="mt-1 text-sm text-slate-600">
      Beyond the IUC, many teams maintain Galaxy tool wrappers. The IWC complements this ecosystem with
      reviewed Galaxy workflows. To add a new repository,
      edit <a href="https://github.com/galaxyproject/tools-iuc/blob/main/website/config/tool_repos.yaml" class="underline" target="_blank" rel="noopener"><code>tool_repos.yaml</code></a>.
    </p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {repos.map(r => (
        <li class="card">
          <a href={r.url} class="font-semibold no-underline" target="_blank" rel="noopener">{r.name}</a>
          <p class="mt-1 text-sm text-slate-600">{r.description}</p>
          {r.owner && <p class="mt-1 text-xs text-slate-400">{r.owner}</p>}
        </li>
      ))}
    </ul>
  </section>
</Base>
