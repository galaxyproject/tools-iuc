---
import Base from '../../layouts/Base.astro';
import { loadYaml, type ToolIndexEntry } from '../../lib/data';

const tools = loadYaml<ToolIndexEntry[]>('tools_index.yaml');
const base = import.meta.env.BASE_URL;

// Build sorted lists of all input/output datatypes
const inputTypes = [...new Set(tools.flatMap(t => t.input_types || []))].sort();
const outputTypes = [...new Set(tools.flatMap(t => t.output_types || []))].sort();
---

<Base title="Tools — IUC">
  <h1 class="text-2xl font-bold">IUC Tools <span class="text-slate-400">({tools.length.toLocaleString()})</span></h1>
  <p class="mt-1 max-w-3xl text-slate-600">
    Browse reviewed Galaxy tool wrappers maintained by the IUC and published through the Main ToolShed.
    Search by tool name, identifier, description, EDAM metadata, or input/output datatype.
  </p>

  <!-- Client-side filter -->
  <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center">
    <input id="filter" type="search" placeholder="Filter by name or id…"
      class="w-full rounded-md border border-slate-300 px-3 py-2 sm:max-w-xs" />
    <span class="text-sm text-slate-500" id="count"></span>
  </div>

  <!-- Datatype filters -->
  <div class="mt-4 flex flex-col gap-4 sm:flex-row">
    <div class="flex flex-col gap-1">
      <label class="text-sm font-medium text-slate-600" for="input-filter">Input datatype</label>
      <select id="input-filter" class="rounded-md border border-slate-300 px-3 py-2 text-sm">
        <option value="">Any input</option>
        {inputTypes.map(t => <option value={t}>{t}</option>)}
      </select>
    </div>
    <div class="flex flex-col gap-1">
      <label class="text-sm font-medium text-slate-600" for="output-filter">Output datatype</label>
      <select id="output-filter" class="rounded-md border border-slate-300 px-3 py-2 text-sm">
        <option value="">Any output</option>
        {outputTypes.map(t => <option value={t}>{t}</option>)}
      </select>
    </div>
  </div>

  <!-- Pagefind full-text search -->
  <div class="mt-4">
    <link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
    <div id="pagefind-search"></div>
  </div>

  <p class="mt-2 text-sm text-slate-500">Or filter the listing below by name or id.</p>

  <ul id="tool-list" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {tools.map(t => (
      <li class="card" data-name={t.name.toLowerCase()} data-id={t.id.toLowerCase()} data-desc={t.description.toLowerCase()}
          data-inputs={(t.input_types || []).join(',')} data-outputs={(t.output_types || []).join(',')}>
        <a href={`${base}/tools/${t.owner}/${t.repo}/${t.id}/`} class="font-semibold no-underline">{t.name}</a>
        <p class="mt-1 text-sm text-slate-600 line-clamp-2">{t.description}</p>
        <div class="mt-2 flex flex-wrap gap-1">
          {t.biotools && <a class="badge badge-purple no-underline" href={`https://bio.tools/${t.biotools}`} target="_blank" rel="noopener">bio.tools</a>}
          <span class="badge badge-blue">v{t.version}</span>
        </div>
      </li>
    ))}
  </ul>
</Base>

<script is:inline define:vars={{ base }}>
  const input = document.getElementById('filter');
  const inputFilter = document.getElementById('input-filter');
  const outputFilter = document.getElementById('output-filter');
  const list = document.getElementById('tool-list');
  const items = [...list.querySelectorAll('li')];
  const countEl = document.getElementById('count');

  // Read ?q= from URL (runtime, since this is a static site)
  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get('q') ?? '';
  if (initialQuery) input.value = initialQuery;

  function apply() {
    const q = (input.value || '').toLowerCase();
    const inType = inputFilter.value;
    const outType = outputFilter.value;
    let n = 0;
    for (const li of items) {
      const inList = li.dataset.inputs ? li.dataset.inputs.split(',') : [];
      const outList = li.dataset.outputs ? li.dataset.outputs.split(',') : [];
      const match = (!q || li.dataset.name.includes(q) || li.dataset.id.includes(q) || li.dataset.desc.includes(q))
        && (!inType || inList.includes(inType))
        && (!outType || outList.includes(outType));
      li.style.display = match ? '' : 'none';
      if (match) n++;
    }
    countEl.textContent = `${n} tools`;
  }
  input.addEventListener('input', apply);
  inputFilter.addEventListener('change', apply);
  outputFilter.addEventListener('change', apply);
  apply();
</script>

<script is:inline define:vars={{ base }}>
  import(`${base}/pagefind/pagefind-ui.js`).then(({ PagefindUI }) => {
    new PagefindUI({
      element: '#pagefind-search',
      bundlePath: `${base}/pagefind/`,
      showImages: false,
      pageSize: 10,
    });
  }).catch(() => {});
</script>
