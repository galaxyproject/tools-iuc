---
import Base from '../../layouts/Base.astro';
import { siteConfig } from '../../lib/data';

const issuesUrl = siteConfig.iuc.issues;
const base = import.meta.env.BASE_URL;
---

<Base title="Request a tool — IUC">
  <h1 class="text-2xl font-bold">Request a tool</h1>
  <p class="mt-2 max-w-2xl text-slate-600">
    Can't find a tool in the IUC or the ToolShed? Request it here. Fill in the details, we'll
    check it doesn't already exist, and generate a pre-filled GitHub issue you can submit with one click.
  </p>

  <form id="request-form" class="mt-6 max-w-2xl space-y-4">
    <div>
      <label for="name" class="block text-sm font-medium">Tool name <span class="text-red-500">*</span></label>
      <input id="name" name="name" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2" placeholder="e.g. Samtools sort" />
    </div>
    <div>
      <label for="upstream" class="block text-sm font-medium">Upstream repository / software URL</label>
      <input id="upstream" name="upstream" type="url" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2" placeholder="https://github.com/samtools/samtools" />
    </div>
    <div>
      <label for="description" class="block text-sm font-medium">Description / motivation <span class="text-red-500">*</span></label>
      <textarea id="description" name="description" required rows="4" class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2" placeholder="What does the tool do and why is it useful in Galaxy?"></textarea>
    </div>
    <div class="flex gap-3">
      <button type="submit" class="btn btn-primary">Check & generate issue</button>
      <span id="status" class="self-center text-sm text-slate-500"></span>
    </div>
  </form>

  <div id="warning" class="mt-4 hidden max-w-2xl rounded-md border border-amber-300 bg-amber-50 p-4 text-sm text-amber-800"></div>
  <div id="result" class="mt-4 hidden max-w-2xl rounded-md border border-green-300 bg-green-50 p-4 text-sm text-green-800"></div>
</Base>

<script is:inline define:vars={{ issuesUrl, base }}>
  const form = document.getElementById('request-form');
  const status = document.getElementById('status');
  const warning = document.getElementById('warning');
  const result = document.getElementById('result');
  let duplicateIndex = null;

  function clearNode(node) {
    while (node.firstChild) node.removeChild(node.firstChild);
  }

  function appendText(parent, tag, text, className) {
    const el = document.createElement(tag);
    if (className) el.className = className;
    el.textContent = text;
    parent.appendChild(el);
    return el;
  }

  function appendIssueButton(parent, url, label) {
    const link = document.createElement('a');
    link.href = url;
    link.target = '_blank';
    link.rel = 'noopener';
    link.className = 'btn btn-primary mt-2';
    link.textContent = label;
    parent.appendChild(link);
  }

  function normalize(s) { return (s || '').toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, ''); }
  function fuzzyMatch(a, normalizedRepoName) {
    a = normalize(a);
    if (!a || !normalizedRepoName) return false;
    if (a === normalizedRepoName) return true;
    if (a.includes(normalizedRepoName) || normalizedRepoName.includes(a)) return true;
    return false;
  }

  async function loadDuplicateIndex() {
    if (duplicateIndex) return duplicateIndex;
    const response = await fetch(`${base}/toolshed-duplicates.json`);
    if (!response.ok) throw new Error(`ToolShed duplicate index failed: ${response.status}`);
    duplicateIndex = await response.json();
    return duplicateIndex;
  }

  function checkTs(name) {
    const hits = [];
    for (const row of duplicateIndex || []) {
      const [key, owner, repoName, description] = row;
      if (fuzzyMatch(name, key)) {
        hits.push({ owner, name: repoName, description });
      }
      if (hits.length >= 5) break;
    }
    return hits;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    warning.classList.add('hidden');
    result.classList.add('hidden');
    clearNode(warning);
    clearNode(result);
    const name = form.name.value.trim();
    const desc = form.description.value.trim();
    if (!name || !desc) { status.textContent = 'Please fill in name and description.'; return; }

    status.textContent = 'Checking ToolShed…';
    let duplicateCheckAvailable = true;
    try {
      await loadDuplicateIndex();
    } catch {
      duplicateCheckAvailable = false;
      status.textContent = '';
      warning.classList.remove('hidden');
      appendText(warning, 'p', 'Could not check the ToolShed duplicate index. You can still generate the issue.', 'font-semibold');
    }
    const hits = duplicateCheckAvailable ? checkTs(name) : [];

    const body = [
      '## Tool request',
      '',
      `**Name:** ${name}`,
      '',
      '### Description / motivation',
      desc,
      '',
      form.upstream.value ? `### Upstream\n${form.upstream.value}` : '',
      '',
      '---',
      '_Generated by the IUC website request form._',
    ].filter(Boolean).join('\n');
    const title = `Tool request: ${name}`;
    const url = `${issuesUrl}?title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}&labels=${encodeURIComponent('request,new-tool')}`;

    if (!duplicateCheckAvailable) {
      result.classList.remove('hidden');
      appendIssueButton(result, url, 'Open pre-filled GitHub issue');
    } else if (hits.length) {
      warning.classList.remove('hidden');
      appendText(warning, 'p', 'Possible duplicates found on the ToolShed:', 'font-semibold');
      const list = document.createElement('ul');
      list.className = 'mt-2 space-y-1';
      for (const hit of hits) {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `https://toolshed.g2.bx.psu.edu/view/${encodeURIComponent(hit.owner)}/${encodeURIComponent(hit.name)}`;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = `${hit.owner}/${hit.name}`;
        item.appendChild(link);
        if (hit.description) {
          item.appendChild(document.createTextNode(` — ${hit.description}`));
        }
        list.appendChild(item);
      }
      warning.appendChild(list);
      appendText(warning, 'p', 'Please check these before submitting. If your request is different, use the button below.', 'mt-2');
      result.classList.remove('hidden');
      appendIssueButton(result, url, 'Open pre-filled GitHub issue anyway');
    } else {
      result.classList.remove('hidden');
      appendText(result, 'p', 'No duplicates found on the ToolShed.', 'font-semibold');
      appendIssueButton(result, url, 'Open pre-filled GitHub issue');
    }
    status.textContent = '';
  });
</script>
