<tool id="ucsc_genepredtobed" name="genePredToBed" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="26.0">
    <description>convert genePred to BED12</description>
    <macros>
        <token name="@TOOL_VERSION@">502</token>
        <token name="@VERSION_SUFFIX@">0</token>
    </macros>
    <xrefs>
        <xref type="bio.tools">UCSC_Genome_Browser_Utilities</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">ucsc-genepredtobed</requirement>
    </requirements>
    <version_command><![CDATA[echo "@TOOL_VERSION@"]]></version_command>
    <command detect_errors="aggressive"><![CDATA[
genePredToBed
    -tab
    $fill_space
    -score=$score
    '$input'
    '$output'
    ]]></command>
    <inputs>
        <param name="input" type="data" format="tabular" label="genePred file" help="For example, the output of gff3ToGenePred."/>
        <param name="fill_space" argument="-fillSpace" type="boolean" truevalue="-fillSpace" falsevalue="" checked="false" label="Replace spaces in names with underscores"/>
        <param argument="-score" type="integer" min="0" max="1000" value="0" label="Score" help="The value for the score column of every line."/>
    </inputs>
    <outputs>
        <data name="output" format="bed12"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="input" value="tiny.genepred" ftype="tabular"/>
            <output name="output" file="tiny.bed" ftype="bed12"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="spaced.genepred" ftype="tabular"/>
            <output name="output" file="spaced.bed" ftype="bed12"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="spaced.genepred" ftype="tabular"/>
            <param name="fill_space" value="true"/>
            <param name="score" value="500"/>
            <output name="output" file="spaced_filled.bed" ftype="bed12"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="empty.genepred" ftype="tabular"/>
            <output name="output" ftype="bed12">
                <assert_contents>
                    <has_size value="0"/>
                </assert_contents>
            </output>
        </test>
        <test expect_failure="true" expect_exit_code="255">
            <param name="input" value="bad.genepred" ftype="tabular"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

genePredToBed converts a UCSC [genePred](https://genome.ucsc.edu/FAQ/FAQformat.html#format9) table to [BED12](https://genome.ucsc.edu/FAQ/FAQformat.html#format1).
BED12 keeps the exon structure and the coding region of each transcript.
To make a gene track for a genome browser, convert the BED12 file to bigBed with bedToBigBed.

-----

**Input**

A tab-separated genePred table, for example from gff3ToGenePred.

**Output**

A BED12 file with one line for each transcript.

-----

**More information**

- [genePredToBed source code](https://github.com/ucscGenomeBrowser/kent/tree/master/src/hg/genePredToBed)
    ]]></help>
    <citations>
        <citation type="doi">10.1093/bib/bbs038</citation>
    </citations>
</tool>
