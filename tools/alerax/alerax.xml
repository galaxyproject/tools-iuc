<tool id="alerax" name="AleRax" version="1.4.0+galaxy0" profile="23.0">
    <description>species tree - gene tree inference and reconciliation under gene duplication, loss, and HGT</description>
    <requirements>
        <requirement type="package" version="1.4.0">alerax</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[

if [ "\${GALAXY_SLOTS:-1}" -gt 1 ]; then
    MPI_PREFIX="\${GALAXY_MPIRUN:-mpiexec --allow-run-as-root --oversubscribe -np \${GALAXY_SLOTS:-1}}";
else
    MPI_PREFIX="";
fi &&

\$MPI_PREFIX alerax
    -f '$families_file'
    #if $species_tree_input.source == "file":
        -s '$species_tree_input.species_tree'
    #else:
        -s $species_tree_input.source
    #end if
    --species-tree-search $species_tree_search
    --rec-model $model.rec_model
    --model-parametrization $model.model_parametrization
    --gene-tree-samples $advanced.gene_tree_samples
    --seed $advanced.seed
    -p output

#if $advanced.archive:
    && tar -cf alerax_output.tar --exclude='output/ccps' --exclude='output/checkpoint' output
#end if
    ]]></command>
    <configfiles>
        <configfile name="families_file"><![CDATA[[FAMILIES]
#for $gt in $gene_trees:
- ${gt.element_identifier}
gene_tree = ${gt}
#if $mappings:
#for $m in $mappings:
#if $m.element_identifier == $gt.element_identifier:
mapping = ${m}
#end if
#end for
#end if
#end for
]]></configfile>
    </configfiles>
    <inputs>
        <conditional name="species_tree_input">
            <param name="source" type="select" label="Do you have a species tree?"
                   help="If you have no species tree, choose MiniNJ and set the species tree search to HYBRID, so that AleRax builds the tree.">
                <option value="file" selected="true">Yes</option>
                <option value="MiniNJ">MiniNJ</option>
                <option value="Random">Random</option>
            </param>
            <when value="file">
                <param name="species_tree" type="data" format="newick" label="Species tree"
                       help="One rooted, bifurcating species tree in Newick format. Species names must match those in the mapping files."/>
            </when>
            <when value="MiniNJ"/>
            <when value="Random"/>
        </conditional>
             <param name="species_tree_search" type="select" label="Optimization of species tree"
       help="SKIP is the default. Choose HYBRID to infer the species tree (needed if you start from MiniNJ or a random tree).">
    <option value="SKIP" selected="true">SKIP: skip the species tree search (default)</option>
    <option value="REROOT">REROOT: only re-estimate the root of the starting species tree</option>
    <option value="HYBRID">HYBRID: standard search (transfer-guided and local SPR moves)</option>
        </param>
        <param name="gene_trees" type="data_collection" collection_type="list" format="newick,txt"
               label="Gene tree samples (one file per gene family)"
               help="A list collection: each element is one gene family."/>
        <param name="mappings" type="data_collection" collection_type="list" format="txt" optional="true"
               label="Gene to species mapping files (optional)"
               help="Optional. One gene to species mapping file per gene family."/>
        <section name="model" title="Reconciliation model" expanded="false">
            <param name="rec_model" type="select" label="Reconciliation model"
                   help="--rec-model. UndatedDTL models duplications, transfers and losses. UndatedDL models only duplications and losses (no transfers).">
                <option value="UndatedDTL" selected="true">UndatedDTL (default)</option>
                <option value="UndatedDL">UndatedDL</option>
            </param>
            <param name="model_parametrization" type="select" label="Model parametrization"
                   help="--model-parametrization. Defines which model parameters are shared among species or families.">
                <option value="GLOBAL" selected="true">GLOBAL (default)</option>
                <option value="PER-FAMILY">PER-FAMILY</option>
                <option value="PER-SPECIES">PER-SPECIES</option>
            </param>
        </section>
        <section name="advanced" title="Advanced options" expanded="false">
            <param name="gene_tree_samples" type="integer" value="100" min="1"
                   label="Number of output reconciled gene tree samples per family."
                   help="--gene-tree-samples. Default is 100. More samples give more stable averages but take longer."/>
            <param name="seed" type="integer" value="123"
                   label="Random seed"
                   help="--seed. Default is 123. Use the same seed to get exactly the same results again."/>
            <param name="archive" type="boolean" checked="false"
                   label="Also output the complete results folder as one archive (.tar)"
                   help="Contains all AleRax result files, including every sampled reconciliation."/>
        </section>
    </inputs>
    <outputs>
        <data name="species_tree_out" format="newick" from_work_dir="output/species_trees/inferred_species_tree.newick"
              label="${tool.name} on ${on_string}: species tree"/>
        <data name="log" format="txt" from_work_dir="output/alerax.log"
              label="${tool.name} on ${on_string}: log"/>
        <data name="likelihoods" format="txt" from_work_dir="output/per_fam_likelihoods.txt"
              label="${tool.name} on ${on_string}: per-family likelihoods"/>
        <collection name="event_counts" type="list" label="${tool.name} on ${on_string}: per-family event counts">
            <discover_datasets pattern="(?P&lt;designation&gt;.+)_meanSpeciesEventCounts\.txt"
                               directory="output/reconciliations/summaries" format="txt"/>
        </collection>
        <collection name="transfers" type="list" label="${tool.name} on ${on_string}: per-family transfers">
            <discover_datasets pattern="(?P&lt;designation&gt;.+)_meanTransfers\.txt"
                               directory="output/reconciliations/summaries" format="txt"/>
        </collection>
        <data name="archive_out" format="tar" from_work_dir="alerax_output.tar"
              label="${tool.name} on ${on_string}: all results (archive)">
            <filter>advanced['archive']</filter>
        </data>
    </outputs>
    <tests>
        <!-- Test 1: own species tree, no optimization (SKIP), UndatedDTL, GLOBAL rates, seed 42, archive on: 6 outputs -->
        <test expect_num_outputs="6">
            <conditional name="species_tree_input">
                <param name="source" value="file"/>
                <param name="species_tree" value="species_tree.newick" ftype="newick"/>
            </conditional>
            <param name="species_tree_search" value="SKIP"/>
            <param name="gene_trees">
                <collection type="list">
                    <element name="family_381" value="family_381.newick" ftype="newick"/>
                    <element name="family_497" value="family_497.newick" ftype="newick"/>
                </collection>
            </param>
            <param name="mappings">
                <collection type="list">
                    <element name="family_381" value="family_381.link" ftype="txt"/>
                    <element name="family_497" value="family_497.link" ftype="txt"/>
                </collection>
            </param>
            <section name="model">
                <param name="rec_model" value="UndatedDTL"/>
                <param name="model_parametrization" value="GLOBAL"/>
            </section>
            <section name="advanced">
                <param name="gene_tree_samples" value="10"/>
                <param name="seed" value="42"/>
                <param name="archive" value="true"/>
            </section>
            <output name="species_tree_out">
                <assert_contents>
                    <has_text text="HomoUUUSapiens"/>
                </assert_contents>
            </output>
            <output name="log">
                <assert_contents>
                    <has_text text="Random seed: 42"/>
                    <has_text text="will be imported from the user file"/>
                    <has_text text="skip species tree search"/>
                    <has_text text="Reconciliation model: UndatedDTL"/>
                    <has_text text="rates are global to all species and families"/>
                </assert_contents>
            </output>
            <output name="likelihoods">
                <assert_contents>
                    <has_n_lines min="1"/>
                </assert_contents>
            </output>
            <output_collection name="event_counts" type="list" count="2">
                <element name="family_381">
                    <assert_contents>
                        <has_text text="duplications"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="transfers" type="list" count="2"/>
            <output name="archive_out">
                <assert_contents>
                    <has_archive_member path="output/alerax.log"/>
                </assert_contents>
            </output>
        </test>
