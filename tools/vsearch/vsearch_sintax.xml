<tool id="vsearch_sintax" name="VSEARCH SINTAX" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>assign taxonomy to amplicon sequences</description>
    <macros>
        <import>vsearch_macros.xml</import>
    </macros>
    <xrefs>
        <xref type="bio.tools">vsearch</xref>
    </xrefs>
    <expand macro="requirements"/>
    <version_command>vsearch --version 2&gt;&amp;1 | head -n 1</version_command>
    <command detect_errors="exit_code"><![CDATA[
vsearch
    --sintax '$sintax'
    --db '$db'
    --tabbedout '$tabbedout'
    --strand '$strand'
    --randseed '$randseed'
    --dbmask '$dbmask'
    --threads "\${GALAXY_SLOTS:-1}"
    $sintax_random
    #if str($sintax_cutoff) not in ('', 'None'):
        --sintax_cutoff '$sintax_cutoff'
    #end if
    ]]></command>
    <inputs>
        <param argument="--sintax" type="data" format="fasta,fasta.gz,fastqsanger,fastqsanger.gz" label="Query sequences"/>
        <param argument="--db" type="data" format="fasta,fasta.gz" label="Taxonomy reference sequences" help="FASTA headers must contain ;tax= followed by comma-separated rank:taxon annotations."/>
        <param argument="--sintax_cutoff" type="float" min="0" max="1" optional="true" label="Minimum bootstrap confidence" help="A positive value adds a column containing only ranks that meet this threshold. Zero or unset retains the unfiltered three-column output."/>
        <param argument="--strand" type="select" label="Query strands to search">
            <option value="plus" selected="true">Forward strand only</option>
            <option value="both">Both strands</option>
        </param>
        <param argument="--randseed" type="integer" min="0" value="0" label="Random seed" help="Set a positive seed for reproducible classifications. Zero uses a time-dependent seed. Output row order can still vary with parallel execution."/>
        <param argument="--sintax_random" type="boolean" truevalue="--sintax_random" falsevalue="" checked="false" label="Break reference ties randomly" help="Recommended to avoid preference for shorter references. Disabled preserves the upstream default tie-breaking behavior."/>
        <param argument="--dbmask" type="select" label="Reference masking">
            <option value="dust" selected="true">Ignore lowercase reference regions (upstream default)</option>
            <option value="soft">Ignore lowercase reference regions</option>
            <option value="none">Use all reference bases</option>
        </param>
    </inputs>
    <outputs>
        <data name="tabbedout" format="tabular" label="${tool.name} on ${on_string}: taxonomy">
            <actions>
                <action name="column_names" type="metadata" default="${'query,taxonomy,strand,accepted_taxonomy' if $sintax_cutoff and float($sintax_cutoff) &gt; 0 else 'query,taxonomy,strand'}"/>
                <action name="column_types" type="metadata" default="${'str,list,str,list' if $sintax_cutoff and float($sintax_cutoff) &gt; 0 else 'str,list,str'}"/>
            </actions>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="sintax" value="queries.fasta"/>
            <param name="db" value="reference.fasta"/>
            <param name="randseed" value="100"/>
            <output name="tabbedout" file="default.tsv" sort="true">
                <metadata name="columns" value="3"/>
                <metadata name="column_names" value="query,taxonomy,strand"/>
                <metadata name="column_types" value="str,list,str"/>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="sintax" value="queries.fasta.gz" ftype="fasta.gz"/>
            <param name="db" value="reference.fasta.gz" ftype="fasta.gz"/>
            <param name="sintax_cutoff" value="0.8"/>
            <param name="strand" value="both"/>
            <param name="randseed" value="100"/>
            <output name="tabbedout" file="both-cutoff.tsv" sort="true">
                <metadata name="columns" value="4"/>
                <metadata name="column_names" value="query,taxonomy,strand,accepted_taxonomy"/>
                <metadata name="column_types" value="str,list,str,list"/>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="sintax" value="queries.fastq.gz" ftype="fastqsanger.gz"/>
            <param name="db" value="reference.fasta"/>
            <param name="sintax_cutoff" value="0"/>
            <param name="strand" value="both"/>
            <param name="randseed" value="42"/>
            <param name="sintax_random" value="true"/>
            <param name="dbmask" value="none"/>
            <output name="tabbedout" file="random-zero-cutoff.tsv" sort="true">
                <metadata name="columns" value="3"/>
                <metadata name="column_names" value="query,taxonomy,strand"/>
                <metadata name="column_types" value="str,list,str"/>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
Classify query sequences with the VSEARCH implementation of SINTAX. Supply a
reference FASTA whose headers contain taxonomy, for example:

```
>reference1;tax=k:Fungi,p:Ascomycota,c:Sordariomycetes,g:Fusarium
ACGT...
```

The tabular result contains the query identifier, predicted ranks with bootstrap
confidence, and matching strand. Setting a positive confidence threshold adds a fourth
column with supported ranks. Queries that cannot be classified remain as rows
with empty classification fields.

A positive random seed makes classifications reproducible across thread counts;
row order may vary. Random tie breaking avoids a preference for shorter reference
sequences. For a FASTA database, the default masking treats lowercase bases as
masked; it does not run the DUST algorithm.

Queries with fewer than 32 unique 8-mers cannot be classified. The tool performs
taxonomic classification only; filtering reads, inferring ASVs, and constructing
abundance tables are separate operations.
    ]]></help>
    <expand macro="citations">
        <citation type="doi">10.1101/074161</citation>
    </expand>
</tool>
