<tool id="liana_plot" name="Liana Plot" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>visualize ligand-receptor interactions, spatial metrics, LRIC curves, and MISTy results</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tools"/>
    <expand macro="creators"/>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <command detect_errors="exit_code"><![CDATA[
#if $method.adata.ext == 'h5mu':
cp '$method.adata' 'input.h5mu' &&
#else:
cp '$method.adata' 'anndata.h5ad' &&
#end if
cat '$script_file' > '$hidden_output' &&
python '$script_file' >> '$hidden_output' &&
ls . >> '$hidden_output'
    ]]></command>
    <configfiles>
        <configfile name="script_file"><![CDATA[
@CMD_IMPORTS@
import matplotlib.pyplot as plt

if '$method.adata.ext' == 'h5mu':
    adata = mu.read_h5mu('input.h5mu')
else:
    adata = sc.read_h5ad('anndata.h5ad')

fig = None
mpl_fig = None

#if str($method.method) == 'pl.dotplot':
fig = li.pl.dotplot(
    adata=adata,
    uns_key='$method.uns_key',
    colour='$method.colour'.strip(),
    size='$method.size'.strip(),
    @CMD_PLOT_SOURCE_TARGET_LABELS@
    @CMD_PLOT_LIGAND_RECEPTOR_COMPLEX@
    @CMD_PLOT_TOP_N_ORDERBY@
    @CMD_PLOT_FILTER_FN@
    inverse_colour=$method.inverse_colour,
    inverse_size=$method.inverse_size,
    cmap='$method.cmap',
    size_range=($method.size_range_min, $method.size_range_max),
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)

#else if str($method.method) == 'pl.dotplot_by_sample':
fig = li.pl.dotplot_by_sample(
    adata=adata,
    uns_key='$method.uns_key',
    sample_key='$method.sample_key',
    colour='$method.colour'.strip(),
    size='$method.size'.strip(),
    @CMD_PLOT_SOURCE_TARGET_LABELS@
    @CMD_PLOT_LIGAND_RECEPTOR_COMPLEX@
    inverse_colour=$method.inverse_colour,
    inverse_size=$method.inverse_size,
    cmap='$method.cmap',
    size_range=($method.size_range_min, $method.size_range_max),
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)

#else if str($method.method) == 'pl.tileplot':
    #if str($method.label_style) == 'round2':
lbl_fn = lambda x: f"{x:.2f}" if isinstance(x, (int, float, np.floating)) and not pd.isna(x) else str(x)
    #else if str($method.label_style) == 'star05':
lbl_fn = lambda x: "*" if isinstance(x, (int, float, np.floating)) and x < 0.05 else ""
    #else:
lbl_fn = None
    #end if
fig = li.pl.tileplot(
    adata=adata,
    uns_key='$method.uns_key',
    fill='$method.fill'.strip(),
    label='$method.label'.strip(),
    label_fn=lbl_fn,
    @CMD_PLOT_SOURCE_TARGET_LABELS@
    @CMD_PLOT_LIGAND_RECEPTOR_COMPLEX@
    @CMD_PLOT_TOP_N_ORDERBY@
    @CMD_PLOT_FILTER_FN@
    #if str($method.source_title).strip() != '':
    source_title='$method.source_title'.strip(),
    #end if
    #if str($method.target_title).strip() != '':
    target_title='$method.target_title'.strip(),
    #end if
    cmap='$method.cmap',
    label_size=$method.label_size,
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)

#else if str($method.method) == 'pl.circle':
ax = li.pl.circle(
    adata=adata,
    uns_key='$method.uns_key',
    groupby='$method.groupby'.strip(),
    source_key='$method.source_key'.strip(),
    target_key='$method.target_key'.strip(),
    #if str($method.score_key).strip() != '':
    score_key='$method.score_key'.strip(),
    #end if
    inverse_score=$method.inverse_score,
    pivot_mode='$method.pivot_mode',
    mask_mode='$method.mask_mode',
    @CMD_PLOT_SOURCE_TARGET_LABELS@
    @CMD_PLOT_LIGAND_RECEPTOR_COMPLEX@
    @CMD_PLOT_TOP_N_ORDERBY@
    @CMD_PLOT_FILTER_FN@
    figure_size=($method.figure_size_width, $method.figure_size_height))
mpl_fig = ax.figure

#else if str($method.method) == 'pl.connectivity':
fig = li.pl.connectivity(
    adata=adata,
    idx=$method.idx,
    spatial_key='$method.spatial_key',
    connectivity_key='$method.connectivity_key',
    size=$method.size,
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)

#else if str($method.method) == 'pl.elbow':
fig = li.pl.elbow(
    adata=adata,
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)

#else if str($method.method) == 'pl.feature_by_group':
mpl_fig, _ = li.pl.feature_by_group(
    adata=adata,
    groupby='$method.groupby'.strip(),
    spatial_key='$method.spatial_key'.strip(),
    labels=[x.strip() for x in '$method.labels'.split(',') if x.strip()],
    feature='$method.feature'.strip(),
    normalize=$method.normalize,
    show_counts=$method.show_counts,
    figure_size=($method.figure_size_width, $method.figure_size_height))

#else if str($method.method) == 'pl.annulus':
mpl_fig = li.pl.annulus(
    adata=adata,
    spatial_key='$method.spatial_key'.strip(),
    radius_step=$method.radius_step,
    annulus_steps=$method.annulus_steps,
    extend_first_annulus=$method.extend_first_annulus,
    n_rings=$method.n_rings,
    seed=$method.seed,
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)

#else if str($method.method) == 'pl.lric_lineplot':
fig = li.pl.lric_lineplot(
    adata=adata,
    uns_key='$method.uns_key',
    #if str($method.interaction).strip() != '':
    interaction='$method.interaction'.strip(),
    #end if
    #if str($method.source).strip() != '':
    source='$method.source'.strip(),
    #end if
    #if str($method.target).strip() != '':
    target='$method.target'.strip(),
    #end if
    #if str($method.max_dist) != '':
    max_dist=$method.max_dist,
    #end if
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)

#else if str($method.method) == 'pl.lric_divergence':
fa = {k.strip(): v.strip() for part in '$method.feature_a'.split(',') if ':' in part for k, v in [part.split(':', 1)]}
fb = {k.strip(): v.strip() for part in '$method.feature_b'.split(',') if ':' in part for k, v in [part.split(':', 1)]}
fig = li.pl.lric_divergence(
    adata=adata,
    uns_key='$method.uns_key',
    feature_a=fa,
    feature_b=fb,
    #if str($method.max_dist) != '':
    max_dist=$method.max_dist,
    #end if
    min_bins=$method.min_bins,
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)

#else if str($method.method) == 'pl.misty_target_metrics':
misty = li.mt.MistyData(adata)
stat_col = '$method.custom_stat'.strip() if str('$method.stat') == 'custom' else '$method.stat'
fig = li.pl.misty_target_metrics(
    misty=misty,
    stat=stat_col,
    #if str($method.key) == 'abs':
    key=np.abs,
    #end if
    #if str($method.aggregate_fn) != '':
    aggregate_fn=getattr(np, '$method.aggregate_fn'),
    #end if
    #if str($method.top_n) != '':
    top_n=$method.top_n,
    #end if
    @CMD_PLOT_FILTER_FN@
    ascending=$method.ascending,
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)

#else if str($method.method) == 'pl.misty_contributions':
misty = li.mt.MistyData(adata)
fig = li.pl.misty_contributions(
    misty=misty,
    #if str($method.view_names).strip() != '':
    view_names=[x.strip() for x in '$method.view_names'.split(',') if x.strip()],
    #end if
    #if str($method.aggregate_fn) != '':
    aggregate_fn=getattr(np, '$method.aggregate_fn'),
    #end if
    @CMD_PLOT_FILTER_FN@
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)

#else if str($method.method) == 'pl.misty_interactions':
misty = li.mt.MistyData(adata)
fig = li.pl.misty_interactions(
    misty=misty,
    view='$method.view'.strip(),
    #if str($method.key) == 'abs':
    key=np.abs,
    #end if
    #if str($method.aggregate_fn) != '':
    aggregate_fn=getattr(np, '$method.aggregate_fn'),
    #end if
    #if str($method.top_n) != '':
    top_n=$method.top_n,
    #end if
    @CMD_PLOT_FILTER_FN@
    ascending=$method.ascending,
    figure_size=($method.figure_size_width, $method.figure_size_height),
    return_fig=True)
#end if

if fig is not None:
    fig.save('plot.$format', dpi=150)
elif mpl_fig is not None:
    mpl_fig.savefig('plot.$format', dpi=150, bbox_inches='tight')
        ]]></configfile>
    </configfiles>
    <inputs>
        <param name="format" type="select" label="Format for saving figure">
            <option value="png" selected="true">png</option>
            <option value="pdf">pdf</option>
            <option value="svg">svg</option>
        </param>
        <conditional name="method">
            <param argument="method" type="select" label="Plotting method">
                <option value="pl.dotplot" selected="true">dotplot: Interactions by source and target cells</option>
                <option value="pl.dotplot_by_sample">dotplot_by_sample: Interactions grouped by sample</option>
                <option value="pl.tileplot">tileplot: Ligand and receptor stats as side-by-side tiles</option>
                <option value="pl.circle">circle: Circular cell-cell communication network</option>
                <option value="pl.connectivity">connectivity: Spatial connectivity weights for a reference cell/spot</option>
                <option value="pl.elbow">elbow: NMF reconstruction error and estimated elbow rank</option>
                <option value="pl.feature_by_group">feature_by_group: Spatial Inflow score scatter across receiver cell types</option>
                <option value="pl.annulus">annulus: Concentric distance rings for LRIC / cross-PCF parameter selection</option>
                <option value="pl.lric_lineplot">lric_lineplot: Distance enrichment g(r) profile for an interaction</option>
                <option value="pl.lric_divergence">lric_divergence: Compare two g(r) curves and their shaded divergence</option>
                <option value="pl.misty_target_metrics">misty_target_metrics: Plot R² target metrics from MISTy results</option>
                <option value="pl.misty_contributions">misty_contributions: Plot view contributions per target from MISTy</option>
                <option value="pl.misty_interactions">misty_interactions: Plot predictor-target importances for a MISTy view</option>
            </param>
            <!-- please note that some API in the docs have arg=None, however when you run the tool, it fails if you don't provide a value. So, we have to make some of the args optional=False, even though they are optional in the API. -->
            <when value="pl.dotplot">
                <expand macro="inputs_anndata" format="h5ad,h5mu" label="Annotated data matrix (AnnData, or MuData)"/>
                <expand macro="param_uns_key" DEFAULT="liana_res"/>
                <expand macro="param_plot_colour" optional="false"/>
                <expand macro="param_plot_size" optional="false"/>
                <expand macro="param_source_labels"/>
                <expand macro="param_target_labels"/>
                <expand macro="param_ligand_complex"/>
                <expand macro="param_receptor_complex"/>
                <expand macro="param_top_n"/>
                <expand macro="param_orderby"/>
                <expand macro="param_orderby_ascending"/>
                <expand macro="param_orderby_absolute"/>
                <expand macro="param_plot_filter"/>
                <expand macro="param_inverse_colour"/>
                <expand macro="param_inverse_size"/>
                <expand macro="param_cmap"/>
                <expand macro="param_size_range"/>
                <expand macro="param_figure_size"/>
            </when>
            <when value="pl.dotplot_by_sample">
                <expand macro="inputs_anndata" format="h5ad,h5mu" label="Annotated data matrix (AnnData, or MuData)"/>
                <expand macro="param_uns_key" DEFAULT="liana_res"/>
                <expand macro="param_sample_key" VALUE="sample"/>
                <expand macro="param_plot_colour"/>
                <expand macro="param_plot_size"/>
                <expand macro="param_source_labels"/>
                <expand macro="param_target_labels"/>
                <expand macro="param_ligand_complex"/>
                <expand macro="param_receptor_complex"/>
                <expand macro="param_inverse_colour"/>
                <expand macro="param_inverse_size"/>
                <expand macro="param_cmap"/>
                <expand macro="param_size_range"/>
                <expand macro="param_figure_size"/>
            </when>
            <when value="pl.tileplot">
                <expand macro="inputs_anndata" format="h5ad,h5mu" label="Annotated data matrix (AnnData, or MuData)"/>
                <expand macro="param_uns_key" DEFAULT="liana_res"/>
                <param argument="fill" type="text" value="means" optional="false" label="Fill by column suffix" help="Column suffix shared by ligand_&lt;fill&gt; and receptor_&lt;fill&gt; (e.g., 'means', 'props', 'stat', 'logfc', 'zscores').">
                    <expand macro="sanitize_query"/>
                    <validator type="empty_field" message="fill column suffix is required (e.g. 'means' or 'stat')"/>
                </param>
                <param argument="label" type="text" value="props" optional="false" label="Label by column suffix" help="Column suffix shared by ligand_&lt;label&gt; and receptor_&lt;label&gt; (e.g., 'props', 'means', 'padj', 'pvalue', 'pvals').">
                    <expand macro="sanitize_query"/>
                    <validator type="empty_field" message="label column suffix is required (e.g. 'props' or 'padj')"/>
                </param>
                <param name="label_style" type="select" label="Label formatting function (label_fn)">
                    <option value="round2" selected="true">Round numbers to 2 decimal places</option>
                    <option value="star05">Significance asterisk (* if &lt; 0.05, else empty)</option>
                    <option value="raw">Raw values as-is</option>
                </param>
                <expand macro="param_source_labels"/>
                <expand macro="param_target_labels"/>
                <expand macro="param_ligand_complex"/>
                <expand macro="param_receptor_complex"/>
                <expand macro="param_top_n"/>
                <expand macro="param_orderby"/>
                <expand macro="param_orderby_ascending"/>
                <expand macro="param_orderby_absolute"/>
                <expand macro="param_plot_filter"/>
                <param argument="source_title" type="text" optional="true" label="Source axis title (default 'Source')">
                    <expand macro="sanitize_query"/>
                </param>
                <param argument="target_title" type="text" optional="true" label="Target axis title (default 'Target')">
                    <expand macro="sanitize_query"/>
                </param>
                <expand macro="param_cmap"/>
                <param argument="label_size" type="integer" value="12" min="1" label="Label text size"/>
                <expand macro="param_figure_size" width="5" height="5"/>
            </when>
            <when value="pl.circle">
                <expand macro="inputs_anndata" format="h5ad,h5mu" label="Annotated data matrix (AnnData, or MuData)"/>
                <expand macro="param_uns_key" DEFAULT="liana_res"/>
                <expand macro="param_groupby"/>
                <param argument="pivot_mode" type="select" label="Edge weight aggregation mode">
                    <option value="counts" selected="true">counts - Number of interactions between source and target</option>
                    <option value="mean">mean - Mean of score_key between source and target</option>
                </param>
                <param argument="score_key" type="text" optional="true" label="Score column, If None, the score is inferred from the method. (required when pivot_mode is 'mean')">
                    <expand macro="sanitize_query"/>
                </param>
                <param argument="inverse_score" type="boolean" truevalue="True" falsevalue="False" checked="false" label="Apply -log10 transformation to score_key"/>
                <param argument="mask_mode" type="select" label="Source/Target label combination mode">
                    <option value="or" selected="true">or - Keep interactions matching source_labels OR target_labels</option>
                    <option value="and">and - Keep interactions matching both source_labels AND target_labels</option>
                </param>
                <expand macro="param_source_key"/>
                <expand macro="param_target_key"/>
                <expand macro="param_source_labels"/>
                <expand macro="param_target_labels"/>
                <expand macro="param_ligand_complex"/>
                <expand macro="param_receptor_complex"/>
                <expand macro="param_top_n"/>
                <expand macro="param_orderby"/>
                <expand macro="param_orderby_ascending"/>
                <expand macro="param_orderby_absolute"/>
                <expand macro="param_plot_filter"/>
                <expand macro="param_figure_size" width="5" height="5"/>
            </when>
            <when value="pl.connectivity">
                <expand macro="inputs_anndata" format="h5ad,h5mu" label="Annotated data matrix (AnnData, or MuData)"/>
                <param argument="idx" type="integer" value="0" min="0" label="Cell/spot index"/>
                <expand macro="param_spatial_key"/>
                <param argument="connectivity_key" type="text" value="spatial_connectivities" label="Connectivity key in obsp">
                    <expand macro="sanitize_query"/>
                </param>
                <param argument="size" type="float" value="1" min="0" label="Point size"/>
                <expand macro="param_figure_size" width="5.4" height="5"/>
            </when>
            <when value="pl.elbow">
                <expand macro="inputs_anndata"/>
                <expand macro="param_figure_size" width="5" height="4"/>
            </when>
            <when value="pl.feature_by_group">
                <expand macro="inputs_anndata"/>
                <expand macro="param_groupby"/>
                <expand macro="param_spatial_key"/>
                <param argument="labels" type="text" label="Cell-type labels to compare" help="Comma-separated labels from groupby (e.g. 'Astro,Micro' or 'Dendritic,CD14+ Monocyte').">
                    <expand macro="sanitize_query"/>
                    <validator type="empty_field" message="At least one label from groupby is required"/>
                </param>
                <param argument="feature" type="text" label="Feature name in adata.var_names (e.g. 'Astro^Apoe^Lrp1')">
                    <expand macro="sanitize_query"/>
                    <validator type="empty_field" message="feature name is required"/>
                </param>
                <param argument="normalize" type="boolean" truevalue="True" falsevalue="False" checked="true" label="Normalize expression to [0, 1] per group"/>
                <param argument="show_counts" type="boolean" truevalue="True" falsevalue="False" checked="true" label="Show expressing cell counts in colorbar labels"/>
                <expand macro="param_figure_size" width="10" height="6"/>
            </when>
            <when value="pl.annulus">
                <expand macro="inputs_anndata"/>
                <expand macro="param_spatial_key"/>
                <param argument="radius_step" type="float" value="20.0" min="0.001" label="Radius step size"/>
                <param argument="annulus_steps" type="integer" value="1" min="1" label="Annulus width in steps"/>
                <param argument="extend_first_annulus" type="boolean" truevalue="True" falsevalue="False" checked="true" label="Extend first annulus from radius 0"/>
                <param argument="n_rings" type="integer" value="10" min="1" label="Number of concentric rings to draw"/>
                <expand macro="param_seed"/>
                <expand macro="param_figure_size" width="6" height="6"/>
            </when>
            <when value="pl.lric_lineplot">
                <expand macro="inputs_anndata" format="h5ad,h5mu" label="Annotated data matrix (AnnData, or MuData)"/>
                <expand macro="param_uns_key" DEFAULT="lric"/>
                <param argument="interaction" type="text" label="Interaction to plot (e.g. 'Pdyn^Oprd1' or 'Astro^Micro')" help="Interaction identifier from the 'interaction' column.">
                    <expand macro="sanitize_query"/>
                    <validator type="empty_field" message="interaction is required"/>
                </param>
                <param argument="source" type="text" optional="true" label="Sender cell type (required if result has 'source' column)">
                    <expand macro="sanitize_query"/>
                </param>
                <param argument="target" type="text" optional="true" label="Receiver cell type (required if result has 'target' column)">
                    <expand macro="sanitize_query"/>
                </param>
                <param argument="max_dist" type="float" min="0" optional="true" label="Maximum radius to plot (leave empty for all radii)"/>
                <expand macro="param_figure_size" width="6" height="4"/>
            </when>
            <when value="pl.lric_divergence">
                <expand macro="inputs_anndata" format="h5ad,h5mu" label="Annotated data matrix (AnnData, or MuData)"/>
                <expand macro="param_uns_key" DEFAULT="lric"/>
                <param argument="feature_a" type="text" label="First curve selector (key:value pairs, comma-separated)" help="Example: 'source:Astro,target:Neuron,interaction:Apoe^Lrp1' or 'interaction:Dcn^Egfr,condition:stim'">
                    <expand macro="sanitize_query"/>
                    <validator type="empty_field" message="feature_a is required"/>
                </param>
                <param argument="feature_b" type="text" label="Second curve selector (key:value pairs, comma-separated)" help="Example: 'source:Micro,target:Neuron,interaction:Apoe^Lrp1' or 'interaction:Dcn^Egfr,condition:ctrl'">
                    <expand macro="sanitize_query"/>
                    <validator type="empty_field" message="feature_b is required"/>
                </param>
                <param argument="max_dist" type="float" min="0" optional="true" label="Maximum radius to compare (leave empty for all radii)"/>
                <param argument="min_bins" type="integer" value="3" min="2" label="Minimum shared finite radius bins"/>
                <expand macro="param_figure_size" width="6" height="4"/>
            </when>
            <when value="pl.misty_target_metrics">
                <expand macro="inputs_anndata" format="h5mu" label="MISTy (MuData .h5mu) file"/>
                <param argument="stat" type="select" label="Statistic to plot">
                    <option value="gain_R2" selected="true">gain_R2 - R² gain from extra spatial views</option>
                    <option value="intra_R2">intra_R2 - Intra-view R²</option>
                    <option value="multi_R2">multi_R2 - Total multi-view R²</option>
                    <option value="custom">Custom column (e.g. a specific view contribution column)</option>
                </param>
                <param name="custom_stat" type="text" optional="true" label="Custom statistic column name (used when 'Custom column' is selected above)">
                    <expand macro="sanitize_query"/>
                </param>
                <expand macro="param_misty_key"/>
                <expand macro="param_misty_aggregate_fn"/>
                <param argument="top_n" type="integer" optional="true" min="1" label="Top N targets"/>
                <param argument="ascending" type="boolean" truevalue="True" falsevalue="False" checked="false" label="Sort ascending"/>
                <expand macro="param_plot_filter"/>
                <expand macro="param_figure_size" width="5" height="5"/>
            </when>
            <when value="pl.misty_contributions">
                <expand macro="inputs_anndata" format="h5mu" label="MISTy (MuData .h5mu) file"/>
                <param argument="view_names" type="text" optional="true" label="Views to include (comma-separated, leave empty for all views in MISTy object)">
                    <expand macro="sanitize_query"/>
                </param>
                <expand macro="param_misty_aggregate_fn"/>
                <expand macro="param_plot_filter"/>
                <expand macro="param_figure_size" width="5" height="5"/>
            </when>
            <when value="pl.misty_interactions">
                <expand macro="inputs_anndata" format="h5mu" label="MISTy (MuData .h5mu) file"/>
                <param argument="view" type="text" value="para" optional="false" label="View name to plot (e.g., 'intra', 'juxta', 'para', 'extra')">
                    <expand macro="sanitize_query"/>
                    <validator type="empty_field" message="view name is required"/>
                </param>
                <expand macro="param_misty_key"/>
                <expand macro="param_misty_aggregate_fn"/>
                <param argument="top_n" type="integer" optional="true" min="1" label="Top N predictor-target pairs"/>
                <param argument="ascending" type="boolean" truevalue="True" falsevalue="False" checked="false" label="Sort ascending"/>
                <expand macro="param_plot_filter"/>
                <expand macro="param_figure_size" width="5" height="5"/>
            </when>
        </conditional>
        <expand macro="inputs_common_advanced"/>
    </inputs>
    <outputs>
        <data name="out_png" format="png" from_work_dir="plot.png" label="${tool.name} (${method.method}) on ${on_string}: PNG">
            <filter>format == 'png'</filter>
        </data>
        <data name="out_pdf" format="pdf" from_work_dir="plot.pdf" label="${tool.name} (${method.method}) on ${on_string}: PDF">
            <filter>format == 'pdf'</filter>
        </data>
