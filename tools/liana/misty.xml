<tool id="liana_misty" name="Liana MISTy" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>learn spatial relationships with multi-view modelling</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tools"/>
    <expand macro="creators"/>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <command detect_errors="exit_code"><![CDATA[
@CMD@
    ]]></command>
    <configfiles>
        <configfile name="script_file"><![CDATA[
@CMD_IMPORTS@
@CMD_READ_INPUTS@

#if str($method.method) == 'genericMistyData':
    #if $method.extra_adata:
extra_ad = sc.read_h5ad('$method.extra_adata')
    #else:
extra_ad = None
    #end if
misty = li.mt.genericMistyData(
    intra=adata,
    intra_use_raw=$method.intra_use_raw,
    #if str($method.intra_layer).strip() != '':
    intra_layer='$method.intra_layer'.strip(),
    #end if
    extra=extra_ad,
    extra_use_raw=$method.extra_use_raw,
    #if str($method.extra_layer).strip() != '':
    extra_layer='$method.extra_layer'.strip(),
    #end if
    nz_threshold=$method.nz_threshold,
    add_para=$method.add_para,
    spatial_key='$method.spatial_key',
    set_diag=$method.set_diag,
    kernel='$method.kernel',
    bandwidth=$method.bandwidth,
    zoi=$method.zoi,
    cutoff=$method.cutoff,
    add_juxta=$method.add_juxta,
    n_neighs=$method.n_neighs,
    max_neighs=$method.max_neighs,
    verbose=False)

#else if str($method.method) == 'lrMistyData':
    #if str($method.resource_selection.resource_type) == 'interactions':
pairs = [tuple(x.strip().split(',')) for x in '''$method.resource_selection.interactions'''.strip().split('\n') if x.strip()]
res_df = pd.DataFrame(pairs, columns=['ligand', 'receptor'])
misty = li.mt.lrMistyData(
    adata,
    resource=res_df,
    #else if str($method.resource_selection.resource_type) == 'resource':
res_df = pd.read_csv('$method.resource_selection.resource', sep='\t')
misty = li.mt.lrMistyData(
    adata,
    resource=res_df,
    #else:
misty = li.mt.lrMistyData(
    adata,
    resource_name='$method.resource_selection.resource_name',
    #end if
    nz_threshold=$method.nz_threshold,
    use_raw=$method.use_raw,
    #if str($method.layer).strip() != '':
    layer='$method.layer'.strip(),
    #end if
    spatial_key='$method.spatial_key',
    set_diag=$method.set_diag,
    kernel='$method.kernel',
    bandwidth=$method.bandwidth,
    zoi=$method.zoi,
    cutoff=$method.cutoff,
    verbose=False)

#else if str($method.method) == 'MistyData':
if isinstance(adata, mu.MuData):
    misty = li.mt.MistyData(
        data=adata,
        spatial_key='$method.spatial_key',
        enforce_obs=$method.enforce_obs)
else:
    views = {'intra': adata}
    #for $i, $v in enumerate($method.extra_views):
    views['$v.view_name'] = sc.read_h5ad('$v.view_adata')
    #end for
    misty = li.mt.MistyData(
        data=views,
        spatial_key='$method.spatial_key',
        enforce_obs=$method.enforce_obs)
#end if

misty(
    model=li.mt.sp.$method.model,
    bypass_intra=$method.bypass_intra,
    predict_self=$method.predict_self,
    #if str($method.maskby).strip() != '':
    maskby='$method.maskby'.strip(),
    #end if
    k_cv=$method.k_cv,
    seed=$method.seed,
    verbose=False)

misty.write_h5mu('misty_results.h5mu')
#if $output_tables:
misty.uns['target_metrics'].to_csv('target_metrics.tsv', sep='\t', index=False)
misty.uns['interactions'].to_csv('interactions.tsv', sep='\t', index=False)
#end if
with open('anndata_info.txt', 'w', encoding='utf-8') as ainfo:
    print(misty, file=ainfo)
        ]]></configfile>
    </configfiles>
    <inputs>
        <expand macro="inputs_anndata" format="h5ad,h5mu" label="Annotated data matrix (AnnData, or MuData)"/>
        <conditional name="method">
            <param name="method" type="select" label="Method">
                <option value="genericMistyData" selected="true">genericMistyData - Generic multi-view spatial modelling (intra + juxta + para)</option>
                <option value="lrMistyData">lrMistyData - Ligand-receptor multi-view spatial modelling</option>
                <option value="MistyData">MistyData - Build MISTy from custom view AnnDatas or MuData</option>
            </param>
            <when value="genericMistyData">
                <param argument="intra_use_raw" type="boolean" truevalue="True" falsevalue="False" checked="false" label="Use raw counts for intra-view"/>
                <param argument="intra_layer" type="text" optional="true" label="Intra-view layer">
                    <expand macro="sanitize_query"/>
                </param>
                <param name="extra_adata" type="data" format="h5ad" optional="true" label="Separate extra-view AnnData" help="If provided (e.g., pathway/TF activities or cell-type compositions), predictors in juxta/para views are built from this AnnData instead of the intra-view AnnData."/>
                <param argument="extra_use_raw" type="boolean" truevalue="True" falsevalue="False" checked="false" label="Use raw counts for extra-views"/>
                <param argument="extra_layer" type="text" optional="true" label="Extra-view layer">
                    <expand macro="sanitize_query"/>
                </param>
                <expand macro="param_nz_threshold"/>
                <param argument="add_para" type="boolean" truevalue="True" falsevalue="False" checked="true" label="Compute paraview"/>
                <expand macro="param_spatial_key"/>
                <expand macro="param_set_diag"/>
                <expand macro="param_kernel" DEFAULT_KERNEL="misty_rbf"/>
                <expand macro="param_bandwidth"/>
                <expand macro="param_zoi"/>
                <expand macro="param_cutoff"/>
                <param argument="add_juxta" type="boolean" truevalue="True" falsevalue="False" checked="true" label="Compute juxtaview"/>
                <param argument="n_neighs" type="integer" value="6" min="1" label="Juxtaview neighborhood size" help="The number of nearest neighbors to consider when constructing the juxtaview."/>
                <param argument="max_neighs" type="integer" value="18" min="1" label="Maximum paraview neighbors" help="The maximum number of neighbors to consider when constructing the paraview."/>
                <expand macro="params_misty_fit"/>
            </when>
            <when value="lrMistyData">
                <expand macro="param_resource_selection"/>
                <expand macro="param_nz_threshold"/>
                <expand macro="param_use_raw"/>
                <expand macro="param_layer"/>
                <expand macro="param_spatial_key"/>
                <expand macro="param_set_diag"/>
                <expand macro="param_kernel" DEFAULT_KERNEL="misty_rbf"/>
                <expand macro="param_bandwidth"/>
                <expand macro="param_zoi"/>
                <expand macro="param_cutoff"/>
                <expand macro="params_misty_fit"/>
            </when>
            <when value="MistyData">
                <repeat name="extra_views" title="Extra spatial views (ignored if primary input is already a MuData)" min="0">
                    <param name="view_name" type="text" value="extra" label="View name (e.g., 'juxta', 'para', 'TFs', 'receptor', 'ct')">
                        <expand macro="sanitize_query"/>
                        <validator type="empty_field" message="View name is required"/>
                    </param>
                    <param name="view_adata" type="data" format="h5ad" label="View AnnData (must contain spatial connectivities in .obsp or .obsm)"/>
                </repeat>
                <expand macro="param_spatial_key"/>
                <param argument="enforce_obs" type="boolean" truevalue="True" falsevalue="False" checked="true" label="Enforce matching observations across views (enforce_obs)" help="Enable when all views share the same spots/cells (.obsp['spatial_connectivities']). Disable when views come from unaligned modalities with rectangular connectivities in .obsm['spatial_connectivities']."/>
                <expand macro="params_misty_fit"/>
            </when>
        </conditional>
        <param name="output_tables" type="boolean" checked="false" label="Also output target_metrics and interactions as TSV tables?"/>
        <expand macro="inputs_common_advanced"/>
    </inputs>
    <outputs>
        <data name="misty_out" format="h5mu" from_work_dir="misty_results.h5mu" label="${tool.name} (${method.method}) on ${on_string}: MISTy results"/>
        <data name="target_metrics_out" format="tabular" from_work_dir="target_metrics.tsv" label="${tool.name} (${method.method}) on ${on_string}: Target metrics">
            <filter>output_tables</filter>
        </data>
        <data name="interactions_out" format="tabular" from_work_dir="interactions.tsv" label="${tool.name} (${method.method}) on ${on_string}: Interactions">
            <filter>output_tables</filter>
        </data>
        <data name="hidden_output" format="txt" label="Log file">
            <filter>advanced_common['show_log']</filter>
        </data>
    </outputs>
    <tests>
        <!-- Test 1: genericMistyData with RandomForestModel and tabular outputs -->
        <test expect_num_outputs="4">
            <param name="adata" location="https://zenodo.org/records/18388645/files/misty_small.h5ad"/>
            <conditional name="method">
                <param name="method" value="genericMistyData"/>
                <param name="intra_use_raw" value="false"/>
                <param name="extra_use_raw" value="false"/>
                <param name="nz_threshold" value="0.1"/>
                <param name="add_para" value="true"/>
                <param name="spatial_key" value="spatial"/>
                <param name="set_diag" value="false"/>
                <param name="kernel" value="misty_rbf"/>
                <param name="bandwidth" value="100"/>
                <param name="zoi" value="0"/>
                <param name="cutoff" value="0.1"/>
                <param name="add_juxta" value="true"/>
                <param name="n_neighs" value="6"/>
                <param name="max_neighs" value="18"/>
                <param name="model" value="RandomForestModel"/>
                <param name="bypass_intra" value="false"/>
                <param name="seed" value="1337"/>
            </conditional>
            <param name="output_tables" value="true"/>
            <section name="advanced_common">
                <param name="show_log" value="true"/>
            </section>
            <assert_stdout>
                <has_text_matching expression="MuData object with n_obs × n_vars = 50 × 60"/>
                <has_text_matching expression="target_metrics"/>
                <has_text_matching expression="interactions"/>
            </assert_stdout>
            <output name="misty_out" ftype="h5mu">
                <assert_contents>
                    <has_h5_keys keys="uns/interactions/importances"/>
                </assert_contents>
            </output>
            <output name="target_metrics_out" ftype="tabular">
                <assert_contents>
                    <has_text text="gain_R2"/>
                </assert_contents>
            </output>
            <output name="interactions_out" ftype="tabular">
                <assert_contents>
                    <has_text text="importances"/>
                </assert_contents>
            </output>
            <output name="hidden_output">
                <assert_contents>
                    <has_text_matching expression="li\.mt\.genericMistyData\("/>
                    <has_text_matching expression="model=li\.mt\.sp\.RandomForestModel"/>
                </assert_contents>
            </output>
        </test>
        <!-- Test 2: genericMistyData with LinearModel -->
