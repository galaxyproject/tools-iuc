<tool id="epa_ng" name="EPA-ng" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>place aligned sequences onto a reference phylogeny</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <xrefs>
        <xref type="bio.tools">epa-ng</xref>
    </xrefs>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">epa-ng</requirement>
    </requirements>
    <version_command>epa-ng --version</version_command>
    <command detect_errors="exit_code"><![CDATA[
epa-ng --query '$query' --ref-msa '$reference' --tree '$tree'
    --model '$model' --threads \${GALAXY_SLOTS:-1}
#if $retention.mode == 'minimum'
    --filter-min-lwr $retention.threshold
#else
    --filter-acc-lwr $retention.threshold
#end if
    --filter-min $filter_min --filter-max $filter_max --precision $precision
    ]]></command>
    <inputs>
        <param name="query" type="data" format="fasta" label="Aligned query sequences" help="Queries must use the same alignment columns as the reference alignment."/>
        <param name="reference" type="data" format="fasta" label="Reference sequence alignment"/>
        <param name="tree" type="data" format="newick" label="Reference tree" help="Tip labels must match the reference sequence identifiers."/>
        <param name="model" type="text" value="GTR+G" label="Substitution model" help="RAxML-NG model description, for example GTR+F+I+I+R3.">
            <validator type="regex" message="Use a model description containing letters, numbers, and model punctuation only.">^[A-Za-z0-9+._{},/:=-]+$</validator>
        </param>
        <conditional name="retention">
            <param name="mode" type="select" label="Likelihood-weight retention rule">
                <option value="minimum" selected="true">Minimum individual placement weight</option>
                <option value="accumulated">Accumulated placement weight</option>
            </param>
            <when value="minimum">
                <param name="threshold" type="float" value="0.01" min="0" max="1" label="Minimum likelihood weight"/>
            </when>
            <when value="accumulated">
                <param name="threshold" type="float" value="0.99" min="0" max="1" label="Accumulated likelihood weight"/>
            </when>
        </conditional>
        <param name="filter_min" type="integer" value="1" min="1" label="Minimum placements per query"/>
        <param name="filter_max" type="integer" value="7" min="1" label="Maximum placements per query"/>
        <param name="precision" type="integer" value="10" min="1" max="17" label="Decimal precision of placement output"/>
    </inputs>
    <outputs>
        <data name="placements" format="json" from_work_dir="epa_result.jplace" label="${tool.name} on ${on_string}: placements (jplace JSON)"/>
        <data name="log" format="txt" from_work_dir="epa_info.log" label="${tool.name} on ${on_string}: run log"/>
    </outputs>
    <tests>
        <test expect_num_outputs="2">
            <param name="query" value="query.fasta"/>
            <param name="reference" value="reference.fasta"/>
            <param name="tree" value="reference.newick"/>
            <param name="model" value="GTR+F+I+I+R3"/>
            <output name="placements">
                <assert_contents>
                    <has_json_property_with_value property="version" value="3"/>
                    <has_json_property_with_value property="fields" value="[&quot;edge_num&quot;, &quot;likelihood&quot;, &quot;like_weight_ratio&quot;, &quot;distal_length&quot;, &quot;pendant_length&quot;]"/>
                    <has_json_property_with_value property="n" value="[&quot;08e82441af4098baf31f236034ea249b&quot;]"/>
                </assert_contents>
            </output>
            <output name="log">
                <assert_contents>
                    <has_text text="275"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="2">
            <param name="query" value="query.fasta"/>
            <param name="reference" value="reference.fasta"/>
            <param name="tree" value="reference.newick"/>
            <param name="model" value="GTR+F+I+I+R3"/>
            <conditional name="retention">
                <param name="mode" value="accumulated"/>
                <param name="threshold" value="0.99"/>
            </conditional>
            <param name="filter_max" value="1"/>
            <output name="placements">
                <assert_contents>
                    <has_json_property_with_value property="version" value="3"/>
                    <has_json_property_with_value property="n" value="[&quot;08e82441af4098baf31f236034ea249b&quot;]"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
EPA-ng places aligned query sequences onto a fixed reference phylogeny using maximum likelihood. All query and reference sequences must have the same alignment columns. Reference tree tips must match the reference alignment identifiers.

The output is a jplace JSON document containing candidate placement edges, likelihood weights and branch lengths. It can be used by GAPPA to graft query sequences, assign taxonomy, or visualize placement mass. The tool retains multiple placements by default (minimum weight 0.01, maximum seven) so uncertainty remains available downstream. A maximum of one retains only the best placement.

The model input accepts a RAxML-NG model description. This wrapper does not estimate a reference tree or align sequences.
    ]]></help>
    <citations>
        <citation type="doi">10.1093/sysbio/syy054</citation>
    </citations>
</tool>
