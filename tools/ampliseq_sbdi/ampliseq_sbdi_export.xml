<tool id="ampliseq_sbdi_export" name="SBDI submission tables" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="25.0">
    <description>from amplicon counts, taxonomy and sample metadata</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <required_files>
        <include type="literal" path="sbdiexport.R"/>
        <include type="literal" path="galaxy_metadata.R"/>
    </required_files>
    <version_command>echo '@TOOL_VERSION@'</version_command>
    <command detect_errors="exit_code"><![CDATA[
sed '1s/^[^\t]*/ASV_ID/' '$counts' > counts.tsv &&
sed '1s/^[^\t]*/ASV_ID/' '$taxonomy' > taxonomy.tsv &&
Rscript '$__tool_directory__/sbdiexport.R'
'$library_layout' '$forward_primer' '$reverse_primer' counts.tsv taxonomy.tsv
#if $metadata
    '$metadata'
#end if
&& Rscript '$__tool_directory__/galaxy_metadata.R' 'event=event.tsv' 'dna=dna.tsv' 'emof=emof.tsv' 'asv_table=asv-table.tsv'
    ]]></command>
    <inputs>
        <param name="counts" type="data" format="tabular,dada2_sequencetable" label="ASV count table" help="First column: ASV identifier; remaining columns: sample read counts. One header row."/>
        <param name="taxonomy" type="data" format="tabular" label="ASV taxonomy table" help="First column: matching ASV identifier. Named columns include sequence and taxonomic ranks; optional SH or BOLD_bin identifiers are retained."/>
        <param name="metadata" type="data" format="tabular" optional="true" label="Sample metadata" help="Optional table with an ID column matching count-table sample names. SBDI/MiXS fields are retained when present."/>
        <param name="library_layout" type="select" label="Library layout">
            <option value="paired">Paired</option>
            <option value="single">Single</option>
        </param>
        <param name="forward_primer" type="text" value="" label="Forward primer sequence">
            <validator type="regex" message="Use IUPAC DNA letters only.">^[ACGTRYSWKMBDHVNacgtryswkmbdhvn]*$</validator>
        </param>
        <param name="reverse_primer" type="text" value="" label="Reverse primer sequence">
            <validator type="regex" message="Use IUPAC DNA letters only.">^[ACGTRYSWKMBDHVNacgtryswkmbdhvn]*$</validator>
        </param>
    </inputs>
    <outputs provided_metadata_file="galaxy.json">
        <data name="event" format="tabular" from_work_dir="event.tsv" label="${tool.name} on ${on_string}: event"/>
        <data name="dna" format="tabular" from_work_dir="dna.tsv" label="${tool.name} on ${on_string}: DNA"/>
        <data name="emof" format="tabular" from_work_dir="emof.tsv" label="${tool.name} on ${on_string}: measurements"/>
        <data name="asv_table" format="tabular" from_work_dir="asv-table.tsv" label="${tool.name} on ${on_string}: ASVs"/>
    </outputs>
    <tests>
        <test expect_num_outputs="4">
            <param name="counts" value="counts.tsv"/>
            <param name="taxonomy" value="taxonomy.tsv"/>
            <param name="metadata" value="metadata.tsv"/>
            <param name="library_layout" value="paired"/>
            <param name="forward_primer" value="CTTGGTCATTTAGAGGAAGTAA"/>
            <param name="reverse_primer" value="TCCTGAGGGAAACTTCG"/>
            <output name="event" file="with-metadata-event.tsv">
                <metadata name="columns" value="25"/>
                <metadata name="column_names" value="eventID,datasetID,institutionCode,institutionID,collectionCode,materialSampleID,associatedSequences,fieldNumber,catalogNumber,references,eventDate,samplingProtocol,locationID,decimalLatitude,decimalLongitude,geodeticDatum,coordinateUncertaintyInMeters,recordedBy,country,municipality,verbatimLocality,minimumElevationInMeters,maximumElevationInMeters,minimumDepthInMeters,maximumDepthInMeters"/>
            </output>
            <output name="dna" file="with-metadata-dna.tsv">
                <metadata name="columns" value="12"/>
                <metadata name="column_names" value="eventID,sop,target_gene,target_subfragment,lib_layout,pcr_primer_name_forward,pcr_primer_name_reverse,pcr_primer_forward,pcr_primer_reverse,env_broad_scale,env_local_scale,env_medium"/>
            </output>
            <output name="emof" file="with-metadata-emof.tsv">
                <metadata name="columns" value="12"/>
                <metadata name="column_names" value="eventID,measurementType,measurementTypeID,measurementValue,measurementValueID,measurementUnit,measurementUnitID,measurementAccuracy,measurementDeterminedDate,measurementDeterminedBy,measurementMethod,measurementRemarks"/>
            </output>
            <output name="asv_table" file="with-metadata-asv-table.tsv">
                <metadata name="columns" value="15"/>
                <metadata name="column_names" value="asv_id_alias,pb1,pb2,pb3,DNA_sequence,associatedSequences,kingdom,phylum,class,order,family,genus,specificEpithet,infraspecificEpithet,otu"/>
            </output>
        </test>
        <test expect_num_outputs="4">
            <param name="counts" value="counts.tsv"/>
            <param name="taxonomy" value="taxonomy.tsv"/>
            <param name="library_layout" value="single"/>
            <param name="forward_primer" value="ACGT"/>
            <output name="event" file="without-metadata-event.tsv">
                <metadata name="columns" value="25"/>
                <metadata name="column_names" value="eventID,datasetID,institutionCode,institutionID,collectionCode,materialSampleID,associatedSequences,fieldNumber,catalogNumber,references,eventDate,samplingProtocol,locationID,decimalLatitude,decimalLongitude,geodeticDatum,coordinateUncertaintyInMeters,recordedBy,country,municipality,verbatimLocality,minimumElevationInMeters,maximumElevationInMeters,minimumDepthInMeters,maximumDepthInMeters"/>
            </output>
            <output name="dna" file="without-metadata-dna.tsv">
                <metadata name="columns" value="12"/>
                <metadata name="column_names" value="eventID,sop,target_gene,target_subfragment,lib_layout,pcr_primer_name_forward,pcr_primer_name_reverse,pcr_primer_forward,pcr_primer_reverse,env_broad_scale,env_local_scale,env_medium"/>
            </output>
            <output name="emof" file="without-metadata-emof.tsv">
                <metadata name="columns" value="12"/>
                <metadata name="column_names" value="eventID,measurementType,measurementTypeID,measurementValue,measurementValueID,measurementUnit,measurementUnitID,measurementAccuracy,measurementDeterminedDate,measurementDeterminedBy,measurementMethod,measurementRemarks"/>
            </output>
            <output name="asv_table" file="without-metadata-asv-table.tsv">
                <metadata name="columns" value="15"/>
                <metadata name="column_names" value="asv_id_alias,pb1,pb2,pb3,DNA_sequence,associatedSequences,kingdom,phylum,class,order,family,genus,specificEpithet,infraspecificEpithet,otu"/>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
Create four tables for a Swedish Biodiversity Data Infrastructure (SBDI) submission:

- **event:** sample identifiers, location and collection metadata, including ENA links.
- **dna:** library layout, primers and available MiXS metadata.
- **emof:** extended measurement-or-fact metadata.
- **ASVs:** per-sample counts joined to sequences, taxonomy and species hypotheses.

This tool formats existing results; it does not classify sequences or validate a submission against current SBDI policy. Inspect and complete required metadata before submission. Missing optional metadata produce empty fields. The default SOP field is the upstream nf-core/ampliseq URL and can be overridden by a `sop` metadata column.

Inputs must have one tab-separated header row. The first column in counts and taxonomy is normalized to `ASV_ID`; identifier values must agree between tables. Taxonomy requires `sequence` and can include Domain/Kingdom/Phylum/Class/Order/Family/Genus/Species/Species_exact, SH or BOLD_bin. Metadata use an `ID` column matching sample headers.

The format-normalized MIT-licensed formatters are from nf-core/ampliseq 2.11.0, commit 0473e157ac9a7b1d36845ff9f8fa7ac843d3b234. See UPSTREAM.md for attribution and provenance.
    ]]></help>
    <expand macro="citations"/>
</tool>
