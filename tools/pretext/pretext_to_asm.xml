<tool id="pretext_to_asm" name="Pretext-to-asm" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Build an assembly from curation</description>
    <macros>
        <token name="@TOOL_VERSION@">1.4.1</token>
        <token name="@VERSION_SUFFIX@">0</token>
        <token name="@PROFILE@">25.0</token>
    </macros>
    <requirements>
        <requirement type="package" version="@TOOL_VERSION@">pretext-to-asm</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
        mkdir -p 'pretext_to_asm_out' &&
        ln -s '${input_fasta}' input.fasta &&
        pretext-to-asm
        -a input.fasta
        -p '${input_agp}'
        -o 'pretext_to_asm_out/pretext_galaxy.fa'
        #if str($opt.prefix) != ''
            -c '${opt.prefix}'
        #end if
        #if str($opt.map_order) != ''
                --default-assembly-name '${opt.map_order}'
        #end if
        #if str($opt.max_contig_length) != ''
            --max-contig-length '${opt.max_contig_length}'
        #else
            --no-max-contig-length
        #end if
        --no-write-log
    ]]></command>

    <inputs>
        <param name="input_fasta" type="data" format="fasta" label="Assembly sequence (FASTA)" help="Assembly before curation"/>
        <param name="input_agp" type="data" format="agp,txt" label="Assembly file from Pretext"/>

        <param name="outputs" type="select" multiple="true" display="checkboxes" label="Output files to generate" help="Select which output assemblies to keep. 'Primary' is the curated main assembly and is selected by default.">
            <option value="primary" selected="true">Primary (curated assembly)</option>
            <option value="info_yaml">Info YAML (assembly metadata)</option>
            <option value="haplotigs">Haplotigs</option>
            <option value="csv">Chromosome report (CSV)</option>
            <option value="contaminants">Contaminants</option>
            <option value="shorts">Short contigs (only if input contigs are shorter than the minimum contig length)</option>
        </param>

        <section name="opt" title="Advanced Options">
            <param name="prefix" argument="-c" type="text" label="Prefix for naming autosomal chromosomes" help="default: SUPER_"/>
            <param name="map_order" argument="--default-assembly-name" type="text" label="Name for output files which are not split per haplotype" help="Defaults to 'map-order' if the '--keep-map-order' option is given."/>
            <param name="max_contig_length" type="integer" optional="true"  min="1" label="Maximum length for a single contig" help="If a contig exceeds this size, it will be broken at gaps into a number of pieces such that each is less than this number. The pieces will have the suffixes '_1', '_2' etc.. added to their names. [default: 2 Gbp]"/>
        </section>
    </inputs>
    <outputs>
        <data name="primary" format="fasta" label="Primary assembly on ${on_string}"
            from_work_dir="pretext_to_asm_out/pretext_galaxy.1.primary.fa">
            <filter>outputs and 'primary' in outputs</filter>
        </data>
        <data name="haplotigs" format="fasta" label="Haplotigs on ${on_string}"
            from_work_dir="pretext_to_asm_out/pretext_galaxy.1.haplotigs.fa">
            <filter>outputs and 'haplotigs' in outputs</filter>
        </data>
        <data name="contaminants" format="fasta" label="Contaminants on ${on_string}"
            from_work_dir="pretext_to_asm_out/pretext_galaxy.1.contaminants.fa">
            <filter>outputs and 'contaminants' in outputs</filter>
        </data>
        <data name="shorts" format="fasta" label="Short contigs on ${on_string}"
            from_work_dir="pretext_to_asm_out/pretext_galaxy.1.shorts.fa">
            <filter>outputs and 'shorts' in outputs</filter>
        </data>
        <data name="info_yaml" format="yaml" label="Assembly info on ${on_string}"
            from_work_dir="pretext_to_asm_out/pretext_galaxy.1.info.yaml">
            <filter>outputs and 'info_yaml' in outputs</filter>
        </data>
        <data name="chr_report" format="csv" label="Chromosome report on ${on_string}"
            from_work_dir="pretext_to_asm_out/pretext_galaxy.1.chr_report.csv">
            <filter>outputs and 'csv' in outputs</filter>
        </data>
    </outputs>
    <tests>
        <!-- <test 1-->
        <test expect_num_outputs="1">
            <param name="input_fasta" value="genome_masked.fasta" ftype="fasta"/>
            <param name="input_agp" value="genome_masked.pretext.agp_1" ftype="agp"/>
            <param name="outputs" value="primary"/>
            <output name="primary" file="test_output.1.primary.fa" ftype="fasta" compare="sim_size" delta="0"/>
        </test>
        <!-- <test 2-->
        <test expect_num_outputs="2">
            <param name="input_fasta" value="genome_masked.fasta" ftype="fasta"/>
            <param name="input_agp" value="genome_masked.pretext_haplo.agp" ftype="txt"/>
            <param name="outputs" value="primary,haplotigs"/>
            <output name="primary" file="test_output.haplo.1.primary.fa" ftype="fasta" compare="sim_size" delta="0"/>
            <output name="primary" file="test_output.haplo.1.haplotigs.fa" ftype="fasta" compare="sim_size" delta="0"/>
        </test>
    </tests>

    <help><![CDATA[
        pretext-to-asm_ Uses fragments in the assembly (AGP) produced by PretextView to find
        matching fragments in the assembly which was fed into Pretext and output an
        assembly made from the input assembly fragments.

        .. _pretext-to-asm: https://github.com/sanger-tol/agp-tpf-utils
    ]]></help>
    <citations>
        <citation type="bibtex">
            @misc{pretext_to_asm,
                author       = {Sanger Institute Tree of Life Programme},
                title        = {pretext-to-asm: build an assembly from PretextView curated AGP},
                year         = {2023},
                howpublished = {\url{https://github.com/sanger-tol/agp-tpf-utils}},
            }
        </citation>
    </citations>
</tool>