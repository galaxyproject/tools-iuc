#genai_models.loc — models offered by your LiteLLM proxy (or any
#OpenAI-compatible endpoint). 6 columns, TAB separated:
#<value>	<model_id>	<name>	<domain>	<provider>	<free_tag>
#value:     unique dropdown key
#model_id:  model identifier sent to the API  <- this is what bionym passes to LLM_MODEL
#name:      display label
#domain:    text | image | multimodal   (bionym filters on "text")
#provider:  key into the LiteLLM servers map / endpoint label
#free_tag:  optional admin tag
#
#Example:
#gpt-oss-20b	gpt-oss-20b-llmlb	GPT-OSS Local (20B)	text	uni-freiburg	openai
