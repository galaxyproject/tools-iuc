<macros>
    <token name="@TOOL_VERSION@">0.8.1</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <!--
        IUC packaging note. These tools call the `pyeuk` command-line interface, distributed
        on Bioconda. The bioconda `pyeuk` package carries pysam (the amplicon extra) and the
        report/clustering dependencies, so a single package requirement is enough. This is the
        conda-resolvable requirement expected by the Tool Shed / Galaxy, replacing the private
        container image used during development.
    -->
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">pyeuk</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="version_command">
        <version_command>python -c "import pyeuk; print(pyeuk.__version__)"</version_command>
    </xml>
    <xml name="edam">
        <edam_topics>
            <edam_topic>topic_0637</edam_topic>
            <!-- Taxonomy -->
            <edam_topic>topic_3305</edam_topic>
            <!-- Public health and epidemiology -->
            <edam_topic>topic_3168</edam_topic>
            <!-- Sequencing -->
        </edam_topics>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1017/S0031182019000581</citation>
            <!-- Barratt et al. 2019, eukaryotyping -->
            <citation type="doi">10.1017/S0950268820001697</citation>
            <!-- Nascimento et al. 2020 -->
        </citations>
    </xml>
    <token name="@HELP_FOOTER@"><![CDATA[

----

**PyEuk.** Part of the PyEuk portable multilocus-typing system. The tools call the ``pyeuk``
command line: a haplotype is named by how its sequence differs from the reference over a
window, so no curated allele catalogue is required, and the result is portable between
laboratories. Source, container, and tests: https://github.com/veg/pyeuk
    ]]></token>
    <!--
        Reference selection, IUC-style: from the history OR from a Galaxy-cached genome
        (the all_fasta data table; fields.path is the FASTA on disk). If no cached genomes
        are installed the cached option shows a clear message and the user falls back to
        history. @REF_RESOLVE@ sets $ref_path to the chosen FASTA in a tool <command>.
    -->
    <xml name="reference_source" token_label="Reference FASTA" token_help="">
        <conditional name="reference_source">
            <param name="reference_source_selector" type="select" label="@LABEL@ -- source" help="@HELP@">
                <option value="history" selected="true">From your history</option>
                <option value="cached">Use a built-in (cached) genome</option>
            </param>
            <when value="history">
                <param name="ref_file" type="data" format="fasta,fasta.gz" label="@LABEL@ (from history)" help="@HELP@"/>
            </when>
            <when value="cached">
                <param name="ref_file" type="select" label="@LABEL@ (built-in)" help="Cached genomes on this Galaxy, managed with the reference-genome data manager.">
                    <options from_data_table="all_fasta">
                        <filter type="sort_by" column="2"/>
                        <validator type="no_options" message="No cached genomes are available. Install one with the reference-genome data manager, or choose 'From your history'."/>
                    </options>
                </param>
            </when>
        </conditional>
    </xml>
    <token name="@REF_RESOLVE@"><![CDATA[
#if str($reference_source.reference_source_selector) == "cached"
    #set $ref_path = str($reference_source.ref_file.fields.path)
#else
    #set $ref_path = str($reference_source.ref_file)
#end if
]]></token>
</macros>
