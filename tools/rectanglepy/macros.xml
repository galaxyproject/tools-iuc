<macros>
    <token name="@TOOL_VERSION@">1.5.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">rectanglepy</requirement>
            <!-- anndata will get updated in next version, pining here to avoid breaking changes -->
            <requirement type="package" version="0.10.8">anndata</requirement>
            <requirement type="package" version="0.4.0">spatialdata</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="creators">
        <creator>
            <person givenName="Amirhossein" familyName="Naghsh Nilchi" email="nilchia@informatik.uni-freiburg.de" identifier="https://orcid.org/0000-0003-1329-3044"/>
            <person givenName="Björn" familyName="Grüning" email="gruening@informatik.uni-freiburg.de" identifier="https://orcid.org/0000-0002-3079-6586"/>
        </creator>
    </xml>
    <xml name="edam">
        <edam_topics>
            <edam_topic>topic_3308</edam_topic>
            <!-- Transcriptomics -->
            <edam_topic>topic_0203</edam_topic>
            <!-- Gene expression -->
             <!-- The following topics is recently added to EDAM and the lint is not yet updated to this -->
            <!-- <edam_topic>topic_4028</edam_topic> -->
            <!-- Single-cell sequencing -->
            <edam_topic>topic_2269</edam_topic>
            <!-- Statistics and probability -->
            <edam_topic>topic_2229</edam_topic>
            <!-- Cell biology -->
        </edam_topics>
        <edam_operations>
            <edam_operation>operation_3223</edam_operation>
            <!-- Differential expression analysis -->
        </edam_operations>
    </xml>
    <xml name="validator_macro">
        <validator type="regex" message="Only letters, digits, underscores, hyphens and periods are allowed">^[A-Za-z0-9_.-]+$</validator>
    </xml>
    <xml name="testing" token_format="png" token_channels="4" token_bulks="bulk_top2000_hvg.tabular" token_bulks_ftype="tabular">
        <test expect_num_outputs="2">
            <param name="adata" value="sc_adata.h5ad.gz" ftype="h5ad"/>
            <param name="cell_type_col" value="cell_type"/>
            <param name="bulks" value="@BULKS@" ftype="@BULKS_FTYPE@"/>
            <section name="figure">
                <param name="plot_format" value="@FORMAT@"/>
            </section>
            <assert_stdout>
                <has_text_matching expression="raw=False,\n    optimize_cutoffs=True,\n    p=0.015,\n    lfc=1.5,\n    correct_mrna_bias=True,\n    gene_expression_threshold=0.5,"/>
                <yield/>
            </assert_stdout>
            <output name="fractions" ftype="tabular">
                <assert_contents>
                    <has_text_matching expression="B cells\tILC\tMonocytes\tNK cells\tPlasma cells\tPlatelet\tT cells CD4 conv\tT cells CD8\tTregs\tmDC\tpDC\tUnknown"/>
                    <has_n_lines n="4"/>
                    <has_text_matching expression="pbmc_12"/>
                </assert_contents>
            </output>
            <output name="plot" ftype="@FORMAT@">
                <assert_contents>
                    <has_image_center_of_mass center_of_mass="920,910" eps="10"/>
                    <has_image_channels channels="@CHANNELS@"/>
                    <has_image_height height="1800"/>
                    <has_image_width width="1800"/>
                </assert_contents>
            </output>
        </test>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.64898/2026.07.07.736950 </citation>
        </citations>
    </xml>
</macros>
