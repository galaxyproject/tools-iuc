<tool id="seqfu_count" name="SeqFu count" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="@LICENSE@">
    <description>Count FASTA/FASTQ reads (paired-end aware)</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tools"/>
    <expand macro="requirements"/>
    <expand macro="creators"/>
    <version_command>seqfu version</version_command>
    <command detect_errors="exit_code"><![CDATA[
#import re
#if $input_type.type == "paired_collection"
    #set $name = re.sub('[^\w\-\.]', '_', str($input_type.input.name))
    #if $input_type.input.forward.is_of_type('fasta.gz')
        #set $ext = 'fasta.gz'
    #elif $input_type.input.forward.is_of_type('fasta')
        #set $ext = 'fasta'
    #elif $input_type.input.forward.is_of_type('fastqsanger.gz')
        #set $ext = 'fastq.gz'
    #else
        #set $ext = 'fastq'
    #end if
    ln -s '$input_type.input.forward' '${name}_R1.${ext}' &&
    ln -s '$input_type.input.reverse' '${name}_R2.${ext}' &&
    seqfu count -b
        --threads "\${GALAXY_SLOTS:-1}"
        $input_type.unpair
        '${name}_R1.${ext}' '${name}_R2.${ext}' > '$output'
#else
    #for $i, $f in enumerate($input_type.input)
        #set $name = re.sub('[^\w\-\.]', '_', str($f.element_identifier))
        mkdir -p 'in_${i}' &&
        ln -s '$f' 'in_${i}/${name}' &&
    #end for
    seqfu count -b
        --threads "\${GALAXY_SLOTS:-1}"
        #for $i, $f in enumerate($input_type.input)
            #set $name = re.sub('[^\w\-\.]', '_', str($f.element_identifier))
            'in_${i}/${name}'
        #end for
        > '$output'
#end if
    ]]></command>
    <inputs>
        <conditional name="input_type">
            <param name="type" type="select" label="Read type">
                <option value="single">Single-end or individual datasets</option>
                <option value="paired_collection">Paired-end collection</option>
            </param>
            <when value="single">
                <param name="input" type="data" format="fasta,fasta.gz,fastqsanger,fastqsanger.gz" multiple="true" label="Sequence datasets"/>
            </when>
            <when value="paired_collection">
                <param name="input" type="data_collection" collection_type="paired" format="fasta,fasta.gz,fastqsanger,fastqsanger.gz" label="Paired-end collection"/>
                <param argument="--unpair" type="boolean" truevalue="--unpair" falsevalue="" checked="false" label="Print separate records for paired-end files" help="Report counts separately for forward and reverse reads"/>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="output" format="tabular" label="${tool.name} on ${on_string}: sequence counts">
            <actions>
                <action name="column_names" type="metadata" default="Filename,Sequences,Type"/>
            </actions>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <conditional name="input_type">
                <param name="type" value="single"/>
                <param name="input" value="fq.fastq.gz" ftype="fastqsanger.gz"/>
            </conditional>
            <output name="output" file="seqfu_count_se.tsv" ftype="tabular"/>
        </test>
        <test expect_num_outputs="1">
            <conditional name="input_type">
                <param name="type" value="paired_collection"/>
                <param name="input">
                    <collection type="paired" name="fq">
                        <element name="forward" value="fq_1.fastq.gz" ftype="fastqsanger.gz"/>
                        <element name="reverse" value="fq_2.fastq.gz" ftype="fastqsanger.gz"/>
                    </collection>
                </param>
                <param name="unpair" value="false"/>
            </conditional>
            <output name="output" file="seqfu_count_pe.tsv" ftype="tabular"/>
        </test>
        <test expect_num_outputs="1">
            <conditional name="input_type">
                <param name="type" value="paired_collection"/>
                <param name="input">
                    <collection type="paired" name="fq">
                        <element name="forward" value="fq_1.fastq.gz" ftype="fastqsanger.gz"/>
                        <element name="reverse" value="fq_2.fastq.gz" ftype="fastqsanger.gz"/>
                    </collection>
                </param>
                <param name="unpair" value="true"/>
            </conditional>
            <output name="output" file="seqfu_count_pe_unpair.tsv" ftype="tabular"/>
        </test>
        <test expect_num_outputs="1">
            <conditional name="input_type">
                <param name="type" value="single"/>
                <param name="input" value="fq_1.fastq.gz,fq_1.fastq.gz" ftype="fastqsanger.gz"/>
            </conditional>
            <output name="output" file="seqfu_count_multi.tsv" ftype="tabular"/>
        </test>
        <test expect_num_outputs="1">
            <conditional name="input_type">
                <param name="type" value="single"/>
                <param name="input" value="fq.fa" ftype="fasta"/>
            </conditional>
            <output name="output" file="seqfu_count_fa.tsv" ftype="tabular"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
# SeqFu count

Count sequences and bases in FASTA or FASTQ files with automatic detection of
paired-end files.

Output
------

A tabular file with:

- Filename
- Sequence count
- File type (`SE`, `Paired`, or `Paired:R2`)

[SeqFu repository](https://github.com/telatin/seqfu2)
    ]]></help>
    <expand macro="citations"/>
</tool>
