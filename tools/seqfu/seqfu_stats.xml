<tool id="seqfu_stats" name="SeqFu stats" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="@LICENSE@">
    <description>Statistics on FASTA and FASTQ sequence lengths and quality</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tools"/>
    <expand macro="requirements"/>
    <expand macro="creators"/>
    <version_command>seqfu version</version_command>
    <command detect_errors="exit_code"><![CDATA[
#import re
#for $i, $f in enumerate($input)
    #set $name = re.sub('[^\w\-\.]', '_', str($f.element_identifier))
    mkdir -p 'in_${i}' &&
    ln -s '$f' 'in_${i}/${name}' &&
#end for
seqfu stats -b
    --threads "\${GALAXY_SLOTS:-1}"
    $gc
    $thousands
    #if $multiqc
        --multiqc '$output_multiqc'
    #end if
    #for $i, $f in enumerate($input)
        #set $name = re.sub('[^\w\-\.]', '_', str($f.element_identifier))
        'in_${i}/${name}'
    #end for
    > '$output'
    ]]></command>
    <inputs>
        <param name="input" type="data" format="fasta,fasta.gz,fastqsanger,fastqsanger.gz" multiple="true" label="Sequence datasets"/>
        <param argument="--gc" type="boolean" truevalue="--gc" falsevalue="" checked="true" label="Calculate GC content" help="Print %GC column"/>
        <param argument="--thousands" type="boolean" truevalue="--thousands" falsevalue="" checked="false" label="Add thousands separator" help="Format counts with comma separator"/>
        <param argument="--multiqc" type="boolean" truevalue="true" falsevalue="false" checked="false" label="Generate MultiQC report" help="Emit a MultiQC-compatible custom content table"/>
    </inputs>
    <outputs>
        <data name="output" format="tabular" label="${tool.name} on ${on_string}: statistics report"/>
        <data name="output_multiqc" format="tabular" label="${tool.name} on ${on_string}: MultiQC report">
            <filter>multiqc</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="input" value="fq.fastq.gz" ftype="fastqsanger.gz"/>
            <param name="gc" value="true"/>
            <param name="thousands" value="false"/>
            <param name="multiqc" value="false"/>
            <output name="output" file="seqfu_stats_se.tsv" ftype="tabular"/>
        </test>
        <test expect_num_outputs="2">
            <param name="input" value="fq.fastq.gz" ftype="fastqsanger.gz"/>
            <param name="gc" value="true"/>
            <param name="thousands" value="false"/>
            <param name="multiqc" value="true"/>
            <output name="output" file="seqfu_stats_se.tsv" ftype="tabular"/>
            <output name="output_multiqc">
                <assert_contents>
                    <has_text text="section_name: 'SeqFu stats'"/>
                    <has_text text="Sample&#009;col1&#009;col2"/>
                    <has_text text="fq&#009;3&#009;360"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="fq_1.fastq.gz,fq_1.fastq.gz" ftype="fastqsanger.gz"/>
            <param name="gc" value="true"/>
            <param name="thousands" value="false"/>
            <param name="multiqc" value="false"/>
            <output name="output" file="seqfu_stats_multi.tsv" ftype="tabular"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
# SeqFu stats

Calculate sequence length statistics (number of sequences, total bases,
average length, N50, N75, N90, auN, min/max length, and GC%) on FASTA or
FASTQ files.

Output
------

A tabular summary with statistics for each input file.

If **Generate MultiQC report** is enabled, an additional MultiQC custom
content table is produced. It can be passed directly to the Galaxy
**MultiQC** tool: add it under *Custom Content* (plot type `table`), where
it will appear as a `SeqFu stats` section in the report.

[SeqFu repository](https://github.com/telatin/seqfu2)
    ]]></help>
    <expand macro="citations"/>
</tool>
