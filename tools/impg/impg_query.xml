<tool id="impg_query" name="impg query" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>project ranges through pairwise alignments</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
@SETUP_ALIGNMENTS@
#set $sequence_files = $seq_output.sequence_files
@SETUP_SEQUENCE_FILES@
impg query
    @ALIGNMENT_ARGS@
    #if str($query_region.mode) == "single"
        -r '$query_region.target_range'
    #else
        -b '$query_region.target_bed'
    #end if
    @CMD_MERGE_DISTANCE@
    -o $output_format
    #if $sequence_files
        @SEQUENCE_FILE_ARGS@
    #end if
    #if str($output_format) in ["gfa", "maf", "vcf"]
        --gfa-engine $seq_output.gfa_engine
    #end if
    #if str($output_format) == "fasta"
        $seq_output.reverse_complement
    #end if
    $seq_output.force_large_region
    $seq_output.approximate
    @CMD_TRANSITIVE@
    @CMD_INDEX_OPTS@
    #if str($coords.original_sequence_coordinates) == "true"
        --original-sequence-coordinates
    #end if
    @THREADS@
    > '$output'
    ]]></command>
    <inputs>
        <expand macro="alignment_input"/>
        <expand macro="target_region_conditional"/>
        <expand macro="merge_distance_param"/>
        <param name="output_format" type="select" label="Output format" help="Projected homologous intervals. Graph/sequence formats (gfa, maf, vcf, fasta) require sequence files below.">
            <option value="bed" selected="true">bed — merged homologous intervals</option>
            <option value="bedpe">bedpe — paired query/result intervals</option>
            <option value="paf">paf — PAF-like projected matches</option>
            <option value="fasta">fasta — sequences for query-selected intervals</option>
            <option value="gfa">gfa — local sequence graph (poa engine)</option>
            <option value="maf">maf — multiple alignment (poa engine)</option>
            <option value="vcf">vcf — variant calls from the local graph (poa engine)</option>
        </param>
        <section name="seq_output" title="Sequence / graph output" expanded="false">
            <expand macro="sequence_files_param"/>
            <param name="gfa_engine" type="select" label="GFA engine" help="Engine used for gfa, maf, and vcf output. 'poa' is bundled with impg; 'seqwish' and 'pggb' additionally require seqwish/smoothxg/gfaffix in the environment.">
                <option value="poa" selected="true">poa (built-in, single-pass SPOA)</option>
                <option value="seqwish">seqwish (sweepga + seqwish; needs seqwish)</option>
                <option value="pggb">pggb (sweepga + seqwish + smoothxg; needs pggb stack)</option>
            </param>
            <param argument="--reverse-complement" type="boolean" truevalue="--reverse-complement" falsevalue="" checked="false" label="Reverse-complement reverse-strand sequences" help="Applies to fasta output: reverse-complement sequences gathered from the reverse strand."/>
            <param argument="--force-large-region" type="boolean" truevalue="--force-large-region" falsevalue="" checked="false" label="Force large-region processing" help="Force processing of regions &gt;10 kb with maf/gfa output formats (disabled by default to avoid very long runtimes)."/>
            <param argument="--approximate" type="boolean" truevalue="--approximate" falsevalue="" checked="false" label="Approximate mode" help="Faster queries for tracepoint files (.1aln/.tpa); only bed/bedpe output. Ignored for plain PAF."/>
        </section>
        <expand macro="transitive_section"/>
        <expand macro="filtering_section"/>
        <expand macro="coordinate_options_section"/>
        <expand macro="advanced_index_section"/>
    </inputs>
    <outputs>
        <data name="output" format="bed" label="${tool.name} on ${on_string}: projected intervals">
            <change_format>
                <when input="output_format" value="bedpe" format="tabular"/>
                <when input="output_format" value="paf" format="paf"/>
                <when input="output_format" value="fasta" format="fasta"/>
                <when input="output_format" value="gfa" format="gfa1"/>
                <when input="output_format" value="maf" format="maf"/>
                <when input="output_format" value="vcf" format="vcf"/>
            </change_format>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="alignment" value="pan.paf" ftype="paf"/>
            <conditional name="query_region">
                <param name="mode" value="single"/>
                <param name="target_range" value="S288C#1#chrI:500-1500"/>
            </conditional>
            <param name="merge_distance" value="100"/>
            <param name="output_format" value="bed"/>
            <output name="output" file="impg_query_bed.bed" ftype="bed" compare="diff"/>
        </test>
        <test expect_num_outputs="1">
            <param name="alignment" value="pan.paf" ftype="paf"/>
            <conditional name="query_region">
                <param name="mode" value="single"/>
                <param name="target_range" value="S288C#1#chrI:500-1500"/>
            </conditional>
            <param name="merge_distance" value="100"/>
            <param name="output_format" value="paf"/>
            <output name="output" file="impg_query_paf.paf" ftype="paf" compare="diff"/>
        </test>
        <test expect_num_outputs="1">
            <param name="alignment" value="pan.paf" ftype="paf"/>
            <conditional name="query_region">
                <param name="mode" value="single"/>
                <param name="target_range" value="S288C#1#chrI:500-1500"/>
            </conditional>
            <param name="merge_distance" value="100"/>
            <param name="output_format" value="bedpe"/>
            <output name="output" file="impg_query_bedpe.bedpe" ftype="tabular" compare="diff"/>
        </test>
        <test expect_num_outputs="1">
            <param name="alignment" value="pan.paf" ftype="paf"/>
            <conditional name="query_region">
                <param name="mode" value="single"/>
                <param name="target_range" value="S288C#1#chrI:500-1500"/>
            </conditional>
            <param name="merge_distance" value="100"/>
            <param name="output_format" value="fasta"/>
            <section name="seq_output">
                <param name="sequence_files" value="pan.fa" ftype="fasta"/>
            </section>
            <output name="output" file="impg_query_fasta.fa" ftype="fasta" compare="diff"/>
        </test>
        <test expect_num_outputs="1">
            <param name="alignment" value="pan.paf" ftype="paf"/>
            <conditional name="query_region">
                <param name="mode" value="single"/>
                <param name="target_range" value="S288C#1#chrI:500-1500"/>
            </conditional>
            <param name="merge_distance" value="100"/>
            <param name="output_format" value="gfa"/>
            <section name="seq_output">
                <param name="gfa_engine" value="poa"/>
                <param name="sequence_files" value="pan.fa" ftype="fasta"/>
            </section>
            <output name="output" ftype="gfa1">
                <assert_contents>
                    <has_line_matching expression="^H\tVN:Z:1\.\d"/>
                    <has_line_matching expression="^S\t.+"/>
                    <has_line_matching expression="^L\t.+"/>
                    <has_line_matching expression="^P\t.+"/>
                    <has_size min="1000"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="alignment" value="pan.paf" ftype="paf"/>
            <conditional name="query_region">
                <param name="mode" value="single"/>
                <param name="target_range" value="S288C#1#chrI:500-1500"/>
            </conditional>
            <param name="merge_distance" value="100"/>
            <param name="output_format" value="maf"/>
            <section name="seq_output">
                <param name="gfa_engine" value="poa"/>
                <param name="sequence_files" value="pan.fa" ftype="fasta"/>
            </section>
            <output name="output" file="impg_query_maf.maf" ftype="maf" compare="diff"/>
        </test>
        <test expect_num_outputs="1">
            <param name="alignment" value="pan.paf" ftype="paf"/>
            <conditional name="query_region">
                <param name="mode" value="single"/>
                <param name="target_range" value="S288C#1#chrI:500-1500"/>
            </conditional>
            <param name="merge_distance" value="100"/>
            <param name="output_format" value="vcf"/>
            <section name="seq_output">
                <param name="gfa_engine" value="poa"/>
                <param name="sequence_files" value="pan.fa" ftype="fasta"/>
            </section>
            <output name="output" ftype="vcf">
                <assert_contents>
                    <has_line_matching expression="##fileformat=VCFv4\.2"/>
                    <has_line_matching expression="##contig=&lt;ID=S288C#1#chrI:500-1500,length=1000&gt;"/>
                    <has_line_matching expression="#CHROM\tPOS\tID\tREF\tALT\tQUAL\tFILTER\tINFO\tFORMAT\tDBVPG6044\tS288C\tSK1"/>
                    <has_line_matching expression="S288C#1#chrI:500-1500\t58\t&gt;2&gt;5\tA\tC\t60\tPASS\tAC=1;.*"/>
                    <has_line_matching expression="S288C#1#chrI:500-1500\t182\t&gt;9&gt;12\tC\tA\t60\tPASS\tAC=1;.*"/>
                    <has_line_matching expression="S288C#1#chrI:500-1500\t799\t&gt;35&gt;38\tT\tG\t60\tPASS\tAC=1;.*"/>
                    <has_line_matching expression="S288C#1#chrI:500-1500\t964\t&gt;50&gt;53\tT\tG\t60\tPASS\tAC=1;.*"/>
                    <has_n_lines n="33"/>
                    <has_size min="4000" max="6000"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="alignment" value="pan.paf" ftype="paf"/>
            <conditional name="query_region">
                <param name="mode" value="single"/>
                <param name="target_range" value="S288C#1#chrI:500-1500"/>
            </conditional>
            <param name="merge_distance" value="100"/>
            <param name="output_format" value="bed"/>
            <section name="transitive">
                <param name="transitive" value="true"/>
            </section>
            <output name="output" file="impg_query_bed_trans.bed" ftype="bed" compare="diff"/>
            <assert_command>
                <has_text text="--transitive"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <param name="alignment" value="pan.paf" ftype="paf"/>
            <conditional name="query_region">
                <param name="mode" value="bed"/>
                <param name="target_bed" value="regions.bed" ftype="bed"/>
            </conditional>
            <param name="merge_distance" value="100"/>
            <param name="output_format" value="bed"/>
            <output name="output" file="impg_query_bed_b.bed" ftype="bed" compare="diff"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**impg query** — project a range through pairwise alignments

`impg` treats all-vs-all pairwise alignments as an *implicit pangenome
graph* and lifts a target range from the reference of an alignment into
every homologous sequence aligned onto it. The result is ready to feed
FASTA extraction, multiple sequence alignment, or a graph builder such
as `pggb` or `minigraph-cactus`.

-----

**Input**

- One or more PAF files (optionally bgzipped). PAF must use `=`/`X` CIGAR
  ops (from `wfmash` or `minimap2 --eqx`).
- A **target range** (`seq_name:start-end`) or a **BED file** of regions.
  The range split is on the *last* colon; names that already contain
  coordinates need an explicit trailing sub-range.
- **Merge distance** (required): merge gathered ranges separated by at
  most this many bp. Also the largest internal gap/SV one query hop can
  absorb. Accepts k/m/g suffixes.

**Output formats**

| Format | Description |
|--------|-------------|
| `bed`  | merged homologous intervals |
| `bedpe`| paired query/result intervals |
| `paf`  | PAF-like projected matches |
| `fasta`| sequences for query-selected intervals |
| `gfa`  | local sequence graph (poa engine) |
| `maf`  | multiple alignment (poa engine) |
| `vcf`  | variant calls from the local graph (poa engine) |

`fasta`, `gfa`, `maf`, and `vcf` require **sequence files**. The `poa`
GFA engine is bundled with impg; `seqwish`/`pggb` engines additionally
require those tools in the environment.

**Key options**

- **Walk transitive closure**: recursively find everything aligned to
  the initial result (`-x`), bounded by **Max recursion depth**.
- **Min result identity**: gap-compressed identity filter on results.
- **Subset sequence list**: restrict results to a whitelist of sequence
  names.
- **Use original-sequence coordinates**: re-map coordinates to the
  original sequences when inputs are subsequences named
  `seq_name:start-end`.
    ]]></help>
    <expand macro="citations"/>
</tool>
