<tool id="fasta_to_dbkey" name="Get dbkey from cached genome" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="20.01" license="MIT">
    <description></description>
    <macros>
        <token name="@TOOL_VERSION@">0.1.0</token>
        <token name="@VERSION_SUFFIX@">0</token>
    </macros>
    <!-- I put data management but I am not sure it is the good one -->
    <edam_topics>
        <edam_topic>topic_3071</edam_topic>
    </edam_topics>
    <!-- I put query retrieval -->
    <edam_operations>
        <edam_operation>operation_0224</edam_operation>
    </edam_operations>
    <command detect_errors="exit_code"><![CDATA[
    
    echo "$all_fasta_value.fields.dbkey" > '$output'
]]></command>
    <inputs>
        <param name="all_fasta_value" type="select" label="Cached genome">
            <options from_data_table="all_fasta"/>
        </param>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="dbkey of ${all_fasta_value}" />
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="all_fasta_value" value="fasta_value"/>
            <output name="output">
                <assert_contents>
                    <has_line line="fasta_dbkey"/>
                    <has_n_lines n="1"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[

.. class:: infomark

This tools gives the `dbkey` value of the `all_fasta` table for a given `value`.

    ]]></help>
</tool>