<tool name="Combine boolean parameters" id="combine_boolean_params" version="0.1.0" profile="@PROFILE@" tool_type="expression">
    <description>with AND, OR, XOR and more</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expression type="ecma5.1"><![CDATA[{
var policy = $job.null_handling;
var total = $job.booleans.length;
var nTrue = 0;
for (var i = 0; i < total; i++) {
    var value = $job.booleans[i].value;
    if (value === null || value === undefined) {
        if (policy == "fail") {
            return { __error_message: "Boolean " + (i + 1) + " is unset (null). Connect a value, or choose how unset inputs are treated." };
        }
        value = policy == "true";
    }
    if (value) {
        nTrue++;
    }
}
var result;
switch ($job.operator) {
    case "and": result = nTrue == total; break;
    case "or": result = nTrue > 0; break;
    case "nand": result = nTrue < total; break;
    case "nor": result = nTrue == 0; break;
    case "xor": result = nTrue % 2 == 1; break;
    case "exactly_one": result = nTrue == 1; break;
    case "all_equal": result = nTrue == 0 || nTrue == total; break;
    default: return { __error_message: "Unknown operator: " + $job.operator };
}
return { output: result };
}]]></expression>
    <inputs>
        <repeat name="booleans" title="Boolean" min="2">
            <param name="value" type="boolean" optional="true" label="Boolean value"/>
        </repeat>
        <param name="operator" type="select" label="Operator">
            <option value="and" selected="true">AND: all inputs are true</option>
            <option value="or">OR: at least one input is true</option>
            <option value="nand">NAND: at least one input is false (not all true)</option>
            <option value="nor">NOR: no input is true (all false)</option>
            <option value="xor">XOR: an odd number of inputs are true (for two inputs: exactly one)</option>
            <option value="exactly_one">Exactly one input is true</option>
            <option value="all_equal">All equal: all inputs are true or all are false (XNOR for two inputs)</option>
        </param>
        <expand macro="null_handling" label="If an input is unset (null)" help="Treat unset inputs as true to ignore them for AND; treat them as false to ignore them for OR."
            false_label="Treat as false" true_label="Treat as true"/>
    </inputs>
    <expand macro="boolean_output"/>
    <tests>
