<tool id="fair_bioheaders_combine" name="FAIR-bioHeaders combine" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="MIT">
    <description>add a metadata header to FASTA, GFA or GFF3</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="edam_topics"/>
    <edam_operations>
        <edam_operation>operation_0335</edam_operation>
    </edam_operations>
    <expand macro="xrefs"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SET_TYPE@
## bioheaders reads the metadata format from the file extension.
#set $metadata_name = 'metadata.' + $base_type($metadata)
ln -s '$metadata' '$metadata_name' &&
#if $compressed
    #set $out = 'combined.' + $type + '.gz'
#else
    #set $out = 'combined.' + $type
#end if
bioheaders combine --type '$type' -o '$out' '$metadata_name' '$input' &&
mv '$out' '$output'
    ]]></command>
    <inputs>
        <param name="metadata" type="data" format="@METADATA_FORMATS@" label="Metadata"
            help="FHR, FHP or FHGFF3 metadata in YAML, JSON or JSON-LD. Any checksum it contains is replaced."/>
        <param name="input" type="data" format="@HEADED_FORMATS@" label="Data file"
            help="FASTA (nucleotide or protein), GFA or GFF3, plain or gzip-compressed. An existing header is replaced."/>
    </inputs>
    <outputs>
        <data name="output" format_source="input" label="${tool.name} on ${on_string}"/>
    </outputs>
    <tests>
        <!-- 1: YAML metadata and FASTA give the toolkit's example file -->
        <test expect_num_outputs="1">
            <param name="metadata" value="example.fhr.yaml" ftype="yaml"/>
            <param name="input" value="genome.fasta" ftype="fasta"/>
            <output name="output" file="example.fhr.fasta" ftype="fasta"/>
        </test>
        <!-- 2: JSON metadata give the same header -->
        <test expect_num_outputs="1">
            <param name="metadata" value="example.fhr.json" ftype="json"/>
            <param name="input" value="genome.fasta" ftype="fasta"/>
            <output name="output" file="example.fhr.fasta" ftype="fasta"/>
        </test>
        <!-- 3: JSON-LD metadata give the same header -->
        <test expect_num_outputs="1">
            <param name="metadata" value="example.fhr.jsonld" ftype="jsonld"/>
            <param name="input" value="genome.fasta" ftype="fasta"/>
            <output name="output" file="example.fhr.fasta" ftype="fasta"/>
        </test>
        <!-- 4: a header that is already present is replaced, giving the same file -->
        <test expect_num_outputs="1">
            <param name="metadata" value="example.fhr.yaml" ftype="yaml"/>
            <param name="input" value="example.fhr.fasta" ftype="fasta"/>
            <output name="output" file="example.fhr.fasta" ftype="fasta"/>
        </test>
        <!-- 5: gzip FASTA gives compressed FASTA -->
        <test expect_num_outputs="1">
            <param name="metadata" value="example.fhr.yaml" ftype="yaml"/>
            <param name="input" value="genome.fasta.gz" ftype="fasta.gz"/>
            <!-- byte-for-byte: the toolkit's BGZF output is deterministic -->
            <output name="output" file="example.fhr.fasta.bgzf.gz" ftype="fasta.gz"/>
        </test>
        <!-- 6: GFA -->
        <test expect_num_outputs="1">
            <param name="metadata" value="example.fhr.yaml" ftype="yaml"/>
            <param name="input" value="graph.gfa" ftype="gfa1"/>
            <output name="output" file="example.fhr.gfa" ftype="gfa1"/>
        </test>
        <!-- 7: GFF3 with FHGFF3 metadata -->
        <test expect_num_outputs="1">
            <param name="metadata" value="annotation.fhgff3.yaml" ftype="yaml"/>
            <param name="input" value="annotation.gff3" ftype="gff3"/>
            <output name="output" file="annotation.fhgff3.gff3" ftype="gff3"/>
        </test>
        <!-- 8: GFA2 -->
        <test expect_num_outputs="1">
            <param name="metadata" value="example.fhr.yaml" ftype="yaml"/>
            <param name="input" value="graph2.gfa" ftype="gfa2"/>
            <output name="output" file="example.fhr2.gfa" ftype="gfa2"/>
        </test>
        <!-- 9: protein FASTA with FHP metadata -->
        <test expect_num_outputs="1">
            <param name="metadata" value="example.fhp.yaml" ftype="yaml"/>
            <param name="input" value="protein.fasta" ftype="fasta"/>
            <output name="output" file="example.fhp.fasta" ftype="fasta"/>
        </test>
        <!-- 10: datatypes derived from json and fasta are read as JSON and FASTA -->
        <test expect_num_outputs="1">
            <param name="metadata" value="example.fhr.json" ftype="freq.json"/>
            <param name="input" value="genome.fasta" ftype="a3m"/>
            <output name="output" file="example.fhr.fasta" ftype="a3m"/>
        </test>
        <!-- 11: invalid metadata (an FHGFF3 header without a genome link) fail the job -->
        <test expect_failure="true">
            <param name="metadata" value="header-invalid.yaml" ftype="yaml"/>
            <param name="input" value="annotation.gff3" ftype="gff3"/>
            <assert_stderr>
                <has_text text="no genome link"/>
            </assert_stderr>
        </test>
    </tests>
    <help><![CDATA[
.. class:: infomark

**What it does**

Adds a FAIR-bioHeaders metadata header to a FASTA, GFA or GFF3 file and
calculates its checksum, using the fair-bioheaders_ toolkit
(``bioheaders combine``). The data lines are copied unchanged.

@HEADER_HELP@

-----

**Input**

- **Metadata** in YAML, JSON or JSON-LD: FHR for a genome assembly (FASTA or
  GFA), FHP for a protein FASTA, FHGFF3 for a GFF3 annotation. See the
  specification for the fields, and the `examples`_. Leave out the checksum: it is
  calculated, and any checksum in the metadata is replaced.
- **Data file**: FASTA, GFA or GFF3, plain or gzip-compressed. If it already
  has a header, the header is replaced.

The metadata are validated against the schema first; the job fails, with the
reason in its standard error, if they are invalid.

**Output**

The data file with the header, in the same datatype. Check it with the
**FAIR-bioHeaders verify** tool.

@GALAXY_HELP@

.. _examples: https://github.com/FAIR-bioHeaders/FAIR-bioHeaders-Tools/tree/main/examples
@LINKS@
    ]]></help>
    <expand macro="citations"/>
    <expand macro="creator"/>
</tool>
