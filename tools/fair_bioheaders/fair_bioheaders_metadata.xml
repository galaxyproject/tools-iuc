<tool id="fair_bioheaders_metadata" name="FAIR-bioHeaders metadata" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="MIT">
    <description>write FHR metadata for a genome assembly</description>
    <macros>
        <import>macros.xml</import>
        <!-- Text values reach bioheaders unchanged (not sanitized). What keeps
             the shell safe is the quoting: the command passes every value as
             option=$q(value), one shell word in single quotes, each ' written as
             '\'', joined to its option name by = so that a value starting with -
             is never read as an option. The validators only report bad values
             early (they may not run for values connected in a workflow).
             bioheaders refuses control and line-break characters itself, but
             Galaxy turns line breaks in the command into spaces, so $q writes
             them as U+2028, which bioheaders refuses too. -->
        <xml name="text_checks">
            <sanitizer sanitize="false"/>
            <validator type="regex" message="Line breaks and other control characters are not allowed">^[^\x00-\x08\x0a-\x1f\x7f-\x9f  ]*\Z</validator>
        </xml>
        <xml name="required_text" tokens="name,label,help">
            <param name="@NAME@" type="text" optional="false" label="@LABEL@" help="@HELP@">
                <expand macro="text_checks"/>
                <validator type="empty_field"/>
                <validator type="regex" message="Enter a value, not only spaces">(?s).*\S</validator>
            </param>
        </xml>
        <xml name="optional_text" tokens="name,label,help">
            <param name="@NAME@" type="text" optional="true" label="@LABEL@" help="@HELP@">
                <expand macro="text_checks"/>
            </param>
        </xml>
        <xml name="text_repeat" tokens="name,title,label,help">
            <repeat name="@NAME@" title="@TITLE@">
                <expand macro="required_text" name="value" label="@LABEL@" help="@HELP@"/>
            </repeat>
        </xml>
        <xml name="authors" tokens="name,title">
            <repeat name="@NAME@" title="@TITLE@" min="1">
                <param name="name" type="text" optional="false" label="Name" help="For example Jane Doe or a consortium name">
                    <expand macro="text_checks"/>
                    <validator type="empty_field"/>
                    <validator type="regex" message="The name cannot contain &lt; or &gt;">^[^&lt;&gt;]*\Z</validator>
                </param>
                <param name="orcid" type="text" optional="true" label="ORCID URI" help="Optional, for example https://orcid.org/0000-0002-1825-0097">
                    <expand macro="text_checks"/>
                    <validator type="regex" message="Write the ORCID as https://orcid.org/XXXX-XXXX-XXXX-XXXX">^https://orcid\.org/[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]\Z</validator>
                </param>
            </repeat>
        </xml>
        <token name="@QUOTE@"><![CDATA[
#def q($value)
#return "'" + str($value).replace("\r", "\u2028").replace("\n", "\u2028").replace("'", "'\\''") + "'"
#end def
        ]]></token>
    </macros>
    <expand macro="edam_topics"/>
    <edam_operations>
        <edam_operation>operation_0335</edam_operation>
        <edam_operation>operation_0236</edam_operation>
    </edam_operations>
    <expand macro="xrefs"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@QUOTE@
## NAME=VERSION=URI cannot hold = in the name or version.
#for $item in $optional_fields.assembly_software
    #if '=' in str($item.name) or ($item.software_version and '=' in str($item.software_version))
        echo 'Assembly software: the name and version cannot contain =' >&2 && exit 1 &&
    #end if
#end for
bioheaders metadata
    --genome=$q($genome)
    #for $item in $genome_synonyms
        --genome-synonym=$q($item.value)
    #end for
    --taxon-name=$q($taxon_name)
    --taxon-id=$q($taxon_id)
    --version=$q($assembly_version)
    #for $item in $metadata_authors
        #if $item.orcid
            --metadata-author=$q(str($item.name) + ' <' + str($item.orcid) + '>')
        #else
            --metadata-author=$q($item.name)
        #end if
    #end for
    #for $item in $assembly_authors
        #if $item.orcid
            --assembly-author=$q(str($item.name) + ' <' + str($item.orcid) + '>')
        #else
            --assembly-author=$q($item.name)
        #end if
    #end for
    --date-created=$q($date_created)
    --masking=$q($masking)
    #for $item in $optional_fields.instruments
        --instrument=$q($item.value)
    #end for
    #for $item in $optional_fields.assembly_software
        #set $spec = str($item.name)
        #if $item.uri
            #set $spec = $spec + '=' + (str($item.software_version) if $item.software_version else '') + '=' + str($item.uri)
        #elif $item.software_version
            #set $spec = $spec + '=' + str($item.software_version)
        #end if
        --assembly-software=$q($spec)
    #end for
    #if $optional_fields.assembly_protocol
        --assembly-protocol=$q($optional_fields.assembly_protocol)
    #end if
    #if $optional_fields.documentation
        --documentation=$q($optional_fields.documentation)
    #end if
    #if $optional_fields.accession
        --accession=$q($optional_fields.accession)
    #end if
    #if $optional_fields.accession_url
        --accession-url=$q($optional_fields.accession_url)
    #end if
    #for $item in $optional_fields.identifiers
        --identifier=$q($item.value)
    #end for
    #if $optional_fields.reuse_conditions
        --reuse-conditions=$q($optional_fields.reuse_conditions)
    #end if
    #for $item in $optional_fields.related_links
        --related-link=$q($item.value)
    #end for
    #if $optional_fields.voucher_specimen
        --voucher-specimen=$q($optional_fields.voucher_specimen)
    #end if
    #if $optional_fields.scholarly_article
        --scholarly-article=$q($optional_fields.scholarly_article)
    #end if
    #if $optional_fields.funding
        --funding=$q($optional_fields.funding)
    #end if
    #if $optional_fields.seqcol_id
        --seqcol-id=$q($optional_fields.seqcol_id)
    #end if
    #if $statistics.compute == 'yes'
        --stats-from=$q($statistics.fasta)
    #end if
    #for $item in $optional_fields.stats
        --stat=$q(str($item.key) + '=' + str($item.value))
    #end for
    #for $item in $optional_fields.extras
        --extra=$q(str($item.key) + '=' + str($item.value))
    #end for
    --format=$q($output_format)
    --output=$q($output)
    ]]></command>
    <inputs>
        <expand macro="required_text" name="genome" label="Genome name" help="Name of the genome assembly, for example a ToLID such as mHomSap1 (genome)"/>
        <expand macro="text_repeat" name="genome_synonyms" title="Genome synonym" label="Genome synonym" help="Another common name of the genome (genomeSynonym)"/>
        <expand macro="required_text" name="taxon_name" label="Taxon name" help="Species name, for example Homo sapiens (taxon.name)"/>
        <param name="taxon_id" type="integer" min="1" optional="false" label="NCBI taxonomy ID" help="For example 9606; written as https://identifiers.org/taxonomy:9606 (taxon.uri)"/>
        <expand macro="required_text" name="assembly_version" label="Assembly version" help="Version of the genome assembly, for example 1 (version)"/>
        <expand macro="authors" name="metadata_authors" title="Metadata author"/>
        <expand macro="authors" name="assembly_authors" title="Assembly author"/>
        <param name="date_created" type="text" optional="false" label="Date created" help="Date the assembly was created, as YYYY-MM-DD; not today's date unless it was created today (dateCreated)">
            <expand macro="text_checks"/>
            <validator type="regex" message="Write the date as YYYY-MM-DD">^[0-9]{4}-[0-9]{2}-[0-9]{2}\Z</validator>
        </param>
        <param name="masking" type="select" label="Masking" help="Masking applied to the assembly (masking). There is no default.">
            <option value="" selected="true">Select the masking</option>
            <option value="not-masked">not masked</option>
            <option value="hard-masked">hard-masked</option>
            <option value="soft-masked">soft-masked</option>
            <option value="repeat-masked">repeat-masked</option>
            <option value="unknown">unknown</option>
            <validator type="expression" message="Select the masking applied to the assembly">value</validator>
        </param>
        <conditional name="statistics">
            <param name="compute" type="select" label="Compute assembly statistics from a FASTA file?" help="Adds vitalStats: total length, scaffold and contig counts, N50, L50, N90, L90 and GC content">
                <option value="no" selected="true">No</option>
                <option value="yes">Yes</option>
            </param>
            <when value="yes">
                <param name="fasta" type="data" format="fasta,fasta.gz" label="Assembly FASTA" help="The assembly the metadata describe, plain or gzip-compressed. A FAIR-bioHeaders header in it is ignored; give a FASTA with a header the fasta datatype by hand."/>
            </when>
            <when value="no"/>
        </conditional>
        <section name="optional_fields" title="Optional fields" expanded="false">
            <expand macro="text_repeat" name="instruments" title="Instrument" label="Instrument" help="Instrument used to create the assembly, for example PacBio Revio (instrument)"/>
            <repeat name="assembly_software" title="Assembly software">
                <param name="name" type="text" optional="false" label="Name" help="For example hifiasm">
                    <expand macro="text_checks"/>
                    <validator type="empty_field"/>
                    <validator type="regex" message="The name cannot contain =">^[^=]*\Z</validator>
                </param>
                <param name="software_version" type="text" optional="true" label="Version" help="For example 0.19.8">
                    <expand macro="text_checks"/>
                    <validator type="regex" message="The version cannot contain =">^[^=]*\Z</validator>
                </param>
                <param name="uri" type="text" optional="true" label="URI" help="For example https://github.com/chhylp123/hifiasm">
                    <expand macro="text_checks"/>
                </param>
            </repeat>
            <expand macro="optional_text" name="assembly_protocol" label="Assembly protocol" help="URI of the assembly protocol or workflow (assemblyProtocol)"/>
            <expand macro="optional_text" name="documentation" label="Documentation" help="Documentation about the genome (documentation)"/>
            <expand macro="optional_text" name="accession" label="Accession" help="For example GCA_000001405.29 (accessionID.name)"/>
            <expand macro="optional_text" name="accession_url" label="Accession URL" help="Needs an accession (accessionID.url)"/>
            <expand macro="text_repeat" name="identifiers" title="Identifier" label="Identifier" help="PREFIX:ACCESSION, for example insdc.gca:GCA_000001405.29 (identifier)"/>
            <expand macro="optional_text" name="reuse_conditions" label="Reuse conditions" help="License and reuse conditions, for example CC0 (reuseConditions)"/>
            <expand macro="text_repeat" name="related_links" title="Related link" label="Related link" help="Related URL (relatedLink)"/>
            <expand macro="optional_text" name="voucher_specimen" label="Voucher specimen" help="Description of the physical sample (voucherSpecimen)"/>
            <expand macro="optional_text" name="scholarly_article" label="Scholarly article" help="DOI without a resolver prefix, for example 10.1093/bib/bbae122 (scholarlyArticle)"/>
            <expand macro="optional_text" name="funding" label="Funding" help="Grant line item (funding)"/>
            <expand macro="optional_text" name="seqcol_id" label="Sequence collection ID" help="GA4GH sequence collection digest (32 characters), if you have one (seqcol_id)"/>
            <repeat name="stats" title="Statistic">
                <param name="key" type="select" label="Field" help="Fields computed from the FASTA cannot also be given here">
                    <option value="readTechnology">readTechnology</option>
                    <option value="totalBasePairs">totalBasePairs</option>
                    <option value="numberContigs">numberContigs</option>
                    <option value="numberScaffolds">numberScaffolds</option>
                    <option value="N50">N50</option>
                    <option value="L50">L50</option>
                    <option value="N90">N90</option>
                    <option value="L90">L90</option>
                    <option value="scaffoldN50">scaffoldN50</option>
                    <option value="scaffoldL50">scaffoldL50</option>
                    <option value="scaffoldN90">scaffoldN90</option>
                    <option value="scaffoldL90">scaffoldL90</option>
                    <option value="gcContent">gcContent</option>
                </param>
                <expand macro="required_text" name="value" label="Value" help="For example hifi for readTechnology, or a number from another statistics tool (vitalStats)"/>
            </repeat>
            <repeat name="extras" title="Extension field">
                <param name="key" type="text" optional="false" label="Key" help="x- followed by a letter or digit, then letters, digits, _, . or -; for example x-project">
                    <validator type="regex" message="Write the key as x- followed by a letter or digit, then letters, digits, _, . or -">^x-[A-Za-z0-9][A-Za-z0-9_.-]*\Z</validator>
                </param>
                <expand macro="required_text" name="value" label="Value" help="Text value"/>
            </repeat>
        </section>
        <param name="output_format" type="select" label="Output format">
            <option value="yaml" selected="true">YAML</option>
            <option value="json">JSON</option>
        </param>
    </inputs>
    <outputs>
        <data name="output" format="yaml" label="${tool.name} on ${genome}">
            <change_format>
                <when input="output_format" value="json" format="json"/>
            </change_format>
        </data>
    </outputs>
    <tests>
        <!-- 1: the required fields only give YAML with no checksum -->
        <test expect_num_outputs="1">
            <param name="genome" value="mTest1"/>
            <param name="taxon_name" value="Homo sapiens"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="1"/>
            <repeat name="metadata_authors">
                <param name="name" value="Jane Doe"/>
                <param name="orcid" value="https://orcid.org/0000-0002-1825-0097"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="Joe Bloggs"/>
            </repeat>
            <param name="date_created" value="2026-01-02"/>
            <param name="masking" value="soft-masked"/>
            <output name="output" ftype="yaml">
                <assert_contents>
                    <has_text text="schema: https://w3id.org/fair-bioheaders/fhr/v"/>
                    <has_line_matching expression="schemaVersion: '[0-9.]+'"/>
                    <has_line line="genome: mTest1"/>
                    <has_line line="taxon:"/>
                    <has_line line="  name: Homo sapiens"/>
                    <has_line line="  uri: https://identifiers.org/taxonomy:9606"/>
                    <has_line line="version: '1'"/>
                    <has_line line="metadataAuthor:"/>
                    <has_line line="- name: Jane Doe"/>
                    <has_line line="  uri: https://orcid.org/0000-0002-1825-0097"/>
                    <has_line line="assemblyAuthor:"/>
                    <has_line line="- name: Joe Bloggs"/>
                    <has_line line="dateCreated: '2026-01-02'"/>
                    <has_line line="masking: soft-masked"/>
                    <not_has_text text="checksum"/>
                    <not_has_text text="vitalStats"/>
                </assert_contents>
            </output>
        </test>
        <!-- 2: every optional field, and statistics from a FASTA (hand-computed:
             scaffolds 14, 8 and 12 bp; contigs 4, 6, 4, 2 and 12 bp) -->
        <test expect_num_outputs="1">
            <param name="genome" value="mTest1"/>
            <repeat name="genome_synonyms">
                <param name="value" value="test genome"/>
            </repeat>
            <repeat name="genome_synonyms">
                <param name="value" value="TG1"/>
            </repeat>
            <param name="taxon_name" value="Homo sapiens"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="2"/>
            <repeat name="metadata_authors">
                <param name="name" value="Jane Doe"/>
                <param name="orcid" value="https://orcid.org/0000-0002-1825-0097"/>
            </repeat>
            <repeat name="metadata_authors">
                <param name="name" value="Joe Bloggs"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="Test Consortium"/>
            </repeat>
            <param name="date_created" value="2026-01-02"/>
            <param name="masking" value="not-masked"/>
            <conditional name="statistics">
                <param name="compute" value="yes"/>
                <param name="fasta" value="scaffolds.fasta" ftype="fasta"/>
            </conditional>
            <section name="optional_fields">
                <repeat name="instruments">
                    <param name="value" value="PacBio Revio"/>
                </repeat>
                <repeat name="assembly_software">
                    <param name="name" value="hifiasm"/>
                    <param name="software_version" value="0.19.8"/>
                    <param name="uri" value="https://github.com/chhylp123/hifiasm"/>
                </repeat>
                <repeat name="assembly_software">
                    <param name="name" value="YaHS"/>
                    <param name="uri" value="https://github.com/c-zhou/yahs"/>
                </repeat>
                <repeat name="assembly_software">
                    <param name="name" value="purge_dups"/>
                    <param name="software_version" value="1.2.6"/>
                </repeat>
                <param name="assembly_protocol" value="https://example.org/protocol"/>
                <param name="documentation" value="A test assembly"/>
                <param name="accession" value="GCA_000001405.29"/>
                <param name="accession_url" value="https://www.ncbi.nlm.nih.gov/datasets/genome/GCA_000001405.29/"/>
                <repeat name="identifiers">
                    <param name="value" value="insdc.gca:GCA_000001405.29"/>
                </repeat>
                <param name="reuse_conditions" value="CC0"/>
                <repeat name="related_links">
                    <param name="value" value="https://example.org/related"/>
                </repeat>
                <param name="voucher_specimen" value="Specimen 42"/>
                <param name="scholarly_article" value="10.1093/bib/bbae122"/>
                <param name="funding" value="Grant 123"/>
                <param name="seqcol_id" value="EiYgJtUfGyad7wf5atL5Ozc6lTSRHzmd"/>
                <repeat name="stats">
                    <param name="key" value="readTechnology"/>
                    <param name="value" value="hifi"/>
                </repeat>
                <repeat name="extras">
                    <param name="key" value="x-project"/>
                    <param name="value" value="Test project"/>
                </repeat>
            </section>
            <output name="output" ftype="yaml">
                <assert_contents>
                    <has_line line="genome: mTest1"/>
                    <has_line line="genomeSynonym:"/>
                    <has_line line="- test genome"/>
                    <has_line line="- TG1"/>
                    <has_line line="version: '2'"/>
                    <has_line line="- name: Joe Bloggs"/>
                    <has_line line="- name: Test Consortium"/>
                    <has_line line="masking: not-masked"/>
                    <has_line line="voucherSpecimen: Specimen 42"/>
                    <has_line line="accessionID:"/>
                    <has_line line="  name: GCA_000001405.29"/>
                    <has_line line="  url: https://www.ncbi.nlm.nih.gov/datasets/genome/GCA_000001405.29/"/>
                    <has_line line="instrument:"/>
                    <has_line line="- PacBio Revio"/>
                    <has_line line="scholarlyArticle: 10.1093/bib/bbae122"/>
                    <has_line line="documentation: A test assembly"/>
                    <has_line line="identifier:"/>
                    <has_line line="- insdc.gca:GCA_000001405.29"/>
                    <has_line line="relatedLink:"/>
                    <has_line line="- https://example.org/related"/>
                    <has_line line="funding: Grant 123"/>
                    <has_line line="reuseConditions: CC0"/>
                    <has_line line="vitalStats:"/>
                    <has_line line="  L50: 2"/>
                    <has_line line="  N50: 6"/>
                    <has_line line="  L90: 4"/>
                    <has_line line="  totalBasePairs: 34"/>
                    <has_line line="  numberContigs: 5"/>
                    <has_line line="  numberScaffolds: 3"/>
                    <has_line line="  readTechnology: hifi"/>
                    <has_line line="  N90: 4"/>
                    <has_line line="  scaffoldN50: 12"/>
                    <has_line line="  scaffoldN90: 8"/>
                    <has_line line="  scaffoldL50: 2"/>
                    <has_line line="  scaffoldL90: 3"/>
                    <has_line line="  gcContent: 32.14"/>
                    <has_line line="assemblySoftware:"/>
                    <has_line line="- name: hifiasm"/>
                    <has_line line="  version: 0.19.8"/>
                    <has_line line="  uri: https://github.com/chhylp123/hifiasm"/>
                    <has_line line="- name: YaHS"/>
                    <has_line line="  uri: https://github.com/c-zhou/yahs"/>
                    <has_line line="- name: purge_dups"/>
                    <has_line line="  version: 1.2.6"/>
                    <has_line line="assemblyProtocol: https://example.org/protocol"/>
                    <has_line line="seqcol_id: EiYgJtUfGyad7wf5atL5Ozc6lTSRHzmd"/>
                    <has_line line="x-project: Test project"/>
                    <not_has_text text="checksum"/>
                </assert_contents>
            </output>
        </test>
        <!-- 3: JSON output, statistics from gzip-compressed FASTA -->
        <test expect_num_outputs="1">
            <param name="genome" value="mTest1"/>
            <param name="taxon_name" value="Homo sapiens"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="1"/>
            <repeat name="metadata_authors">
                <param name="name" value="Jane Doe"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="Joe Bloggs"/>
            </repeat>
            <param name="date_created" value="2026-01-02"/>
            <param name="masking" value="unknown"/>
            <conditional name="statistics">
                <param name="compute" value="yes"/>
                <param name="fasta" value="genome.fasta.gz" ftype="fasta.gz"/>
            </conditional>
            <param name="output_format" value="json"/>
            <output name="output" ftype="json">
                <assert_contents>
                    <has_json_property_with_value property="genome" value="&quot;mTest1&quot;"/>
                    <has_json_property_with_value property="masking" value="&quot;unknown&quot;"/>
                    <has_json_property_with_value property="dateCreated" value="&quot;2026-01-02&quot;"/>
                    <has_json_property_with_value property="totalBasePairs" value="16"/>
                    <has_json_property_with_value property="gcContent" value="37.5"/>
                    <not_has_text text="checksum"/>
                </assert_contents>
            </output>
        </test>
        <!-- 4: a required field left empty is refused before the job runs -->
        <test expect_failure="true">
            <param name="genome" value="mTest1"/>
            <param name="taxon_name" value="Homo sapiens"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="1"/>
            <repeat name="metadata_authors">
                <param name="name" value="Jane Doe"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="Joe Bloggs"/>
            </repeat>
            <param name="masking" value="unknown"/>
        </test>
        <!-- 5: no masking selected is refused before the job runs (there is no default) -->
        <test expect_failure="true">
            <param name="genome" value="mTest1"/>
            <param name="taxon_name" value="Homo sapiens"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="1"/>
            <repeat name="metadata_authors">
                <param name="name" value="Jane Doe"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="Joe Bloggs"/>
            </repeat>
            <param name="date_created" value="2026-01-02"/>
        </test>
        <!-- 6: a value bioheaders refuses fails the job with the reason -->
        <test expect_failure="true">
            <param name="genome" value="mTest1"/>
            <param name="taxon_name" value="Homo sapiens"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="1"/>
            <repeat name="metadata_authors">
                <param name="name" value="Jane Doe"/>
                <param name="orcid" value="https://orcid.org/0000-0002-1825-0098"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="Joe Bloggs"/>
            </repeat>
            <param name="date_created" value="2026-01-02"/>
            <param name="masking" value="unknown"/>
            <assert_stderr>
                <has_text text="check digit"/>
            </assert_stderr>
        </test>
        <!-- 7: an impossible date fails the job -->
        <test expect_failure="true">
            <param name="genome" value="mTest1"/>
            <param name="taxon_name" value="Homo sapiens"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="1"/>
            <repeat name="metadata_authors">
                <param name="name" value="Jane Doe"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="Joe Bloggs"/>
            </repeat>
            <param name="date_created" value="2026-02-30"/>
            <param name="masking" value="unknown"/>
            <assert_stderr>
                <has_text text="is not a date"/>
            </assert_stderr>
        </test>
        <!-- 8: statistics from a FASTA with a FAIR-bioHeaders header ignore the header -->
        <test expect_num_outputs="1">
            <param name="genome" value="mTest1"/>
            <param name="taxon_name" value="Homo sapiens"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="1"/>
            <repeat name="metadata_authors">
                <param name="name" value="Jane Doe"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="Joe Bloggs"/>
            </repeat>
            <param name="date_created" value="2026-01-02"/>
            <param name="masking" value="unknown"/>
            <conditional name="statistics">
                <param name="compute" value="yes"/>
                <param name="fasta" value="example.fhr.fasta" ftype="fasta"/>
            </conditional>
            <output name="output" ftype="yaml">
                <assert_contents>
                    <has_line line="  totalBasePairs: 16"/>
                    <has_line line="  numberScaffolds: 1"/>
                    <has_line line="  gcContent: 37.5"/>
                </assert_contents>
            </output>
        </test>
        <!-- 9: a statistic given and also computed fails the job -->
        <test expect_failure="true">
            <param name="genome" value="mTest1"/>
            <param name="taxon_name" value="Homo sapiens"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="1"/>
            <repeat name="metadata_authors">
                <param name="name" value="Jane Doe"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="Joe Bloggs"/>
            </repeat>
            <param name="date_created" value="2026-01-02"/>
            <param name="masking" value="unknown"/>
            <conditional name="statistics">
                <param name="compute" value="yes"/>
                <param name="fasta" value="scaffolds.fasta" ftype="fasta"/>
            </conditional>
            <section name="optional_fields">
                <repeat name="stats">
                    <param name="key" value="N50"/>
                    <param name="value" value="100"/>
                </repeat>
            </section>
            <assert_stderr>
                <has_text text="--stats-from computes this value"/>
            </assert_stderr>
        </test>
        <!-- 10: shell and YAML metacharacters and leading dashes are written unchanged -->
        <test expect_num_outputs="1">
            <param name="genome" value="-x O'Brien &quot;q&quot; $(touch injected) `id` &gt; @ ; | &amp; \ # $HOME * ''"/>
            <param name="taxon_name" value="--help"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="-1"/>
            <repeat name="metadata_authors">
                <param name="name" value="O'Neil '; touch injected; '"/>
                <param name="orcid" value="https://orcid.org/0000-0002-1825-0097"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="-o /tmp/x"/>
            </repeat>
            <param name="date_created" value="2026-01-02"/>
            <param name="masking" value="unknown"/>
            <section name="optional_fields">
                <repeat name="assembly_software">
                    <param name="name" value="tool'$(id)"/>
                    <param name="software_version" value="--version"/>
                    <param name="uri" value="https://example.org/a?b=c=d"/>
                </repeat>
                <param name="funding" value="yes"/>
                <repeat name="extras">
                    <param name="key" value="x-note"/>
                    <param name="value" value="a: b # c"/>
                </repeat>
            </section>
            <param name="output_format" value="json"/>
            <output name="output" ftype="json">
                <assert_contents>
                    <has_text text="&quot;genome&quot;: &quot;-x O'Brien \&quot;q\&quot; $(touch injected) `id` &gt; @ ; | &amp; \\ # $HOME * ''&quot;"/>
                    <has_text text="&quot;name&quot;: &quot;--help&quot;"/>
                    <has_text text="&quot;version&quot;: &quot;-1&quot;"/>
                    <has_text text="&quot;name&quot;: &quot;O'Neil '; touch injected; '&quot;"/>
                    <has_text text="&quot;name&quot;: &quot;-o /tmp/x&quot;"/>
                    <has_text text="&quot;name&quot;: &quot;tool'$(id)&quot;"/>
                    <has_text text="&quot;version&quot;: &quot;--version&quot;"/>
                    <has_text text="&quot;uri&quot;: &quot;https://example.org/a?b=c=d&quot;"/>
                    <has_text text="&quot;funding&quot;: &quot;yes&quot;"/>
                    <has_text text="&quot;x-note&quot;: &quot;a: b # c&quot;"/>
                </assert_contents>
            </output>
        </test>
        <!-- 11: the same in YAML: > and @ are escaped, yes and a: b are quoted -->
        <test expect_num_outputs="1">
            <param name="genome" value="a &gt; b @ c 'd'"/>
            <param name="taxon_name" value="Homo sapiens"/>
            <param name="taxon_id" value="9606"/>
            <param name="assembly_version" value="1"/>
            <repeat name="metadata_authors">
                <param name="name" value="Jane Doe"/>
            </repeat>
            <repeat name="assembly_authors">
                <param name="name" value="Joe Bloggs"/>
            </repeat>
            <param name="date_created" value="2026-01-02"/>
            <param name="masking" value="unknown"/>
            <section name="optional_fields">
                <param name="funding" value="yes"/>
                <param name="documentation" value="a: b"/>
            </section>
            <output name="output" ftype="yaml">
                <assert_contents>
                    <has_line line="genome: &quot;a \x3E b \x40 c 'd'&quot;"/>
                    <has_line line="funding: 'yes'"/>
                    <has_line line="documentation: 'a: b'"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
.. class:: infomark

**What it does**

Writes FAIR-bioHeaders metadata (FHR) for a genome assembly from the values
you enter, using the fair-bioheaders_ toolkit (``bioheaders metadata``). The
metadata are validated against the FHR schema before they are written; the
job fails, with the reason in its standard error, if a value is invalid.

Add the metadata to the assembly with the **FAIR-bioHeaders combine** tool:
give it this tool's output as *Metadata* and the assembly FASTA as *Data file*.
Check the result with **FAIR-bioHeaders verify**.

@HEADER_HELP@

-----

**Input**

- **Required**: genome name, taxon name and NCBI taxonomy ID, assembly
  version, at least one metadata author and one assembly author, the date the
  assembly was created and its masking. Nothing required is filled in for you:
  there is no default date or masking.
- **Authors**: a name and, optionally, an ORCID URI.
- **Statistics** (optional): computed from the assembly FASTA. Every record
  with bases is a scaffold; contigs are split at every run of ``N`` or ``n``;
  ``gcContent`` is 100 * (G + C) / (A + C + G + T + U). Other
  statistics, such as ``readTechnology``, can be entered under *Optional
  fields*.
- **Optional fields**: the other FHR fields, and extension fields whose keys
  start with ``x-``.

**Output**

FHR metadata in YAML (default) or JSON, without a checksum: the checksum
covers the whole data file, so **FAIR-bioHeaders combine** calculates it when
it adds the header. Until then, **FAIR-bioHeaders verify** reports the
checksum as missing.

@LINKS@
    ]]></help>
