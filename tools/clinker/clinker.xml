<tool id="clinker" name="clinker" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="MIT">
    <description>gene cluster comparison</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <xrefs>
        <xref type="bio.tools">clinker</xref>
    </xrefs>
    <expand macro="requirements"/>
    <required_files>
        <include path="prepare_inputs.py"/>
        <include path="sanitize_html.py"/>
    </required_files>
    <version_command>clinker --version</version_command>
    <command detect_errors="aggressive"><![CDATA[
mkdir -p staged &&
python '$__tool_directory__/prepare_inputs.py'
    --input-dir staged
#for $input in $genbank_files
    --genbank '$input' '$input.element_identifier'
#end for
&&
clinker staged/*/*.gbff
    --identity '$identity'
    --jobs "\${GALAXY_SLOTS:-1}"
    $use_file_order
    --plot figure.html
&&
python '$__tool_directory__/sanitize_html.py' --html figure.html
    ]]></command>
    <inputs>
        <param name="genbank_files" type="data_collection" format="genbank" collection_type="list" label="Annotated GenBank/GBFF collection" help="An ordered list collection containing at least two annotated GenBank/GBFF files, one per plasmid. Each element is validated as GenBank before clinker runs."/>
        <param argument="--identity" type="float" min="0" max="1" value="0.3" label="Minimum alignment sequence identity" help="Minimum protein sequence identity for links between genes, as a fraction from 0 to 1, default is 0.3."/>
        <param argument="--use_file_order" type="boolean" truevalue="--use_file_order" falsevalue="" checked="false" label="Keep input collection order" help="Display clusters in the order supplied by the input collection."/>
    </inputs>
    <outputs>
        <data name="plot" format="html" from_work_dir="figure.html"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="genbank_files">
                <collection type="list">
                    <element name="plasmid_Z" value="plasmid_a.gbff" ftype="genbank"/>
                    <element name="plasmid_A" value="plasmid_b.gbff" ftype="genbank"/>
                </collection>
            </param>
            <param name="identity" value="0.8"/>
            <param name="use_file_order" value="true"/>
            <output name="plot">
                <assert_contents>
                    <has_text text="const data="/>
                    <has_text text="plasmid_Z"/>
                    <has_text text="plasmid_A"/>
                    <has_text_matching expression="plasmid_Z.*plasmid_A"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="genbank_files">
                <collection type="list">
                    <element name="first" value="plasmid_a.gbff" ftype="genbank"/>
                    <element name="second" value="plasmid_b.gbff" ftype="genbank"/>
                </collection>
            </param>
            <output name="plot">
                <assert_contents>
                    <has_text text="clustermap"/>
                    <has_text text="first"/>
                    <has_text text="second"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="genbank_files">
                <collection type="list">
                    <element name="generic_alpha" value="generic_alpha.gbff" ftype="genbank"/>
                    <element name="generic_beta" value="generic_beta.gbff" ftype="genbank"/>
                </collection>
            </param>
            <param name="identity" value="0.8"/>
            <output name="plot">
                <assert_contents>
                    <has_text text="const data="/>
                    <has_text text="generic_alpha"/>
                    <has_text text="generic_beta"/>
                    <has_text text="conserved plasmid protein"/>
                </assert_contents>
            </output>
        </test>
        <test expect_failure="true" expect_exit_code="1">
            <param name="genbank_files">
                <collection type="list">
                    <element name="valid" value="plasmid_a.gbff" ftype="genbank"/>
                    <element name="not_genbank" value="invalid_genbank.gbff" ftype="genbank"/>
                </collection>
            </param>
        </test>
        <test expect_failure="true">
            <param name="genbank_files">
                <collection type="list">
                    <element name="only" value="plasmid_a.gbff" ftype="genbank"/>
                </collection>
            </param>
        </test>
        <test expect_num_outputs="1">
            <param name="genbank_files">
                <collection type="list">
                    <element name="safe" value="plasmid_a.gbff" ftype="genbank"/>
                    <element name="malicious" value="malicious_annotation.gbff" ftype="genbank"/>
                </collection>
            </param>
            <output name="plot">
                <assert_contents>
                    <has_text text="const data="/>
                    <not_has_text text="&lt;/script&gt;&lt;script&gt;window.__clinker_xss__=true&lt;/script&gt;"/>
                    <has_text text="\u003c/script\u003e\u003cscript\u003ewindow.__clinker_xss__=true\u003c/script\u003e"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
**What it does**

clinker compares annotated gene clusters or plasmids and creates a standalone,
interactive HTML visualization. It reads GenBank files and aligns the protein
translations of their CDS features.

**Input**

Provide an ordered list collection with at least two annotated GenBank/GBFF
files, one per plasmid. Each input is parsed as GenBank and rejected if it is
not valid annotated GenBank data.

**Parameters**

* **Minimum alignment sequence identity**: a fraction from 0 to 1.
* **Keep input collection order**: pass `--use_file_order` so the visualization
  follows the collection order.

**Output**

The result is a standalone HTML file containing the interactive visualization.
It can be viewed in Galaxy when HTML rendering is enabled by the administrator,
or downloaded and opened locally.

    ]]></help>
    <expand macro="citations"/>
    <creator>
        <person givenName="Casper" familyName="Westergaard" url="https://github.com/CWestergaard" />
    </creator>
</tool>
