<macros>
    <token name="@SALMON_COMMAND@"><![CDATA[
        #if str($repeat.software_cond.input) != "None"
            #set $at_least_one_input="T"
            #for $file in $repeat.software_cond.input
            @ESCAPE_IDENTIFIER@
                #set sample_dir = os.path.join($software_dir, str($identifier))
                mkdir '$sample_dir' &&
                tar -xf '$file' -C '$sample_dir' &&
            #end for
        #end if
    ]]></token>
    <xml name="salmon_form">
        <param argument="input" type="data" format="tar" multiple="true" label="Output of Salmon(tar)" help="Tarball(s) produced by Salmon quant's 'Generate auxiliary files' option."/>
    </xml>
    <!-- add here your test files and tests, the more stringent the better -->
    <!--Test-->
    <xml name="salmon_test">
        <test expect_num_outputs="2">
            <repeat name="results">
                <conditional name="software_cond">
                    <param name="software" value="salmon"/>
                    <param name="input" value="salmon_output_1.tar"/>
                </conditional>
            </repeat>
            <output name="html_report">
                <assert_contents>
                    <has_text text="Salmon"/>
                    <has_text text="General Statistics"/>
                </assert_contents>
            </output>
            <output name="stats">
                <assert_contents>
                    <has_text text="salmon"/>
                </assert_contents>
            </output>
        </test>
    </xml>
</macros>
