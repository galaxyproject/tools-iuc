<macros>
    <token name="@FGBIO_COMMAND@"><![CDATA[
        #for $j, $repeat2 in enumerate( $repeat.software_cond.output )
            @CREATE_REPEAT_DIR_2@
            #if str($repeat2.type.type) == "groupreadsbyumi"
                #set $pattern = "fraction_gt_or_eq_family_size"
                #set $prefix = ""
                #set $suffix = ""
                @LN_3_FILES@
            #elif str($repeat2.type.type) == "errorratebyreadposition"
                #set $pattern = "read_number\tposition\tbases_total\terrors\terror_rate"
                #set $prefix = ""
                #set $suffix = ""
                @LN_3_FILES@
            #end if
        #end for
    ]]></token>
    <xml name="fgbio_form">
        <repeat name="output" title="fgbio output" min="1">
            <conditional name="type">
                <param name="type" type="select" label="Type of fgbio output?">
                    <option value="groupreadsbyumi">GroupReadsByUmi</option>
                    <option value="errorratebyreadposition">ErrorRateByReadPosition</option>
                </param>
                <when value="groupreadsbyumi">
                    <param name="input" type="data" format="txt,tabular,tsv" multiple="true" label="fgbio GroupReadsByUmi output" help="A tab-separated file with a 'family_size' / 'fraction_gt_or_eq_family_size' header" optional="true"/>
                </when>
                <when value="errorratebyreadposition">
                    <param name="input" type="data" format="txt,tabular,tsv" multiple="true" label="fgbio ErrorRateByReadPosition output" help="A tab-separated file starting with 'read_number	position	bases_total ...'" optional="true"/>
                </when>
            </conditional>
        </repeat>
    </xml>
    <xml name="fgbio_test">
        <test expect_num_outputs="3">
            <repeat name="results">
                <conditional name="software_cond">
                    <param name="software" value="fgbio"/>
                    <repeat name="output">
                        <conditional name="type">
                            <param name="type" value="groupreadsbyumi"/>
                            <param name="input" value="fgbio_groupreadsbyumi.txt"/>
                        </conditional>
                    </repeat>
                    <repeat name="output">
                        <conditional name="type">
                            <param name="type" value="errorratebyreadposition"/>
                            <param name="input" value="fgbio_errorratebyreadposition.txt"/>
                        </conditional>
                    </repeat>
                </conditional>
            </repeat>
            <param name="title" value="Title of the report"/>
            <param name="comment" value="Commment for the report"/>
            <param name="flat" value="true"/>
            <param name="export" value="true"/>
            <output name="html_report">
                <assert_contents>
                    <has_text text="Title of the report"/>
                    <has_text text="Commment for the report"/>
                    <has_text text="fgbio"/>
                    <has_text text="ErrorRateByReadPosition"/>
                </assert_contents>
            </output>
            <output name="stats" ftype="tabular">
                <assert_contents>
                    <has_text text="fgbio-error_rate"/>
                    <has_n_lines n="2"/>
                </assert_contents>
            </output>
            <output_collection name="plots" type="list" count="2"/>
        </test>
    </xml>
</macros>
