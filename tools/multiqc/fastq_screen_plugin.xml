<macros>
    <token name="@FASTQ_SCREEN_COMMAND@"><![CDATA[
        #set $pattern = ""
        #set $prefix = ""
        #set $suffix = "_screen.txt"
        @LN_FILES@
    ]]></token>
    <xml name="fastq_screen_form">
        <param name="input" type="data" format="txt,tabular" multiple="true" label="Output of FastQ Screen" help="Files ending in '_screen.txt' produced by fastq_screen" optional="true"/>
    </xml>
    <xml name="fastq_screen_test">
        <test expect_num_outputs="3">
            <repeat name="results">
                <conditional name="software_cond">
                    <param name="software" value="fastq_screen"/>
                    <param name="input" value="sampleA_screen.txt"/>
                </conditional>
            </repeat>
            <param name="title" value="Title of the report"/>
            <param name="comment" value="Commment for the report"/>
            <param name="flat" value="true"/>
            <param name="export" value="true"/>
            <output name="html_report">
                <assert_contents>
                    <has_text text="Title of the report"/>
                    <has_text text="Commment for the report"/>
                    <has_text text="fastq_screen"/>
                    <has_text text="Mapped Reads"/>
                </assert_contents>
            </output>
            <output name="stats" ftype="tabular">
                <assert_contents>
                    <has_n_lines n="0"/>
                </assert_contents>
            </output>
            <output_collection name="plots" type="list" count="1"/>
        </test>
    </xml>
</macros>
