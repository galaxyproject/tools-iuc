<macros>
    <token name="@UMITOOLS_COMMAND@"><![CDATA[
        #for $j, $repeat2 in enumerate( $repeat.software_cond.output )
            @CREATE_REPEAT_DIR_2@
            #if str($repeat2.type.type) == "dedup"
                #set $pattern = "# output generated by dedup"
                #set $prefix = ""
                #set $suffix = ""
                @LN_3_FILES@
            #elif str($repeat2.type.type) == "extract"
                #set $pattern = "# output generated by extract"
                #set $prefix = ""
                #set $suffix = ""
                @LN_3_FILES@
            #end if
        #end for
    ]]></token>
    <xml name="umitools_form">
        <repeat name="output" title="UMI-tools output" min="1">
            <conditional name="type">
                <param name="type" type="select" label="Type of UMI-tools output?">
                    <option value="dedup">dedup log</option>
                    <option value="extract">extract log</option>
                </param>
                <when value="dedup">
                    <param name="input" type="data" format="txt" multiple="true" label="UMI-tools dedup log" help="Stderr/stdout log containing '# output generated by dedup'" optional="true"/>
                </when>
                <when value="extract">
                    <param name="input" type="data" format="txt" multiple="true" label="UMI-tools extract log" help="Stderr/stdout log containing '# output generated by extract'" optional="true"/>
                </when>
            </conditional>
        </repeat>
    </xml>
    <xml name="umitools_test">
        <test expect_num_outputs="3">
            <repeat name="results">
                <conditional name="software_cond">
                    <param name="software" value="umitools"/>
                    <repeat name="output">
                        <conditional name="type">
                            <param name="type" value="dedup"/>
                            <param name="input" value="umitools_dedup.log"/>
                        </conditional>
                    </repeat>
                    <repeat name="output">
                        <conditional name="type">
                            <param name="type" value="extract"/>
                            <param name="input" value="umitools_extract.log"/>
                        </conditional>
                    </repeat>
                </conditional>
            </repeat>
            <param name="title" value="Title of the report"/>
            <param name="comment" value="Commment for the report"/>
            <param name="flat" value="true"/>
            <param name="export" value="true"/>
            <output name="html_report">
                <assert_contents>
                    <has_text text="Title of the report"/>
                    <has_text text="Commment for the report"/>
                    <has_text text="UMI-tools"/>
                    <has_text text="Deduplication"/>
                </assert_contents>
            </output>
            <output name="stats" ftype="tabular">
                <assert_contents>
                    <has_text text="umi_tools-dedup_output_reads"/>
                    <has_text text="3000"/>
                    <has_text text="umi_tools-extract_output_reads"/>
                    <has_text text="49000"/>
                    <has_n_lines n="3"/>
                </assert_contents>
            </output>
            <output_collection name="plots" type="list" count="3"/>
        </test>
    </xml>
</macros>
