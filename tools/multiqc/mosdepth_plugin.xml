<macros>
    <token name="@MOSDEPTH_COMMAND@"><![CDATA[
        #for $j, $repeat2 in enumerate( $repeat.software_cond.output )
            @CREATE_REPEAT_DIR_2@
            #if str($repeat2.type.type) == "summary"
                #set $pattern = ""
                #set $prefix = ""
                #set $suffix = ".mosdepth.summary.txt"
                @LN_3_FILES@
            #elif str($repeat2.type.type) == "global_dist"
                #set $pattern = ""
                #set $prefix = ""
                #set $suffix = ".mosdepth.global.dist.txt"
                @LN_3_FILES@
            #elif str($repeat2.type.type) == "region_dist"
                #set $pattern = ""
                #set $prefix = ""
                #set $suffix = ".mosdepth.region.dist.txt"
                @LN_3_FILES@
            #end if
        #end for
    ]]></token>
    <xml name="mosdepth_form">
        <repeat name="output" title="mosdepth output" min="1">
            <conditional name="type">
                <param name="type" type="select" label="Type of mosdepth output?">
                    <option value="summary">summary (per-contig mean/min/max coverage)</option>
                    <option value="global_dist">global distribution</option>
                    <option value="region_dist">region distribution</option>
                </param>
                <when value="summary">
                    <param name="input" type="data" format="txt,tabular" multiple="true" label="mosdepth summary output" help="Files ending in '.mosdepth.summary.txt'" optional="true"/>
                </when>
                <when value="global_dist">
                    <param name="input" type="data" format="txt,tabular" multiple="true" label="mosdepth global distribution output" help="Files ending in '.mosdepth.global.dist.txt'" optional="true"/>
                </when>
                <when value="region_dist">
                    <param name="input" type="data" format="txt,tabular" multiple="true" label="mosdepth region distribution output" help="Files ending in '.mosdepth.region.dist.txt'" optional="true"/>
                </when>
            </conditional>
        </repeat>
    </xml>
    <xml name="mosdepth_test">
        <test expect_num_outputs="3">
            <repeat name="results">
                <conditional name="software_cond">
                    <param name="software" value="mosdepth"/>
                    <repeat name="output">
                        <conditional name="type">
                            <param name="type" value="summary"/>
                            <param name="input" value="sampleA.mosdepth.summary.txt"/>
                        </conditional>
                    </repeat>
                </conditional>
            </repeat>
            <param name="title" value="Title of the report"/>
            <param name="comment" value="Commment for the report"/>
            <param name="flat" value="true"/>
            <param name="export" value="true"/>
            <output name="html_report">
                <assert_contents>
                    <has_text text="Title of the report"/>
                    <has_text text="Commment for the report"/>
                    <has_text text="mosdepth"/>
                </assert_contents>
            </output>
            <output name="stats" ftype="tabular">
                <assert_contents>
                    <has_text text="sampleA"/>
                    <has_text text="mean_coverage"/>
                    <has_n_lines n="2"/>
                </assert_contents>
            </output>
            <output_collection name="plots" type="list" count="0"/>
        </test>
    </xml>
</macros>
