<macros>
    <token name="@TOOL_VERSION@">2.5.1</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.1</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">skesa</requirement>
        </requirements>
    </xml>
    <xml name="insert_size">
        <param argument="--insert_size" type="integer" min="1" optional="true" label="Expected insert size"
            help="Leave empty to let SKESA estimate it from the reads"/>
    </xml>
    <!-- the 3 kb test genome assembles into a single contig of roughly 2.8-2.9 kb -->
    <xml name="one_contig">
        <assert_contents>
            <has_n_lines n="2"/>
            <has_line_matching expression="^>Contig_1_[0-9.]+$"/>
            <has_size size="2870" delta="150"/>
        </assert_contents>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1186/s13059-018-1540-z</citation>
        </citations>
    </xml>
</macros>
