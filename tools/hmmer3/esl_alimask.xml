<tool id="hmmer_esl_alimask" name="esl-alimask" version="@TOOL_VERSION@+galaxy0" profile="25.0">
    <description>remove alignment columns using reference annotations or gap frequency</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tools"/>
    <expand macro="requirements"/>
    <version_command>esl-alimask -h | head -n 2</version_command>
    <command detect_errors="exit_code"><![CDATA[
esl-alimask
#if $mask.mode == 'reference'
    --rf-is-mask
#else
    -g --gapthresh $mask.threshold
#end if
    --outformat $output_format '$alignment' > '$output'
    ]]></command>
    <inputs>
        <param name="alignment" type="data" format="stockholm" label="Input alignment" help="Reference masking requires the #=GC RF annotation, for example from hmmalign."/>
        <conditional name="mask">
            <param name="mode" type="select" label="Column selection">
                <option value="reference" selected="true">Keep non-gap reference annotation columns</option>
                <option value="gap">Keep columns below a gap frequency threshold</option>
            </param>
            <when value="reference"/>
            <when value="gap">
                <param name="threshold" type="float" value="0.5" min="0" max="1" label="Maximum fraction of gaps"/>
            </when>
        </conditional>
        <param name="output_format" type="select" label="Output alignment format">
            <option value="afa" selected="true">Aligned FASTA</option>
            <option value="stockholm">Stockholm</option>
        </param>
    </inputs>
    <outputs>
        <data name="output" format="fasta" label="${tool.name} on ${on_string}: masked alignment">
            <change_format>
                <when input="output_format" value="stockholm" format="stockholm"/>
            </change_format>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="alignment" value="placement-query.sto"/>
            <output name="output" file="placement-query-masked.fasta"/>
        </test>
        <test expect_num_outputs="1">
            <param name="alignment" value="globins4.sto"/>
            <conditional name="mask">
                <param name="mode" value="gap"/>
                <param name="threshold" value="0.5"/>
            </conditional>
            <param name="output_format" value="stockholm"/>
            <output name="output" ftype="stockholm">
                <assert_contents>
                    <has_text text="# STOCKHOLM 1.0"/>
                    <has_text text="HBA_HUMAN"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
Remove alignment columns using Easel's esl-alimask utility. Reference mode retains the non-gap columns in the Stockholm ``#=GC RF`` annotation, preserving the profile coordinates used for independent reference and query alignments. Gap-frequency mode retains columns below the chosen gap fraction.

Output can be aligned FASTA for phylogenetic placement or Stockholm for downstream alignment tools. Unlike HMMER's ``alimask`` tool, which adds a model-mask annotation, this tool physically removes columns.
    ]]></help>
    <expand macro="citation"/>
</tool>
