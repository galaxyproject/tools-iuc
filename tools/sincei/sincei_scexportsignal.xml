<tool id="sincei_scexportsignal" name="sincei scExportSignal" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="@LICENSE@">
    <description>export a count matrix to MatrixMarket or BedGraphMatrix</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tools"/>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
        scExportSignal
            --input '$input'
            --outFileFormat '$format.outFileFormat'
            --outFilePrefix export
            #if str($format.outFileFormat) == 'bm':
                --region '$format.region'
            #end if
    ]]></command>
    <inputs>
        <expand macro="h5ad_input"/>
        <conditional name="format">
            <param argument="--outFileFormat" type="select" label="Output file format">
                <option value="mtx" selected="true">MatrixMarket (sparse matrix with row and column names)</option>
                <option value="bm">BedGraphMatrix (dense, for pyGenomeTracks)</option>
            </param>
            <when value="mtx"/>
            <when value="bm">
                <param argument="--region" type="text" value="" label="Region" help="Region of the genome to export. The format is chr:start:end (chr:start-end is also accepted), for example chr10 or chr10:456700:891000. The BedGraphMatrix stores data in dense format, so we recommend choosing a region to export instead of the whole dataset.">
                    <validator type="regex" message="Use the format chr, chr:start:end or chr:start-end">[A-Za-z0-9_.]+(:[0-9]+[:-][0-9]+)?</validator>
                </param>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="matrix" format="mtx" from_work_dir="export.counts.mtx" label="${tool.name} on ${on_string}: matrix">
            <filter>format['outFileFormat'] == 'mtx'</filter>
        </data>
        <data name="rownames" format="txt" from_work_dir="export.rownames.txt" label="${tool.name} on ${on_string}: row names (cells)">
            <filter>format['outFileFormat'] == 'mtx'</filter>
        </data>
        <data name="colnames" format="txt" from_work_dir="export.colnames.txt" label="${tool.name} on ${on_string}: column names (features)">
            <filter>format['outFileFormat'] == 'mtx'</filter>
        </data>
        <data name="bedgraph_matrix" format="tabular" from_work_dir="export.bm" label="${tool.name} on ${on_string}: BedGraphMatrix">
            <filter>format['outFileFormat'] == 'bm'</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="3">
            <param name="input" value="counts.h5ad"/>
            <output name="matrix" ftype="mtx">
                <assert_contents>
                    <has_text text="%%MatrixMarket"/>
                </assert_contents>
            </output>
            <output name="rownames" ftype="txt">
                <assert_contents>
                    <has_text text="SL2-1::AGCGTCTA"/>
                    <has_n_lines n="10"/>
                </assert_contents>
            </output>
            <output name="colnames" ftype="txt">
                <assert_contents>
                    <has_text text="chr1_23365000_23365020"/>
                    <has_n_lines n="1000"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <conditional name="format">
                <param name="outFileFormat" value="bm"/>
                <param name="region" value="chr1:23365000:23366000"/>
            </conditional>
            <param name="input" value="counts.h5ad"/>
            <output name="bedgraph_matrix" ftype="tabular">
                <assert_contents>
                    <has_line_matching expression="chr1\t23365000\t23365020(\t[0-9.]+){10}"/>
                    <has_n_lines n="50"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

`scExportSignal` converts a sincei AnnData (`h5ad`) count matrix to other formats:

- **MatrixMarket**: a sparse matrix (`.mtx`) with separate files for the row (cell) and column
  (feature) names. Most single-cell tools can read it.
- **BedGraphMatrix**: a dense table with one row per feature (chrom, start, end) and one column
  per cell, which pyGenomeTracks can plot. Since it is dense, export a region rather than the
  whole genome.

-----

**Inputs**

- An AnnData (`h5ad`) count matrix from sincei.

**Outputs**

- The matrix in the chosen format.
@HELP_FOOTER@
    ]]></help>
    <expand macro="creator"/>
    <expand macro="citations"/>
</tool>
