<tool id="sincei_sccountreads_bins" name="sincei scCountReads bins" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="@LICENSE@">
    <description>count reads per cell in genomic bins</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tools"/>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
        @PREPARE_BAMS@
        scCountReads bins
            @BAM_ARGS@
            --barcodes '$barcodes'
            --outFilePrefix counts
            @CELL_TAG_CMD@
            --binSize $binSize
            --distanceBetweenBins $distanceBetweenBins
            @REGION_CMD@
            @EXCLUSION_CMD@
            @READ_FILTERS_CMD@
            @FRAGMENT_LENGTH_CMD@
            @SEQUENCE_FILTERS_CMD@
            @READ_PROCESSING_CMD@
            @THREADS@
    ]]></command>
    <inputs>
        <expand macro="bam_inputs"/>
        <expand macro="barcodes"/>
        <expand macro="cell_tag"/>
        <expand macro="bin_size" value="10000"/>
        <expand macro="distance_between_bins" value="0"/>
        <expand macro="region"/>
        <expand macro="exclusion"/>
        <expand macro="read_filters">
            <expand macro="fragment_length_filters"/>
            <expand macro="sequence_filters"/>
        </expand>
        <expand macro="read_processing"/>
    </inputs>
    <outputs>
        <data name="counts" format="h5ad" from_work_dir="counts.h5ad" label="${tool.name} on ${on_string}: counts (AnnData)"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="bamfiles" value="SL2-1.bam,SL2-2.bam"/>
            <param name="barcodes" value="test_barcodes.txt"/>
            <param name="binSize" value="1000"/>
            <param name="region" value="chr1:23365000-23385000"/>
            <!-- 10 cells x 20 bins, 115 counts; the output is byte-identical between runs, so compare all counts -->
            <output name="counts" ftype="h5ad" file="counts_bins.h5ad">
                <assert_contents>
                    <has_h5_keys keys="X/data,X/indices,X/indptr,obs/_index,var/_index"/>
                    <has_h5_attribute key="encoding-type" value="anndata"/>
                    <has_text text="SL2-1::AGCGTCTA"/>
                    <has_text text="SL2-2::AAGGCTAC"/>
                    <has_text text="chr1_23365000_23366000"/>
                    <has_text text="chr1_23384000_23385000"/>
                </assert_contents>
                <metadata name="shape" value="10,20"/>
            </output>
        </test>
        <!-- same input as above, with read filters: total counts drop from 115 to 48 (top bin 32 -> 8) -->
        <test expect_num_outputs="1">
            <param name="bamfiles" value="SL2-1.bam,SL2-2.bam"/>
            <param name="barcodes" value="test_barcodes.txt"/>
            <param name="binSize" value="1000"/>
            <param name="region" value="chr1:23365000:23385000"/>
            <section name="filtering">
                <param name="minMappingQuality" value="10"/>
                <param name="duplicateFilter" value="start_bc"/>
                <param name="GCcontentFilter" value="0.1,0.9"/>
            </section>
            <section name="processing">
                <param name="centerReads" value="true"/>
            </section>
            <output name="counts" ftype="h5ad" file="counts_bins_filtered.h5ad">
                <assert_contents>
                    <has_h5_keys keys="X/data,obs/_index,var/_index"/>
                    <has_text text="SL2-1::AGCGTCTA"/>
                </assert_contents>
                <metadata name="shape" value="10,20"/>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

`scCountReads bins` splits the genome into consecutive bins of a fixed size and counts, for each
cell barcode in the whitelist, the reads falling into every bin. The result is a cells x bins
count matrix, the input for QC (`scCountQC`), clustering (`scClusterCells`) and the other
downstream sincei tools.

Use **scCountReads features** to count over genes or other regions from a BED/GTF file instead.

-----

**Inputs**

- One or more BAM files with a cell barcode tag. The dataset name (without `.bam`) is used as the
  sample label, so cells are named `label::barcode`.
- A barcode whitelist, e.g. the selected barcodes from `scFilterBarcodes`.

**Outputs**

- An AnnData (`h5ad`) object with cells as observations and bins as variables.
@HELP_FOOTER@
    ]]></help>
    <expand macro="creator"/>
    <expand macro="citations"/>
</tool>
