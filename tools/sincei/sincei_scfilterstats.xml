<tool id="sincei_scfilterstats" name="sincei scFilterStats" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="@LICENSE@">
    <description>estimate per-cell read filtering statistics</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tools"/>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
        @PREPARE_BAMS@
        scFilterStats
            @BAM_ARGS@
            --barcodes '$barcodes'
            --outFile '$stats'
            @CELL_TAG_CMD@
            --binSize $binSize
            --distanceBetweenBins $distanceBetweenBins
            @EXCLUSION_CMD@
            @READ_FILTERS_CMD@
            @SEQUENCE_FILTERS_CMD@
            @RNA_STRAND_CMD@
            @THREADS@
    ]]></command>
    <inputs>
        <expand macro="bam_inputs"/>
        <expand macro="barcodes"/>
        <expand macro="cell_tag"/>
        <expand macro="bin_size" value="100000"/>
        <expand macro="distance_between_bins" value="1000000"/>
        <expand macro="exclusion"/>
        <expand macro="read_filters">
            <expand macro="sequence_filters"/>
            <expand macro="rna_strand_filter"/>
        </expand>
    </inputs>
    <outputs>
        <data name="stats" format="tabular" label="${tool.name} on ${on_string}: filtering statistics"/>
    </outputs>
    <tests>
        <!-- defaults (no filters) -->
        <test expect_num_outputs="1">
            <param name="bamfiles" value="SL2-1.mini.bam,SL2-2.mini.bam"/>
            <param name="barcodes" value="test_barcodes.txt"/>
            <param name="binSize" value="1000"/>
            <param name="distanceBetweenBins" value="0"/>
            <output name="stats" ftype="tabular">
                <assert_contents>
                    <has_text text="Cell_ID"/>
                    <has_text text="Internal_Duplicates"/>
                    <has_line_matching expression="SL2-1.mini::AGCCAGAT\t32.0\t.*"/>
                    <has_n_lines n="11"/>
                </assert_contents>
            </output>
        </test>
        <!-- filters active -->
        <test expect_num_outputs="1">
            <param name="bamfiles" value="SL2-1.mini.bam,SL2-2.mini.bam"/>
            <param name="barcodes" value="test_barcodes.txt"/>
            <param name="binSize" value="1000"/>
            <param name="distanceBetweenBins" value="0"/>
            <section name="filtering">
                <param name="minMappingQuality" value="30"/>
                <param name="duplicateFilter" value="start_bc"/>
            </section>
            <output name="stats" ftype="tabular">
                <assert_contents>
                    <has_text text="Low_MAPQ"/>
                    <has_n_lines n="11"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

`scFilterStats` estimates, for every cell, how many reads would be removed by a given set of
filtering criteria. Use it to choose read filters before counting with `scCountReads`.

The following metrics are reported per cell, as a percentage of sampled reads:

- reads in blacklisted regions
- reads below the mapping quality threshold
- reads missing required SAM flags, or carrying excluded ones
- duplicates found by sincei, and duplicates marked externally (e.g. by Picard)
- singletons (paired reads with only one mate aligned)
- reads on the wrong strand, without the required motif, outside the GC range, or with a
  low aligned fraction

Reads are sampled from bins of size *Bin size*, spaced *Distance between bins* apart.

-----

**Inputs**

- One or more BAM files with a cell barcode tag.
- A barcode whitelist.

**Outputs**

- A table with one row per cell (`sample::barcode`) and one column per metric.
@HELP_FOOTER@
    ]]></help>
    <expand macro="creator"/>
    <expand macro="citations"/>
</tool>
