<tool id="sincei_scjsd" name="sincei scJSD" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@" license="@LICENSE@">
    <description>per-cell signal enrichment using the Jensen-Shannon distance</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tools"/>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <command detect_errors="aggressive"><![CDATA[
        @PREPARE_BAMS@
        scJSD
            @BAM_ARGS@
            --barcodes '$barcodes'
            --outFile '$jsd'
            @CELL_TAG_CMD@
            --binSize $binSize
            --numberOfSamples $numberOfSamples
            $skipZeros
            @EXCLUSION_CMD@
            @READ_FILTERS_CMD@
            @FRAGMENT_LENGTH_CMD@
            @THREADS@
    ]]></command>
    <inputs>
        <expand macro="bam_inputs"/>
        <expand macro="barcodes"/>
        <expand macro="cell_tag"/>
        <expand macro="bin_size" value="10000"/>
        <param argument="--numberOfSamples" type="integer" min="1" value="100000" label="Number of samples" help="The number of bins that are sampled from the genome, for which the overlapping number of reads is computed."/>
        <param argument="--skipZeros" type="boolean" truevalue="--skipZeros" falsevalue="" checked="false" label="Skip zeros" help="If set, then regions with zero overlapping reads for all given BAM files are ignored. This will result in a reduced number of read counts than that specified in the number of samples."/>
        <expand macro="exclusion"/>
        <expand macro="read_filters">
            <expand macro="fragment_length_filters"/>
        </expand>
    </inputs>
    <outputs>
        <data name="jsd" format="tabular" label="${tool.name} on ${on_string}: JSD per cell"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="bamfiles" value="SL2-1.mini.bam,SL2-2.mini.bam"/>
            <param name="barcodes" value="test_barcodes.txt"/>
            <param name="binSize" value="1000"/>
            <param name="numberOfSamples" value="100"/>
            <output name="jsd" ftype="tabular">
                <assert_contents>
                    <has_line_matching expression="\tcell\tjsd"/>
                    <has_text text="SL2-1.mini_AGCCAGAT"/>
                    <has_n_lines n="11"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="bamfiles" value="SL2-1.mini.bam,SL2-2.mini.bam"/>
            <param name="barcodes" value="test_barcodes.txt"/>
            <param name="binSize" value="1000"/>
            <param name="numberOfSamples" value="100"/>
            <param name="skipZeros" value="true"/>
            <section name="filtering">
                <param name="minMappingQuality" value="10"/>
                <param name="maxFragmentLength" value="1000"/>
            </section>
            <output name="jsd" ftype="tabular">
                <assert_contents>
                    <has_line_matching expression="\tcell\tjsd"/>
                    <has_text text="SL2-2.mini_AGACTGTA"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

`scJSD` samples regions from the genome and, for each cell, compares the cumulative read
coverage over those regions with that of a synthetic cell with Poisson-distributed reads, using
the Jensen-Shannon distance (JSD). Cells with enriched signal (e.g. good ChIP or ATAC
enrichment) have a higher JSD than cells whose reads are spread uniformly. Use it as a per-cell
quality metric.

-----

**Inputs**

- One or more BAM files with a cell barcode tag.
- A barcode whitelist.

**Outputs**

- A table with the JSD value of each cell.
@HELP_FOOTER@
    ]]></help>
    <expand macro="creator"/>
    <expand macro="citations"/>
</tool>
