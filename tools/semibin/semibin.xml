        <test expect_num_outputs="1">
            <!-- Long reads are not reclustered, so SemiBin always writes the bins
                 to output_bins: they must not be hidden when the pre-reclustering
                 bins are requested -->
            <conditional name="mode">
                <param name="select" value="single"/>
                <param name="input_fasta" ftype="fasta.gz" value="input_single.fasta.gz"/>
                <param name="input_bam" ftype="bam" value="input_single.bam"/>
                <conditional name="ref">
                    <param name="select" value="ml"/>
                </conditional>
            </conditional>
            <conditional name="min_len">
                <param name="method" value="min-len"/>
                <param name="min_len" value="0"/>
            </conditional>
            <param name="orf_finder" value="prodigal"/>
            <param name="random_seed" value="0"/>
            <param name="sequencing_type" value="long_read"/>
            <section name="training">
                <param name="epoches" value="20"/>
                <param name="batch_size" value="2048"/>
            </section>
            <section name="bin">
                <param name="max_node" value="1"/>
                <param name="max_edges" value="200"/>
                <param name="minfasta_kbs" value="0"/>
            </section>
            <param name="extra_output" value="pre_reclustering_bins"/>
            <output_collection name="output_bins" count="16">
                <!-- the bin numbering is not stable, only their contents count -->
                <element name="SemiBin_0" ftype="fasta">
                    <assert_contents>
                        <has_text_matching expression="&gt;g[0-9]+k_[0-9]+"/>
                    </assert_contents>
                </element>
            </output_collection>
        </test>
