<tool id="teloscope" name="Teloscope" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Assembly telomere annotation</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <version_command>teloscope -v</version_command>
    <command detect_errors="exit_code"><![CDATA[
        mkdir -p output &&
        teloscope
            --input-sequence '$input_sequence'
            --output output
            --canonical '$canonical'
            --patterns '$patterns'
            --window '$window'
            --step '$step'
            --threads "\${GALAXY_SLOTS:-2}"
            --terminal-limit '$terminal_limit'
            --terminal-tolerance '$terminal_tolerance'
            --max-match-distance '$max_match_distance'
            --max-block-distance '$max_block_distance'
            --min-block-length '$min_block_length'
            --min-block-density '$min_block_density'
            --min-block-counts '$min_block_counts'
            --label-threshold '$label_threshold'
            --edit-distance '$edit_distance'
            #if $filters.include_bed:
                #for $f in $filters.include_bed:
                    --include-bed '$f'
                #end for
            #end if
            #if $filters.exclude_bed:
                #for $f in $filters.exclude_bed:
                    --exclude-bed '$f'
                #end for
            #end if
            #if $filters.include_prefix:
                --include-prefix '$filters.include_prefix'
            #end if
            #if $filters.exclude_prefix:
                --exclude-prefix '$filters.exclude_prefix'
            #end if
            $filters.chr_only
            $out_win_repeats
            $out_gc
            $out_entropy
            $out_matches
            $out_its
            $out_fasta
            $manual_curation
            $ultra_fast
            $plot_report
            $verbose
    ]]></command>
    <inputs>
        <param argument="--input-sequence" type="data" format="fasta,fasta.gz" label="Input assembly"/>
        <param argument="--canonical" type="text" value="TTAGGG" label="Canonical telomeric pattern">
            <sanitizer>
                <valid initial="string.printable">
                    <remove value=" "/>
                    <remove value="\t"/>
                    <remove value="\r"/>
                    <remove value="\n"/>
                </valid>
            </sanitizer>
            <validator type="regex" message="Canonical must contain only A,C,G,T.">^[ACGTacgt]+$</validator>
        </param>
        <param argument="--patterns" type="text" value="TTAGGG,CCCTAA" label="Patterns to explore (comma-separated), IUPAC allowed">
            <validator type="regex" message="Use IUPAC letters ACGTRYSWKMBDHVN; comma-separated.">^[ACGTRYSWKMBDHVNacgtryswkmbdhvn]+(?:,[ACGTRYSWKMBDHVNacgtryswkmbdhvn]+)*$</validator>
        </param>
        <param argument="--window" type="integer" min="100" value="1000" label="Sliding window size"/>
        <param argument="--step" type="integer" min="100" value="500" label="Sliding window step"/>
        <param argument="--terminal-limit" type="integer" min="10000" value="50000" label="Terminal limit (bp) in contigs"/>
        <param argument="--terminal-tolerance" type="integer" min="1" value="3000" label="Terminal tolerance (bp)" help="How far from a sequence end a telomere may start"/>
        <param argument="--max-match-distance" type="integer" min="1" value="50" label="Maximum distance (bp) for merging matches"/>
        <param argument="--max-block-distance" type="integer" min="1" value="200" label="Maximum block distance for merging"/>
        <param argument="--min-block-length" type="integer" min="1" value="500" label="Minimum block length"/>
        <param argument="--min-block-density" type="float" min="0.000001" max="1" value="0.5" label="Minimum block density (0–1]"/>
        <param argument="--min-block-counts" type="integer" min="1" value="2" label="Minimum matches per block"/>
        <param argument="--label-threshold" type="float" value="0.667" label="Forward-strand fraction for the p/q label (0.5–1]">
            <validator type="in_range" min="0.5" max="1" exclude_min="true" message="Must be greater than 0.5 and at most 1."/>
        </param>
        <param argument="--edit-distance" type="integer" min="0" max="2" value="0" label="Edit distance for pattern matching (0–2)"/>
        <section name="filters" title="Record filters" expanded="false" help="Filtering is off unless an option is set. Includes (Chromosomes only among them) form a union; exclusions apply last. Matching is case-sensitive and every ID and prefix must match a record.">
            <param argument="--include-bed" type="data" format="bed,txt,tabular" multiple="true" optional="true" label="Include records listed in" help="One ID per line or BED rows; column 1 selects whole records"/>
            <param argument="--exclude-bed" type="data" format="bed,txt,tabular" multiple="true" optional="true" label="Exclude records listed in" help="One ID per line or BED rows; column 1 selects whole records"/>
            <param argument="--include-prefix" type="text" optional="true" value="" label="Include records whose ID starts with (comma-separated)">
                <validator type="regex" message="Comma-separated prefixes without spaces.">^[^,\s]+(,[^,\s]+)*$</validator>
            </param>
            <param argument="--exclude-prefix" type="text" optional="true" value="" label="Exclude records whose ID starts with (comma-separated)">
                <validator type="regex" message="Comma-separated prefixes without spaces.">^[^,\s]+(,[^,\s]+)*$</validator>
            </param>
            <param argument="--chr-only" type="boolean" truevalue="--chr-only" falsevalue="" checked="false" label="Chromosomes only" help="Keep only records named like the longest one"/>
        </section>
        <param argument="--out-win-repeats" type="boolean" truevalue="--out-win-repeats" falsevalue="" checked="false" label="Window repeat counts"/>
        <param argument="--out-gc" type="boolean" truevalue="--out-gc" falsevalue="" checked="false" label="Window GC"/>
        <param argument="--out-entropy" type="boolean" truevalue="--out-entropy" falsevalue="" checked="false" label="Window Shannon entropy"/>
        <param argument="--out-matches" type="boolean" truevalue="--out-matches" falsevalue="" checked="false" label="Canonical/NonCanonical Matches"/>
        <param argument="--out-its" type="boolean" truevalue="--out-its" falsevalue="" checked="false" label="Interstitial telomeres (ITSs)"/>
        <param argument="--out-fasta" type="boolean" truevalue="--out-fasta" falsevalue="" checked="false" label="Terminal telomere sequences (FASTA)"/>
        <param argument="--manual-curation" type="boolean" truevalue="--manual-curation" falsevalue="" checked="false" label="Manual curation (retain contig + scaffold terminal telomeres)"/>
        <param argument="--ultra-fast" type="boolean" truevalue="--ultra-fast" falsevalue="" checked="true" label="Ultra-fast mode (terminal regions only)"/>
        <param argument="--plot-report" type="boolean" truevalue="--plot-report" falsevalue="" checked="false" label="PDF plot reports" help="Terminal and ITS PDF reports"/>
        <param argument="--verbose" type="boolean" truevalue="--verbose" falsevalue="" checked="false" label="Verbose output"/>
    </inputs>
    <outputs>
        <!-- BASIC OUTFILES -->
        <data name="terminal_telomeres" format="bed" from_work_dir="output/*_terminal_telomeres.bed" label="${tool.name} on ${on_string}: Terminal telomeres"/>
        <data name="gaps" format="bed" from_work_dir="output/*_gaps.bed" label="${tool.name} on ${on_string}: Gaps"/>
        <data name="telo_report" format="tabular" from_work_dir="output/*_report.tsv" label="${tool.name} on ${on_string}: Summary report"/>
        <!-- OPTIONAL OUTFILES -->
        <data name="interstitial_telomeres" format="bed" from_work_dir="output/*_interstitial_telomeres.bed" label="${tool.name} on ${on_string}: Interstitial telomeres">
            <filter>out_its</filter>
        </data>
        <data name="canonical_matches" format="bed" from_work_dir="output/*_canonical_matches.bed" label="${tool.name} on ${on_string}: Canonical matches">
            <filter>out_matches</filter>
        </data>
        <data name="noncanonical_matches" format="bed" from_work_dir="output/*_noncanonical_matches.bed" label="${tool.name} on ${on_string}: Noncanonical matches">
            <filter>out_matches</filter>
        </data>
        <data name="window_gc" format="bedgraph" from_work_dir="output/*_window_gc.bedgraph" label="${tool.name} on ${on_string}: Window GC">
            <filter>out_gc</filter>
        </data>
        <data name="window_entropy" format="bedgraph" from_work_dir="output/*_window_entropy.bedgraph" label="${tool.name} on ${on_string}: Window Shannon entropy">
            <filter>out_entropy</filter>
        </data>
        <data name="window_repeat_density" format="bedgraph" from_work_dir="output/*_window_repeat_density.bedgraph" label="${tool.name} on ${on_string}: Window repeat density">
            <filter>out_win_repeats</filter>
        </data>
        <data name="window_canonical_ratio" format="bedgraph" from_work_dir="output/*_window_canonical_ratio.bedgraph" label="${tool.name} on ${on_string}: Window canonical ratio">
            <filter>out_win_repeats</filter>
        </data>
        <data name="window_strand_ratio" format="bedgraph" from_work_dir="output/*_window_strand_ratio.bedgraph" label="${tool.name} on ${on_string}: Window strand ratio">
            <filter>out_win_repeats</filter>
        </data>
        <data name="terminal_fasta" format="fasta" from_work_dir="output/*_terminal_telomeres.fa" label="${tool.name} on ${on_string}: Terminal telomere sequences">
            <filter>out_fasta</filter>
        </data>
        <data name="plot_report_terminal" format="pdf" from_work_dir="output/*_plot_report_terminal.pdf" label="${tool.name} on ${on_string}: Terminal plot report">
            <filter>plot_report</filter>
        </data>
        <data name="plot_report_its" format="pdf" from_work_dir="output/*_plot_report_its.pdf" label="${tool.name} on ${on_string}: ITS plot report">
            <filter>plot_report</filter>
        </data>
    </outputs>
    <tests>
        <!-- 1) Default (-u) : terminal telomeres + gaps + report -->
        <test expect_num_outputs="3">
            <param name="input_sequence" value="bTaeGut7_chr33_mat.fa.gz" ftype="fasta.gz"/>
            <param name="canonical" value="TTAGGG"/>
            <param name="patterns" value="TTAGGG,CCCTAA"/>
            <output name="terminal_telomeres">
                <assert_contents>
                    <!-- 12-column block BED -->
                    <has_line_matching expression="^\S+\t\d+\t\d+\t\d+\t[pqb]\t[pq]\t\d+\t\d+\t\d+\t\d+\t\d+\t\S+$"/>
                    <has_line_matching expression="^chr33_mat\t\d+\t\d+\t\d+\tp\tp\t.*\tscaffold$"/>
                    <has_line_matching expression="^chr33_mat\t\d+\t\d+\t\d+\tq\tq\t.*\tscaffold$"/>
                </assert_contents>
            </output>
            <output name="gaps">
                <assert_contents>
                    <!-- no gaps in this single-scaffold assembly -->
                    <has_n_lines n="0"/>
                </assert_contents>
            </output>
            <output name="telo_report">
                <assert_contents>
                    <has_line_matching expression="#teloscope version=0\.1\.6 .*"/>
                    <has_line_matching expression="\+\+\+ Assembly Summary Report \+\+\+"/>
                    <has_line_matching expression="\+\+\+ Telomere Statistics \+\+\+"/>
                    <has_line_matching expression="\+\+\+ Chromosome Telomere Counts \+\+\+"/>
                    <has_line_matching expression="\+\+\+ Chromosome Telomere/Gap Completeness \+\+\+"/>
                    <has_line_matching expression="\+\+\+ Scaffold Anomalies \+\+\+"/>
                </assert_contents>
            </output>
        </test>
        <!-- 2) Genome-wide (-g -e -r -m -i -a ; disable -u) -->
        <test expect_num_outputs="12">
            <param name="input_sequence" value="bTaeGut7_chr33_mat.fa.gz" ftype="fasta.gz"/>
            <param name="canonical" value="TTAGGG"/>
            <param name="patterns" value="TTAGGG,CCCTAA"/>
            <param name="out_gc" value="true"/>
            <param name="out_entropy" value="true"/>
            <param name="out_win_repeats" value="true"/>
            <param name="out_matches" value="true"/>
            <param name="out_its" value="true"/>
            <param name="out_fasta" value="true"/>
            <param name="ultra_fast" value="false"/>
            <output name="terminal_telomeres">
                <assert_contents>
                    <has_line_matching expression="^\S+\t\d+\t\d+\t\d+\t[pqb]\t[pq]\t\d+\t\d+\t\d+\t\d+\t\d+\t\S+$"/>
                </assert_contents>
            </output>
            <output name="gaps">
                <assert_contents>
                    <has_n_lines n="0"/>
                </assert_contents>
            </output>
            <output name="interstitial_telomeres">
                <assert_contents>
                    <has_line_matching expression="^\S+\t\d+\t\d+\t\d+\t[pqb]\t[pq]\t\d+\t\d+\t\d+\t\d+\t\d+\t\S+$"/>
                </assert_contents>
            </output>
            <output name="canonical_matches">
                <assert_contents>
                    <!-- ensure at least one CCCTAA match line -->
                    <has_line_matching expression="^\S+\t\d+\t\d+\tCCCTAA(?:\s|$)"/>
                </assert_contents>
            </output>
            <output name="noncanonical_matches">
                <assert_contents>
                    <!-- expect an empty file -->
                    <has_n_lines n="0"/>
                </assert_contents>
            </output>
            <output name="window_gc">
                <assert_contents>
                    <has_text text="track type=bedGraph"/>
                    <!-- first data window line -->
                    <has_line_matching expression="^\S+\t0\t1000\t.*"/>
                </assert_contents>
            </output>
            <output name="window_entropy">
                <assert_contents>
                    <has_text text="track type=bedGraph"/>
                    <has_line_matching expression="^\S+\t0\t1000\t.*"/>
                </assert_contents>
            </output>
            <output name="window_repeat_density">
                <assert_contents>
                    <has_text text="track type=bedGraph"/>
                    <has_line_matching expression="^\S+\t0\t1000\t.*"/>
                </assert_contents>
            </output>
            <output name="window_canonical_ratio">
                <assert_contents>
                    <has_text text="track type=bedGraph"/>
                    <has_line_matching expression="^\S+\t0\t1000\t.*"/>
                </assert_contents>
            </output>
            <output name="window_strand_ratio">
                <assert_contents>
                    <has_text text="track type=bedGraph"/>
                    <has_line_matching expression="^\S+\t0\t1000\t.*"/>
                </assert_contents>
            </output>
            <output name="terminal_fasta">
                <assert_contents>
                    <has_line_matching expression="^>chr33_mat:\d+-\d+$"/>
                </assert_contents>
            </output>
            <output name="telo_report">
                <assert_contents>
                    <has_line_matching expression="#teloscope version=0\.1\.6 .*"/>
                    <has_line_matching expression="\+\+\+ Assembly Summary Report \+\+\+"/>
                    <has_line_matching expression="Total ITS blocks:\t\d+"/>
                    <has_line_matching expression="\+\+\+ Telomere Statistics \+\+\+"/>
                    <has_line_matching expression="\+\+\+ Chromosome Telomere Counts \+\+\+"/>
                    <has_line_matching expression="\+\+\+ Chromosome Telomere/Gap Completeness \+\+\+"/>
                    <has_line_matching expression="\+\+\+ Scaffold Anomalies \+\+\+"/>
                </assert_contents>
            </output>
        </test>
        <!-- 3) Edit distance 1: more variants detected -->
        <test expect_num_outputs="3">
            <param name="input_sequence" value="bTaeGut7_chr33_mat.fa.gz" ftype="fasta.gz"/>
            <param name="canonical" value="TTAGGG"/>
            <param name="patterns" value="TTAGGG,CCCTAA"/>
            <param name="edit_distance" value="1"/>
            <output name="terminal_telomeres">
                <assert_contents>
                    <has_line_matching expression="^chr33_mat\t\d+\t\d+\t\d+\tp\tp\t.*\tscaffold$"/>
                    <has_line_matching expression="^chr33_mat\t\d+\t\d+\t\d+\tq\tq\t.*\tscaffold$"/>
                </assert_contents>
            </output>
            <output name="gaps">
                <assert_contents>
                    <has_n_lines n="0"/>
                </assert_contents>
            </output>
            <output name="telo_report">
                <assert_contents>
                    <has_line_matching expression="#params .* edit_distance=1 .*"/>
                    <has_line_matching expression="\+\+\+ Assembly Summary Report \+\+\+"/>
                </assert_contents>
            </output>
        </test>
        <!-- 4) Edit distance 2: maximum variants detected -->
        <test expect_num_outputs="3">
            <param name="input_sequence" value="bTaeGut7_chr33_mat.fa.gz" ftype="fasta.gz"/>
            <param name="canonical" value="TTAGGG"/>
            <param name="patterns" value="TTAGGG,CCCTAA"/>
            <param name="edit_distance" value="2"/>
            <output name="terminal_telomeres">
                <assert_contents>
                    <has_line_matching expression="^chr33_mat\t\d+\t\d+\t\d+\tp\tp\t.*\tscaffold$"/>
                    <has_line_matching expression="^chr33_mat\t\d+\t\d+\t\d+\tq\tq\t.*\tscaffold$"/>
                </assert_contents>
            </output>
            <output name="gaps">
                <assert_contents>
                    <has_n_lines n="0"/>
                </assert_contents>
            </output>
            <output name="telo_report">
                <assert_contents>
                    <has_line_matching expression="#params .* edit_distance=2 .*"/>
                    <has_line_matching expression="\+\+\+ Assembly Summary Report \+\+\+"/>
                </assert_contents>
            </output>
        </test>
        <!-- 5) Gapped assembly: gap interval reported in gaps.bed -->
        <test expect_num_outputs="3">
            <param name="input_sequence" value="gapped_test.fa.gz" ftype="fasta.gz"/>
            <param name="canonical" value="TTAGGG"/>
            <param name="patterns" value="TTAGGG,CCCTAA"/>
            <output name="terminal_telomeres">
                <assert_contents>
                    <has_line_matching expression="^\S+\t\d+\t\d+\t\d+\t[pqb]\t[pq]\t\d+\t\d+\t\d+\t\d+\t\d+\t\S+$"/>
                </assert_contents>
            </output>
            <output name="gaps">
                <assert_contents>
                    <!-- assembly gap (N-run) reported as a BED interval -->
                    <has_n_lines n="1"/>
                    <has_text text="chrGap&#9;4400&#9;4900"/>
                </assert_contents>
            </output>
            <output name="telo_report">
                <assert_contents>
                    <has_line_matching expression="\+\+\+ Assembly Summary Report \+\+\+"/>
                    <has_line_matching expression="Total gaps:\t1"/>
                </assert_contents>
            </output>
        </test>
        <!-- 6) Record filters and block-calling parameters -->
        <test expect_num_outputs="3">
            <param name="input_sequence" value="bTaeGut7_chr33_mat.fa.gz" ftype="fasta.gz"/>
            <param name="canonical" value="TTAGGG"/>
            <param name="patterns" value="TTAGGG,CCCTAA"/>
            <param name="terminal_tolerance" value="5000"/>
            <param name="min_block_counts" value="3"/>
            <param name="label_threshold" value="0.8"/>
            <section name="filters">
                <param name="include_bed" value="chr33_ids.txt" ftype="txt"/>
                <param name="chr_only" value="true"/>
            </section>
            <output name="terminal_telomeres">
                <assert_contents>
                    <has_line_matching expression="^chr33_mat\t\d+\t\d+\t\d+\t[pq]\t[pq]\t.*\tscaffold$"/>
                </assert_contents>
            </output>
            <output name="gaps">
                <assert_contents>
                    <has_n_lines n="0"/>
                </assert_contents>
            </output>
            <output name="telo_report">
                <assert_contents>
                    <has_line_matching expression="#params .* terminal_tolerance=5000 .*"/>
                    <has_line_matching expression="Filter input paths:\t1"/>
                    <has_line_matching expression="Filter selected paths:\t1"/>
                </assert_contents>
            </output>
        </test>
        <!-- 7) PDF plot reports -->
        <test expect_num_outputs="5">
            <param name="input_sequence" value="bTaeGut7_chr33_mat.fa.gz" ftype="fasta.gz"/>
            <param name="canonical" value="TTAGGG"/>
            <param name="patterns" value="TTAGGG,CCCTAA"/>
            <param name="plot_report" value="true"/>
            <output name="terminal_telomeres">
                <assert_contents>
                    <has_line_matching expression="^\S+\t\d+\t\d+\t\d+\t[pqb]\t[pq]\t\d+\t\d+\t\d+\t\d+\t\d+\t\S+$"/>
                </assert_contents>
            </output>
            <output name="gaps">
                <assert_contents>
                    <has_n_lines n="0"/>
                </assert_contents>
            </output>
            <output name="telo_report">
                <assert_contents>
                    <has_line_matching expression="\+\+\+ Assembly Summary Report \+\+\+"/>
                </assert_contents>
            </output>
            <output name="plot_report_terminal" ftype="pdf">
                <assert_contents>
                    <has_text text="%PDF"/>
                    <has_size value="36897"/>
                </assert_contents>
            </output>
            <output name="plot_report_its" ftype="pdf">
                <assert_contents>
                    <has_text text="%PDF"/>
                    <has_size value="27241"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
**Description**

Teloscope is a tool for telomere annotation in genome assemblies.
It scans for user-specified telomeric repeat patterns across assembly paths, contigs and windows.
Teloscope annotates terminal and interstitial telomeres, canonical/noncanonical matches and genome-wide metrics such as GC content, Shannon entropy, and repeat counts.
It generates a detailed telomere summary report for paths, telomere statistics, and chromosome labels to assess telomere completeness.
Teloscope can be used for both complete and fragmented assemblies, providing valuable information for genome manual curation and analysis.

**Usage**

Default (ultra-fast) scans terminal regions and reports:

* Terminal telomeres (BED)
* Gaps (BED)
* Summary report (TSV): per-sequence classes and assembly summary, preceded by ``#teloscope`` version and ``#params`` lines

Enabling window/match options (-g -e -r -m -i) performs a genome-wide scan and can additionally produce:

* Interstitial telomeres (BED, -i)
* Canonical and noncanonical matches (BED, -m)
* Window GC, Shannon entropy, repeat density, canonical ratio and strand ratio (bedGraph, -g -e -r)

Independent of the scan mode:

* Terminal telomere sequences (FASTA, -a), one record per terminal BED row, named ``>{chr}:{start}-{end}``
* Terminal and ITS PDF plot reports (--plot-report). In ultra-fast mode the ITS report covers only the scanned ends.

**Telomere block BED**

Terminal and interstitial BEDs share a 12-column layout (zero-based, half-open):
chr, start, end, teloLen, teloLabel (p forward, q reverse, b mixed), closestEnd (p/q), fwdCan, revCan, fwdNonCan, revNonCan, chrSize, teloType
(``scaffold`` or ``contig`` for terminal rows; junction class for interstitial rows).

**Key parameters**

- -c / --canonical: Canonical repeat (default TTAGGG). This is the vertebrate telomeric motif found at chromosome ends that binds to shelterin complex to form a telomere.
- -p / --patterns: Variant patterns (comma-separated). These are additional telomeric repeat motifs to search for, besides the canonical repeat, it includes other variants that can be part of telomeres.
- -w / -s: window size / step (defaults 1000/500).
- -u / --ultra-fast: terminal scan only (default true); disabled automatically when -g/-e/-r/-m/-i are used.
- -x / --edit-distance: Edit Hamming distance for pattern matching (0–2). Useful for identifying degenerate telomeric repeats (default 0).
- -n / --manual-curation: Also report telomeres at contig ends in the terminal BED; by default only scaffold-level terminal telomeres are reported.
- --terminal-tolerance: how far from a sequence end a telomere may start (default 3000).
- --min-block-counts: minimum matches a block needs (default 2).
- --label-threshold: forward-strand share required for a p or q label, in (0.5, 1] (default 0.667).

**Record filters**

Filtering is off unless an option is set. Includes (Chromosomes only among them) form a union; exclusions apply last.
Matching is case-sensitive, prefixes are literal (not globs), and FASTA records are matched by the first word after ``>``.
Every listed ID and prefix must match a record, and the selection cannot be empty.

- --include-bed / --exclude-bed: files with one ID per line or BED rows; column 1 selects whole records (coordinates never crop them).
- --include-prefix / --exclude-prefix: comma-separated ID prefixes.
- --chr-only: keep records named like the longest one (same leading letters and same number of separators), e.g. ``chr1`` keeps ``chrX`` but drops ``chrUn_KI270302v1``.
    ]]></help>
    <expand macro="citations"/>
</tool>
