<tool id="gappa_heat_tree" name="GAPPA heat tree" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>visualize placement mass on a reference tree</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <xrefs>
        <xref type="bio.tools">gappa</xref>
    </xrefs>
    <expand macro="requirements"/>
    <version_command>gappa --version</version_command>
    <command detect_errors="exit_code"><![CDATA[
gappa examine heat-tree --jplace-path '$jplace' --threads "\${GALAXY_SLOTS:-1}"
#for format in $formats
    --write-${format}-tree
#end for
    --log-file heat-tree.log
    ]]></command>
    <inputs>
        <expand macro="placements"/>
        <param name="formats" type="select" multiple="true" label="Output tree formats">
            <option value="svg" selected="true">SVG</option>
            <option value="nexus" selected="true">Nexus</option>
            <option value="phyloxml" selected="true">PhyloXML</option>
            <option value="newick">Newick</option>
            <validator type="no_options" message="Select at least one output format"/>
        </param>
    </inputs>
    <outputs>
        <data name="svg" format="svg" from_work_dir="tree.svg" label="${tool.name} on ${on_string}: SVG">
            <filter>'svg' in formats</filter>
        </data>
        <data name="nexus" format="nexus" from_work_dir="tree.nexus" label="${tool.name} on ${on_string}: Nexus">
            <filter>'nexus' in formats</filter>
        </data>
        <data name="phyloxml" format="phyloxml" from_work_dir="tree.phyloxml" label="${tool.name} on ${on_string}: PhyloXML">
            <filter>'phyloxml' in formats</filter>
        </data>
        <data name="newick" format="newick" from_work_dir="tree.newick" label="${tool.name} on ${on_string}: Newick">
            <filter>'newick' in formats</filter>
        </data>
        <data name="log" format="txt" from_work_dir="heat-tree.log" label="${tool.name} on ${on_string}: scale and log"/>
    </outputs>
    <tests>
        <test expect_num_outputs="4">
            <param name="jplace" value="placements.json"/>
            <output name="nexus" file="heat-tree.nexus"/>
            <output name="phyloxml" file="heat-tree.phyloxml"/>
            <output name="svg" file="heat-tree.svg.re" compare="re_match"/>
            <output name="log">
                <assert_contents>
                    <has_text text="At"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="2">
            <param name="jplace" value="placements.json"/>
            <param name="formats" value="newick"/>
            <output name="newick" file="heat-tree.newick"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
Display phylogenetic placement mass on a reference tree. The default exports SVG, Nexus and PhyloXML versions of the same heat tree. The log records the colour scale. Newick output can be requested separately; it does not preserve graphical colour annotations.
    ]]></help>
    <expand macro="citations"/>
</tool>
