<tool id="gappa_assign" name="GAPPA assign" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>assign taxonomy from phylogenetic placements</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <xrefs>
        <xref type="bio.tools">gappa</xref>
    </xrefs>
    <expand macro="requirements"/>
    <version_command>gappa --version</version_command>
    <command detect_errors="exit_code"><![CDATA[
gappa examine assign --jplace-path '$jplace' --taxon-file '$taxon_file' --threads \${GALAXY_SLOTS:-1}
    $per_query_results $krona $sativa
    ]]></command>
    <inputs>
        <expand macro="placements"/>
        <param argument="--taxon-file" type="data" format="tabular" label="Reference taxon assignments" help="Two tab-separated columns: reference-tree leaf name and semicolon-separated taxonomic lineage."/>
        <param argument="--per-query-results" type="boolean" truevalue="--per-query-results" falsevalue="" checked="false" label="Output per-query assignments"/>
        <param argument="--krona" type="boolean" truevalue="--krona" falsevalue="" checked="false" label="Output Krona profile"/>
        <param argument="--sativa" type="boolean" truevalue="--sativa" falsevalue="" checked="false" label="Output SATIVA assignments"/>
    </inputs>
    <outputs>
        <data name="profile" format="tabular" from_work_dir="profile.tsv" label="${tool.name} on ${on_string}: taxonomy profile"/>
        <data name="labelled_tree" format="newick" from_work_dir="labelled_tree.newick" label="${tool.name} on ${on_string}: labelled reference tree"/>
        <data name="per_query" format="tabular" from_work_dir="per_query.tsv" label="${tool.name} on ${on_string}: per-query assignments">
            <filter>per_query_results</filter>
        </data>
        <data name="krona_profile" format="tabular" from_work_dir="krona.profile" label="${tool.name} on ${on_string}: Krona profile">
            <filter>krona</filter>
        </data>
        <data name="sativa_results" format="tabular" from_work_dir="sativa.tsv" label="${tool.name} on ${on_string}: SATIVA assignments">
            <filter>sativa</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="2">
            <param name="jplace" value="placements.json"/>
            <param name="taxon_file" value="taxonomy.tsv"/>
            <output name="profile" file="profile.tsv"/>
            <output name="labelled_tree" file="labelled_tree.newick"/>
        </test>
        <test expect_num_outputs="5">
            <param name="jplace" value="placements.json"/>
            <param name="taxon_file" value="taxonomy.tsv"/>
            <param name="per_query_results" value="true"/>
            <param name="krona" value="true"/>
            <param name="sativa" value="true"/>
            <output name="profile" file="profile.tsv"/>
            <output name="per_query" file="per_query.tsv"/>
            <output name="krona_profile" file="krona.profile"/>
            <output name="sativa_results" file="sativa.tsv"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
Assign taxonomy to phylogenetically placed query sequences. The reference taxonomy maps tree leaf names to semicolon-separated lineages. Outputs include the placement-weighted taxonomic profile and a labelled reference tree; per-query, Krona and SATIVA tables are optional. Uncertainty is retained through placement likelihood weights. No sequence alignment or placement search is performed by this tool.
    ]]></help>
    <expand macro="citations"/>
</tool>
