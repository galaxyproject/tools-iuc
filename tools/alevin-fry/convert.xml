<tool id="alevin_fry_convert" name="alevin-fry convert" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" python_template_version="3.5" profile="@PROFILE_VERSION@">
    <description>BAM/SAM to RAD</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <expand macro="version_command"/>
    <command detect_errors="exit_code"><![CDATA[
        ln -s '$input' 'input.$input.ext' &&
        alevin-fry convert --bam 'input.$input.ext' $filter_best --output map.rad &&
        mv map.rad '$output_rad'
    ]]></command>
    <inputs>
        <param name="input" argument="--bam" type="data" format="bam,sam" label="BAM or SAM file"/>
        <param argument="--filter_best" type="boolean" truevalue="--filter_best" falsevalue="" checked="false" label="Filter best alignments" help="Keep only the highest scoring alignments for each read."/>
    </inputs>
    <outputs>
        <data name="output_rad" format="rad" label="${tool.name} on ${on_string}"/>
    </outputs>
    <tests>
        <test>
            <param name="input" value="convert/input.bam"/>
            <param name="filter_best" value="false"/>
            <output name="output_rad" file="convert/bam_output.rad"/>
        </test>
        <test>
            <param name="input" value="convert/input.bam"/>
            <param name="filter_best" value="true"/>
            <output name="output_rad" file="convert/bam_filter.rad"/>
        </test>
        <test>
            <param name="input" value="convert/input.sam"/>
            <param name="filter_best" value="false"/>
            <output name="output_rad" file="convert/sam_output.rad"/>
        </test>
    </tests>
    <help><![CDATA[
This tool runs **alevin-fry convert**, converting an input BAM or SAM file into a RAD file.
Optionally, alignments can be filtered, keeping only the highest scoring alignments for each read.

----

**Input**

- **BAM** or **SAM** file

----

**Output**

- **RAD** file, used as input for **alevin-fry generate permit list and collate**
    ]]></help>
    <expand macro="citations"/>
</tool>
