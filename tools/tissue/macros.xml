<macros>
    <token name="@TOOL_VERSION@">1.0.1</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <xml name="expression_table" token_name="" token_lines="129" token_rows="128" token_columns="2" token_values="1" token_header="cell_id\tplp1">
        <output name="@NAME@">
            <assert_contents>
                <has_n_lines n="@LINES@"/>
                <has_n_columns n="@COLUMNS@"/>
                <has_line_matching expression="@HEADER@"/>
                <has_text_matching expression="(?m)^\d+(?:\t[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?){@VALUES@}$" n="@ROWS@"/>
                <yield/>
            </assert_contents>
        </output>
    </xml>
    <token name="@THREADS@"><![CDATA[
export OMP_NUM_THREADS=\${GALAXY_SLOTS:-1} &&
export OPENBLAS_NUM_THREADS=\${GALAXY_SLOTS:-1} &&
export MKL_NUM_THREADS=\${GALAXY_SLOTS:-1} &&
export NUMBA_NUM_THREADS=\${GALAXY_SLOTS:-1} &&
]]></token>
    <xml name="prediction_method">
        <param argument="--method" type="select" label="Prediction method used in the input">
            <option value="spage" selected="true">SpaGE</option>
            <option value="knn">Harmony-kNN</option>
            <option value="tangram">Tangram</option>
        </param>
    </xml>
    <xml name="seed">
        <param argument="--seed" type="integer" min="0" max="4294967295" value="444" label="Random seed"/>
    </xml>
    <xml name="pca_parameters">
        <param argument="--n-components" type="integer" min="1" value="15" label="Principal components" help="Cannot exceed the number of predicted genes or cells used to fit PCA."/>
        <param argument="--scale" type="boolean" truevalue="--scale" falsevalue="--no-scale" checked="true" label="Standardize expression before PCA"/>
    </xml>
    <xml name="cell_filter_parameters">
        <conditional name="filtering">
            <param name="method" argument="--filter-method" type="select" label="Uncertain cell threshold">
                <option value="proportion" selected="true">Drop a fixed proportion of cells</option>
                <option value="otsu">Otsu threshold</option>
            </param>
            <when value="proportion">
                <param argument="--proportion" type="float" min="0" max="1" value="0.05" label="Proportion of most uncertain cells to drop">
                    <validator type="in_range" min="0" max="1" exclude_max="true"/>
                </param>
            </when>
            <when value="otsu"/>
        </conditional>
        <param argument="--stratification" type="text" optional="true" label="Observation column for stratification" help="If supplied, filter cells independently within each value in this obs column."/>
        <param argument="--normalize" type="boolean" truevalue="--normalize" falsevalue="" checked="false" label="Normalize interval widths by expression" help="Divide widths by 1 + absolute predicted expression before filtering."/>
    </xml>
    <xml name="spatial_neighbors">
        <param argument="--n-neighbors" type="integer" min="1" value="20" label="Spatial neighbors" help="Must be smaller than the number of spatial cells."/>
    </xml>
    <xml name="spatial_radius" token_help="If omitted, use Q3 + 1.5 × IQR of neighbor distances.">
        <param argument="--radius" type="float" min="0" optional="true" label="Maximum neighbor distance" help="In coordinate units; must be positive. @HELP@">
            <validator type="in_range" min="0" exclude_min="true"/>
        </param>
    </xml>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">tissue-sc</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1038/s41592-024-02184-y</citation>
        </citations>
    </xml>
</macros>
