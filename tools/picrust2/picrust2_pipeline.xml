<tool id="picrust2_pipeline" name="PICRUSt2 Full pipeline" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description/>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tool"/>
    <expand macro="requirements"/>
    <version_command>picrust2_pipeline.py -v</version_command>
    <command detect_errors="exit_code"><![CDATA[
@VAR_ACCESS_FOO@
@PIPELINE_REF_DIRS_PREPROCESSING@
@PIPELINE_CUSTOM_TRAITS_PREPROCESSING@
@PREPARE_METAGENOME_PIPELINE_PARAMS@

picrust2_pipeline.py
    ## place_seqs parameters
    @PLACE_SEQS_PARAMS@
    @PIPELINE_REF_DIRS_PARAMS@

    ## hsp parameters
    #if str($hsp_section.trait_input.selector) == "default"
        --in_traits '$hsp_section.trait_input.in_traits'
    #else
        @PIPELINE_CUSTOM_TRAITS_PARAMS@
    #end if
    @HSP_METHOD_PARAMS@

    ## metagenome_pipeline parameters
    @METAGENOME_PIPELINE_PARAMS@

    ## pathway_pipeline parameters
    #if $predict_pathways.no_pathways == ''
        @PATHWAY_PIPELINE_PARAMS@
        --reaction_func '$predict_pathways.reaction_map_file.reaction_func'
    #else
        $predict_pathways.no_pathways
    #end if

    #if $remove_intermediate is None
        --remove_intermediate
    #end if

    --output 'full_pipeline_output'
    --processes "\${GALAXY_SLOTS:-1}"
    ## unzip all (potential) output files
    &&
    find full_pipeline_output -name "*.gz" -exec gunzip {} \;
    ## rename all tsv files to tabular to simplify discovery
    &&
    find full_pipeline_output -name "*.tsv" -exec sh -c 'mv {} \$(dirname {})/\$(basename {} .tsv).tabular' \;
    ## flatten metagenome output dirs ro simplify/enable discovery
    &&
    for d in full_pipeline_output/*_metagenome_out; do
        D=\$(basename \$d);
        for i in \$d/*; do
            I=\$(basename \$i);
            mv "\$i" "full_pipeline_output/""\$D""_""\$I";
        done;
    done;
    ## since 2.6 the sequences are placed into one tree per domain, so there is
    ## also one intermediate dir per domain. merge them into a single dir and
    ## prefix the file names with the domain to enable discovery
    mkdir -p full_pipeline_output/intermediate/place_seqs;
    for d in full_pipeline_output/intermediate/place_seqs_*; do
        [ -d "\$d" ] || continue;
        D=\$(basename "\$d" | sed 's/^place_seqs_//');
        for i in "\$d"/*; do
            [ -f "\$i" ] || continue;
            I=\$(basename \$i);
            mv "\$i" "full_pipeline_output/intermediate/place_seqs/""\$D""_""\$I";
        done;
    done;
    ## otherwise the `;` on the last line is swallowed
    true
    ]]></command>
    <inputs>
        <!-- place_seqs parameters -->
        <section name="place_seqs_section" title="Sequence placement options" expanded="true">
            <expand macro="place_seqs_params">
                <expand macro="pipeline_ref_dirs"/>
            </expand>
        </section>
        <!-- hsp parameters -->
        <section name="hsp_section" title="Hidden state prediction (HSP) options" expanded="true">
            <conditional name="trait_input">
                <param name="selector" type="select" label="Trait table(s)" help="i.e. which gene families to predict">
                    <option value="default" selected="true">Default trait table(s)</option>
                    <option value="custom">Customized trait table(s)</option>
                </param>
                <when value="default">
                    <expand macro="hsp_traits_sc" in_trait_arg="--in_traits" in_trait_multiple="true" in_trait_label_suff="(s)" ko_selected="true" in_traits_help="Note that EC numbers will always be predicted unless pathway inference is switched off below"/>
                </when>
                <when value="custom">
                    <!-- one set of tables per domain, PICRUSt2 aborts if only one of them is given -->
                    <param argument="--custom_trait_tables_ref1" type="data" multiple="true" format="tabular" label="Customized trait table(s) for the first domain" help="With gene families as columns and genomes as rows. The first table is used for inferring pathway abundances. Note that the name of each dataset is used as the name of the predicted function, i.e. it determines the names of the output datasets"/>
                    <param argument="--marker_gene_table_ref1" type="data" format="tabular" optional="true" label="Table of predicted marker gene (16S or other) copy numbers for the first domain"/>
                    <param argument="--custom_trait_tables_ref2" type="data" multiple="true" format="tabular" label="Customized trait table(s) for the second domain" help="With gene families as columns and genomes as rows. Has to contain the same trait names as the tables of the first domain"/>
                    <param argument="--marker_gene_table_ref2" type="data" format="tabular" optional="true" label="Table of predicted marker gene (16S or other) copy numbers for the second domain"/>
                </when>
            </conditional>
            <expand macro="hsp_method_params"/>
        </section>
        <!-- metagenome_pipeline parameters -->
        <section name="metagenome_pipeline_section" title="Metagenome prediction options" expanded="true">
            <expand macro="metagenome_pipeline_params" stratified_arg="--stratified"/>
        </section>
        <!-- pathway_pipeline parameters -->
        <conditional name="predict_pathways">
            <param argument="--no_pathways" type="select" label="Infer pathways">
                <option value="" selected="true">Yes</option>
                <option value="--no_pathways">No</option>
            </param>
            <when value="">
                <expand macro="pathway_pipeline_params" mapargument="--pathway_map"/>
                <conditional name="reaction_map_file">
                    <param name="selector" type="select" label="Functional database to use as reactions for inferring pathway abundances">
                        <option value="default" selected="true">Default functional database</option>
                        <option value="custom">Customized reation functional map file</option>
                    </param>
                    <when value="default">
                        <param argument="--reaction_func" type="select" label="Default functional database">
                            <option value="EC" selected="true">Enzyme Commission number database (EC number)</option>
                            <option value="KO">KEGG Orthology database (KO)</option>
                            <option value="GO">Gene Ontology (GO)</option>
                            <option value="PFAM">Pfam database</option>
                            <option value="BIGG">BiGG reactions</option>
                            <option value="CAZY">Carbohydrate-Active enZYmes (CAZy)</option>
                            <option value="GENE_NAMES">Preferred gene names</option>
                        </param>
                    </when>
                    <when value="custom">
                        <param argument="--reaction_func" type="data" format="tabular" label="Custom mapping table" help="An input 2 column map table linking function ids to descriptions for each function"/>
                    </when>
                </conditional>
            </when>
            <when value="--no_pathways"/>
        </conditional>
        <param argument="--remove_intermediate" type="select" multiple="true" optional="true" label="Keep intermediate files of">
            <option value="place_seqs">place_seqs</option>
            <option value="pathways">pathways_pipeline</option>
        </param>
    </inputs>
    <outputs>
        <collection name="out_trees" type="list" label="${tool.name} on ${on_string}: Trees of reference and study sequences">
            <discover_datasets pattern="(?P&lt;designation&gt;.+)\.tre" directory="full_pipeline_output/" format="newick"/>
        </collection>
        <collection name="place_seqs_intermediate_output" type="list" label="${tool.name} on ${on_string}: Intermediate files (place_seqs)">
            <discover_datasets pattern="__name_and_ext__" directory="full_pipeline_output/intermediate/place_seqs/"/>
            <filter>remove_intermediate and "place_seqs" in remove_intermediate</filter>
        </collection>
        <!-- hsp output: one table per domain plus the combined table -->
        <collection name="hsp_output" type="list" label="${tool.name} on ${on_string}: predicted copy numbers">
            <discover_datasets pattern="(?P&lt;designation&gt;.+)_predicted\.tabular" directory="full_pipeline_output/" format="tabular"/>
        </collection>
        <data name="nsti_output" format="tabular" from_work_dir="full_pipeline_output/combined_marker_predicted_and_nsti.tabular" label="${tool.name} on ${on_string}: predicted marker gene copy numbers and NSTI"/>
        <!-- metagenome output -->
        <collection name="metagenome_output" type="list:list" label="${tool.name} on ${on_string}: metagenome output">
            <discover_datasets pattern="(?P&lt;identifier_0&gt;.+)_metagenome_out_(?P&lt;identifier_1&gt;.+)\.tabular" directory="full_pipeline_output/" format="tabular"/>
        </collection>
        <!-- pathways output -->
        <expand macro="pathways_output" from_work_dir="full_pipeline_output/" label_suffix="pathways">
            <filter>predict_pathways["no_pathways"] == ""</filter>
            <token name="intermediate_filter">
                <filter>remove_intermediate and "pathways" in remove_intermediate</filter>
            </token>
            <token name="coverage_filter">
                <filter>predict_pathways["coverage"]</filter>
            </token>
            <token name="per_sequence_filter">
                <filter>predict_pathways["strat_output"]["per_sequence_contrib"]</filter>
            </token>
        </expand>
    </outputs>
    <tests>
        <!-- Note: Both tests use the small custom reference (15 tips) for both domains.
             The default SC reference is far too expensive for CI: the hidden state
             prediction of a single trait over the 26867 tip bacterial tree takes
             ~15min, i.e. more than the per test limit of the IUC CI. The default
             references are covered by the place_seqs (bac, arc, oldIMG) and hsp
             (bac, oldIMG) tests instead. -->
        
        <!-- Test 01: pathways inferred, keep all intermediate results -->
        <test expect_num_outputs="7">
            <!-- place_seq -->
            <section name="place_seqs_section">
                <param name="study_fasta" value="study_seqs_test2.fasta"/>
                <param name="placement_tool" value="epa-ng"/>
                <param name="min_align" value="0.80"/>
                <conditional name="ref_dirs">
                    <param name="selector" value="custom"/>
                    <section name="ref1">
                        <param name="custom_fna" value="img_centroid_16S_aligned_head30.fna.gz"/>
                        <param name="custom_hmm" value="img_centroid_16S_aligned_head30.hmm"/>
                        <param name="custom_tre" value="img_centroid_16S_aligned_head30.tre"/>
                        <param name="custom_model" value="img_centroid_16S_aligned_head30.model"/>
                    </section>
                    <section name="ref2">
                        <param name="custom_fna" value="img_centroid_16S_aligned_head30.fna.gz"/>
                        <param name="custom_hmm" value="img_centroid_16S_aligned_head30.hmm"/>
                        <param name="custom_tre" value="img_centroid_16S_aligned_head30.tre"/>
                        <param name="custom_model" value="img_centroid_16S_aligned_head30.model"/>
                    </section>
                </conditional>
            </section>
            <!-- hsp: the trait table is named EC.tsv, so the predicted function is
                 called EC and the default reaction_func (EC) refers to it -->
            <section name="hsp_section">
                <conditional name="trait_input">
                    <param name="selector" value="custom"/>
                    <param name="custom_trait_tables_ref1" value="EC.tsv"/>
                    <param name="marker_gene_table_ref1" value="16S.tsv"/>
                    <param name="custom_trait_tables_ref2" value="EC.tsv"/>
                    <param name="marker_gene_table_ref2" value="16S.tsv"/>
                </conditional>
            </section>
            <!-- metagenome -->
            <section name="metagenome_pipeline_section">
                <param name="input" value="workflow_seq_abun.biom"/>
                <conditional name="input_options">
                    <param name="selector" value="ASV"/>
                    <param name="min_reads" value="1"/>
                    <param name="min_samples" value="1"/>
                </conditional>
                <param name="max_nsti" value="100"/>
                <param name="skip_norm" value="false"/>
            </section>
            <!-- pathway -->
            <conditional name="predict_pathways">
                <param name="no_pathways" value=""/>
            </conditional>
            <param name="remove_intermediate" value="place_seqs,pathways"/>
            <output_collection name="out_trees" type="list" count="4">
                <element name="ref1" ftype="newick">
                    <assert_contents>
                        <has_n_lines n="1"/>
                        <has_text text="2511231166_test"/>
                    </assert_contents>
                </element>
                <element name="ref2" ftype="newick">
                    <assert_contents>
                        <has_n_lines n="1"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="place_seqs_intermediate_output" type="list" count="6">
                <element name="ref1_query_align" ftype="stockholm">
                    <assert_contents>
                        <has_text text="STOCKHOLM 1.0"/>
                    </assert_contents>
                </element>
                <element name="ref1_study_seqs_hmmalign" ftype="fasta">
                    <assert_contents>
                        <has_text text="02905cfb87861c837dde629596d9272b"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="hsp_output" type="list" count="1">
                <element name="ref1_EC" ftype="tabular">
                    <assert_contents>
                        <has_text text="1.1.1.1"/>
                        <has_n_lines n="6"/>
                        <has_n_columns n="1493"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output name="nsti_output" ftype="tabular">
                <assert_contents>
                    <has_text text="metadata_NSTI"/>
                    <has_text text="best_domain"/>
                    <has_n_lines n="6"/>
                </assert_contents>
            </output>
            <output_collection name="metagenome_output" type="list:list" count="1">
                <element name="EC">
                    <element name="pred_metagenome_unstrat" ftype="tabular">
                        <assert_contents>
                            <has_text text="function"/>
                            <has_n_lines n="635"/>
                            <has_n_columns n="3"/>
                        </assert_contents>
                    </element>
                    <element name="seqtab_norm" ftype="tabular">
                        <assert_contents>
                            <has_text text="normalized"/>
                            <has_n_lines n="6"/>
                        </assert_contents>
                    </element>
                </element>
            </output_collection>
            <output name="pathways_output" ftype="tabular">
                <assert_contents>
                    <has_text text="pathway"/>
                    <has_text text="1CMET2-PWY"/>
                    <has_n_lines n="126"/>
                    <has_n_columns n="3"/>
                </assert_contents>
            </output>
            <output_collection name="pathways_intermediate_output" type="list" count="2">
                <element name="regrouped_infile" ftype="tabular">
                    <assert_contents>
                        <has_text text="function"/>
                        <has_n_columns n="3"/>
                    </assert_contents>
                </element>
            </output_collection>
            <assert_command>
                <has_text text="--ref_dir1 custom1/"/>
                <has_text text="--ref_dir2 custom2/"/>
                <has_text text="--custom_trait_tables_ref1 'traits1/EC.tsv'"/>
                <has_text text="--custom_trait_tables_ref2 'traits2/EC.tsv'"/>
                <has_text text="--in_traits" negate="true"/>
            </assert_command>
            <assert_stderr>
                <has_text text="There was only one file for the function: EC"/>
            </assert_stderr>
        </test>
        <!-- Test 02: no pathways, stratified metagenome output, OTU input, no intermediates -->
        <test expect_num_outputs="4">
            <section name="place_seqs_section">
                <param name="study_fasta" value="study_seqs_test2.fasta"/>
                <param name="placement_tool" value="epa-ng"/>
                <param name="min_align" value="0.80"/>
                <conditional name="ref_dirs">
                    <param name="selector" value="custom"/>
                    <section name="ref1">
                        <param name="custom_fna" value="img_centroid_16S_aligned_head30.fna.gz"/>
                        <param name="custom_hmm" value="img_centroid_16S_aligned_head30.hmm"/>
                        <param name="custom_tre" value="img_centroid_16S_aligned_head30.tre"/>
                        <param name="custom_model" value="img_centroid_16S_aligned_head30.model"/>
                    </section>
                    <section name="ref2">
                        <param name="custom_fna" value="img_centroid_16S_aligned_head30.fna.gz"/>
                        <param name="custom_hmm" value="img_centroid_16S_aligned_head30.hmm"/>
                        <param name="custom_tre" value="img_centroid_16S_aligned_head30.tre"/>
                        <param name="custom_model" value="img_centroid_16S_aligned_head30.model"/>
                    </section>
                </conditional>
            </section>
            <section name="hsp_section">
                <conditional name="trait_input">
                    <param name="selector" value="custom"/>
                    <param name="custom_trait_tables_ref1" value="EC.tsv"/>
                    <param name="marker_gene_table_ref1" value="16S.tsv"/>
                    <param name="custom_trait_tables_ref2" value="EC.tsv"/>
                    <param name="marker_gene_table_ref2" value="16S.tsv"/>
                </conditional>
            </section>
            <section name="metagenome_pipeline_section">
                <param name="input" value="workflow_seq_abun.biom"/>
                <conditional name="input_options">
                    <param name="selector" value="OTU"/>
                </conditional>
                <param name="max_nsti" value="100"/>
                <param name="skip_norm" value="false"/>
                <conditional name="stratified_output">
                    <param name="selector" value="--stratified"/>
                    <param name="wide_table" value="false"/>
                </conditional>
            </section>
            <conditional name="predict_pathways">
                <param name="no_pathways" value="--no_pathways"/>
            </conditional>
            <output_collection name="out_trees" type="list" count="4"/>
            <output_collection name="hsp_output" type="list" count="1">
                <element name="ref1_EC" ftype="tabular">
                    <assert_contents>
                        <has_n_lines n="6"/>
                        <has_n_columns n="1493"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output name="nsti_output" ftype="tabular">
                <assert_contents>
                    <has_text text="metadata_NSTI"/>
                    <has_n_lines n="6"/>
                </assert_contents>
            </output>
            <output_collection name="metagenome_output" type="list:list" count="1">
                <element name="EC">
                    <element name="pred_metagenome_contrib" ftype="tabular">
                        <assert_contents>
                            <has_text text="taxon"/>
                            <has_n_lines n="4177"/>
                        </assert_contents>
                    </element>
                    <element name="pred_metagenome_unstrat" ftype="tabular">
                        <assert_contents>
                            <has_n_lines n="635"/>
                        </assert_contents>
                    </element>
                </element>
            </output_collection>
            <assert_command>
                <has_text text="--stratified"/>
                <has_text text="--no_pathways"/>
                <has_text text="--min_reads" negate="true"/>
                <has_text text="--reaction_func" negate="true"/>
            </assert_command>
        </test>
    </tests>
    <help><![CDATA[
@HELP_HEADER@

PICRUSt2 full pipeline
======================
Run sequence placement with EPA-NG and GAPPA to place study sequences (i.e. OTUs and ASVs) into a reference tree. Then runs hidden-state prediction with the castor R package to predict genome for each study sequence. Metagenome profiles are then generated, which can be optionally stratified by the contributing sequence. Finally, pathway abundances are predicted based on metagenome profiles. By default, output files include predictions for Enzyme Commission (EC) numbers, KEGG Orthologs (KOs), and MetaCyc pathway abundances. However, the tool enables users to use custom reference and trait tables to customize analyses.

Note
====
The standard pipeline will generate metagenome predictions for 16S rRNA gene data.

Since PICRUSt2 2.6 the study sequences are placed into **two** reference trees
(bacteria and archaea by default). Marker gene copy numbers and NSTI are predicted
for both domains, the best matching domain is chosen for each study sequence, and the
per domain trait predictions are combined afterwards. Consequently this tool always
computes NSTI, and only the trait tables of the new SC database (EC, KO, GO, PFAM,
BIGG, CAZY, GENE_NAMES) can be used. Use the separate sequence placement and hidden
state prediction tools if you need the legacy IMG database, e.g. for COG, TIGRFAM or
PHENO predictions.

When customized trait tables are used, PICRUSt2 names each predicted function after
the trait table it came from. The tool therefore uses the *name of the dataset* as the
function name, and that name also shows up in the names of the output datasets. So a
trait table dataset named ``EC`` is predicted as function ``EC``, which is what the
default setting of "Functional database to use as reactions for inferring pathway
abundances" refers to. Rename your trait table datasets accordingly if you want
pathways to be inferred from a customized trait table.

Input
=====
1. A FASTA of amplicon sequences variants (ASVs; i.e. your representative sequences, not your raw reads)
2. A BIOM table of the abundance of each ASV across each sample.

Output
======
1. Output trees with placed study sequences, one per domain plus the trees reduced to the sequences that were assigned to that domain.
2. Predicted copy numbers per domain and combined over both domains.
3. Predicted marker gene copy numbers and NSTI.
4. Metagenome Predictions
5. Pathway level predictions

    ]]></help>
    <expand macro="citations"/>
</tool>
