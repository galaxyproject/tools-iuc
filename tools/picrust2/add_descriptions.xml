<tool id="picrust2_add_descriptions" name="PICRUSt2 Add descriptions" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>column to a function abundance table</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="bio_tool"/>
    <expand macro="requirements"/>
    <version_command>add_descriptions.py -v</version_command>
    <command detect_errors="exit_code"><![CDATA[
#if str($map_file.selector) == "default" and str($map_file.database.selector) == "oldIMG"
    add_descriptions_oldIMG.py
#else
    add_descriptions.py
#end if
    --input '$input'
    --output '$func_abun_table_description'
#if str($map_file.selector) == "default"
    --map_type '$map_file.database.map_type'
#else
    --custom_map_table '$map_file.custom_map_table'
#end if
    ]]></command>
    <inputs>
        <param argument="--input" type="data" format="tabular" label="Input function (gene family or pathway) abundance table"/>
        <conditional name="map_file">
            <param name="selector" type="select" label="Mapping table linking function ids to descriptions">
                <option value="default" selected="true">Default mapping file</option>
                <option value="custom">Customized mapping file</option>
            </param>
            <when value="default">
                <conditional name="database">
                    <param name="selector" type="select" label="Reference database" help="Has to match the database that was used to predict the function abundances">
                        <option value="SC" selected="true">SC: separate bacteria and archaea reference (default since PICRUSt2 2.6)</option>
                        <option value="oldIMG">oldIMG: legacy single prokaryotic IMG reference (PICRUSt2 2.5 and earlier)</option>
                    </param>
                    <when value="SC">
                        <param argument="--map_type" type="select" label="Mapping table to use">
                            <option value="EC" selected="true">Enzyme Commission number database (EC number)</option>
                            <option value="KO">KEGG Orthology database (KO)</option>
                            <option value="GO">Gene Ontology (GO)</option>
                            <option value="PFAM">Pfam database</option>
                            <option value="METACYC">Metabolic Pathway database (MetaCyc)</option>
                        </param>
                    </when>
                    <when value="oldIMG">
                        <param argument="--map_type" type="select" label="Mapping table to use">
                            <option value="COG">Clusters of Orthologous Genes database (COG)</option>
                            <option value="EC" selected="true">Enzyme Commission number database (EC number)</option>
                            <option value="KO">KEGG Orthology database (KO)</option>
                            <option value="PFAM">Pfam database</option>
                            <option value="TIGRFAM">TIGRFAM database</option>
                            <option value="METACYC">Metabolic Pathway database (MetaCyc)</option>
                        </param>
                    </when>
                </conditional>
            </when>
            <when value="custom">
                <param argument="--custom_map_table" type="data" format="tabular" label="Custom mapping table" help="A table with at least two columns linking function ids to descriptions for each function">
                    <validator type="dataset_metadata_in_range" metadata_name="columns" min="2" message="Input needs to have at least two columns"/>
                </param>
            </when>
        </conditional>
    </inputs>
    <outputs>
        <data name="func_abun_table_description" format="tabular"/>
    </outputs>
    <tests>
        <!-- default (SC) description mapfiles, which use EC ids without the "EC:" prefix -->
        <test expect_num_outputs="1">
            <param name="input" value="pred_metagenome_unstrat_sc.tsv.gz"/>
            <conditional name="map_file">
                <param name="selector" value="default"/>
                <conditional name="database">
                    <param name="selector" value="SC"/>
                    <param name="map_type" value="EC"/>
                </conditional>
            </conditional>
            <output name="func_abun_table_description">
                <assert_contents>
                    <has_text text="description"/>
                    <has_n_lines n="1000"/>
                </assert_contents>
            </output>
            <assert_command>
                <has_text text="add_descriptions.py"/>
                <has_text text="add_descriptions_oldIMG.py" negate="true"/>
            </assert_command>
        </test>
        <!-- legacy IMG description mapfiles, the only ones offering COG/TIGRFAM -->
        <test expect_num_outputs="1">
            <param name="input" value="pred_metagenome_unstrat.tsv.gz"/>
            <conditional name="map_file">
                <param name="selector" value="default"/>
                <conditional name="database">
                    <param name="selector" value="oldIMG"/>
                    <param name="map_type" value="EC"/>
                </conditional>
            </conditional>
            <output name="func_abun_table_description">
                <assert_contents>
                    <has_text text="description"/>
                    <has_n_lines n="1000"/>
                </assert_contents>
            </output>
            <assert_command>
                <has_text text="add_descriptions_oldIMG.py"/>
            </assert_command>
        </test>
        <test expect_num_outputs="1">
            <param name="input" value="pred_metagenome_unstrat.tsv.gz"/>
            <conditional name="map_file">
                <param name="selector" value="custom"/>
                <param name="custom_map_table" value="ec_unstrat_test.txt.gz"/>
            </conditional>
            <output name="func_abun_table_description">
                <assert_contents>
                    <has_text text="description"/>
                    <has_n_lines n="1000"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
@HELP_HEADER@

Add Descriptions
================
Adds a description column to a function abundance table and outputs a new file.

Note
====
The user needs to specify the input file and what type of functions are in the input table. Will throw an error if no ids overlap and otherwise will fill in "not_found" for the description of ids in the function table not in the mapfile.

@HELP_DATABASE@

Pick the database that was used to produce the function abundance table. COG and
TIGRFAM descriptions are only available for the legacy IMG database, GO descriptions
only for the SC database.

Input
=====
Input function abundance table.

Output
======
Output function abundance table with added description column.
    ]]></help>
    <expand macro="citations"/>
</tool>
