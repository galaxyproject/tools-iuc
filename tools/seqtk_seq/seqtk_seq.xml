<tool id="seqtk_seq" name="Convert FASTQ to FASTA" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <requirements>
        <requirement type="package" version="1.5">seqtk</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
        seqtk seq -A '$input1' > '$output1'
    ]]></command>
    <inputs>
        <param type="data" name="input1" format="fastq" />
    </inputs>
    <outputs>
        <data name="output1" format="fasta" />
    </outputs>
    <tests>
        <test>
            <param name="input1" value="2.fastq"/>
            <output name="output1" file="2.fasta"/>
        </test>
        <test expect_num_outputs="1">
            <param name="input1" value="2.fastq"/>
            <output name="output1">
                <assert_contents>
                    <has_text text="&gt;"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="input1" value="2.fastq"/>
            <output name="output1" file="2.fasta" compare="sim_size" delta="10"/>
        </test>
    </tests>
    <help><![CDATA[
This tool converts FASTQ files to FASTA format using seqtk.
]]></help>
