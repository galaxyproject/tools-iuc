<macros>
    <token name="@TOOL_VERSION@">1.4.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">dnaapler</requirement>
        </requirements>
    </xml>
    <xml name="search_controls">
        <param argument="--evalue" type="float" value="1e-10" min="0" label="Maximum MMseqs2 E-value" help="DNAapler's default is 1e-10."/>
        <param argument="--autocomplete" type="select" label="If no marker-based reorientation succeeds" help="The fallback requires enough coding sequences; none keeps DNAapler's default behavior.">
            <option value="none" selected="true">Do not use a fallback</option>
            <option value="mystery">Choose a random coding sequence</option>
            <option value="largest">Use the largest coding sequence</option>
            <option value="nearest">Use the second predicted coding sequence (DNAapler nearest)</option>
        </param>
        <param argument="--seed_value" type="integer" value="13" label="Random seed" help="Used by random coding-sequence methods; DNAapler's default is 13."/>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.21105/joss.05968</citation>
        </citations>
    </xml>
</macros>
