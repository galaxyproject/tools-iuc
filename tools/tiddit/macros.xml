<macros>
    <token name="@TOOL_VERSION@">3.9.7</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.1</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">tiddit</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="xrefs">
        <xrefs>
            <xref type="bio.tools">tiddit</xref>
        </xrefs>
    </xml>
    <xml name="version_command">
        <version_command><![CDATA[tiddit 2>&1 | sed -n 's/^usage: tiddit-\([^ ]*\).*/\1/p']]></version_command>
    </xml>
    <!-- TIDDIT insists on a .bam suffix, wants the index alongside the BAM,
         and falls back to the file name for the sample ID when the BAM has no
         read group, so link the input under a sanitised element identifier. -->
    <token name="@LINK_BAM@"><![CDATA[
#import re
#set $sample_name = re.sub(r'[^\w\-]', '_', re.sub(r'\.bam$', '', str($input.element_identifier))) or 'sample'
ln -s '$input' './${sample_name}.bam' &&
ln -s '${input.metadata.bam_index}' './${sample_name}.bam.bai' &&
    ]]></token>
    <xml name="bam_input">
        <param name="input" argument="--bam" type="data" format="bam" label="Coordinate-sorted BAM file"/>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.12688/f1000research.11168.2</citation>
        </citations>
    </xml>
</macros>
