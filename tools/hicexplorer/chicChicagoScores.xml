<tool id="hicexplorer_chicchicagoscores" name="@BINARY@" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>computes CHiCAGO scores</description>
    <macros>
        <token name="@BINARY@">chicChicagoScores</token>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements" />
    <command detect_errors="exit_code"><![CDATA[
        @CHICAGO_LINK_MATRICES@
        @BINARY@

            --backgroundModel '$backgroundModel'
            @CHICAGO_INPUT_SOURCE@
            --baitmap '$baitmap'
            --rmap '$rmap'
            --outFileName chicago_scores.txt

            --minFragLen $minFragLen
            --maxFragLen $maxFragLen
            --minNPerBait $minNPerBait
            --maxLBrownEst $maxLBrownEst
            $noRemoveAdjacent
            --weightAlpha $weightAlpha
            --weightBeta $weightBeta
            --weightGamma $weightGamma
            --weightDelta $weightDelta
            --threads @THREADS@
]]>
    </command>
    <inputs>
        <param argument="--backgroundModel" type="data" format="tabular,txt" label="Background model" help="chicChicagoBackgroundModel's own output file." />
        <expand macro="chicago_input_source" />
        <param argument="--baitmap" type="data" format="tabular,txt" label="CHiCAGO .baitmap file" />
        <param argument="--rmap" type="data" format="tabular,txt" label="CHiCAGO .rmap file" />
        <param argument="--minFragLen" type="integer" value="150" min="0" label="Minimum other-end length" />
        <param argument="--maxFragLen" type="integer" value="40000" min="0" label="Maximum other-end length" />
        <param argument="--minNPerBait" type="integer" value="250" min="0" label="Minimum reads per bait" />
        <param argument="--maxLBrownEst" type="integer" value="1500000" min="0" label="Brownian estimation distance cutoff" />
        <param argument="--noRemoveAdjacent" type="boolean" truevalue="--noRemoveAdjacent" falsevalue="" checked="false" label="Keep bait-adjacent interactions" />
        <param argument="--weightAlpha" type="float" value="34.1157346557331" label="Weight curve alpha" />
        <param argument="--weightBeta" type="float" value="-2.58688050486759" label="Weight curve beta" />
        <param argument="--weightGamma" type="float" value="-17.1347845819659" label="Weight curve gamma" />
        <param argument="--weightDelta" type="float" value="-7.07609217973722" label="Weight curve delta" />
    </inputs>
    <outputs>
        <data name="outFileName" from_work_dir="chicago_scores.txt" format="tabular" label="${tool.name} on ${on_string}: CHiCAGO scores" />
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="backgroundModel" value="chicChicago/background_model.txt" ftype="tabular" />
            <conditional name="input_source">
                <param name="select_input_source" value="chinput" />
                <param name="chinput" value="chicChicago/sample.chinput" ftype="tabular" />
            </conditional>
            <param name="baitmap" value="chicChicago/h19_min.baitmap" ftype="tabular" />
            <param name="rmap" value="chicChicago/h19_min.rmap" ftype="tabular" />
            <output name="outFileName" ftype="tabular">
                <assert_contents>
                    <has_line line="baitID&#009;otherEndID&#009;N&#009;distSign&#009;Bmean&#009;Tmean&#009;log_p&#009;score" />
                    <has_n_columns n="8" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="backgroundModel" value="chicChicago/background_model_custom.txt" ftype="txt" />
            <conditional name="input_source">
                <param name="select_input_source" value="chinput" />
                <param name="chinput" value="chicChicago/sample.chinput" ftype="txt" />
            </conditional>
            <param name="baitmap" value="chicChicago/h19_min.baitmap" ftype="txt" />
            <param name="rmap" value="chicChicago/h19_min.rmap" ftype="txt" />
            <param name="minFragLen" value="100" />
            <param name="maxFragLen" value="30000" />
            <param name="minNPerBait" value="200" />
            <param name="maxLBrownEst" value="1400000" />
            <param name="noRemoveAdjacent" value="true" />
            <param name="weightAlpha" value="30" />
            <param name="weightBeta" value="-2.5" />
            <param name="weightGamma" value="-17" />
            <param name="weightDelta" value="-7" />
            <output name="outFileName" ftype="tabular">
                <assert_contents>
                    <has_line line="baitID&#009;otherEndID&#009;N&#009;distSign&#009;Bmean&#009;Tmean&#009;log_p&#009;score" />
                    <has_n_columns n="8" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="backgroundModel" value="chicChicago/background_model.txt" ftype="tabular" />
            <conditional name="input_source">
                <param name="select_input_source" value="matrices" />
                <param name="matrix_h5_cooler_multiple" value="chicChicago/sample.cool" ftype="cool" />
            </conditional>
            <param name="baitmap" value="chicChicago/h19_min.baitmap" ftype="tabular" />
            <param name="rmap" value="chicChicago/h19_min.rmap" ftype="tabular" />
            <output name="outFileName" ftype="tabular">
                <assert_contents>
                    <has_line line="baitID&#009;otherEndID&#009;N&#009;distSign&#009;Bmean&#009;Tmean&#009;log_p&#009;score" />
                    <has_n_columns n="8" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="backgroundModel" value="chicChicago/background_model.txt" ftype="tabular" />
            <conditional name="input_source">
                <param name="select_input_source" value="matrices" />
                <param name="matrix_h5_cooler_multiple" value="chicChicago/sample.h5" ftype="h5" />
            </conditional>
            <param name="baitmap" value="chicChicago/h19_min.baitmap" ftype="tabular" />
            <param name="rmap" value="chicChicago/h19_min.rmap" ftype="tabular" />
            <output name="outFileName" ftype="tabular">
                <assert_contents>
                    <has_line line="baitID&#009;otherEndID&#009;N&#009;distSign&#009;Bmean&#009;Tmean&#009;log_p&#009;score" />
                    <has_n_columns n="8" />
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[

CHiCAGO scores
================

**chicChicagoScores** computes CHiCAGO's own significance scores for every bait-other end pair, using ``chicChicagoBackgroundModel``'s background model.

A native C++ implementation of CHiCAGO's own statistical model (Cairns et al. 2016).

_________________

Usage
-----

Provide the background model from ``chicChicagoBackgroundModel``, the same design files (.rmap, .baitmap) used there, and either a .chinput file or the raw Hi-C matrices. The output is CHiCAGO's own scores file, the required input to ``chicChicagoSignificantInteractions`` and ``chicChicagoPlotViewpoint``.

_________________

For more information about HiCExplorer please consider our documentation on readthedocs.io_.

.. _readthedocs.io: http://hicexplorer.readthedocs.io/en/latest/index.html

]]>    </help>
    <expand macro="citations">
        <citation type="doi">10.1186/s13059-016-0992-y</citation>
    </expand>
</tool>
