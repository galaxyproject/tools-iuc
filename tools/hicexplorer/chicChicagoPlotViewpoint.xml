<tool id="hicexplorer_chicchicagoplotviewpoint" name="@BINARY@" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>plots CHiCAGO viewpoints</description>
    <macros>
        <token name="@BINARY@">chicChicagoPlotViewpoint</token>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements" />
    <command detect_errors="exit_code"><![CDATA[
        @BINARY@

            --scores '$scores'

            #if $scope.select_scope == 'baitID':
                --baitID $scope.baitID
            #else
                --region '$scope.region_chrom' '$scope.region_start' '$scope.region_end'
            #end if

            --style $style

            #if $baitmap:
                --baitmap '$baitmap'
            #end if
            #if $backgroundModel:
                --backgroundModel '$backgroundModel'
            #end if

            --range $rangeUpstream $rangeDownstream
            --plevel1 $plevel1
            --plevel2 $plevel2
            $keepBait2bait
            $onlySignificant

            #if $writeLinksFile and $rmap:
                --rmap '$rmap'
                --linksFile links.txt
            #end if

            --outFileName plot.$outputFormat
            --outputFormat $outputFormat
            #if $dpi:
                --dpi $dpi
            #end if
]]>
    </command>
    <inputs>
        <param argument="--scores" type="data" format="tabular,txt" label="CHiCAGO scores" help="chicChicagoScores' own output file." />
        <conditional name="scope">
            <param name="select_scope" type="select" label="What to plot">
                <option value="baitID" selected="true">A single bait, by ID</option>
                <option value="region">Every bait in a region</option>
            </param>
            <when value="baitID">
                <param argument="--baitID" type="integer" label="Bait ID to plot" />
            </when>
            <when value="region">
                <param name="region_chrom" type="text" label="Chromosome">
                    <validator type="empty_field" />
                </param>
                <param name="region_start" type="integer" label="Region start" />
                <param name="region_end" type="integer" label="Region end" />
            </when>
        </conditional>
        <param argument="--style" type="select" label="Plot style">
            <option value="scatter" selected="true">Scatter</option>
            <option value="arcs">Arcs</option>
        </param>
        <param argument="--baitmap" type="data" format="tabular,txt" optional="true" label="CHiCAGO .baitmap file" help="Only has an effect together with 'Keep bait2bait rows' or the links file." />
        <param argument="--backgroundModel" type="data" format="tabular,txt" optional="true" label="Background model" help="chicChicagoBackgroundModel's own output file." />
        <param name="rangeUpstream" type="integer" value="1000000" min="0" label="Upstream distance from each bait to plot" />
        <param name="rangeDownstream" type="integer" value="1000000" min="0" label="Downstream distance from each bait to plot" />
        <param argument="--plevel1" type="float" value="5.0" label="More significant score threshold" />
        <param argument="--plevel2" type="float" value="3.0" label="Less significant score threshold" />
        <param argument="--keepBait2bait" type="boolean" truevalue="--keepBait2bait" falsevalue="" checked="false" label="Keep bait2bait rows" help="Default: removed. Only has an effect with a baitmap file given above." />
        <param argument="--onlySignificant" type="boolean" truevalue="--onlySignificant" falsevalue="" checked="false" label="Drop background rows" help="Only the two significant colour tiers are drawn, no background." />
        <param name="writeLinksFile" type="boolean" truevalue="--linksFile" falsevalue="" checked="false" label="Also write a pyGenomeTracks links file" help="Requires both a .rmap file (below) and a baitmap file (above)." />
        <param argument="--rmap" type="data" format="tabular,txt" optional="true" label="CHiCAGO .rmap file" help="Only used, and required, when 'Also write a pyGenomeTracks links file' is checked." />
        <param argument="--outputFormat" type="select" label="Output format">
            <option value="png" selected="true">PNG</option>
            <option value="pdf">PDF</option>
            <option value="svg">SVG</option>
        </param>
        <expand macro="dpi" />
    </inputs>
    <outputs>
        <data name="outFileName" from_work_dir="plot.png" format="png" label="${tool.name} on ${on_string}: Plot (PNG)">
            <filter>outputFormat == 'png'</filter>
        </data>
        <data name="outFileNamePdf" from_work_dir="plot.pdf" format="pdf" label="${tool.name} on ${on_string}: Plot (PDF)">
            <filter>outputFormat == 'pdf'</filter>
        </data>
        <data name="outFileNameSvg" from_work_dir="plot.svg" format="svg" label="${tool.name} on ${on_string}: Plot (SVG)">
            <filter>outputFormat == 'svg'</filter>
        </data>
        <data name="linksFile" from_work_dir="links.txt" format="interval" label="${tool.name} on ${on_string}: Links file">
            <filter>writeLinksFile and rmap</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="scores" value="chicChicago/scores.txt" ftype="tabular" />
            <conditional name="scope">
                <param name="select_scope" value="baitID" />
                <param name="baitID" value="403482" />
            </conditional>
            <param name="backgroundModel" value="chicChicago/background_model.txt" ftype="tabular" />
            <output name="outFileName" ftype="png">
                <assert_contents>
                    <has_size value="100000" delta="95000" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="2">
            <param name="scores" value="chicChicago/scores.txt" ftype="txt" />
            <conditional name="scope">
                <param name="select_scope" value="baitID" />
                <param name="baitID" value="403482" />
            </conditional>
            <param name="style" value="scatter" />
            <param name="baitmap" value="chicChicago/h19_min.baitmap" ftype="txt" />
            <param name="backgroundModel" value="chicChicago/background_model.txt" ftype="txt" />
            <param name="rangeUpstream" value="500000" />
            <param name="rangeDownstream" value="600000" />
            <param name="plevel1" value="4.0" />
            <param name="plevel2" value="2.0" />
            <param name="keepBait2bait" value="true" />
            <param name="onlySignificant" value="true" />
            <param name="writeLinksFile" value="true" />
            <param name="rmap" value="chicChicago/h19_min.rmap" ftype="txt" />
            <param name="outputFormat" value="svg" />
            <param name="dpi" value="30" />
            <output name="outFileNameSvg" ftype="svg">
                <assert_contents>
                    <has_text text="&lt;svg" />
                </assert_contents>
            </output>
            <output name="linksFile" ftype="interval">
                <assert_contents>
                    <has_n_columns n="7" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="2">
            <param name="scores" value="chicChicago/scores.txt" ftype="tabular" />
            <conditional name="scope">
                <param name="select_scope" value="region" />
                <param name="region_chrom" value="20" />
                <param name="region_start" value="100000" />
                <param name="region_end" value="400000" />
            </conditional>
            <param name="style" value="arcs" />
            <param name="baitmap" value="chicChicago/h19_min.baitmap" ftype="tabular" />
            <param name="rangeUpstream" value="200000" />
            <param name="rangeDownstream" value="200000" />
            <param name="plevel1" value="4.0" />
            <param name="plevel2" value="2.0" />
            <param name="onlySignificant" value="true" />
            <param name="writeLinksFile" value="true" />
            <param name="rmap" value="chicChicago/h19_min.rmap" ftype="tabular" />
            <param name="outputFormat" value="png" />
            <param name="dpi" value="30" />
            <output name="outFileName" ftype="png">
                <assert_contents>
                    <has_size value="20000" delta="19000" />
                </assert_contents>
            </output>
            <output name="linksFile" ftype="interval">
                <assert_contents>
                    <has_n_columns n="7" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="scores" value="chicChicago/scores.txt" ftype="tabular" />
            <conditional name="scope">
                <param name="select_scope" value="baitID" />
                <param name="baitID" value="403482" />
            </conditional>
            <param name="style" value="arcs" />
            <param name="outputFormat" value="pdf" />
            <param name="dpi" value="30" />
            <output name="outFileNamePdf" ftype="pdf">
                <assert_contents>
                    <has_text text="%PDF" />
                    <has_size value="30000" delta="29000" />
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[

CHiCAGO viewpoint plotting
=============================

**chicChicagoPlotViewpoint** plots CHiCAGO viewpoints from ``chicChicagoScores``' own output: a single bait, or every bait in a region, as a scatter plot or as arcs.

A native C++ implementation of CHiCAGO's own statistical model (Cairns et al. 2016).

_________________

Usage
-----

Pick either a single *Bait ID* or a region (every bait inside it) to plot, and a *Plot style*. *More significant score threshold* and *Less significant score threshold* set the two CHiCAGO-standard colour tiers (CHiCAGO's own convention uses 5 and 3). With a baitmap file, bait2bait rows can be kept (off by default) and, together with a .rmap file, the kept interactions can also be written out as a pyGenomeTracks ``links`` file for further plotting.

_________________

For more information about HiCExplorer please consider our documentation on readthedocs.io_.

.. _readthedocs.io: http://hicexplorer.readthedocs.io/en/latest/index.html

]]>    </help>
    <expand macro="citations">
        <citation type="doi">10.1186/s13059-016-0992-y</citation>
    </expand>
</tool>
