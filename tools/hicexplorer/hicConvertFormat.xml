                    <param name="matrix_h5_cooler" value="small_test_matrix.cool" />
                </conditional>

                <conditional name="outputFormat_conditional">
                    <param name="outputFormat_selector" value="h5" />
                </conditional>
            </conditional>
            <output name="output_converted_matrix" ftype="h5">
