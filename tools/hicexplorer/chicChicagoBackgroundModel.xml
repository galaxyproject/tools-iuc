<tool id="hicexplorer_chicchicagobackgroundmodel" name="@BINARY@" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>estimates CHiCAGO's own background model</description>
    <macros>
        <token name="@BINARY@">chicChicagoBackgroundModel</token>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements" />
    <command detect_errors="exit_code"><![CDATA[
        @CHICAGO_LINK_MATRICES@
        @BINARY@

            --rmap '$rmap'
            --baitmap '$baitmap'
            @CHICAGO_INPUT_SOURCE@
            --nperbin '$nperbin'
            --nbaitsperbin '$nbaitsperbin'
            --proxOE '$proxOE'
            --outFileName background_model.txt

            --minFragLen $minFragLen
            --maxFragLen $maxFragLen
            --minNPerBait $minNPerBait
            --maxLBrownEst $maxLBrownEst
            --binsize $binsize
            $noRemoveAdjacent
            --tlbFilterTopPercent $tlbFilterTopPercent
            --tlbMinProxOEPerBin $tlbMinProxOEPerBin
            --tlbMinProxB2BPerBin $tlbMinProxB2BPerBin
            --techNoiseMinBaitsPerBin $techNoiseMinBaitsPerBin
            --brownianNoiseSubset $brownianNoiseSubset
            --threads @THREADS@
]]>
    </command>
    <inputs>
        <param argument="--rmap" type="data" format="tabular,txt" label="CHiCAGO .rmap file" />
        <param argument="--baitmap" type="data" format="tabular,txt" label="CHiCAGO .baitmap file" />
        <expand macro="chicago_input_source" />
        <param argument="--nperbin" type="data" format="tabular,txt" label="CHiCAGO .npb design table" />
        <param argument="--nbaitsperbin" type="data" format="tabular,txt" label="CHiCAGO .nbpb design table" />
        <param argument="--proxOE" type="data" format="tabular,txt" label="CHiCAGO .poe design table" />
        <param argument="--minFragLen" type="integer" value="150" min="0" label="Minimum other-end length" />
        <param argument="--maxFragLen" type="integer" value="40000" min="0" label="Maximum other-end length" />
        <param argument="--minNPerBait" type="integer" value="250" min="0" label="Minimum reads per bait" />
        <param argument="--maxLBrownEst" type="integer" value="1500000" min="0" label="Brownian estimation distance cutoff" />
        <param argument="--binsize" type="integer" value="20000" min="1" label="Distance bin width" />
        <param argument="--noRemoveAdjacent" type="boolean" truevalue="--noRemoveAdjacent" falsevalue="" checked="false" label="Keep bait-adjacent interactions" />
        <param argument="--tlbFilterTopPercent" type="float" value="0.01" label="Top trans-count percent dropped before pooling" />
        <param argument="--tlbMinProxOEPerBin" type="integer" value="50000" min="1" label="Minimum non-bait2bait other ends per pool" />
        <param argument="--tlbMinProxB2BPerBin" type="integer" value="2500" min="1" label="Minimum bait2bait other ends per pool" />
        <param argument="--techNoiseMinBaitsPerBin" type="integer" value="1000" min="1" label="Minimum baits per technical-noise pool" />
        <param argument="--brownianNoiseSubset" type="integer" value="1000" min="1" label="Bait count above which R subsamples" help="Reported for compatibility only; this C++ port does not subsample." />
    </inputs>
    <outputs>
        <data name="outFileName" from_work_dir="background_model.txt" format="tabular" label="${tool.name} on ${on_string}: Background model" />
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="rmap" value="chicChicago/h19_min.rmap" ftype="tabular" />
            <param name="baitmap" value="chicChicago/h19_min.baitmap" ftype="tabular" />
            <param name="nperbin" value="chicChicago/h19_min.npb" ftype="tabular" />
            <param name="nbaitsperbin" value="chicChicago/h19_min.nbpb" ftype="tabular" />
            <param name="proxOE" value="chicChicago/h19_min.poe" ftype="tabular" />
            <conditional name="input_source">
                <param name="select_input_source" value="chinput" />
                <param name="chinput" value="chicChicago/sample.chinput" ftype="tabular" />
            </conditional>
            <output name="outFileName" ftype="tabular">
                <assert_contents>
                    <has_line line="[Settings]" />
                    <has_text text="[DistFun]" />
                    <has_text text="[Dispersion]" />
                    <has_text text="[BaitFactors]" />
                    <has_text text="[TechnicalNoise]" />
                    <has_size value="1400" delta="800" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="rmap" value="chicChicago/h19_min.rmap" ftype="txt" />
            <param name="baitmap" value="chicChicago/h19_min.baitmap" ftype="txt" />
            <param name="nperbin" value="chicChicago/h19_min.npb" ftype="txt" />
            <param name="nbaitsperbin" value="chicChicago/h19_min.nbpb" ftype="txt" />
            <param name="proxOE" value="chicChicago/h19_min.poe" ftype="txt" />
            <conditional name="input_source">
                <param name="select_input_source" value="chinput" />
                <param name="chinput" value="chicChicago/sample.chinput" ftype="txt" />
            </conditional>
            <param name="minFragLen" value="100" />
            <param name="maxFragLen" value="30000" />
            <param name="minNPerBait" value="200" />
            <param name="maxLBrownEst" value="1400000" />
            <param name="binsize" value="20000" />
            <param name="noRemoveAdjacent" value="true" />
            <param name="tlbFilterTopPercent" value="0.02" />
            <param name="tlbMinProxOEPerBin" value="40000" />
            <param name="tlbMinProxB2BPerBin" value="2000" />
            <param name="techNoiseMinBaitsPerBin" value="500" />
            <param name="brownianNoiseSubset" value="500" />
            <output name="outFileName" ftype="tabular">
                <assert_contents>
                    <has_line_matching expression="minFragLen\t100" />
                    <has_line_matching expression="maxFragLen\t30000" />
                    <has_line_matching expression="removeAdjacent\t0" />
                    <has_text text="[TechnicalNoise]" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="rmap" value="chicChicago/h19_min.rmap" ftype="tabular" />
            <param name="baitmap" value="chicChicago/h19_min.baitmap" ftype="tabular" />
            <param name="nperbin" value="chicChicago/h19_min.npb" ftype="tabular" />
            <param name="nbaitsperbin" value="chicChicago/h19_min.nbpb" ftype="tabular" />
            <param name="proxOE" value="chicChicago/h19_min.poe" ftype="tabular" />
            <conditional name="input_source">
                <param name="select_input_source" value="matrices" />
                <param name="matrix_h5_cooler_multiple" value="chicChicago/sample.cool" ftype="cool" />
            </conditional>
            <output name="outFileName" ftype="tabular">
                <assert_contents>
                    <has_line line="[Settings]" />
                    <has_text text="[DistFun]" />
                    <has_text text="[Dispersion]" />
                    <has_text text="[BaitFactors]" />
                    <has_text text="[TechnicalNoise]" />
                    <has_size value="1400" delta="800" />
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1">
            <param name="rmap" value="chicChicago/h19_min.rmap" ftype="tabular" />
            <param name="baitmap" value="chicChicago/h19_min.baitmap" ftype="tabular" />
            <param name="nperbin" value="chicChicago/h19_min.npb" ftype="tabular" />
            <param name="nbaitsperbin" value="chicChicago/h19_min.nbpb" ftype="tabular" />
            <param name="proxOE" value="chicChicago/h19_min.poe" ftype="tabular" />
            <conditional name="input_source">
                <param name="select_input_source" value="matrices" />
                <param name="matrix_h5_cooler_multiple" value="chicChicago/sample.h5" ftype="h5" />
            </conditional>
            <output name="outFileName" ftype="tabular">
                <assert_contents>
                    <has_line line="[Settings]" />
                    <has_text text="[DistFun]" />
                    <has_text text="[Dispersion]" />
                    <has_text text="[BaitFactors]" />
                    <has_text text="[TechnicalNoise]" />
                    <has_size value="1400" delta="800" />
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[

CHiCAGO background model
==========================

**chicChicagoBackgroundModel** estimates CHiCAGO's own background model (the Brownian and technical-noise components CHiCAGO's significance calling needs) directly from CHiCAGO's own design files and either a .chinput file or Hi-C matrices.

A native C++ implementation of CHiCAGO's own statistical model (Cairns et al. 2016). This is a different, capture-Hi-C-specific significance model from the generic viewpoint tools (``chicViewpoint``, ``chicSignificantInteractions``); use these ``chicChicago*`` tools when CHiCAGO's own design files (.rmap, .baitmap, .npb, .nbpb, .poe, usually produced by CHiCAGO's own design-file generator) are available.

_________________

Usage
-----

Provide the .rmap, .baitmap and three design tables (.npb, .nbpb, .poe) CHiCAGO's own design-file generator produces for the capture design, plus either a CHiCAGO .chinput file or the raw Hi-C matrices to derive fragment-pair counts from directly. The output background model file is CHiCAGO's own format and is the required input to ``chicChicagoScores``.

_________________

For more information about HiCExplorer please consider our documentation on readthedocs.io_.

.. _readthedocs.io: http://hicexplorer.readthedocs.io/en/latest/index.html

]]>    </help>
