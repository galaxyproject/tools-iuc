<tool id="tantan" name="tantan" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>find and mask simple repeats in DNA sequences</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <version_command>tantan --version</version_command>
    <command detect_errors="aggressive"><![CDATA[
tantan
    -f $output_type.f
    #if str($output_type.f) == '0'
        $output_type.x
        $output_type.c
    #end if
    -r $model.r
    -e $model.e
    -w $model.w
    -d $model.d
    -s $model.s
    -i $scoring.i
    -j $scoring.j
    -a $scoring.a
    -b $scoring.b
    '$input'
    > '$output'
    ]]></command>
    <inputs>
        <param name="input" type="data" format="fasta,fasta.gz" label="DNA sequences"/>
        <conditional name="output_type">
            <param argument="-f" type="select" label="Output">
                <option value="3" selected="true">BED of repeat intervals</option>
                <option value="0">Masked FASTA</option>
            </param>
            <when value="3"/>
            <when value="0">
                <param argument="-x" type="select" label="Masking">
                    <option value="" selected="true">Soft-mask (lowercase)</option>
                    <option value="-x N">Hard-mask with N</option>
                </param>
                <param argument="-c" type="boolean" truevalue="-c" falsevalue="" checked="false" label="Keep the letter case outside repeats" help="By default, tantan converts letters outside repeats to uppercase."/>
            </when>
        </conditional>
        <section name="model" title="Repeat model" expanded="false">
            <param argument="-r" type="float" min="0" max="1" value="0.005" label="Probability of a repeat start per position"/>
            <param argument="-e" type="float" min="0" max="1" value="0.05" label="Probability of a repeat end per position"/>
            <param argument="-w" type="integer" min="1" value="100" label="Maximum tandem repeat period"/>
            <param argument="-d" type="float" min="0" max="1" value="0.9" label="Probability decay per period"/>
            <param argument="-s" type="float" min="0" max="1" value="0.5" label="Minimum repeat probability for masking"/>
        </section>
        <section name="scoring" title="Scoring" expanded="false">
            <param argument="-i" type="integer" min="1" value="1" label="Match score"/>
            <param argument="-j" type="integer" min="0" value="1" label="Mismatch cost" help="0 means infinite."/>
            <param argument="-a" type="integer" min="0" value="0" label="Gap existence cost"/>
            <param argument="-b" type="integer" min="0" value="0" label="Gap extension cost" help="0 means no gaps."/>
        </section>
    </inputs>
    <outputs>
        <data name="output" format="bed" label="${tool.name} on ${on_string}">
            <change_format>
                <when input="output_type.f" value="0" format="fasta"/>
            </change_format>
        </data>
    </outputs>
    <tests>
        <!-- defaults: BED -->
        <test expect_num_outputs="1">
            <param name="input" value="tantan_input.fa" ftype="fasta"/>
            <output name="output" file="tantan_default.bed" ftype="bed"/>
        </test>
        <!-- fasta.gz input gives the same BED -->
        <test expect_num_outputs="1">
            <param name="input" value="tantan_input.fa.gz" ftype="fasta.gz"/>
            <output name="output" file="tantan_default.bed" ftype="bed"/>
        </test>
        <!-- soft-masked FASTA -->
        <test expect_num_outputs="1">
            <param name="input" value="tantan_input.fa" ftype="fasta"/>
            <conditional name="output_type">
                <param name="f" value="0"/>
            </conditional>
            <output name="output" file="tantan_softmask.fa" ftype="fasta"/>
        </test>
        <!-- hard-masked FASTA, letter case kept -->
        <test expect_num_outputs="1">
            <param name="input" value="tantan_input.fa" ftype="fasta"/>
            <conditional name="output_type">
                <param name="f" value="0"/>
                <param name="x" value="-x N"/>
                <param name="c" value="true"/>
            </conditional>
            <output name="output" file="tantan_hardmask_case.fa" ftype="fasta"/>
        </test>
        <!-- non-default repeat model -->
        <test expect_num_outputs="1">
            <param name="input" value="tantan_input.fa" ftype="fasta"/>
            <section name="model">
                <param name="r" value="0.01"/>
                <param name="s" value="0.9"/>
            </section>
            <output name="output" file="tantan_r0.01_s0.9.bed" ftype="bed"/>
        </test>
        <!-- maximum period 4 drops the period-10 repeat -->
        <test expect_num_outputs="1">
            <param name="input" value="tantan_input.fa" ftype="fasta"/>
            <section name="model">
                <param name="w" value="4"/>
            </section>
            <output name="output" file="tantan_w4.bed" ftype="bed"/>
        </test>
        <!-- gapped repeats -->
        <test expect_num_outputs="1">
            <param name="input" value="tantan_input.fa" ftype="fasta"/>
            <section name="scoring">
                <param name="a" value="1"/>
                <param name="b" value="1"/>
            </section>
            <output name="output" file="tantan_gaps.bed" ftype="bed"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
**What it does**

tantan finds simple repeats in DNA sequences. Simple repeats include tandem repeats and low-complexity regions. tantan uses a probabilistic model. Its main aim is to prevent false homology predictions, because simple repeats often align strongly to each other.

-----

**Input**

The input is DNA sequences in FASTA format (fasta or fasta.gz). This wrapper does not support protein sequences.

-----

**Output**

- BED (default): one line for each repeat interval, with 0-based start and end coordinates (``tantan -f3``).
- Masked FASTA: the input sequences with the repeats in lowercase (soft-mask) or replaced by ``N`` (hard-mask). By default, tantan changes the letters outside repeats to uppercase. To keep the input case, set *Keep the letter case outside repeats* (``-c``).

tantan ignores letter case when it finds repeats. A soft-masked input and its uppercase copy give the same intervals.

-----

**Options**

- Repeat model: the probability that a repeat starts (``-r``) or ends (``-e``) at a position and the maximum tandem repeat period (``-w``). This section also sets the probability decay for each period (``-d``) and the minimum repeat probability for masking (``-s``). A higher ``-r`` masks more sequence. A lower ``-r`` masks less.
- Scoring: the match score (``-i``), the mismatch cost (``-j``) and the gap costs (``-a``, ``-b``). Gaps are off by default.

All defaults are the tantan defaults.
    ]]></help>
    <expand macro="citations"/>
</tool>
