<macros>
    <token name="@TOOL_VERSION@">2.5.10.20211024</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">24.2</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">transvar</requirement>
        </requirements>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1038/nmeth.3622</citation>
        </citations>
    </xml>
    <!-- A single HGVS-style query. The default text sanitizer replaces the
         ">" of a substitution (and other HGVS punctuation) with "X", which
         silently turns every typed variant into an unparseable query, so the
         valid character set has to be spelled out here. -->
    <xml name="query_text" token_examples="">
        <param name="query" type="text" label="Variant" help="One variant, region or gene per query, in HGVS-like notation. Examples: @EXAMPLES@">
            <sanitizer invalid_char="">
                <valid initial="string.letters,string.digits">
                    <add value=":"/>
                    <add value="."/>
                    <add value="&gt;"/>
                    <add value="_"/>
                    <add value="-"/>
                    <add value="+"/>
                    <add value="*"/>
                    <add value="="/>
                    <add value="?"/>
                    <add value="/"/>
                    <add value="("/>
                    <add value=")"/>
                    <add value="["/>
                    <add value="]"/>
                </valid>
            </sanitizer>
            <validator type="empty_field"/>
        </param>
    </xml>
    <xml name="query_file">
        <param name="query_file" type="data" format="txt,tabular" label="Variant list" help="One variant, region or gene per line."/>
    </xml>
    <!-- Query input shared by the protein and cDNA modes; TransVar only
         accepts VCF input in genomic mode. -->
    <xml name="query_input" token_examples="">
        <conditional name="input_type">
            <param name="query_source" type="select" label="Variants to annotate">
                <option value="text" selected="true">Enter a single variant</option>
                <option value="file">Read a list of variants from a dataset</option>
            </param>
            <when value="text">
                <expand macro="query_text" examples="@EXAMPLES@"/>
            </when>
            <when value="file">
                <expand macro="query_file"/>
            </when>
        </conditional>
    </xml>
</macros>
