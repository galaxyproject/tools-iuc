<tool id="mothur_get_coremicrobiome" name="Get.coremicrobiome" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>fraction of OTUs for samples or abundances</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

## create symlinks to input datasets
ln -s '$otu' otu.dat &&

## collect the arguments of the mothur command in a list and join them with
## commas, so that the command can never end with a trailing comma
#set $mothur_args = []
#if $otu.is_of_type("mothur.relabund"):
    #silent $mothur_args.append("relabund=otu.dat")
#elif $otu.is_of_type("mothur.shared"):
    #silent $mothur_args.append("shared=otu.dat")
#end if
#if $label:
    #silent $mothur_args.append("label=" + str(str($label).replace(",","-")))
#end if
#if $groups:
    #silent $mothur_args.append("groups=" + str(str($groups).replace(",","-")))
#end if
#if $abundance:
    #silent $mothur_args.append("abundance=" + str($abundance))
#end if
#if $samples:
    #silent $mothur_args.append("samples=" + str($samples))
#end if

echo 'get.coremicrobiome(${",".join($mothur_args)})'
| mothur
| tee mothur.out.log
    ]]></command>
    <inputs>
        <param argument="otu" type="data" format="mothur.shared,mothur.relabund" label="shared or relabund - OTU Shared or Relabund"/>
        <param argument="label" type="select" optional="true" label="label - OTU Labels" multiple="true">
            <expand macro="labeloptions"/>
        </param>
        <param argument="groups" type="select" optional="true" label="groups - Pairwise comparision groups" multiple="true">
            <options>
                <filter type="data_meta" ref="otu" key="groups"/>
            </options>
        </param>
        <param argument="abundance" type="integer" optional="true" value="" min="0" max="100" label="abundance - list OTU names at this abundance"/>
        <param argument="samples" type="integer" optional="true" value="" min="1" label="samples - minimum number of samples requied to list OTU names"/>
        <param argument="output" type="select" label="output - fraction or count">
            <option value="fraction" selected="true">fraction</option>
            <option value="count">count</option>
        </param>
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <expand macro="logfile-output"/>
        <collection name="core_microbiome" type="list" label="${tool.name} on ${on_string}: core.microbiome files">
            <discover_datasets pattern=".*?\.(?P&lt;designation&gt;.*)\.core\.microbiome$" format="tabular"/>
        </collection>
        <collection name="core_microbiome_list" type="list" label="${tool.name} on ${on_string}: core.microbiome list files">
            <filter>abundance or samples </filter>
            <discover_datasets pattern=".*?\.(?P&lt;designation&gt;.*)\.core\.microbiomelist" format="tabular"/>
        </collection>
    </outputs>
    <tests>
        <test expect_num_outputs="2"><!-- test with default params -->
            <param name="otu" value="amazon.an.shared" ftype="mothur.shared"/>
            <output_collection name="core_microbiome" count="36">
                <element name="0.45" ftype="tabular">
                    <assert_contents>
                        <has_n_lines n="3"/>
                    </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="3"><!-- test with list output and label and group select-->
            <param name="otu" value="amazon.an.shared" ftype="mothur.shared"/>
            <param name="abundance" value="30"/>
            <param name="label" value="0.05,0.22,0.45"/>
            <param name="groups" value="forest,pasture"/>
            <!-- mothur >= 1.46 reads shared labels through Utils::getNextRelabund, which keeps handing
                 back records after the requested labels are exhausted, so 0.55 (the label that follows
                 0.45 in the file) is processed as well. -->
            <output_collection name="core_microbiome" count="4">
                <element name="0.05" ftype="tabular">
                    <assert_contents>
                        <has_n_lines n="3"/>
                    </assert_contents>
                </element>
                <element name="0.55" ftype="tabular">
                    <assert_contents>
                        <has_n_lines n="3"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="core_microbiome_list" count="4">
                <element name="0.05" ftype="tabular">
                    <assert_contents>
                        <has_n_lines n="3"/>
                        <has_line line="Samples&#009;OTUList_for_abund=30"/>
                        <has_line line="1&#009;"/>
                        <has_line line="2&#009;"/>
                    </assert_contents>
                </element>
                <element name="0.55" ftype="tabular">
                    <assert_contents>
                        <has_n_lines n="3"/>
                        <has_line line="Samples&#009;OTUList_for_abund=30"/>
                        <has_line line="1&#009;Otu01"/>
                        <has_line line="2&#009;Otu01"/>
                    </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
    </tests>
    <help><![CDATA[

@MOTHUR_OVERVIEW@

**Command Documentation**

The get.coremicrobiome_ command determines the fraction of OTUs that are found in varying numbers of samples for different minimum relative abundances.

.. _get.coremicrobiome: https://mothur.org/wiki/get.coremicrobiome/

    ]]></help>
    <expand macro="citations"/>
</tool>
