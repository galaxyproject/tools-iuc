<tool id="mothur_merge_files" name="Merge.files" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Merge data</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

## create symlinks to input datasets
#for $i in $merge.inputs:
    ln -s '$i' input${merge.inputs.index($i)}.dat &&
#end for

## collect the arguments of the mothur command in a list and join them with
## commas, so that the command can never end with a trailing comma
#set $mothur_args = []
#set $mothur_arg = "input="
#for $i in $merge.inputs:
    #set $mothur_arg += "input" + str($merge.inputs.index($i)) + ".dat-"
#end for
#silent $mothur_args.append($mothur_arg)
#silent $mothur_args.append("output=" + str($output))

echo 'merge.files(${",".join($mothur_args)})'
| sed 's/-,/,/g'
| mothur
| tee mothur.out.log
    ]]></command>
    <inputs>
    <conditional name="merge">
        <param argument="type" type="select" format="fasta,qual,mothur.groups,mothur.names,mothur.accnos" label="Merge">
            <option value="fasta">fasta files</option>
            <option value="qual">qual files</option>
            <option value="groups">group files</option>
            <option value="names">name files</option>
            <option value="accnos">accnos files</option>
        </param>
        <when value="fasta">
            <param argument="inputs" type="data" format="fasta" multiple="true" label="inputs - fasta"/>
        </when> <!-- fasta -->
        <when value="qual">
            <param argument="inputs" type="data" format="qual" multiple="true" label="inputs - qual"/>
        </when> <!-- qual -->
        <when value="groups">
            <param argument="inputs" type="data" format="mothur.groups" multiple="true" label="inputs - groups"/>
        </when> <!-- groups -->
        <when value="names">
            <param argument="inputs" type="data" format="mothur.names" multiple="true" label="inputs - names"/>
        </when> <!-- names -->
        <when value="accnos">
            <param argument="inputs" type="data" format="mothur.accnos" multiple="true" label="inputs - accnos"/>
        </when> <!-- fasta -->
    </conditional> <!-- merge -->
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <expand macro="logfile-output"/>
        <data format_source="merge|inputs" name="output" label="${tool.name} on ${on_string}: ${merge.type}"/>
    </outputs>
    <tests>
        <test expect_num_outputs="2">
            <conditional name="merge">
                <param name="type" value="fasta"/>
                <param name="inputs" value="sample1.fa,sample2.fa,sample3.fa" ftype="fasta"/>
            </conditional>
            <output name="output" file="output.fa" ftype="fasta"/>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
    </tests>
    <help><![CDATA[
@MOTHUR_OVERVIEW@

**Command Documentation**

The merge.files_ command merge inputs into a single output.

.. _merge.files: https://mothur.org/wiki/merge.files/


    ]]></help>
    <expand macro="citations"/>
</tool>
