<tool id="mothur_cluster_split" name="Cluster.split" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Assign sequences to OTUs based on taxonomy and cluster them</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements">
        <requirement type="package" version="2.31.0">vsearch</requirement>
    </expand>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

## create symlinks to input datasets
ln -s '$fasta' input.fasta &&
ln -s '$taxonomy' input.taxonomy &&
#if $nameOrCount.ext == "mothur.names":
    ln -s '$nameOrCount' input.names &&
#else:
    ln -s '$nameOrCount' input.count_table &&
#end if

echo 'cluster.split(
    fasta=input.fasta,
    taxonomy=input.taxonomy,
    #if $nameOrCount.ext == "mothur.names":
        name=input.names,
    #else:
        count=input.count_table,
    #end if
    taxlevel=$taxlevel,
    method=$condmethod.method,
    #if $condmethod.method == "opti":
        metric=$condmethod.metric,
        initialize=$condmethod.initialize,
        delta=$condmethod.delta,
        iters=$condmethod.iters,
    #end if
    classic=$classic,
    #if float($cutoff) > 0.0:
        cutoff=$cutoff,
    #end if
    precision=$precision,
    #if $dist == "true":
        dist=$dist,
    #end if
    cluster=$cluster,
    runsensspec=$runsensspec,
    processors='\${GALAXY_SLOTS:-8}'
)'
| sed 's/ //g; s/,)$/)/'  ## mothur trips over whitespace; a trailing comma segfaults mothur >1.42
| mothur
| tee mothur.out.log
    ]]></command>
    <inputs>
        <param argument="fasta" type="data" format="mothur.align,fasta" label="Fasta"
            help="fasta file containing the sequences to cluster; the VSEARCH methods (agc and dgc) require aligned sequences"/>
        <param argument="taxonomy" type="data" format="mothur.seq.taxonomy" label="taxonomy - Taxonomy (from Classify.seqs)"
            help="taxonomy for each sequence; sequences are split into groups sharing the same taxonomy up to the taxlevel, and clustered within each group"/>
        <param name="nameOrCount" type="data" format="mothur.names,mothur.count_table" label="name file or count table - Sequences Name reference"
            help="name file (one sequence name per line, with length) or count table; required. With a name file, rank and species abundance files are also produced; with a count table, only the OTU list is produced"/>
        <param argument="taxlevel" type="integer" value="3" min="1" label="taxlevel - taxonomy level for split (default=3)"
            help="taxonomy level you want to use to split the sequences, default=3, meaning use the first three taxon levels in each taxonomy line"/>
        <conditional name="condmethod">
            <param argument="method" type="select" label="Clustering Method">
                <option value="opti" selected="true">Opticlust method</option>
                <option value="furthest">Furthest neighbor</option>
                <option value="nearest">Nearest neighbor</option>
                <option value="average">Average neighbor</option>
                <option value="weighted">Weighted neighbor</option>
                <option value="agc">Abundance-based greedy clustering (agc)(VSEARCH)</option>
                <option value="dgc">Distance-based greedy clustering (dgc)(VSEARCH)</option>
            </param>
            <when value="opti">
                <expand macro="params-opticlust"/>
            </when>
            <when value="furthest"/>
            <when value="nearest"/>
            <when value="average"/>
            <when value="weighted"/>
            <when value="agc"/>
            <when value="dgc"/>
        </conditional>
        <param argument="classic" type="boolean" checked="false" truevalue="true" falsevalue="false" label="classic - Use cluster.classic"
            help="run the clustering with cluster.classic instead of the default cluster algorithms; cannot be combined with the agc or dgc methods"/>
        <param argument="cutoff" type="float" value="0.0" min="0.0" label="cutoff - Distance Cutoff threshold - 0 means mothur default"
            help="Ignore pairwise distances larger than this. 0 leaves the mothur default, which is 0.03 for opti, agc and dgc and 0.15 for furthest, nearest, average and weighted"/>
        <param argument="precision" type="select" label="precision - Precision for rounding distance values"
            help="Set higher precision for longer genome scale sequence lengths">
            <option value="10">.1</option>
            <option value="100" selected="true">.01</option>
            <option value="1000">.001</option>
            <option value="10000">.0001</option>
            <option value="100000">.00001</option>
            <option value="1000000">.000001</option>
        </param>
        <param argument="dist" type="boolean" checked="false" truevalue="true" falsevalue="false" label="dist - Also output the merged distance file"
            help="output a single distance file with all pairwise distances below the cutoff; ignored for the opti method, where the distance file is produced when runsensspec is on"/>
        <param argument="cluster" type="boolean" falsevalue="false" truevalue="true" checked="true" label="perform clustering?"
            help="indicate whether you want to run the clustering or just split the sequences into per-taxonomy-group distance files"/>
        <param argument="runsensspec" type="boolean" truevalue="true" falsevalue="false" checked="true" label="runsensspec" help="run the sens.spec command on the completed list file (opti method only)"/>
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <expand macro="logfile-output"/>
        <data name="otulist" format="mothur.list" from_work_dir="input.*.list" label="${tool.name} on ${on_string}: list (OTU List)">
            <filter>cluster</filter>
        </data>
        <data name="rabund" format="mothur.rabund" from_work_dir="input.*.rabund" label="${tool.name} on ${on_string}: rabund (Rank Abundance)">
             <filter>cluster and nameOrCount.ext != "mothur.count_table"</filter>
        </data>
        <data name="sabund" format="mothur.sabund" from_work_dir="input.*.sabund" label="${tool.name} on ${on_string}: sabund (Species Abundance)">
             <filter>cluster and nameOrCount.ext != "mothur.count_table"</filter>
        </data>
        <data name="distfile" format="mothur.pair.dist" from_work_dir="input.dist" label="${tool.name} on ${on_string}: merged distance file">
             <filter>dist or (condmethod['method'] == "opti" and runsensspec)</filter>
        </data>
        <data name="sensspec" format="txt" from_work_dir="input.*.sensspec" label="${tool.name} on ${on_string}: sensspec">
             <filter>runsensspec and condmethod['method'] == "opti"</filter>
        </data>
        <collection name="splitdist" type="list" label="${tool.name} on ${on_string}: split dist">
            <filter>not cluster</filter>
            <discover_datasets pattern="input\.(?P&lt;designation&gt;\d+)\.disttemp" format="mothur.pair.dist"/>
        </collection>
        <collection name="splitnames" type="list" label="${tool.name} on ${on_string}: split names">
            <filter>not cluster</filter>
            <discover_datasets pattern="input\.(?P&lt;designation&gt;\d+)\.name\.temp" format="mothur.names"/>
        </collection>
        <data name="singletons" format="mothur.names" from_work_dir="input.singletons.temp" label="${tool.name} on ${on_string}: singletons">
             <filter>not cluster and nameOrCount.ext != "mothur.count_table"</filter>
        </data>
        <data name="singletonsct" format="mothur.count_table" from_work_dir="input.singletons.temp" label="${tool.name} on ${on_string}: singletons (count table)">
             <filter>not cluster and nameOrCount.ext == "mothur.count_table"</filter>
        </data>
        <data name="splitfile" format="txt" from_work_dir="input.file" label="${tool.name} on ${on_string}: split.file">
            <filter>not cluster</filter>
        </data>
    </outputs>
