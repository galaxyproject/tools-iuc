<tool id="mothur_get_lineage" name="Get.lineage" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Picks by taxon</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

#import re
## create symlinks to input datasets
ln -s '$file.taxonomy' file.taxonomy.dat &&
#if $file.filetype == "useconstaxonomy":
    ln -s '$file.shared' file.shared.dat &&
    ln -s '$file.list' file.list.dat &&
#end if
ln -s '$fasta_in' fasta_in.dat &&
ln -s '$group_in' group_in.dat &&
ln -s '$alignreport_in' alignreport_in.dat &&
ln -s '$list_in' list_in.dat &&
ln -s '$name_in' name_in.dat &&
ln -s '$count' count.dat &&

## collect the arguments of the mothur command in a list and join them with
## commas, so that the command can never end with a trailing comma
#set $mothur_args = []
#if $file.filetype == "usetaxonomy":
    #silent $mothur_args.append("taxonomy=file.taxonomy.dat")
#else
    #silent $mothur_args.append("constaxonomy=file.taxonomy.dat")
    #if $file.shared:
        #silent $mothur_args.append("shared=file.shared.dat")
    #end if
    #if $file.list:
        #silent $mothur_args.append("list=file.list.dat")
    #end if
#end if
#if $file.taxons:
    #set taxonstring=str($file.taxons).replace(",","-")
    #silent $mothur_args.append("taxon='\"'" + str($re.sub("(\s|,)+",",",$re.sub("\(\d+\)","", $taxonstring ))) + "'\"'")
#elif $taxon:
    #silent $mothur_args.append("taxon='\"'" + str($re.sub("(\s|,)+",",",$re.sub("\(\d+\)","", str($taxon) )).replace(",","-")) + "'\"'")
#end if
#if $fasta_in:
    #silent $mothur_args.append("fasta=fasta_in.dat")
#end if
#if $group_in:
    #silent $mothur_args.append("group=group_in.dat")
#end if
#if $alignreport_in:
    #silent $mothur_args.append("alignreport=alignreport_in.dat")
#end if
#if $list_in:
    #silent $mothur_args.append("list=list_in.dat")
#end if
#if $name_in:
    #silent $mothur_args.append("name=name_in.dat")
    #silent $mothur_args.append("dups=" + str($dups))
#end if
#if $count:
    #silent $mothur_args.append("count=count.dat")
#end if

echo 'get.lineage(${",".join($mothur_args)})'
| mothur
| tee mothur.out.log

## work around an upstream typo: get.lineage names the alignreport output
## "[filename],pick.[extension]" so mothur leaves the literal [extension] in the name
&& if [ -e 'alignreport_in.pick.[extension]' ]; then mv 'alignreport_in.pick.[extension]' alignreport_in.pick.align.report; fi
    ]]></command>
    <inputs>
        <conditional name="file">
            <param name="filetype" type="select" label="choose which file is used">
                <option value="usetaxonomy" selected="true">taxonomy</option>
                <option value="useconstaxonomy">constaxonomy</option>
            </param>
            <when value="usetaxonomy">
                <param name="taxonomy" type="data" format="mothur.seq.taxonomy" label="taxonomy - Taxonomy" help="please make sure your file has no quotation marks in it"/>
                <param name="taxons" type="select" size="120" optional="true" multiple="true" label="Browse Taxons from Taxonomy">
                    <options from_dataset="taxonomy">
                        <column name="name" index="1"/>
                        <column name="value" index="1"/>
                        <filter type="unique_value" column="1"/>
                        <filter type="sort_by" column="1"/>
                    </options>
                    <sanitizer>
                        <valid initial="default">
                            <add preset="string.printable"/>
                            <add value=";"/>
                            <remove value="&quot;"/>
                            <remove value="&apos;"/>
                        </valid>
                    </sanitizer>
                </param>
            </when>
            <when value="useconstaxonomy">
                <param name="taxonomy" type="data" format="mothur.cons.taxonomy" label="constaxonomy - Constaxonomy file. Provide either a constaxonomy file or a taxonomy file"
                    help="please make sure your file has no quotation marks in it"/>
                <param name="taxons" type="select" size="120" optional="true" multiple="true" label="Browse Taxons from Taxonomy">
                    <options from_dataset="taxonomy">
                        <column name="name" index="2"/>
                        <column name="value" index="2"/>
                        <filter type="unique_value" column="2"/>
                        <filter type="sort_by" column="2"/>
                    </options>
                    <sanitizer>
                        <valid initial="default">
                            <add preset="string.printable"/>
                            <add value=";"/>
                            <remove value="&quot;"/>
                            <remove value="&apos;"/>
                        </valid>
                    </sanitizer>
                </param>
                <param name="shared" type="data" format="mothur.shared" optional="true" label="shared - shared file"/>
                <param name="list" type="data" format="mothur.list" optional="true" label="list - list file"/>
            </when>
        </conditional>
        <param name="taxon" type="text" area="True" size="5x120" label="taxon - Manually select Taxons for filtering"
            help="If no taxons selected from file, Enter 1 or more taxons separated by dashes here, e.g. Bacteria;Firmicutes;-Bacteria;Actinobacteria; ">
            <!-- taxonomy strings are separated by semicolons, which are not part of the default
                 set of valid characters and would otherwise be replaced by "X" -->
            <sanitizer>
                <valid>
                    <add value=";"/>
                </valid>
            </sanitizer>
        </param>
        <param name="fasta_in" type="data" format="fasta" optional="true" label="fasta - Fasta Sequences"/>
        <param name="group_in" type="data" format="mothur.groups" optional="true" label="group - Groups"/>
        <param name="alignreport_in" type="data" format="mothur.align.report" optional="true" label="alignreport - Align Report"/>
        <param name="list_in" type="data" format="mothur.list" optional="true" label="list - OTU List"/>
        <param name="name_in" type="data" format="mothur.names" optional="true" label="name - Sequences Name reference"/>
        <param name="dups" type="boolean" truevalue="true" falsevalue="false" checked="true" label="dups - Apply to duplicate names"/>
        <param name="count" type="data" format="mothur.count_table" optional="true"  label="Count Table"
            help="The count file is similar to the name file in that it is used to represent the number of duplicate sequences for a given representative sequence. It can also contain group information"/>
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <expand macro="logfile-output"/>
        <data name="taxonomy_out" format="mothur.seq.taxonomy" from_work_dir="file.taxonomy.pick.dat" label="${tool.name} on ${on_string}: pick.taxonomy"/>
        <data name="fasta_out" format_source="fasta_in" from_work_dir="fasta_in.pick.dat" label="${tool.name} on ${on_string}: pick.fasta">
            <filter>fasta_in</filter>
        </data>
        <data name="group_out" format="mothur.groups" from_work_dir="group_in.pick.dat" label="${tool.name} on ${on_string}: pick.group">
            <filter>group_in</filter>
        </data>
        <collection name="list_out" type="list" label="${tool.name} on ${on_string}: pick.list">
            <filter>list_in</filter>
            <discover_datasets pattern="list_in\.(?P&lt;designation&gt;[0-9.]+|unique)\.pick\.dat" format="mothur.list"/>
        </collection>
        <data name="name_out" format="mothur.names" from_work_dir="name_in.pick.dat" label="${tool.name} on ${on_string}: pick.name">
            <filter>name_in</filter>
        </data>
        <data name="alignreport_out" format="mothur.align.report" from_work_dir="alignreport_in.pick.align.report" label="${tool.name} on ${on_string}: pick.align.report">
            <filter>alignreport_in</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="1"><!-- test with defaults and single taxon -->
            <conditional name="file">
                <param name="filetype" value="usetaxonomy"/>
                <param name="taxonomy" value="abrecovery.pds.wang.taxonomy" ftype="mothur.seq.taxonomy"/>
            </conditional>
            <param name="taxon" value="Bacteria;Firmicutes;"/>
            <output name="taxonomy_out">
                <assert_contents>
                    <has_n_lines n="106"/>
                    <has_line_matching expression="^AY457915\tBacteria\(100\);Firmicutes\(100\);.*"/>
                    <has_line_matching expression="^AY457676\t?.*"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="6"><!-- test with multiple taxons and all additional files -->
            <conditional name="file">
                <param name="filetype" value="usetaxonomy"/>
                <param name="taxonomy" value="abrecovery.pds.wang.taxonomy" ftype="mothur.seq.taxonomy"/>
            </conditional>
            <param name="taxon" value="Bacteria;Firmicutes;,Bacteria;Actinobacteria;"/>
            <param name="group_in" value="abrecovery.groups" ftype="mothur.groups"/>
            <param name="fasta_in" value="abrecovery.fasta" ftype="fasta"/>
            <param name="name_in" value="abrecovery.names" ftype="mothur.names"/>
            <param name="alignreport_in" value="Mock_S280_L001_R1_001_small.trim.contigs.good.align.report" ftype="mothur.align.report"/>
            <param name="list_in" value="amazon.an.list" ftype="mothur.list"/>
            <output name="taxonomy_out">
                <assert_contents>
                    <has_n_lines n="119"/>
                    <has_line_matching expression="^AY457915\tBacteria\(100\);Firmicutes\(100\);.*"/>
                </assert_contents>
            </output>
            <output name="group_out" ftype="mothur.groups">
                <assert_contents>
                    <has_n_lines n="119"/>
                </assert_contents>
            </output>
            <output name="fasta_out" ftype="fasta">
                <assert_contents>
                    <has_n_lines n="238"/>
                    <has_line_matching expression="&gt;\S+.*" n="119"/>
                </assert_contents>
            </output>
            <output name="name_out" ftype="mothur.names">
                <assert_contents>
                    <has_n_lines n="119"/>
                </assert_contents>
            </output>
            <output name="alignreport_out" ftype="mothur.align.report">
                <assert_contents>
                    <has_n_lines n="1"/>
                    <has_line_matching expression="QueryName\tQueryLength\t.*"/>
                </assert_contents>
            </output>
            <!-- none of the sequences of these files are in the picked taxonomy -->
            <output_collection name="list_out" count="36">
                <element name="0.05" ftype="mothur.list">
                    <assert_contents>
                        <has_n_lines n="0"/>
                    </assert_contents>
                </element>
            </output_collection>
        </test>
        <test expect_num_outputs="1"><!-- test with taxons from file -->
            <conditional name="file">
                <param name="filetype" value="usetaxonomy"/>
                <param name="taxonomy" value="abrecovery.pds.wang.taxonomy" ftype="mothur.seq.taxonomy"/>
                <param name="taxons" value="Bacteria(100);Firmicutes(100);Clostridia(100);Clostridiales(100);Lachnospiraceae(100);Dorea(99);,Bacteria(100);Firmicutes(100);Clostridia(100);Clostridiales(100);Lachnospiraceae(100);Roseburia(47);"/>
            </conditional>
            <output name="taxonomy_out">
                <assert_contents>
                    <has_n_lines n="12"/>
                    <has_line_matching expression="^AY457913\tBacteria\(100\);Firmicutes\(100\);Clostridia\(100\);.*"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1"><!-- test with constaxonomy file -->
            <conditional name="file">
                <param name="filetype" value="useconstaxonomy"/>
                <param name="taxonomy" value="example.constaxonomy" ftype="mothur.cons.taxonomy"/>
            </conditional>
            <param name="taxon" value="Bacteria;Bacteroidetes;"/>
            <output name="taxonomy_out">
                <assert_contents>
                    <has_n_lines n="4"/>
                    <has_line_matching expression="^OTU\tSize\tTaxonomy$"/>
                    <has_line_matching expression="^Otu1\t34003\tBacteria\(100\);Bacteroidetes\(100\);.*"/>
                </assert_contents>
            </output>
        </test>
        <test expect_num_outputs="1"><!-- test with constaxonomy file and taxons from file -->
            <conditional name="file">
                <param name="filetype" value="useconstaxonomy"/>
                <param name="taxonomy" value="example.constaxonomy" ftype="mothur.cons.taxonomy"/>
                <param name="taxons" value="Bacteria(100);Firmicutes(100);Clostridia(70);Clostridiales(70);Lachnospiraceae(51);unclassified;,Bacteria(100);Proteobacteria(100);Gammaproteobacteria(100);unclassified;unclassified;unclassified;"/>
            </conditional>
            <output name="taxonomy_out">
                <assert_contents>
                    <has_n_lines n="3"/>
                    <has_line_matching expression="^OTU\tSize\tTaxonomy$"/>
                    <has_line_matching expression="^Otu2\t11218\tBacteria;Firmicutes;Clostridia;Clostridiales;.*"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[

@MOTHUR_OVERVIEW@

**Command Documentation**

The get.lineage_ command reads a taxonomy_ file and a taxon and generates a new file that contains only the sequences in the that are from that taxon. You may also include either a fasta, name_, group_, list_, or align.report_ file to this command and mothur will generate new files for each of those containing only the selected sequences.

.. _taxonomy: https://mothur.org/wiki/taxonomy_outline/
.. _name: https://mothur.org/wiki/name_file/
.. _group: https://mothur.org/wiki/group_file/
.. _list: https://mothur.org/wiki/list_file/
.. _align.report: https://mothur.org/wiki/align.seqs/
.. _get.lineage: https://mothur.org/wiki/get.lineage/

**Note on mothur 1.48**

mothur names the align report output ``[filename],pick.[extension]`` (a typo in
``getlineagecommand.cpp``), which leaves the literal string ``[extension]`` in
the file name.  The wrapper renames the file to ``*.pick.align.report`` so that
the output is collected reliably.


    ]]></help>
    <expand macro="citations"/>
</tool>
