<tool id="mothur_sub_sample" name="Sub.sample" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Create a sub sample</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

## create symlinks to input datasets
ln -s '$input.otu' input_otu.dat &&
ln -s '$count' count.dat &&
ln -s '$taxonomy' taxonomy.dat &&
#if ($input.format == "fasta" or $input.format == "list") and $input.use_group.to_filter == "yes":
    ln -s '$input.use_group.group_in' input_use_group_group_in.dat &&
#end if

## collect the arguments of the mothur command in a list and join them with
## commas, so that the command can never end with a trailing comma
#set $mothur_args = []
#if $input.format == "fasta":
    #silent $mothur_args.append("fasta=input_otu.dat")
#else
    #if $input.format == "list":
        #silent $mothur_args.append("list=input_otu.dat")
    #elif $input.format == "sabund":
        #silent $mothur_args.append("sabund=input_otu.dat")
    #elif $input.format == "rabund":
        #silent $mothur_args.append("rabund=input_otu.dat")
    #elif $input.format == "shared":
        #silent $mothur_args.append("shared=input_otu.dat")
        #if $input.groups:
            #silent $mothur_args.append("groups=" + str(str($input.groups).replace(",","-")))
        #end if
    #end if
    #if $input.label:
        #silent $mothur_args.append("label=" + str(str($input.label).replace(",","-")))
    #end if
#end if
#if $input.format == "fasta" or $input.format == "list":
    #if $input.use_group.to_filter == "yes":
        #silent $mothur_args.append("group=input_use_group_group_in.dat")
        #if $input.use_group.groups:
            #silent $mothur_args.append("groups=" + str(str($input.use_group.groups).replace(",","-")))
        #end if
        #silent $mothur_args.append("persample=" + str($input.use_group.persample))
    #end if
#end if
#if $count:
    #silent $mothur_args.append("count=count.dat")
#end if
#if $taxonomy:
    #silent $mothur_args.append("taxonomy=taxonomy.dat")
#end if
#if $size:
    #silent $mothur_args.append("size=" + str($size))
#end if

echo 'sub.sample(${",".join($mothur_args)})'
| mothur
| tee mothur.out.log

## mothur names the subsampled count table after the count input ('count.subsample.dat')
## or after the fasta input ('input_otu.subsample.count_table'); use one stable name
&& if [ -e count.subsample.dat ]; then mv count.subsample.dat count.subsample.count_table; fi
&& if [ -e input_otu.subsample.count_table ]; then mv input_otu.subsample.count_table count.subsample.count_table; fi
    ]]></command>
    <inputs>
        <conditional name="input">
            <param argument="format" type="select" label="Select type of data to sub sample">
                <option value="fasta">FASTA</option>
                <option value="list">OTU List</option>
                <option value="shared">OTU Shared</option>
                <option value="sabund">OTU Shared Abundance (sabund)</option>
                <option value="rabund">OTU Relative Abundance (rabund)</option>
            </param>
            <when value="fasta">
                <param argument="otu" type="data" format="fasta" label="fasta - "/>
                <conditional name="use_group">
                    <param argument="to_filter" type="select" label="Use groups?">
                        <option value="no">No</option>
                        <option value="yes">Yes</option>
                    </param>
                    <when value="no"/>
                    <when value="yes">
                        <param argument="group_in" type="data" format="mothur.groups" label="group - Groups"/>
                        <param argument="groups" type="select" optional="true" label="groups - Pick groups to include" multiple="true">
                            <options>
                                <filter type="data_meta" ref="group_in" key="groups"/>
                            </options>
                        </param>
                        <param argument="persample" type="boolean" truevalue="true" falsevalue="false" checked="false" label="persample - select subsample of the same size from each of the groups"/>
                    </when>
                </conditional>
            </when>
            <when value="list">
                <param argument="otu" type="data" format="mothur.list" label="list - OTU List"/>
                <conditional name="use_group">
                    <param argument="to_filter" type="select" label="Use groups">
                        <option value="no">No</option>
                        <option value="yes">Yes</option>
                    </param>
                    <when value="no"/>
                    <when value="yes">
                        <param argument="group_in" type="data" format="mothur.groups" label="group - Groups"/>
                        <param argument="groups" type="select" optional="true" label="groups - Pick groups to include" multiple="true">
                            <options>
                                <filter type="data_meta" ref="group_in" key="groups"/>
                            </options>
                        </param>
                        <param argument="persample" type="boolean" truevalue="true" falsevalue="false" checked="false" label="persample - select subsample of the same size from each of the groups"/>
                    </when>
                </conditional>
                <param argument="label" type="select" label="label - OTU Labels" optional="true" multiple="true">
                    <expand macro="labeloptions"/>
                </param>
            </when>
            <when value="shared">
                <param argument="otu" type="data" format="mothur.shared" label="shared - OTU Shared"/>
                <param argument="groups" type="select" optional="true" label="groups - Pick groups to include" multiple="true">
                    <options>
                        <filter type="data_meta" ref="otu" key="groups"/>
                    </options>
                </param>
                <param argument="label" type="select" label="label - OTU Labels" optional="true" multiple="true">
                    <expand macro="labeloptions"/>
                </param>
            </when>
            <when value="sabund">
                <param argument="otu" type="data" format="mothur.sabund" label="sabund - OTU Species Abundance"/>
                <param argument="label" type="select" label="label - OTU Labels" optional="true" multiple="true">
                    <expand macro="labeloptions"/>
                </param>
            </when>
            <when value="rabund">
                <param argument="otu" type="data" format="mothur.rabund" label="rabund - OTU Relative Abundance"/>
                <param argument="label" type="select" label="label - OTU Labels" optional="true" multiple="true">
                    <expand macro="labeloptions"/>
                </param>
            </when>
        </conditional>
        <param argument="size" type="integer" value="" min="1" optional="true" label="size - If set, the number of samples to pick"/>
        <param argument="count" type="data" format="mothur.count_table" optional="true" label="count - a count_table" help="generated by count.seqs"/>
        <param argument="taxonomy" type="data" format="mothur.seq.taxonomy,mothur.ref.taxonomy" optional="true" label="taxonomy - allows a taxonomy file"/>
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <expand macro="logfile-output"/>
        <data name="fasta_out" format_source="input|otu" from_work_dir="input_otu.subsample.dat" label="${tool.name} on ${on_string}: subsample.fasta">
            <filter>input['format'] == 'fasta'</filter>
        </data>
        <data name="taxonomy_out" format_source="taxonomy" from_work_dir="taxonomy.subsample.dat" label="${tool.name} on ${on_string}: subsample.taxonomy">
            <filter>taxonomy</filter>
        </data>
        <collection name="list_out" type="list" label="${tool.name} on ${on_string}: subsample.list">
            <filter>input['format'] == 'list'</filter>
            <discover_datasets pattern="input_otu\.(?P&lt;designation&gt;[0-9.]+|unique)\.subsample\.dat" format="mothur.list"/>
        </collection>
        <collection name="shared_out" type="list" label="${tool.name} on ${on_string}: subsample.shared">
            <filter>input['format'] == 'shared'</filter>
            <discover_datasets pattern="input_otu\.(?P&lt;designation&gt;[0-9.]+|unique)\.subsample\.dat" format="mothur.shared"/>
        </collection>
        <data name="sabund_out" format="mothur.sabund" from_work_dir="input_otu.subsample.dat" label="${tool.name} on ${on_string}: subsample.sabund">
            <filter>input['format'] == 'sabund'</filter>
        </data>
        <data name="rabund_out" format="mothur.rabund" from_work_dir="input_otu.subsample.dat" label="${tool.name} on ${on_string}: subsample.rabund">
            <filter>input['format'] == 'rabund'</filter>
        </data>
        <data name="group_out" format="mothur.groups" from_work_dir="input_use_group_group_in*.subsample.*" label="${tool.name} on ${on_string}: subsample.groups">
            <filter>(input['format'] == 'fasta' or input['format'] == 'list') and input['use_group']['to_filter'] == 'yes'</filter>
        </data>
        <data name="count_out" format="mothur.count_table" from_work_dir="count.subsample.count_table" label="${tool.name} on ${on_string}: subsample.count_table">
            <filter>(input['format'] == 'fasta' or input['format'] == 'list') and count</filter>
        </data>
    </outputs>
    <tests>
        <test expect_num_outputs="2"><!-- test with list -->
            <conditional name="input">
                <param name="format" value="list"/>
                <param name="otu" value="amazon.an.list" ftype="mothur.list"/>
            </conditional>
            <output_collection name="list_out" count="36">
                <element name="0.20" ftype="mothur.list">
                    <assert_contents>
                       <has_text text="label"/>
                       <has_text text="numOtus"/>
                   </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="3"><!-- test with list and group file and label select-->
            <conditional name="input">
                <param name="format" value="list"/>
                <param name="otu" value="amazon.an.list" ftype="mothur.list"/>
                <conditional name="use_group">
                    <param name="to_filter" value="yes"/>
                    <param name="group_in" value="amazon.groups" ftype="mothur.groups"/>
                    <param name="groups" value="forest,pasture"/>
                </conditional>
                <param name="label" value="0.20,0.45,0.55"/>
            </conditional>
            <output_collection name="list_out" count="3">
                <element name="0.20" ftype="mothur.list">
                    <assert_contents>
                        <has_text text="label"/>
                        <has_text text="numOtus"/>
                   </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="3"><!-- test with fasta and taxonomy -->
            <conditional name="input">
                <param name="format" value="fasta"/>
                <param name="otu" value="amazon.fasta" ftype="fasta"/>
            </conditional>
            <param name="taxonomy" value="amazon.wang.wang.taxonomy" ftype="mothur.seq.taxonomy"/>
            <output name="fasta_out" ftype="fasta">
                <assert_contents>
                    <has_text text=">U"/>
                </assert_contents>
            </output>
            <output name="taxonomy_out" ftype="mothur.seq.taxonomy">
                <assert_contents>
                    <has_line_matching expression="^U[0-9]+\tBacteria.*$"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="3"><!-- test with fasta and group file -->
            <conditional name="input">
                <param name="format" value="fasta"/>
                <param name="otu" value="amazon.fasta" ftype="fasta"/>
                <conditional name="use_group">
                    <param name="to_filter" value="yes"/>
                    <param name="group_in" value="amazon.groups" ftype="mothur.groups"/>
                    <param name="groups" value="forest,pasture"/>
                </conditional>
            </conditional>
            <output name="fasta_out" ftype="fasta">
                <assert_contents>
                    <has_text_matching expression=">U[0-9]+"/>
                </assert_contents>
            </output>
            <output name="group_out" ftype="mothur.groups">
                <assert_contents>
                    <has_line_matching expression="^U[0-9]+\t(forest|pasture)$"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="3"><!-- test with fasta and a count table that carries group columns -->
            <conditional name="input">
                <param name="format" value="fasta"/>
                <param name="otu" value="abrecovery.fasta" ftype="fasta"/>
            </conditional>
            <param name="count" value="abrecovery.count_table" ftype="mothur.count_table"/>
            <param name="size" value="16"/>
            <output name="fasta_out" ftype="fasta">
                <assert_contents>
                    <has_line_matching expression="^&gt;\S+$" n="16"/>
                </assert_contents>
            </output>
            <output name="count_out" ftype="mothur.count_table">
                <assert_contents>
                    <has_n_lines n="19"/>
                    <has_line line="#Compressed Format: groupIndex,abundance. For example 1,6 would mean the read has an abundance of 6 for group A."/>
                    <has_line_matching expression="^#1,A&#009;2,B&#009;3,C&#009;$"/>
                    <has_line line="Representative_Sequence&#009;total&#009;A&#009;B&#009;C"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="2"><!-- test with shared -->
            <conditional name="input">
                <param name="format" value="shared"/>
                <param name="otu" value="amazon.an.shared" ftype="mothur.shared"/>
                <param name="label" value="unique,0.55"/>
                <param name="groups" value="forest"/>
            </conditional>
            <output_collection name="shared_out" count="2">
                <element name="0.55" ftype="mothur.shared">
                    <assert_contents>
                        <has_text text="label"/>
                        <has_text text="numOtus"/>
                        <has_text text="forest"/>
                        <not_has_text text="pasture"/>
                    </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="2"><!-- test with rabund -->
            <conditional name="input">
                <param name="format" value="rabund"/>
                <param name="otu" value="amazon.an.rabund" ftype="mothur.rabund"/>
            </conditional>
            <output name="rabund_out" ftype="mothur.rabund">
                <assert_contents>
                    <has_text text="unique"/>
                    <has_text text="0.55"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="2"><!-- test with sabund -->
            <conditional name="input">
                <param name="format" value="sabund"/>
                <param name="otu" value="amazon.an.sabund" ftype="mothur.sabund"/>
            </conditional>
            <output name="sabund_out" ftype="mothur.sabund">
                <assert_contents>
                    <has_text text="unique"/>
                    <has_text text="0.55"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="3"><!-- test with count file -->
            <conditional name="input">
                <param name="format" value="fasta"/>
                <param name="otu" value="amazon.unique.fasta" ftype="fasta"/>
            </conditional>
            <param name="count" value="amazon.count_table" ftype="mothur.count_table"/>
            <output name="count_out" ftype="mothur.count_table">
                <assert_contents>
                    <expand macro="test-count-format"/>
                    <has_line_matching expression="^U\d+\t\d$"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
    </tests>
    <help><![CDATA[

@MOTHUR_OVERVIEW@

**Command Documentation**

The sub.sample_ command can be used as a way to normalize your data, or to create a smaller set from your original set. It takes as an input the following file types: fasta, list_, shared_, rabund_ and sabund_ to generate a new file that contains a sampling of your original file.

.. _list: https://mothur.org/wiki/list_file/
.. _shared: https://mothur.org/wiki/shared_file/
.. _rabund: https://mothur.org/wiki/rabund_file/
.. _sabund: https://mothur.org/wiki/sabund_file/
.. _sub.sample: https://mothur.org/wiki/sub.sample/

**Notes**

A name file is not accepted for a fasta input: mothur deconvolutes the subsampled fasta with an
internal ``unique.seqs()`` call that writes a count table rather than a name file, and then
dereferences the (empty) name output of that call, which crashes the job.
Supply a count table (``count.seqs``) through the ``count`` input
instead; a count table that contains group columns can also be used together with ``groups``
to subsample selected groups. The count table output is returned as
``subsample.count_table``.

    ]]></help>
    <expand macro="citations"/>
</tool>
