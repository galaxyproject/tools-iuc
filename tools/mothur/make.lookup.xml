<tool id="mothur_make_lookup" name="Make.lookup" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>allows you to create custom lookup files for use with shhh.flows</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

#import re
## create symlinks to input datasets
ln -s '$reference.template' reference.template.dat &&
ln -s '$flow' flow.dat &&
ln -s '$error' error.dat &&

## collect the arguments of the mothur command in a list and join them with
## commas, so that the command can never end with a trailing comma
#set $mothur_args = []
#silent $mothur_args.append("reference=reference.template.dat")
#silent $mothur_args.append("flow=flow.dat")
#silent $mothur_args.append("error=error.dat")
#silent $mothur_args.append("order=" + str($order))
#silent $mothur_args.append("barcode=" + str($re.sub("[^ACTG]","",str($barcode))))
#silent $mothur_args.append("key=" + str($re.sub("[^ACTG]","",str($key))))
#silent $mothur_args.append("threshold=" + str($threshold))

echo 'make.lookup(${",".join($mothur_args)})'
| mothur
| tee mothur.out.log
    ]]></command>
    <inputs>
        <conditional name="reference">
            <param name="source" type="select" label="Select Reference Template from" help="">
                <option value="hist">History</option>
                <option value="ref">Cached Reference</option>
            </param>
            <when value="ref">
                <param name="template" type="select" label="reference - Select an alignment database " help="">
                    <options from_data_table="mothur_aligndb"/>
                </param>
            </when>
            <when value="hist">
                <param name="template" type="data" format="fasta" label="reference - Reference to align with" help=""/>
            </when>
        </conditional>
        <param name="flow" type="data" format="mothur.sff.flow" label="flow - provide file with flow data"/>
        <param name="error" type="data" format="tabular" label="error - provide the error summary" help="this file is an output of seq.error tool"/>
        <param name="order" type="select" label="order - flow order for nucleotides in the sequencer" help="default is A, was TACG. Also accepts B or I">
            <option value="A" selected="true">A (TACG)</option>
            <option value="B">B</option>
            <option value="I">I</option>
        </param>
        <param name="barcode" type="text" value="AACCGTGTC" label="barcode - provide the barcode sequence"/>
        <param name="key" type="text" value="TCAG" label="key - provide the key sequence"/>
        <param name="threshold" type="integer" value="10000" min="0" label="threshold - " help=""/>
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <expand macro="logfile-output"/>
        <data name="lookup_out" format="txt" from_work_dir="flow*.lookup" label="${tool.name} on ${on_string}: lookup"/>
    </outputs>
    <tests>
        <!-- testflow.error.summary is derived from the Mock_S280 error summary: make.lookup only
             reads the query, reference and numparents columns, and the query names have to match
             the reads of testflow.flow -->
        <test expect_num_outputs="2"><!-- test with defaults -->
            <conditional name="reference">
                <param name="source" value="hist"/>
                <param name="template" value="HMP_MOCK.v35.align" ftype="mothur.align"/>
            </conditional>
            <param name="flow" value="testflow.flow" ftype="mothur.sff.flow"/>
            <param name="error" value="testflow.error.summary" ftype="tabular"/>
            <output name="lookup_out" ftype="txt">
                <assert_contents>
                    <has_n_lines n="11"/>
                    <has_line_matching expression="^-nan(&#009;\S+){1000}$" n="11"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="2"><!-- test sanitizers -->
            <conditional name="reference">
                <param name="source" value="hist"/>
                <param name="template" value="HMP_MOCK.v35.align" ftype="mothur.align"/>
            </conditional>
            <param name="flow" value="testflow.flow" ftype="mothur.sff.flow"/>
            <param name="error" value="testflow.error.summary" ftype="tabular"/>
            <param name="barcode" value="XAXAXCXCXGXTXGXTXC"/><!-- should be converted to the default value -->
            <param name="key" value="XTXCXAXGX"/><!-- should be converted to the default value -->
            <output name="lookup_out" ftype="txt">
                <assert_contents>
                    <has_n_lines n="11"/>
                    <has_line_matching expression="^-nan(&#009;\S+){1000}$" n="11"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
    </tests>
    <help><![CDATA[

@MOTHUR_OVERVIEW@

**Command Documentation**

The make.lookup_ allows you to create custom lookup files for use with shhh.flows.

.. _make.lookup: https://mothur.org/wiki/make.lookup/

.. warning::

    The flow file and the error summary must come from the same sequencing run: use the error
    summary that ``trim.flows`` wrote for this very flow file. A pair from different runs fails
    with a read name mismatch.

    ]]></help>
    <expand macro="citations">
        <citation type="doi">10.1038/nmeth.1361</citation>
    </expand>
</tool>
