<tool id="mothur_cluster" name="Cluster" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Assign sequences to OTUs (Operational Taxonomic Unit)</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

## create symlinks to input datasets
#if $matrix.format == "fasta":
    ln -s '$matrix.fasta' matrix.fasta.dat &&
#else:
    ln -s '$matrix.dist' matrix.dist.dat &&
    #if $matrix.name:
        ln -s '$matrix.name' matrix.name.dat &&
    #end if
#end if
ln -s '$count' count.dat &&

## collect the arguments of the mothur command in a list and join them with
## commas, so that the command can never end with a trailing comma
#set $mothur_args = []
#if $matrix.format == "phylip":
    #silent $mothur_args.append("phylip=matrix.dist.dat")
#elif $matrix.format == "column":
    #silent $mothur_args.append("column=matrix.dist.dat")
#else
    #silent $mothur_args.append("fasta=matrix.fasta.dat")
#end if
#if $matrix.format != "fasta":
    #if $matrix.name:
        #silent $mothur_args.append("name=matrix.name.dat")
    #end if
#end if
#if $count:
    #silent $mothur_args.append("count=count.dat")
#end if
#if float($cutoff) > 0.0:
    #silent $mothur_args.append("cutoff=" + str($cutoff))
#end if
#if $select_method.method =="opti":
    #silent $mothur_args.append("metric=" + str($select_method.metric))
    #silent $mothur_args.append("initialize=" + str($select_method.initialize))
    #silent $mothur_args.append("delta=" + str($select_method.delta))
    #silent $mothur_args.append("iters=" + str($select_method.iters))
#end if
#silent $mothur_args.append("precision=" + str($precision))
#silent $mothur_args.append("sim=" + str($sim))
#silent $mothur_args.append("method=" + str($select_method.method))

echo 'cluster(${",".join($mothur_args)})'
| mothur
| tee mothur.out.log
    ]]></command>
    <inputs>
        <conditional name="matrix">
            <param argument="format" type="select" label="Cluster based on" help="">
                <option value="column">Pairwise Column Matrix</option>
                <option value="phylip">Phylip Distance Matrix</option>
                <option value="fasta">Fasta (VSEARCH agc and dgc methods)</option>
            </param>
            <when value="column">
                <param name="dist" argument="column" type="data" format="mothur.pair.dist" label="column - Distance Matrix"/>
                <param argument="name" type="data" format="mothur.names" optional="true" label="name - Sequences Name reference"/>
            </when>
            <when value="phylip">
                <param name="dist" argument="phylip" type="data" format="mothur.dist,mothur.lower.dist,mothur.square.dist" label="phylip - Distance Matrix"/>
                <param argument="name" type="data" format="mothur.names" optional="true" label="name - Sequences Name reference"/>
            </when>
            <when value="fasta">
                <param argument="fasta" type="data" format="mothur.align,fasta" label="fasta - Fasta file"
                    help="the sequences to cluster; only the VSEARCH methods (agc and dgc) can cluster a fasta file, they compute the distances themselves"/>
            </when>
        </conditional>
        <param argument="count" type="data" format="mothur.count_table" optional="true" label="count - a count_table" help="generated by count.seqs"/>
        <conditional name="select_method">
            <expand macro="param-clustermethods">
                <expand macro="option-vsearch-clustermethods"/>
            </expand>
            <when value="furthest"/>
            <when value="nearest"/>
            <when value="average"/>
            <when value="agc"/>
            <when value="dgc"/>
            <when value="opti">
                <expand macro="params-opticlust"/>
            </when>
        </conditional>
        <param argument="cutoff" type="float" value="0.0" label="cutoff - Distance Cutoff threshold - ignored if not > 0.0"
            help="Ignore pairwise distances larger than this, a common value would be 0.10"/>
        <param argument="precision" type="select" optional="true" label="precision - Precision for rounding distance values"
            help="Set higher precision for longer genome scale sequence lengths">
            <option value="10">.1</option>
            <option value="100" selected="true">.01</option>
            <option value="1000">.001</option>
            <option value="10000">.0001</option>
            <option value="100000">.00001</option>
            <option value="1000000">.000001</option>
        </param>
        <param argument="sim" type="boolean" checked="false" truevalue="true" falsevalue="false" label="sim - Matrix values are Similary instead of Distance"/>
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <expand macro="logfile-output"/>
        <!-- mothur only writes rabund/sabund from the linkage algorithms, and only
             when no count file is given; the opti/vsearch algorithms emit a .list
             only, and giving mothur a count file suppresses rabund/sabund as well. -->
        <data name="rabund" format="mothur.rabund" from_work_dir="matrix.dist*.rabund" label="${tool.name} on ${on_string}: rabund (Rank Abundance)">
            <filter>select_method['method'] in ('furthest', 'nearest', 'average', 'weighted') and not count</filter>
        </data>
        <data name="sabund" format="mothur.sabund" from_work_dir="matrix.dist*.sabund" label="${tool.name} on ${on_string}: sabund (Species Abundance)">
            <filter>select_method['method'] in ('furthest', 'nearest', 'average', 'weighted') and not count</filter>
        </data>
        <data name="otulist" format="mothur.list" from_work_dir="matrix.*.list" label="${tool.name} on ${on_string}: list (OTU List)"/>
    </outputs>
    <tests>
        <!-- default method is opti, which writes a .list only (no rabund/sabund) -->
        <test expect_num_outputs="2"><!-- test with phylip input -->
            <conditional name="matrix">
                <param name="format" value="phylip"/>
                <param name="dist" value="amazon.dist"/>
            </conditional>
            <output name="otulist" ftype="mothur.list">
                <assert_contents>
                    <expand macro="test-list-format"/>
                    <has_text text="0.03"/>
                    <has_text text="U68688"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="2"><!-- test with column input -->
            <conditional name="matrix">
                <param name="format" value="column"/>
                <param name="dist" value="amazon.pair.dist"/>
                <param name="name" value="amazon.names"/>
            </conditional>
            <output name="otulist" ftype="mothur.list">
                <assert_contents>
                    <expand macro="test-list-format"/>
                    <has_text text="0.03"/>
                    <has_text text="U68688"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <!-- only the linkage algorithms (furthest/nearest/average/weighted) write
             rabund/sabund in addition to the .list; give an explicit cutoff or mothur
             silently falls back to cluster.classic for phylip input -->
        <test expect_num_outputs="4"><!-- test with the average linkage algorithm -->
            <conditional name="matrix">
                <param name="format" value="phylip"/>
                <param name="dist" value="amazon.dist"/>
            </conditional>
            <conditional name="select_method">
                <param name="method" value="average"/>
            </conditional>
            <param name="cutoff" value="0.03"/>
            <output name="otulist" ftype="mothur.list">
                <assert_contents>
                    <expand macro="test-list-format"/>
                    <has_text text="0.03"/>
                    <has_text text="U68688"/>
                </assert_contents>
            </output>
            <output name="rabund" ftype="mothur.rabund">
                <assert_contents>
                    <has_line_matching expression="^0\.03(\t\d+)+$"/>
                </assert_contents>
            </output>
            <output name="sabund" ftype="mothur.sabund">
                <assert_contents>
                    <has_line_matching expression="^0\.03(\t\d+)+$"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <!-- the VSEARCH methods cluster a fasta file directly (mothur computes the
             distances with vsearch) and write a .list only -->
        <test expect_num_outputs="2">
            <conditional name="matrix">
                <param name="format" value="fasta"/>
                <param name="fasta" value="amazon.fasta"/>
            </conditional>
            <conditional name="select_method">
                <param name="method" value="agc"/>
            </conditional>
            <output name="otulist" ftype="mothur.list">
                <assert_contents>
                    <expand macro="test-list-format"/>
                    <has_text text="U68665,U68679,U68688"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
    </tests>
    <help><![CDATA[

@MOTHUR_OVERVIEW@

**Command Documentation**

The cluster_ command assign sequences to OTUs (Operational Taxonomy Unit).  The assignment is based on a phylip-formatted_distance_matrix_ or a  column-formatted_distance_matrix_ and name_ file.  It generates a list_ and, with the linkage methods (furthest, nearest, average and weighted), also a sabund_ (Species Abundance) and a rabund_ (Relative Abundance) file.

The VSEARCH methods (agc and dgc) are the exception: they take a fasta file instead of a distance matrix and compute the distances themselves. Choose "Fasta" as the input format together with the agc or dgc clustering method; the linkage methods, opti and the unique method need a distance matrix.

.. _phylip-formatted_distance_matrix: https://mothur.org/wiki/phylip-formatted_distance_matrix/
.. _column-formatted_distance_matrix: https://mothur.org/wiki/column-formatted_distance_matrix/
.. _name: https://mothur.org/wiki/name_file/
.. _list: https://mothur.org/wiki/list_file/
.. _rabund: https://mothur.org/wiki/rabund_file/
.. _sabund: https://mothur.org/wiki/sabund_file/
.. _cluster: https://mothur.org/wiki/cluster/

    ]]></help>
    <expand macro="citations">
        <citation type="doi">10.1128/AEM.02810-10</citation>
        <citation type="doi">10.1128/AEM.71.3.1501-1506.2005</citation>
    </expand>
</tool>
