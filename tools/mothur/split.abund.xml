<tool profile="@PROFILE@" id="mothur_split_abund" name="Split.abund" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@">
    <description>Separate sequences into rare and abundant groups</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

## create symlinks to input datasets
ln -s '$fasta' fasta.dat &&
ln -s '$search.input' search_input.dat &&
#if $split.dosplit == "yes":
    ln -s '$split.group' split_group.dat &&
#end if

echo 'split.abund(
    fasta=fasta.dat,
    #if $search.type == "list":
        list=search_input.dat,
        #if $search.label:
            label=${ str($search.label).replace(",","-") },
        #end if
    #elif $search.type == "name":
        name=search_input.dat,
    #else
        count=search_input.dat,
    #end if
    #if $split.dosplit == "yes":
        #if $split.group:
            group=split_group.dat,
        #end if
    #end if
    cutoff=$cutoff
)'
| sed 's/ //g; s/,)$/)/'  ## mothur trips over whitespace; a trailing comma segfaults mothur >1.42
| mothur
| tee mothur.out.log
    ]]></command>
    <inputs>
        <param name="fasta" type="data" format="fasta" label="fasta - Fasta"/>
        <param name="cutoff" type="integer" value="10" min="0" label="cutoff - Cutoff parameter is used to qualify what is abundant and rare."/>
        <conditional name="search">
            <param name="type" type="select" label="Type to screen" help="">
                <option value="list">OTU List</option>
                <option value="name">Name reference</option>
                <option value="count">Count file</option>
            </param>
            <when value="name">
                <param name="input" type="data" format="mothur.names" label="name - Name reference"/>
            </when>
            <when value="list">
                <param name="input" type="data" format="mothur.list" label="list - OTU List"/>
                <param name="label" type="select" label="label - OTU Labels" multiple="true" help="Select OTU Labels to filter out all but selected labels">
                    <options>
                        <filter type="data_meta" ref="input" key="labels"/>
                    </options>
                </param>
            </when>
            <when value="count">
                <param name="input" type="data" format="mothur.count_table" label="count - count_table file"/>
            </when>
        </conditional>
        <conditional name="split">
            <param name="dosplit" type="select" label="Parse a group file into abundant and rare groups? (only possible if name or list file supplied)" help="">
                <option value="no" selected="true">No</option>
                <option value="yes">Yes</option>
            </param>
            <when value="yes">
                <!-- mothur 1.48 removed the per-group output of split.abund: the groups=
                     parameter is still accepted but no longer read (the help text is stale),
                     so only the combined .abund/.rare files and the group subsets are written.
                     Use split.groups if you need one output per group. -->
                <param name="group" type="data" format="mothur.groups" label="group - Group dataset"/>
            </when>
            <when value="no"/>
        </conditional>
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <expand macro="logfile-output"/>
        <data name="abund_fasta" format_source="fasta" from_work_dir="*abund.fasta" label="${tool.name} on ${on_string}: abund.fasta">
            <filter>search['type'] != 'list'</filter>
        </data>
        <data name="rare_fasta" format_source="fasta" from_work_dir="*rare.fasta" label="${tool.name} on ${on_string}: rare.fasta">
            <filter>search['type'] != 'list'</filter>
        </data>
        <data name="abund_groups" format="mothur.groups" from_work_dir="split_group*.abund.groups" label="${tool.name} on ${on_string}: abund.groups">
            <filter>search['type'] == 'name' and split['dosplit'] == 'yes'</filter>
        </data>
        <data name="rare_groups" format="mothur.groups" from_work_dir="split_group*.rare.groups" label="${tool.name} on ${on_string}: rare.groups">
            <filter>search['type'] == 'name' and split['dosplit'] == 'yes'</filter>
        </data>
        <data name="abund_names" format="mothur.names" from_work_dir="search_input*.abund.names" label="${tool.name} on ${on_string}: abund.names">
            <filter>search['type'] == 'name'</filter>
        </data>
        <data name="rare_names" format="mothur.names" from_work_dir="search_input*.rare.names" label="${tool.name} on ${on_string}: rare.names">
            <filter>search['type'] == 'name'</filter>
        </data>
        <data name="abund_count" format="mothur.count_table" from_work_dir="*.abund.count_table" label="${tool.name} on ${on_string}: abund.count_table">
            <filter>search['type'] == 'count'</filter>
        </data>
        <data name="rare_count" format="mothur.count_table" from_work_dir="*.rare.count_table" label="${tool.name} on ${on_string}: rare.count_table">
            <filter>search['type'] == 'count'</filter>
        </data>
        <data name="abund_accnos" format="mothur.accnos" from_work_dir="*abund.accnos" label="${tool.name} on ${on_string}: abund.accnos">
            <filter>search['type'] != 'list'</filter>
        </data>
        <data name="rare_accnos" format="mothur.accnos" from_work_dir="*rare.accnos" label="${tool.name} on ${on_string}: rare.accnos">
            <filter>search['type'] != 'list'</filter>
        </data>
        <collection name="abund_fasta_coll" type="list" label="${tool.name} on ${on_string}: abund.fasta (collection)">
            <discover_datasets pattern=".*?\.(?P&lt;designation&gt;.*)\.abund\.fasta" format="fasta"/>
            <filter>search['type'] == 'list'</filter>
        </collection>
        <collection name="rare_fasta_coll" type="list" label="${tool.name} on ${on_string}: rare.fasta (collection)">
            <discover_datasets pattern=".*?\.(?P&lt;designation&gt;.*)\.rare\.fasta" format="fasta"/>
            <filter>search['type'] == 'list'</filter>
        </collection>
        <collection name="abund_list_coll" type="list" label="${tool.name} on ${on_string}: abund.list">
            <discover_datasets pattern=".*?\.(?P&lt;designation&gt;.*)\.abund\.list" format="mothur.list"/>
            <filter>search['type'] == 'list'</filter>
        </collection>
        <collection name="rare_list_coll" type="list" label="${tool.name} on ${on_string}: rare.list">
            <discover_datasets pattern=".*?\.(?P&lt;designation&gt;.*)\.rare\.list" format="mothur.list"/>
            <filter>search['type'] == 'list'</filter>
        </collection>
        <collection name="abund_accnos_coll" type="list" label="${tool.name} on ${on_string}: abund.accnos (collection)">
            <discover_datasets pattern="search_input\.(?P&lt;designation&gt;[0-9.]+|unique)\.abund\.accnos" format="mothur.accnos"/>
            <filter>search['type'] == 'list'</filter>
        </collection>
        <collection name="rare_accnos_coll" type="list" label="${tool.name} on ${on_string}: rare.accnos (collection)">
            <discover_datasets pattern="search_input\.(?P&lt;designation&gt;[0-9.]+|unique)\.rare\.accnos" format="mothur.accnos"/>
            <filter>search['type'] == 'list'</filter>
        </collection>
        <collection name="abund_groups_coll" type="list" label="${tool.name} on ${on_string}: abund.groups (collection)">
            <discover_datasets pattern="split_group\.(?P&lt;designation&gt;.*)\.abund\.groups" format="mothur.groups"/>
            <filter>search['type'] == 'list' and split['dosplit'] == 'yes'</filter>
        </collection>
        <collection name="rare_groups_coll" type="list" label="${tool.name} on ${on_string}: rare.groups (collection)">
            <discover_datasets pattern="split_group\.(?P&lt;designation&gt;.*)\.rare\.groups" format="mothur.groups"/>
            <filter>search['type'] == 'list' and split['dosplit'] == 'yes'</filter>
        </collection>
    </outputs>
    <tests>
        <test expect_num_outputs="7"><!-- test with count table -->
            <param name="fasta" value="amazon.fasta" ftype="fasta"/>
            <conditional name="search">
                <param name="type" value="count"/>
                <param name="input" value="amazon.count_table" ftype="mothur.count_table"/>
            </conditional>
            <param name="cutoff" value="1"/>
            <output name="abund_fasta" ftype="fasta">
                <assert_contents>
                    <has_n_lines n="4"/>
                    <has_line_matching expression="^&gt;[^\s]+$" n="2"/>
                </assert_contents>
            </output>
            <output name="rare_fasta" ftype="fasta">
                <assert_contents>
                    <has_n_lines n="188"/>
                    <has_line_matching expression="^&gt;[^\s]+$" n="94"/>
                </assert_contents>
            </output>
            <output name="abund_count" ftype="mothur.count_table">
                <assert_contents>
                    <has_n_lines n="3"/>
                    <has_line_matching expression="^Representative_Sequence\ttotal$"/>
                </assert_contents>
            </output>
            <output name="rare_count" ftype="mothur.count_table">
                <assert_contents>
                    <has_n_lines n="95"/>
                    <has_line_matching expression="^Representative_Sequence\ttotal$"/>
                </assert_contents>
            </output>
            <output name="abund_accnos" ftype="mothur.accnos">
                <assert_contents>
                    <has_n_lines n="2"/>
                </assert_contents>
            </output>
            <output name="rare_accnos" ftype="mothur.accnos">
                <assert_contents>
                    <has_n_lines n="94"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="7"><!-- test with name file and accnos output -->
            <param name="fasta" value="amazon.fasta" ftype="fasta"/>
            <conditional name="search">
                <param name="type" value="name"/>
                <param name="input" value="amazon.names" ftype="mothur.names"/>
            </conditional>
            <param name="cutoff" value="1"/>
            <output name="abund_fasta" ftype="fasta">
                <assert_contents>
                    <has_n_lines n="8"/>
                    <has_line_matching expression="^&gt;[^\s]+$" n="4"/>
                </assert_contents>
            </output>
            <output name="rare_fasta" ftype="fasta">
                <assert_contents>
                    <has_n_lines n="188"/>
                    <has_line_matching expression="^&gt;[^\s]+$" n="94"/>
                </assert_contents>
            </output>
            <output name="abund_names" ftype="mothur.names">
                <assert_contents>
                    <has_n_lines n="2"/>
                </assert_contents>
            </output>
            <output name="rare_names" ftype="mothur.names">
                <assert_contents>
                    <has_n_lines n="94"/>
                </assert_contents>
            </output>
            <output name="abund_accnos" ftype="mothur.accnos">
                <assert_contents>
                    <has_n_lines n="2"/>
                </assert_contents>
            </output>
            <output name="rare_accnos" ftype="mothur.accnos">
                <assert_contents>
                    <has_n_lines n="94"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="9"><!-- test with name file, accnos output and a group file -->
            <param name="fasta" value="amazon.fasta" ftype="fasta"/>
            <conditional name="search">
                <param name="type" value="name"/>
                <param name="input" value="amazon.names" ftype="mothur.names"/>
            </conditional>
            <param name="cutoff" value="1"/>
            <conditional name="split">
                <param name="dosplit" value="yes"/>
                <param name="group" value="amazon.groups" ftype="mothur.groups"/>
            </conditional>
            <output name="abund_fasta" ftype="fasta">
                <assert_contents>
                    <has_n_lines n="8"/>
                    <has_line_matching expression="^&gt;[^\s]+$" n="4"/>
                </assert_contents>
            </output>
            <output name="rare_fasta" ftype="fasta">
                <assert_contents>
                    <has_n_lines n="188"/>
                    <has_line_matching expression="^&gt;[^\s]+$" n="94"/>
                </assert_contents>
            </output>
            <output name="abund_names" ftype="mothur.names">
                <assert_contents>
                    <has_n_lines n="2"/>
                </assert_contents>
            </output>
            <output name="rare_names" ftype="mothur.names">
                <assert_contents>
                    <has_n_lines n="94"/>
                </assert_contents>
            </output>
            <output name="abund_accnos" ftype="mothur.accnos">
                <assert_contents>
                    <has_n_lines n="2"/>
                </assert_contents>
            </output>
            <output name="rare_accnos" ftype="mothur.accnos">
                <assert_contents>
                    <has_n_lines n="94"/>
                </assert_contents>
            </output>
            <output name="abund_groups" ftype="mothur.groups">
                <assert_contents>
                    <has_n_lines n="4"/>
                    <has_line_matching expression="^U68618\tforest$"/>
                </assert_contents>
            </output>
            <output name="rare_groups" ftype="mothur.groups">
                <assert_contents>
                    <has_n_lines n="94"/>
                    <has_line_matching expression="^U68595\tforest$"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="9"><!-- test with list: one element per label -->
            <param name="fasta" value="amazon.fasta" ftype="fasta"/>
            <conditional name="search">
                <param name="type" value="list"/>
                <param name="input" value="amazon.an.list" ftype="mothur.list"/>
            </conditional>
            <param name="cutoff" value="2"/>
            <conditional name="split">
                <param name="dosplit" value="yes"/>
                <param name="group" value="amazon.groups" ftype="mothur.groups"/>
            </conditional>
            <output_collection name="abund_fasta_coll" count="36">
                <element name="0.55" ftype="fasta">
                    <assert_contents>
                        <has_n_lines n="196"/>
                        <has_line_matching expression="^&gt;U68589$"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="rare_fasta_coll" count="36">
                <element name="unique" ftype="fasta">
                    <assert_contents>
                        <has_n_lines n="196"/>
                        <has_line_matching expression="^&gt;U68589$"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="abund_list_coll" count="36">
                <element name="0.55" ftype="mothur.list">
                    <assert_contents>
                        <has_n_lines n="2"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="rare_list_coll" count="36">
                <element name="unique" ftype="mothur.list">
                    <assert_contents>
                        <has_n_lines n="2"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="abund_accnos_coll" count="36">
                <element name="0.55" ftype="mothur.accnos">
                    <assert_contents>
                        <has_n_lines n="98"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="rare_accnos_coll" count="36">
                <element name="unique" ftype="mothur.accnos">
                    <assert_contents>
                        <has_n_lines n="98"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="abund_groups_coll" count="36">
                <element name="0.55" ftype="mothur.groups">
                    <assert_contents>
                        <has_n_lines n="98"/>
                        <has_line_matching expression="^U68589\tforest$"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="rare_groups_coll" count="36">
                <element name="unique" ftype="mothur.groups">
                    <assert_contents>
                        <has_n_lines n="98"/>
                    </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="9"><!-- test with list, a single label and a group file -->
            <param name="fasta" value="amazon.fasta" ftype="fasta"/>
            <conditional name="search">
                <param name="type" value="list"/>
                <param name="input" value="amazon.an.list" ftype="mothur.list"/>
                <!-- a label is a cut point: mothur processes the requested label and keeps
                     extending above it, so ask for the topmost label to get a single one -->
                <param name="label" value="0.55"/>
            </conditional>
            <param name="cutoff" value="2"/>
            <conditional name="split">
                <param name="dosplit" value="yes"/>
                <param name="group" value="amazon.groups" ftype="mothur.groups"/>
            </conditional>
            <output_collection name="abund_fasta_coll" count="1">
                <element name="0.55" ftype="fasta">
                    <assert_contents>
                        <has_n_lines n="196"/>
                        <has_line_matching expression="^&gt;U68589$"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="rare_fasta_coll" count="1">
                <element name="0.55" ftype="fasta">
                    <assert_contents>
                        <has_n_lines n="0"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="abund_list_coll" count="1">
                <element name="0.55" ftype="mothur.list">
                    <assert_contents>
                        <has_n_lines n="2"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="rare_list_coll" count="1">
                <element name="0.55" ftype="mothur.list">
                    <assert_contents>
                        <has_n_lines n="0"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="abund_accnos_coll" count="1">
                <element name="0.55" ftype="mothur.accnos">
                    <assert_contents>
                        <has_n_lines n="98"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="rare_accnos_coll" count="1">
                <element name="0.55" ftype="mothur.accnos">
                    <assert_contents>
                        <has_n_lines n="0"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="abund_groups_coll" count="1">
                <element name="0.55" ftype="mothur.groups">
                    <assert_contents>
                        <has_n_lines n="98"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="rare_groups_coll" count="1">
                <element name="0.55" ftype="mothur.groups">
                    <assert_contents>
                        <has_n_lines n="0"/>
                    </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
    </tests>
    <help><![CDATA[

@MOTHUR_OVERVIEW@

**Command Documentation**

The split.abund_ command reads a fasta file and a list_ or a name_ file and splits the sequences into rare and abundant groups.

.. _list: https://www.mothur.org/wiki/List_file
.. _name: https://www.mothur.org/wiki/Name_file
.. _split.abund: https://www.mothur.org/wiki/Split.abund

    ]]></help>
    <expand macro="citations"/>
</tool>
