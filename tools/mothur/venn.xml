<tool id="mothur_venn" name="Venn" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Generate Venn diagrams for groups </description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

## create symlinks to input datasets
ln -s '$input.otu' input_otu.dat &&

## collect the arguments of the mothur command in a list and join them with
## commas, so that the command can never end with a trailing comma
#set $mothur_args = []
#if $input.source == "shared":
    #silent $mothur_args.append("shared=input_otu.dat")
    #silent $mothur_args.append("nseqs=" + str($nseqs))
    #silent $mothur_args.append("permute=" + str($permute))
    #if $input.groups:
        #silent $mothur_args.append("groups=" + str(str($input.groups).replace(",","-")))
    #end if
#elif $input.source == "similarity":
    #silent $mothur_args.append("list=input_otu.dat")
    #silent $mothur_args.append("abund=" + str($input.abund))
#end if
#if $input.label:
    #silent $mothur_args.append("label=" + str(str($input.label).replace(",","-")))
#end if
#if $input.calc:
    #silent $mothur_args.append("calc=" + str(str($input.calc).replace(",","-")))
#end if
#silent $mothur_args.append("fontsize=" + str($fontsize))
#silent $mothur_args.append("sharedotus=" + str($sharedotus))

echo 'venn(${",".join($mothur_args)})'
| mothur
| tee mothur.out.log
    ]]></command>
    <inputs>
        <conditional name="input">
            <param argument="source" type="select" label="Generate Heatmap for">
                <option value="shared">OTU Shared</option>
                <option value="similarity">OTU list</option>
            </param>
            <when value="shared">
                <param argument="otu" type="data" format="mothur.shared" label="shared - OTU Shared"/>
                <param argument="calc" type="select" multiple="true" label="calc - Calculators (Uses defaults if none selected)">
                    <option value="sharedsobs">Shared Sobs</option>
                    <option value="sharedchao">Shared Chao</option>
                    <option value="sharedace">Shared Ace</option>
                </param>
                <param argument="label" type="select" multiple="true" label="label - OTU Labels">
                    <expand macro="labeloptions"/>
                </param>
                <param argument="groups" type="select" multiple="true" label="groups - Groups to consider">
                    <options>
                        <filter type="data_meta" ref="otu" key="groups"/>
                    </options>
                </param>
            </when>
            <when value="similarity">
                <param argument="otu" type="data" format="mothur.list" label="list - OTU List"/>
                <param argument="calc" type="select" multiple="true" label="calc - Calculators (Uses defaults if none selected)">
                    <option value="sobs">Sobs</option>
                    <option value="chao">Chao</option>
                    <option value="ace">Ace</option>
                </param>
                <param argument="abund" type="integer" value="10" min="5" label="abund - Abundance when using the ace calculator ( >= 5 )"/>
                <param argument="label" type="select" multiple="true" label="label - OTU Labels">
                    <expand macro="labeloptions"/>
                </param>
            </when>
        </conditional>
        <param argument="nseqs" type="boolean" falsevalue="false" truevalue="true" checked="false" label="nseqs - Output the number of sequences represented by the otus in the picture"/>
        <param argument="permute" type="select" label="permute - Create pictures with all possible 4-way permutations of groups">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4" selected="true">4</option>
            <option value="true">true</option>
        </param>
        <param argument="fontsize" type="integer" value="24" label="fontsize - Fontsize (default is 24)"/>
        <param argument="sharedotus" type="boolean" falsevalue="false" truevalue="true" checked="true" label="sharedotus - This parameter can be used with the sharedsobs calculator to get the names of the OTUs in each section of the venn diagram. Default=T"/>
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <collection name="sharedotus_out" type="list" label="${tool.name} on ${on_string}: sharedotus">
            <filter>sharedotus</filter>
            <discover_datasets pattern=".*?\.(?P&lt;designation&gt;.*)\.sharedotus" format="tabular"/>
        </collection>
        <collection name="svgs_out" type="list" label="${tool.name} on ${on_string}: svg">
            <discover_datasets pattern=".*?\.(?P&lt;designation&gt;.*)\.svg" format="svg"/>
        </collection>
        <expand macro="logfile-output"/>
    </outputs>
    <tests>
        <test expect_num_outputs="3"><!-- test with shared file -->
            <conditional name="input">
                <param name="source" value="shared"/>
                <param name="otu" value="amazon.an.shared" ftype="mothur.shared"/>
                <param name="calc" value="sharedsobs,sharedchao"/>
                <param name="groups" value="forest,pasture"/>
            </conditional>
            <output_collection name="sharedotus_out" count="35">
                <element name="0.05.sharedsobs.forest-pasture" ftype="tabular">
                    <assert_contents>
                        <has_n_lines n="2"/>
                        <has_line line="Groups&#009;NumShared&#009;OTULabels"/>
                        <has_line line="forest-pasture&#009;7&#009;Otu02,Otu03,Otu09,Otu10,Otu11,Otu12,Otu13"/>
                    </assert_contents>
                </element>
            </output_collection>
            <output_collection name="svgs_out" count="72">
                <element name="0.05.sharedsobs.forest-pasture" ftype="svg">
                    <assert_contents>
                        <has_n_lines n="15"/>
                        <has_line line="&lt;svg xmlns:svg=&quot;http://www.w3.org/2000/svg&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;100%&quot; height=&quot;100%&quot; viewBox=&quot;0 0 1500 1500 &quot; &gt;"/>
                        <has_line line="&lt;text fill=&quot;black&quot; class=&quot;seri&quot; font-size=&quot;24&quot; x=&quot;750&quot; y=&quot;420&quot;&gt;7&lt;/text&gt;"/>
                        <has_line line="&lt;/svg&gt;"/>
                    </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="3"><!-- test with list file -->
            <conditional name="input">
                <param name="source" value="similarity"/>
                <param name="otu" value="amazon.an.list" ftype="mothur.list"/>
                <param name="calc" value="sobs,chao,ace"/>
            </conditional>
            <output_collection name="svgs_out" count="108">
                <element name=".0.45.ace" ftype="svg">
                    <assert_contents>
                        <has_n_lines n="8"/>
                        <has_line line="&lt;svg xmlns:svg=&quot;http://www.w3.org/2000/svg&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;100%&quot; height=&quot;100%&quot; viewBox=&quot;0 0 1500 1500 &quot; &gt;"/>
                        <has_line line="&lt;text fill=&quot;black&quot; class=&quot;seri&quot;  font-size=&quot;24&quot; x=&quot;525&quot; y=&quot;900&quot;&gt;The lower bound of the confidence interval is 0&lt;/text&gt;"/>
                        <has_line line="&lt;/svg&gt;"/>
                    </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
    </tests>
    <help><![CDATA[

@MOTHUR_OVERVIEW@

**Command Documentation**

The venn_ command generates Venn diagrams to compare the richness shared among 2, 3, or 4 groups.  For calc parameter choices see calculators_.

.. _venn: https://mothur.org/wiki/venn/
.. _calculators: https://mothur.org/wiki/calculators/

    ]]></help>
    <expand macro="citations"/>
</tool>
