<tool id="mothur_list_seqs" name="List.seqs" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>Lists the names (accnos) of the sequences</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

## create symlinks to input datasets
ln -s '$search.input' search.input.dat &&

## collect the arguments of the mothur command in a list and join them with
## commas, so that the command can never end with a trailing comma
#set $mothur_args = []
#if $search.intype == "fasta":
    #silent $mothur_args.append("fasta=search.input.dat")
#elif $search.intype == "fastq":
    #silent $mothur_args.append("fastq=search.input.dat")
#elif $search.intype == "name":
    #silent $mothur_args.append("name=search.input.dat")
#else if $search.intype == "group":
    #silent $mothur_args.append("group=search.input.dat")
#elif $search.intype == "alignreport":
    #silent $mothur_args.append("alignreport=search.input.dat")
#elif $search.intype == "list":
    #silent $mothur_args.append("list=search.input.dat")
#elif $search.intype == "taxonomy":
    #silent $mothur_args.append("taxonomy=search.input.dat")
#elif $search.intype == "count":
    #silent $mothur_args.append("count=search.input.dat")
#end if

echo 'list.seqs(${",".join($mothur_args)})'
| mothur
| tee mothur.out.log
    ]]></command>
    <inputs>
        <conditional name="search">
            <param argument="intype" type="select" label="Type to list" help="">
                <option value="fasta">Sequence Fasta</option>
                <option value="fastq">Sequence Fastq</option>
                <option value="name">Sequences Name reference</option>
                <option value="group">Groups</option>
                <option value="alignreport">Align Report</option>
                <option value="list">OTU List</option>
                <option value="taxonomy">Sequence Taxonomy</option>
                <option value="count">Count Table</option>
            </param>
            <when value="fasta">
                <param argument="input" type="data" format="fasta" label="fasta - Fasta"/>
            </when>
            <when value="fastq">
                <param argument="input" type="data" format="fastq" label="fasta - Fasta"/>
            </when>
            <when value="name">
                <param argument="input" type="data" format="mothur.names" label="name - Names"/>
            </when>
            <when value="group">
                <param argument="input" type="data" format="mothur.groups" label="group - Groups"/>
            </when>
            <when value="alignreport">
                <param argument="input" type="data" format="mothur.align.report" label="alignreport - Align Report"/>
            </when>
            <when value="list">
                <param argument="input" type="data" format="mothur.list" label="list - OTU List"/>
            </when>
            <when value="taxonomy">
                <param argument="input" type="data" format="mothur.seq.taxonomy" label="taxonomy - Sequence Taxonomy"/>
            </when>
            <when value="count">
                <param argument="input" type="data" format="mothur.count_table" label="count - Count Table"/>
            </when>
        </conditional>
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <expand macro="logfile-output"/>
        <data name="accnos" format="mothur.accnos" from_work_dir="search.input*.accnos" label="${tool.name} on ${on_string}: accnos"/>
    </outputs>
    <tests>
        <test expect_num_outputs="2"><!-- test with fasta -->
            <conditional name="search">
                <param name="intype" value="fasta"/>
                <param name="input" value="amazon.fasta"/>
            </conditional>
            <output name="accnos" ftype="mothur.accnos">
                <assert_contents>
                    <has_n_lines n="98"/>
                    <has_line_matching expression="^U68687$"/>
                    <has_line_matching expression="^U68648$"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="2"><!-- test with count file -->
            <conditional name="search">
                <param name="intype" value="count"/>
                <param name="input" value="amazon.count_table"/>
            </conditional>
            <output name="accnos" ftype="mothur.accnos">
                <assert_contents>
                    <has_n_lines n="96"/>
                    <has_line_matching expression="^U68687$"/>
                    <has_line_matching expression="^U68648$"/>
                </assert_contents>
            </output>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
    </tests>
    <help><![CDATA[

@MOTHUR_OVERVIEW@

**Command Documentation**

The list.seqs_ command writes out the names of the sequences found within a fasta, name_, group_, list_, align.report_ or taxonomy_ file.

.. _name: https://mothur.org/wiki/name_file/
.. _group: https://mothur.org/wiki/group_file/
.. _list: https://mothur.org/wiki/list_file/
.. _align.report: https://mothur.org/wiki/align.seqs/
.. _taxonomy: https://mothur.org/wiki/taxonomy_outline/
.. _list.seqs: https://mothur.org/wiki/list.seqs/

    ]]></help>
    <expand macro="citations"/>
</tool>
