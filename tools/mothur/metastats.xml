<tool id="mothur_metastats" name="Metastats" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
    <description>generate principle components plot data</description>
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="biotools"/>
    <expand macro="requirements"/>
    <expand macro="stdio"/>
    <expand macro="version_command"/>
    <command><![CDATA[
@SHELL_OPTIONS@

## create symlinks to input datasets
ln -s '$otu' otu.dat &&
ln -s '$design' design.dat &&

## collect the arguments of the mothur command in a list and join them with
## commas, so that the command can never end with a trailing comma
#set $mothur_args = []
#silent $mothur_args.append("shared=otu.dat")
#silent $mothur_args.append("design=design.dat")
#if $label:
    #silent $mothur_args.append("label=" + str(str($label).replace(",","-")))
#end if
#if $groups:
    #silent $mothur_args.append("groups=" + str(str($groups).replace(",","-")))
#end if
#if $sets:
    #silent $mothur_args.append("sets=" + str(str($sets).replace(",","-")))
#end if
#silent $mothur_args.append("iters=" + str($iters))
#silent $mothur_args.append("threshold=" + str($threshold))
#silent $mothur_args.append("processors='${GALAXY_SLOTS:-8}'")

echo 'metastats(${",".join($mothur_args)})'
| mothur
| tee mothur.out.log
    ]]></command>
    <inputs>
        <param argument="otu" type="data" format="mothur.shared" label="shared - OTU Shared"/>
        <param argument="design" type="data" format="mothur.design" label="design - assign groups to new grouping" help="design has 2 TAB-separated columns with a 'group' header: group (col 1) and grouping (col 2), see the mothur design file documentation"/>
        <param argument="label" type="select" label="label - OTU Labels" multiple="true">
            <expand macro="labeloptions"/>
        </param>
        <param argument="sets" type="select" label="sets - group sets to analyze" multiple="true">
            <options>
                <filter type="data_meta" ref="design" key="groups"/>
            </options>
        </param>
        <param argument="groups" type="select" label="groups - Groups to consider" multiple="true">
            <options>
                <filter type="data_meta" ref="otu" key="groups"/>
            </options>
        </param>
        <param argument="iters" type="integer" value="1000" min="0" label="iters - Number of randomizations (default 1000)"/>
        <param argument="threshold" type="float" value="0.05" min="0" max="1" label="threshold - significance level to reject null hypotheses"/>
        <expand macro="param-savelog"/>
    </inputs>
    <outputs>
        <expand macro="logfile-output"/>
        <collection name="metastats" type="list" label="${tool.name} on ${on_string}: metastats">
            <discover_datasets pattern=".*?\.(?P&lt;designation&gt;.*)\.metastats" format="txt"/>
        </collection>
    </outputs>
    <tests>
        <test expect_num_outputs="2">
            <param name="otu" value="amazon.an.shared" ftype="mothur.shared"/>
            <param name="design" value="toymothur.design2" ftype="mothur.design"/>
            <output_collection name="metastats" count="36">
                <element name="0.23.tardis_dalek" ftype="txt">
                    <assert_contents>
                        <has_text text="group1"/>
                        <has_text text="group2"/>
                        <has_text text="OTU"/>
                        <has_text text="variance"/>
                        <has_text text="1000 permutations"/>
                    </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
        <test expect_num_outputs="2">
            <param name="otu" value="amazon.an.shared" ftype="mothur.shared"/>
            <param name="design" value="toymothur.design2" ftype="mothur.design"/>
            <param name="iters" value="42"/>
            <param name="threshold" value="0.1"/>
            <param name="label" value="0.03,0.05,0.23"/>
            <param name="groups" value="forest,pasture"/>
            <param name="sets" value="tardis,dalek"/>
            <!-- label is a set of cutoffs, not a filter: mothur keeps every label of the
                 shared file from 0.03 upwards, and names the files <label>.<set2>_<set1> -->
            <output_collection name="metastats" count="15">
                <element name="0.23.dalek_tardis" ftype="txt">
                    <assert_contents>
                        <has_text text="group1"/>
                        <has_text text="group2"/>
                        <has_text text="OTU"/>
                        <has_text text="variance"/>
                        <has_text text="42 permutations"/>
                    </assert_contents>
                </element>
            </output_collection>
            <param name="savelog" value="true"/>
            <expand macro="logfile-test"/>
        </test>
    </tests>
    <help><![CDATA[

@MOTHUR_OVERVIEW@

**Command Documentation**

The metastats_ command generate principle components plot data.

.. _metastats: https://mothur.org/wiki/metastats/

    ]]></help>
    <expand macro="citations">
        <citation type="doi">10.1371/journal.pcbi.1000352</citation>
    </expand>
</tool>
