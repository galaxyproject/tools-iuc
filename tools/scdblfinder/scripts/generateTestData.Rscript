# Generates the test data in ../test-data
# Usage: Rscript generateTestData.Rscript <test-data dir>
suppressPackageStartupMessages({
    library(scDblFinder)
    library(Matrix)
})
outdir <- commandArgs(trailingOnly = TRUE)[1]
set.seed(42)
sce <- mockDoubletSCE(ncells = c(150, 200, 150), ngenes = 200)
counts <- as(counts(sce), "CsparseMatrix")
colnames(counts) <- sprintf("CELL%04d", seq_len(ncol(counts)))
rownames(counts) <- sprintf("GENE%03d", seq_len(nrow(counts)))

writeMM(counts, file.path(outdir, "in_matrix.mtx"))
write.table(data.frame(rownames(counts), rownames(counts), "Gene Expression"),
    file.path(outdir, "in_genes.tsv"),
    sep = "\t", quote = FALSE, row.names = FALSE, col.names = FALSE
)
write.table(colnames(counts), file.path(outdir, "in_barcodes.tsv"),
    quote = FALSE, row.names = FALSE, col.names = FALSE
)
# cluster labels (simulated cell types) and two samples, for the optional inputs
write.table(data.frame(barcode = colnames(counts), cluster = sce$cluster),
    file.path(outdir, "in_clusters.tsv"),
    sep = "\t", quote = FALSE, row.names = FALSE
)
write.table(data.frame(barcode = colnames(counts), sample = rep(c("S1", "S2"), length.out = ncol(counts))),
    file.path(outdir, "in_samples.tsv"),
    sep = "\t", quote = FALSE, row.names = FALSE
)
cat("cells:", ncol(counts), "genes:", nrow(counts), "true doublets:", sum(sce$type == "doublet"), "\n")
