<macros>
    <token name="@TOOL_VERSION@">3.0.2</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <token name="@DATATYPES@">fastqsanger.gz,fastqsanger</token>
    <xml name="bio_tools">
        <xrefs>
            <xref type="bio.tools">adapterremoval</xref>
        </xrefs>
    </xml>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">adapterremoval</requirement>
        </requirements>
    </xml>
    <xml name="interleaved_output_param">
        <param argument="--interleaved_output" type="select" label="Write paired-end reads to a single file, interleaving mate 1 and mate 2 reads?">
            <option value="no" selected="true">No</option>
            <option value="yes">Yes</option>
        </param>
    </xml>
    <xml name="polyx_cond" tokens="cond_name,polyx_label,auto_selected,off_selected">
        <conditional name="@COND_NAME@">
            <param name="mode" type="select" label="@POLYX_LABEL@" help="Poly-X tails must be at least as long as the poly-X threshold set below to be trimmed">
                <option value="auto" selected="@AUTO_SELECTED@">Auto - trim poly-G tails on known 2-colour systems</option>
                <option value="off" selected="@OFF_SELECTED@">Off - do not trim poly-X tails</option>
                <option value="all">All - trim A, C, G and T tails</option>
                <option value="custom">Custom - select the nucleotides to trim</option>
            </param>
            <when value="auto"/>
            <when value="off"/>
            <when value="all"/>
            <when value="custom">
                <param name="nucleotides" type="select" multiple="true" label="Nucleotides whose tails should be trimmed">
                    <option value="A">A</option>
                    <option value="C">C</option>
                    <option value="G" selected="true">G</option>
                    <option value="T">T</option>
                    <validator type="no_options" message="Select at least one nucleotide"/>
                </param>
            </when>
        </conditional>
    </xml>
    <xml name="trim_fixed_cond" tokens="cond_name,trim_label">
        <conditional name="@COND_NAME@">
            <param name="trim_param" type="select" label="@TRIM_LABEL@">
                <option value="no" selected="true">No</option>
                <option value="yes">Yes</option>
            </param>
            <when value="no"/>
            <when value="yes">
                <param name="trim_mate1" type="integer" value="0" min="0" label="Number of bases to trim from mate 1 reads"/>
                <param name="trim_mate2" type="integer" value="0" min="0" label="Number of bases to trim from mate 2 reads" help="Ignored for single-end input"/>
            </when>
        </conditional>
    </xml>
    <xml name="sanitizer">
        <sanitizer>
            <valid initial="string.printable">
                <remove value="'"/>
            </valid>
            <mapping initial="none">
                <add source="'" target="__sq__"/>
            </mapping>
        </sanitizer>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1186/s13104-016-1900-2</citation>
        </citations>
    </xml>
</macros>
