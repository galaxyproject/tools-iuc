<macros>
    <token name="@TOOL_VERSION@">1.2.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">perseus</requirement>
        </requirements>
    </xml>
    <xml name="taxonomy_db_param">
        <param name="taxonomy_db" type="data" format="tar" label="ETE3 taxonomy database" help="The tar archive produced by the Perseus Setup Taxonomy Database tool"/>
    </xml>
    <xml name="kraken_input_param">
        <param name="kraken_input" type="data" format="tabular" label="Kraken2 output file" help="The per-read classification output file produced by Kraken2 (not the report file)"/>
    </xml>
    <token name="@CMD_EXTRACT_TAXONOMY_DB@"><![CDATA[
mkdir -p taxonomy_db &&
tar -xf '$taxonomy_db' -C taxonomy_db &&
    ]]></token>
    <xml name="citations">
        <citations>
            <citation type="doi">10.64898/2026.03.06.710148</citation>
        </citations>
    </xml>
</macros>
