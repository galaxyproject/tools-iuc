<macros>
    <token name="@TOOL_VERSION@">1.2.0</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">perseus</requirement>
        </requirements>
    </xml>
    <xml name="taxonomy_db_param">
        <param name="taxonomy_db" type="select" label="Perseus taxonomy database" help="NCBI/ETE3 taxonomy database installed by the Perseus Taxonomy Database Data Manager">
            <options from_data_table="perseus_taxonomy_db">
                <column name="value" index="2"/>
                <column name="name" index="1"/>
            </options>
        </param>
    </xml>
    <xml name="kraken_input_param">
        <param name="kraken_input" type="data" format="tabular" label="Kraken2 output file" help="The per-read classification output file produced by Kraken2 (not the report file)"/>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1093/bioinformatics/btag687</citation>
        </citations>
    </xml>
</macros>
