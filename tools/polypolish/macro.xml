<macros>
    <token name="@TOOL_VERSION@">0.7.1</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <token name="@THREADS@"><![CDATA[
      ##compute the number of ADDITIONAL threads to be used by samtools (-@)
      addthreads=\${GALAXY_SLOTS:-1} && (( addthreads-- )) &&
  ]]></token>
    <!-- Options shared by every 'polypolish polish' invocation -->
    <token name="@POLISH_OPTIONS@"><![CDATA[
        --min_depth $options.min_depth
        --fraction_invalid $options.fraction_invalid
        --max_errors $options.max_errors
        --fraction_valid $options.fraction_valid
        $options.careful
        #if str($options.debug) == 'true'
            --debug '$debug_file'
        #end if
  ]]></token>
    <xml name="version_command">
        <version_command><![CDATA[polypolish -V]]></version_command>
    </xml>
    <xml name="xrefs">
        <xrefs>
            <xref type="bio.tools">Polypolish</xref>
        </xrefs>
    </xml>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">polypolish</requirement>
            <requirement type="package" version="1.24">samtools</requirement>
        </requirements>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1371/journal.pcbi.1009802</citation>
        </citations>
    </xml>
    <!-- Filter option of polypolish -->
    <xml name="filter_option">
        <conditional name="insert_filter">
            <param name="filter_select" type="select" label="Filter by insert size ? [recommended]" help="Exclude some alignments based on their insert size. It reduces the number of excessive alignments, particularly near the edges of repeat sequences">
                <option value="filter" selected="true">Filter by insert size</option>
                <option value="non_filter"> No filtering step</option>
            </param>
            <when value="filter">
                <param argument="--low" type="float" min="0" value="0.1" label="Low percentile threshold" help="Select the lower value to remove [default: 0.1]"/>
                <param argument="--high" type="float" min="0" value="99.9" label="High percentile threshold" help="Select the lower value to remove [default: 99.9]"/>
                <param argument="--orientation" type="select" label="Expected pair orientation" help="Orientation of a correctly aligned read pair. Leave on automatic detection unless you know your library layout [default: auto]">
                    <option value="auto" selected="true">Automatically determine from the alignments</option>
                    <option value="fr">fr (forward-reverse, e.g. Illumina paired-end)</option>
                    <option value="rf">rf (reverse-forward, e.g. Illumina mate-pair)</option>
                    <option value="ff">ff (forward-forward)</option>
                    <option value="rr">rr (reverse-reverse)</option>
                </param>
            </when>
            <when value="non_filter">
          </when>
        </conditional>
    </xml>
</macros>
