<macros>
    <token name="@TOOL_VERSION@">0.6.3</token>
    <token name="@VERSION_SUFFIX@">0</token>
    <token name="@PROFILE@">25.0</token>
    <xml name="requirements">
        <requirements>
            <requirement type="package" version="@TOOL_VERSION@">sccellfie</requirement>
            <!-- if squidpy not pinned here, the latest version will not be installed and causes issue -->
            <requirement type="package" version="1.8.2">squidpy</requirement>
            <yield/>
        </requirements>
    </xml>
    <xml name="bio_tools">
        <xrefs>
            <xref type="bio.tools">sccellfie</xref>
        </xrefs>
    </xml>
    <xml name="creator">
        <creator>
            <person givenName="Amirhossein" familyName="Naghsh Nilchi" email="nilchia@informatik.uni-freiburg.de" identifier="https://orcid.org/0000-0003-1329-3044"/>
            <person givenName="Björn" familyName="Grüning" email="gruening@informatik.uni-freiburg.de" identifier="https://orcid.org/0000-0002-3079-6586"/>
        </creator>
    </xml>
    <xml name="citations">
        <citations>
            <citation type="doi">10.1101/2025.05.09.653038</citation>
        </citations>
    </xml>
    <xml name="version_command">
        <version_command><![CDATA[python -c "import sccellfie; import importlib.metadata; print('sccellfie version: %s' % importlib.metadata.version('sccellfie'))"]]></version_command>
    </xml>
    <!-- sanitizers -->
    <xml name="sanitize_query" token_validinitial="string.printable">
        <sanitizer>
            <valid initial="@VALIDINITIAL@">
                <remove value="'"/>
            </valid>
        </sanitizer>
    </xml>
    <!-- common inputs -->
    <xml name="input_adata" token_label="Annotated data matrix (AnnData)">
        <param name="adata" type="data" format="h5ad" label="@LABEL@"/>
    </xml>
    <xml name="param_groupby" token_label="Column in adata.obs to group cells by" token_help="e.g. cell type or cluster annotation" token_optional="false">
        <param argument="groupby" type="text" optional="@OPTIONAL@" label="@LABEL@" help="@HELP@">
            <expand macro="sanitize_query"/>
        </param>
    </xml>
    <xml name="param_layer" token_label="Layer to use instead of adata.X" token_help="Leave empty to use adata.X" token_optional="true">
        <param argument="layer" type="text" optional="@OPTIONAL@" value="" label="@LABEL@" help="@HELP@">
            <expand macro="sanitize_query"/>
        </param>
    </xml>
    <xml name="param_agg_func" token_default="trimean">
        <param argument="agg_func" type="select" label="Aggregation function">
            <option value="mean">Mean</option>
            <option value="median">Median</option>
            <option value="25p">25th percentile</option>
            <option value="75p">75th percentile</option>
            <option value="trimean" selected="true">Trimean (Tukey's; 0.5*Q2 + 0.25*(Q1+Q3))</option>
            <option value="topmean">Top mean (mean of top X% of values)</option>
            <option value="fraction_above">Fraction of cells above threshold</option>
        </param>
        <yield/>
    </xml>
    <xml name="organism_param">
        <param argument="organism" type="select" label="Organism">
            <option value="human" selected="true">Human</option>
            <option value="mouse">Mouse</option>
        </param>
    </xml>
    <xml name="inputs_common_advanced">
        <section name="advanced_common" title="Advanced Options" expanded="false">
            <param name="show_log" type="boolean" checked="false" label="Output log file?"/>
            <yield/>
        </section>
    </xml>
    <xml name="anndata_outputs" token_label="Annotated data matrix">
        <data name="anndata_out" format="h5ad" from_work_dir="anndata_output.h5ad" label="${tool.name} on ${on_string}: @LABEL@"/>
        <data name="hidden_output" format="txt" label="${tool.name} on ${on_string}: log file">
            <filter>advanced_common['show_log']</filter>
        </data>
    </xml>
    <!-- command tokens -->
    <token name="@CMD_IMPORTS@"><![CDATA[
import sccellfie
import scanpy as sc
import pandas as pd
import numpy as np
    ]]></token>
    <token name="@CMD_READ_INPUTS@"><![CDATA[
adata = sc.read_h5ad('anndata.h5ad')
    ]]></token>
    <token name="@CMD@"><![CDATA[
cp '$adata' 'anndata.h5ad' &&
cat '$script_file' &&
cat '$script_file' > '$hidden_output' &&
python '$script_file' >> '$hidden_output'
    ]]></token>
    <token name="@CMD_ANNDATA_WRITE_OUTPUTS@"><![CDATA[
adata.write_h5ad('anndata_output.h5ad', compression='gzip')
    ]]></token>
    <xml name="param_plot_format">
        <param name="format" type="select" label="Format for saving the figure">
            <option value="png" selected="true">PNG</option>
            <option value="pdf">PDF</option>
            <option value="svg">SVG</option>
        </param>
        <param argument="--dpi" type="integer" min="1" max="1000" value="300" label="DPI for the figure"/>
    </xml>
    <xml name="plot_outputs">
        <data name="out_png" format="png" from_work_dir="*.png" label="${tool.name} (${method.method}) on ${on_string}: plot (PNG)">
            <filter>method['format'] == 'png'</filter>
        </data>
        <data name="out_pdf" format="pdf" from_work_dir="*.pdf" label="${tool.name} (${method.method}) on ${on_string}: plot (PDF)">
            <filter>method['format'] == 'pdf'</filter>
        </data>
        <data name="out_svg" format="svg" from_work_dir="*.svg" label="${tool.name} (${method.method}) on ${on_string}: plot (SVG)">
            <filter>method['format'] == 'svg'</filter>
        </data>
        <data name="hidden_output" format="txt" label="${tool.name} (${method.method}) on ${on_string}: log file">
            <filter>advanced_common['show_log']</filter>
        </data>
    </xml>
    <!-- outputs -->
     <xml name="pipeline_adata_out_assert">
        <assert_contents>
            <has_h5_keys keys="obs/total_counts"/>
            <has_h5_keys keys="uns/neighbors,uns/normalization,uns/umap"/>
            <has_h5_keys keys="obsm/X_pca,obsm/X_spatial,obsm/X_umap"/>
            <has_h5_keys keys="obsp/connectivities,obsp/distances"/>
            <has_h5_keys keys="layers/gene_scores,layers/smoothed_X"/>
        </assert_contents>
    </xml>
     <xml name="pipeline_reactions_out_assert">
        <assert_contents>
            <has_h5_keys keys="obs/total_counts"/>
            <has_h5_keys keys="uns/Rxn-Max-Genes,uns/neighbors,uns/normalization,uns/umap"/>
            <has_h5_keys keys="obsm/X_pca,obsm/X_spatial,obsm/X_umap"/>
            <has_h5_keys keys="obsp/connectivities,obsp/distances"/>
        </assert_contents>
    </xml>
    <xml name="pipeline_metabolic_tasks_out_assert">
        <assert_contents>
            <has_h5_keys keys="obs/total_counts"/>
            <has_h5_keys keys="uns/neighbors,uns/normalization,uns/umap"/>
            <has_h5_keys keys="obsm/X_pca,obsm/X_spatial,obsm/X_umap"/>
            <has_h5_keys keys="obsp/connectivities,obsp/distances"/>
        </assert_contents>
    </xml>
</macros>
