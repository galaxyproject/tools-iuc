<tool id="molsig" name="Molecular Design by Reverse Engineering" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <requirements>
        <requirement type="package" version="2.1.1">molecule-signature</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
    #if $input_type.type_selector=="smiles" and $input_type.incl_input_alf=="true"
        python3 '$__tool_directory__/static/update_alphabet.py' '$__tool_directory__/alphabets/$alphabet_selector' updated_alphabet.npz '$input_mode.input_text' &&
        molsig enumerate --smiles '$input_mode.input_text' --alphabet updated_alphabet.npz --output analogues_smiles.tsv
    #else
    molsig enumerate --smiles '$input_mode.input_text' --alphabet '$__tool_directory__/alphabets/$alphabet_selector' --output analogues_smiles.tsv
    #end if
    ]]></command>
    <inputs>
        <conditional name="input_type">
            <param name="type_selector" type="select" display="radio" label="Input type:" >
                <option value="smiles" selected="true">SMILES - Compute the ECFP from a molecule</option>
                <option value="ecfp">ECFP vector - Paste a 2048-dimensional count vector</option>
            </param>

        <!-- Modèle SMILES en entrée -->
        <when value="smiles">
        <conditional name="input_mode">
            <param name="mode" type="select" label="Enter a SMILES:">
                <option value="manual" selected="true">Manual selection</option>
                <option value="example_phenazinol">Exemple Phenazinol</option>
                <option value="example_linoleic_acid">Exemple Linoleic Acid</option>
                <option value="example_ursolic_acid">Exemple Ursolic Acid</option>
                <option value="example_orlistat">Exemple Orlistat</option>
            </param>
            <when value="manual">
                <param name="input_text" type="text" optional="false" label="Entry :" help="e.g. CCO or c1ccccc1"/>
            </when>
            <when value="example_phenazinol">
                <param name="input_text" type="text" optional="false" value="C1=CC=C2C(=C1)N=C3C=CC=C(C3=N2)O" label="Entry (preloaded example):" help="e.g. CCO or c1ccccc1"/>
            </when>
            <when value="example_linoleic_acid">
                <param name="input_text" type="text" optional="false" value="CCCCC/C=C/C/C=C/C/C=C/C/C=C/CCCCC(=O)O" label="Entry (preloaded example):" help="e.g. CCO or c1ccccc1"/>
            </when>
            <when value="example_ursolic_acid">
                <param name="input_text" type="text" optional="false" value="C[C@@H]1CC[C@@]2(CC[C@@]3(C(=CC[C@H]4[C@]3(CC[C@@H]5[C@@]4(CC[C@@H](C5(C)C)O)C)C)[C@@H]2[C@H]1C)C)C(=O)O" label="Entry (preloaded example):" help="e.g. CCO or c1ccccc1"/>
            </when>
            <when value="example_orlistat">
                <param name="input_text" type="text" optional="false" value="CCCCCCCCCCC[C@@H](C[C@H]1[C@@H](C(=O)O1)CCCCCC)OC(=O)C(CC(C)C)NC=O" label="Entry (preloaded example):" help="e.g. CCO or c1ccccc1"/>
            </when>
        </conditional>
            <param name="incl_input_alf" type="boolean" truevalue="true" falsevalue="false" checked="true"
                   label="Include input molecule in alphabet (recommended for molecular design)"/>
        </when>

